<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <configSections>

  </configSections>

  <connectionStrings>

    <add name="CenterDB" providerName="System.Data.SqlClient" connectionString="Server=0.0.0.0;Initial Catalog=CenterDB;Persist Security Info=False;User ID=sa;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" />

    <add name="Notify" providerName="System.Data.SqlClient" connectionString="Server=0.0.0.0;Initial Catalog=Notify;Persist Security Info=False;User ID=sa;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" />

    <add name="AdminSys" providerName="System.Data.SqlClient" connectionString="Server=0.0.0.0;Initial Catalog=AdminSys;Persist Security Info=False;User ID=sa;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" />

    <add name="PerGameLog" providerName="System.Data.SqlClient" connectionString="Server=0.0.0.0;Initial Catalog=PerGameLog;Persist Security Info=False;User ID=sa;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" />

    <add name="LogDB" providerName="System.Data.SqlClient" connectionString="Server=0.0.0.0;Initial Catalog=LogDB;Persist Security Info=False;User ID=sa;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" />

  </connectionStrings>


  <appSettings>

  </appSettings>


  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken=[REDACTED]" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="example.invalid.Http.Formatting" publicKeyToken=[REDACTED]" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>

    </assemblyBinding>
  </runtime>


  <example.invalid>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true"/>
    </settings>
  </example.invalid>


  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.0"/>
  </startup>
</configuration>
