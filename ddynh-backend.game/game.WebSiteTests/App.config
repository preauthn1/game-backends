<?xml version="1.0" encoding="utf-8"?>
<!--
  有关如何配置 example.invalid 应用程序的详细信息，请访问
  http://example.invalid/fwlink/?LinkId=301880
  -->
<configuration>
  <appSettings>
    <!--支付配置-->
    <add key="PayCenter_Doamin" value="http://example.invalid/" />
    <add key="pay_finishUrl" value="PayCenter/Finish" />
    
    <!--碼上賺-支付配置-->
    <add key="pay_msz_notifyurl" value="PayCenter/MSZPayCall" />

    <!--商易付-支付配置-->
    <add key="pay_syf_notifyurl" value="PayCenter/SYFPayCall" />

    <!--新威付-支付配置-->
    <add key="pay_NewWeiFuPay_notifyurl" value="PayCenter/NewWeiFuPayCall" />

    <!--巨富-支付配置-->
    <add key="pay_GiFuBoPay_notifyurl" value="PayCenter/GiFuBoPayCall" />

    <!--叮叮寶-支付配置-->
    <add key="pay_DDPay_notifyurl" value="PayCenter/DDPayCall" />

    <!--通匯-支付配置-->
    <add key="pay_THPay_notifyurl" value="PayCenter/THPayCall" />

    <!--鐵付-支付配置-->
    <add key="pay_IronPay_notifyurl" value="PayCenter/IronPayCall" />

    <!--四方(新王朝)-支付配置-->
    <add key="pay_HFZCPay_notifyurl" value="PayCenter/HFZCPayCall" />

    <!--啟飛-支付配置-->
    <add key="pay_GoldSoarPay_notifyurl" value="PayCenter/GoldSoarPayCall" />

    <!--吉寶-支付配置-->
    <add key="pay_JBPay_notifyurl" value="PayCenter/JBPayCall" />

    <!--樂匯第三方-支付配置-->
    <add key="pay_LeHuiPay_notifyUrl" value="PayCenter/LeHuiPayCall" />

    <!--第一付-支付配置-->
    <add key="pay_D1FPay_notifyurl" value="PayCenter/D1FPayCall" />

    <!--立馬付-支付配置-->
    <add key="pay_LiMaFuPay_notifyurl" value="PayCenter/LiMaFuPayCall" />

    <!--善付-支付配置-->
    <add key="pay_SFPay_notifyurl" value="PayCenter/SFPayCall" />

    <!--天空付-支付配置-->
    <add key="pay_WonderfulskyPay_notifyurl" value="PayCenter/WonderfulskyPayCall" />

    <!--佰坊支付-支付配置-->
    <add key="pay_GoPay_notifyurl" value="PayCenter/GoPayCall" />

    <!--上分通-支付配置-->
    <add key="pay_SFTPay_notifyurl" value="PayCenter/SFTPayCall" />

    <!--SMS配置-->
    <!--submail-->
    <add key="submail_url" value="https://example.invalid/message/xsend" />
    <add key="submail_appid" value="20829" />
    <add key="submail_project" value="NU25T" />
    <add key="submail_signature" value="bbae493b7c4f435219a63284362b7953" />
    
    <!--ucpaas-->
    <add key="ucpaas_url" value="https://example.invalid/ol/sms/sendsms" />
    <add key="ucpaas_appid" value="9818d5c4224f4e2c8e9ad399f9821889" />
    <add key="ucpaas_token" value="9ad1b3b09baa7f9543bab70e4a749063" />
    <add key="ucpaas_sid" value="57d804881da6f78306dc785cfbaf6e1a" />
    <add key="ucpaas_templateid" value="293439" />
    
    <!--haoservice-->
    <add key="haoservice_url" value="http://example.invalid/sms/send" />
    <add key="haoservice_apikey" value="292e12ec764a4192bfedfc9dc87d70e0" />
    <add key="haoservice_templateid" value="5098" />
    <add key="haoservice_method" value="GET" />
    <add key="haoservice_templatekey" value="#code#={0}" /> <!-- Example: #code#={0}  or  #code#={0}&amp;#no#={1} -->

    <!--winic-->
    <add key="winic_url" value="http://example.invalid:8009/sys_port/gateway/index.asp" />
    <add key="winic_uid" value="16620080572" />
    <add key="winic_pwd" value="james1209" />

    <!-- 设定允許访问短信服務的IP來源, 填入大厅server ip  -->
    <add key="SMS_AllowIPS" value="0.0.0.0,::1,0.0.0.0" />
    
    <!--設定是否開啟支付 -->
    <add key="paymentEnable" value="1" />

    <!--設定是否開啟統一支付 -->
    <add key="TungyiEnable" value="1" />
    <!--AES key-->
    <add key="SecretKey" value="V1M5WE7X8WE2TWEK" />
    <add key="SecretIV" value="DNW123EXGMTR83K7" />


    <add key="IsGlobalApiLogEnable" value="false" />
    <add key="IsAlwaysSlackNotifyWhenExceotion" value="true" />
    <add key="WebSiteName" value="game.WebSite.Dev" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken=[REDACTED]" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
