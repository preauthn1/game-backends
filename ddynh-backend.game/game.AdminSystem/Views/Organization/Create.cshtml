
@using FW.Core.Helper.Enum
@using game.Entity.Users
@model List<game.Entity.AdminSys.Organization>
@{
    var templateRoles = (List<game.Entity.AdminSys.Role>)ViewBag.TemplateRoles;
}

    @section pageLevelPlugins{
        <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
        <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
        <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
        <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
    }



    <div class="row">
        <div class="col-md-6 col-md-offset-3">
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-globe"></i>新增组织
                    </div>
                </div>
                <div class="portlet-body form">

                    <!-- BEGIN FORM-->
                    <form id="addUserFrom" method="post" class="form-horizontal form-bordered" novalidate="novalidate">
                        <div class="form-body">

                            <div class="form-group last">
                                <label class="control-label col-md-3">组织名称</label>
                                <div class="col-md-3">
                                    <input type="text" id="Name" name="Name" class="form-control input-medium" placeholder="请输入组织名称">
                                </div>
                            </div>

                            <div class="form-group last">
                                <label class="control-label col-md-3">简称</label>
                                <div class="col-md-3">
                                    <input type="text" id="ShortName" name="ShortName" class="form-control input-medium" placeholder="请输入简称">
                                </div>
                            </div>

                            <div class="form-group last">
                                <label class="control-label col-md-3">备注</label>
                                <div class="col-md-3">
                                    <input type="text" id="Memo" name="Memo" class="form-control input-medium" placeholder="请输入备注">
                                </div>
                            </div>

                            <div class="form-group last">
                                <label class="control-label col-md-3">是否自动建立预设的权限角色</label>
                                <div class="col-md-6" >

                                    <div style="line-height:30px;">
                                        <input type="checkbox" id="isGenerateTemplate" name="isGenerateTemplate" class="form-control input-medium" checked="checked">
                                    </div>

                                    <div style="margin-top:5px;padding:10px 15px;background:#EEE;color:#7d7d7d;border-radius:5px;">
                                        <b>
                                            若您勾选此项目，将为该组织「自动产生」以下几种权限角色
                                        </b>

                                        <div style="padding-left:10px;margin-top:4px;">

                                            @foreach (var item in templateRoles)
                                            {
                                                <div>
                                                    ．@item.RoleName
                                                </div>
                                            }

                                        </div>

                                    </div>

                                </div>

                               

                            </div>


                        </div>
                        <div class="form-actions">
                            <div class="col-md-offset-3 col-md-9">
                                <button id="btnOk" type="submit" class="btn dark" style="" onclick=""><i class="fa fa-file-o"></i> 确定</button>
                                <button id="btnBack" type="button" class="btn " style="" onclick="javascript:window.history.back();return false;"><i class="fa  fa-mail-reply-all"></i> 返回</button>
                            </div>
                        </div>
                    </form>

                    <!-- END FORM-->
                </div>
            </div>

        </div>
    </div>


    @section initScripts
{
        <script>
            $("#addUserFrom").validate({
                rules: {
                    Name: {
                        required: true,
                        minlength: 1,
                        maxlength: 100
                    },
                    ShortName: {
                        required: true,
                        minlength: 1,
                        maxlength: 10
                    },
                    password: {
                        required: true,
                        minlength: 6,
                        maxlength: 16
                    },
                    rePassword: {
                        required: true,
                        minlength: 6,
                        maxlength: 16,
                        equalTo: "#password"
                    },
                    OrgID: {
                        required: true
                    }
                },
                messages: {
                    Name: {
                        required: "不能为空",
                    }
                }
            });

            function GetQRCode() {
                const url = "/User/GetQRCode";

                $.getJSON(url, {}, function (result) {
                    if (result.success) {
                        $("#imgQRCode").attr('src', result.url);
                        $("#secretKey").val(result.key);
                    }
                });
            }
        </script>
    }
