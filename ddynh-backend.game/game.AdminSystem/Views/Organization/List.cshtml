
@using FW.Core.Helper.Enum
@using game.Entity.Users

<style>

    .dark
    {
        margin-right:3px;
    }

</style>

@model List<game.Entity.AdminSys.Organization>
@{
    var eachCount = (List<game.Entity.EachOrganizationPlatformCountSummaryViewModel>)ViewBag.EachCount;
}

            <div>
                <div class="row">
                    <div class="col-md-12 ">
                        <div class="table-scrollable">
                            <table class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width:5%;">编号</th>
                                        <th>名称</th>
                                        <th>简称</th>
                                        <th>备注</th>
                                        <th>设定平台数</th>
                                        <th>帐号数</th>
                                        <th style="width:15%;">建立时间</th>
                                        <th style="width:25%;">操作</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        var match = eachCount.FirstOrDefault(x => x.OrgID == item.OrgID);

                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.ShortName</td>
                                        <td>@item.Memo</td>
                                        <td>@(match == null ? 0 : match.TotalPlatformCount)</td>
                                        <td>@(match == null ? 0 : match.TotalUserCount)</td>
                                        <td>@item.CreateTime</td>
                                        <td>
                                            <a id="" class="btn btn-sm dark" style="" onclick="" href="/Organization/Edit?orgId=@item.Id">编辑资讯</a>
                                            <a id="" class="btn btn-sm dark" style="" onclick="" href="/Organization/ChangePlatform?orgId=@item.Id">修改关联平台</a>

                                        </td>
                                    </tr>
                                    }


                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>



            </div>
