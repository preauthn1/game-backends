@using FW.Core.Web.Mvc
@model  FW.Core.Helper.PagedList<game.Entity.Stat.AreaDataMonth>
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <link href="@Url.Content("~/Content/fontawesome/css/fontawesome.min.css")" rel="stylesheet">
}

@{
    var summary = (game.Entity.Stat.SumAreaDataMonthView)ViewBag.Summary;
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", true)
                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.AddMonths(-6).ToString("yyyy-MM")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <input type="hidden" name="sortName" id="sortName" value="@ViewBag.CurrentSort" />
                    <input type="hidden" name="sortLifting" id="sortLifting" />
                    <button type="submit" class="btn btn-default" name="btnSearch" value="search"> 搜 索 </button>
                    <button type="submit" class="btn btn-default" name="btnSearch" value="excel"> 汇 出 (上限5000笔) </button>
                    <span style="position: fixed; right:20px;">
                        <button type="button" class="btn" onclick="global_showMyModal()">各渠道总计</button>
                    </span>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th class="hide">编号</th>
                            <th>所属平台</th>
                            <th>所属渠道</th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="StatTime" onclick="submitForm('@game.Entity.AdminSys.SortName.StatTime')">统计时间</a>
                            </th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="ChargeAmount" onclick="submitForm('@game.Entity.AdminSys.SortName.ChargeAmount')">充值获得金币(第三方 + 官方)</a>
                            </th>
                            <th>
                                <a style="font-weight:bold;" name="Sort" href="#" id="ConvertAmount" onclick="submitForm('@game.Entity.AdminSys.SortName.ConvertAmount')">兑换金额</a>
                            </th>
                            <th>兑换手续费</th>
                            <th>登入游戏用户数</th>
                            <th>登入游戏机器数</th>
                            <th>登入游戏IP数</th>
                            <th>游戏税收</th>
                            <th>付費平均比</th>
                            <th>註冊用戶人数</th>
                            <th>註冊用戶充值人数</th>
                            <th>每月充值人数</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                var xml = new System.Xml.XmlDocument();
                                xml.LoadXml(string.Format("<ArrayOfGameTaxDetail>{0}</ArrayOfGameTaxDetail>", item.GameTaxDetail));
                                var hasGameTaxDetail = !string.IsNullOrWhiteSpace(item.GameTaxDetail);
                                <tr>
                                    <td class="hide">@item.Id</td>
                                    <td>@item.PlatformName</td>
                                    <td>@item.AreaName</td>
                                    <td>@item.StatTime.ToString("yyyy-MM")</td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldCharge.ToCash()，新用户：@item.NewCharge.ToCash()">@((item.OldCharge + item.NewCharge).ToCash())</div></td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldConvert.ToCash()，新用户：@item.NewConvert.ToCash()">@((item.OldConvert + item.NewConvert).ToCash())</div></td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldConvertTax.ToCash()，新用户：@item.NewConvertTax.ToCash()">@((item.OldConvertTax + item.NewConvertTax).ToCash())</div></td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldLogin，新用户：@item.NewLogin">@(item.OldLogin + item.NewLogin)</div></td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldLoginMac，新用户：@item.NewLoginMac">@item.LoginMac</div></td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldLoginIP，新用户：@item.NewLoginIP">@item.LoginIP</div></td>
                                    <td data-toggle="tooltipcustom" data-hasdetail="@(hasGameTaxDetail ? 1 : 0)">
                                        <p style="display:none;">
                                            @if (hasGameTaxDetail)
                                            {
                                                foreach (System.Xml.XmlNode taxDetail in xml.GetElementsByTagName("GameTaxDetail"))
                                                {
                                                    <text>@string.Format("{0}：{1}", taxDetail.FirstChild.InnerText, (1 * long.Parse(taxDetail.LastChild.InnerText)).ToCash())</text><br />
                                                }
                                            }
                                        </p>
                                        <div>@item.GameTax.ToCash()</div>
                                    </td>
                                    <td>@item.ARPU.ToCash()</td>
                                    <td>@item.TotalRegCount</td>
                                    <td>@item.NewOrderUser</td>
                                    <td>@item.Total_OrderUser</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="modal_empty_template" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:90%">
        <div class="modal-content" style="padding:15px;text-align:center;">
            <h4><b>月報表</b></h4>

            <div style="text-align:center;font-size:14px;color:#4c75bf;">
                @summary.BeginTime - @summary.EndTime
            </div>

            <table class="table table-striped table-bordered table-hover" style="margin-top:10px;">

                <tr>
                    <th>所属平台</th>
                    <th>所属渠道</th>
                    <th>充值获得金币(第三方 + 官方)</th>
                    <th>兑换金额</th>
                    <th>兑换手续费</th>
                    <th>登入游戏用户数</th>
                    <th>登入游戏机器数</th>
                    <th>登入游戏IP数</th>
                    <th>游戏税收</th>
                    <th>付費平均比</th>
                    <th>註冊用戶人数</th>
                    <th>註冊用戶充值人数</th>
                    <th>每月充值人数</th>
                </tr>

                @foreach (var item in summary.GroupSummary)
                {
                    <tr>
                        <td>@item.PlatformName</td>
                        <td>@item.AreaName</td>
                        <td>@item.TotalCharge.ToCash()</td>
                        <td>@item.TotalConvert.ToCash()</td>
                        <td>@item.TotalConvertTax.ToCash()</td>
                        <td>@item.TotalLogin</td>
                        <td>@item.LoginMac</td>
                        <td>@item.LoginIP</td>
                        <td>@item.GameTax.ToCash()</td>
                        <td>@item.ARPU</td>
                        <td>@item.TotalRegCount</td>
                        <td>@item.NewOrderUser</td>
                        <td>@item.Total_OrderUser</td>
                    </tr>

                }

            </table>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                </div>

            </div>

    </div>
</div>

@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');

            $('#platformid').change();

            $('[data-toggle="tooltip"]').tooltip();

            $('[data-toggle="tooltipcustom"]').each(function (i, e) {
                if ($(e).data('hasdetail') == '1') {
                    $(e).children('div').tooltip({ 'html': true, 'title': $(e).children('p').html(), 'placement': 'left' });
                }
            });

            $("a[name='Sort']").removeClass();
            if ("@ViewBag.SortLifting" == "True") {
                $('#@ViewBag.CurrentSort').addClass("fa fa-sort-up");
            }
            else {
                $('#@ViewBag.CurrentSort').addClass("fa fa-sort-down");
            }
        })

        function submitForm(sortColumn) {
            var _sortLifting = ("@ViewBag.SortLifting" == "True");
            _sortLifting = !_sortLifting;

            $('#sortName').val(sortColumn);
            $('#sortLifting').val(Number(_sortLifting));
            $('#form_search').submit();
        }
    </script>
}