        )
    {
        name = "platformid";
        listPlatform = DataService.GetAllPlatform().FindAll(m => SiteHelper.GetPlatformIDs().Contains(m.Id));
    }

    //3rd party get platform
    if (
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "payment" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "orderlist")
        ||
