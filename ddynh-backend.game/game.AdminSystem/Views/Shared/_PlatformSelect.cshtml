        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "gamemessage" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "add")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "gamemessage" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "edit")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "gamemaster" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "gameserverlist")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "userstat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "getactiveuserkeeplog")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "userstat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "getchargekeeplog")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "message" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "smslog")
