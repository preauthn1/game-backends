        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "moneystat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "gametaxlog")
        ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "moneystat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "gameservertaxlog")
