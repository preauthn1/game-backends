        name = "platformids";
        listPlatform = DataService.GetAllPlatform().FindAll(m => SiteHelper.GetPlatformIDs().Contains(m.Id));
    }

    if (
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "info" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "downloadList")
       ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "message" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "send")
       ||
