    {
        name = "platformids";
        listPlatform = DataService.GetPlatformByAdminId(ViewBag.operatorID);
    }
    if (
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "payment" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "infosetting")
