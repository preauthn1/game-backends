        )
    {
        listPlatform = DataService.GetPlatformByAdminId(ViewBag.operatorID);
    }
}

@if (listPlatform.Count > 0)
{
    listPlatform = listPlatform.OrderBy(x=> x.Id).ToList();
    if (Model)
    {
        <div class="form-group _clear">
            <label class="_hide control-label col-md-4 xing ">平台</label>
            <div class="col-md-8">
                <select class="form-control input-small" id="@name" name="@name">
                    @foreach (var p in listPlatform)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
        </div>
    }
    else
    {
        <div class="form-group _clear">
            <label class="_hide">平台</label>
            <select class="form-control input-small" id="@name" name="@name">
                <option value="">--不限--</option>
                @foreach (var p in listPlatform)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
    }
}
