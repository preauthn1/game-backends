       ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "areastat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "statallareadatamonth")
       ||
        (Request.RequestContext.RouteData.Values["controller"].ToString().ToLower() == "areastat" && Request.RequestContext.RouteData.Values["action"].ToString().ToLower() == "statallareadatadata")
        ||
