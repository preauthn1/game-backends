@{ 
    var listArea = DataService.GetAllArea();
}

<div class="form-group">
    <label>渠道</label>
    <select class="form-control" id="areaID" name="areaID" style="width:180px;">
        <option value="">--不限--</option>
        @foreach (var a in listArea)
        {
            <option value="@a.AreaID" data-pid="@a.PlatformID" style="display:none;">
                @string.Format("{0} {1}" , a.AreaID , a.AreaName)
        </option>
        }
    </select>
</div>


<script>
    var _first = true;

    function changeAreaOption(pid) {       
               
        $('#areaID>[data-pid]').hide();
        $('#areaID>[data-pid="' + pid + '"]').show();
        
        if (!_first) {
            $('#areaID').val('')
        }
        else {
            _first = false
        }
    }
    
    $(function () {
        var pid = getQueryString("platformid")
        if (!pid) {
            pid = getQueryString("platformids")
        }

        changeAreaOption(pid)

        //要先選平台才能選渠道
        $('#platformids').change(() => {
            var pid = $('#platformids').val()
            changeAreaOption(pid)
        })

        $('#platformid').change(() => {
            var pid = $('#platformid').val()
            changeAreaOption(pid)
        })
    })
</script>