@model DropdownPartialSettingViewModel

@{
    DropdownPartialSettingViewModel myModel = Model;
    myModel = myModel ?? new DropdownPartialSettingViewModel();

    string name = myModel.DOM_ElementName ?? "status";
}

    <select class="form-control" id="@name" name="@name" style="width:120px;">

        @if (myModel.FirstOption != null)
        {
            <option value="@myModel.FirstOption.Value">@myModel.FirstOption.Text</option>
        }
        
        <option value="true"  @(myModel.DefaultSelectValue == "1" ? "selected='selected'" : "")  >是</option>
        <option value="0"  @(myModel.DefaultSelectValue == "0" ? "selected='selected'" : "")  >否</option>

    </select>

