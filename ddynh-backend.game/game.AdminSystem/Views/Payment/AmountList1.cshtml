@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using Newtonsoft.Json;
@using game.Entity.Payment;

@section pageLevelPlugins{

}

<style>
    .payGateway {
        display: flex;
    }

    .gateway_btn {
        display: flex;
        align-items: center;
        padding-left: 2%;
    }
</style>

<div class="row" id="payment_amountlist">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th conspan="7">渠道名称</th>
                        </tr>
                        <tr>
                            <th>支付方式</th>
                            <th>最小金额限制</th>
                            <th>最大金额限制</th>
                            <th>是否是固定金额</th>
                            <th>固定金额列表</th>
                            <th>当前状态</th>
                            <th>功能</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.list != null)
                        {
                            List<game.Entity.Pay.PayGateway> list = ViewBag.list;
                            var GatewayName = "";
                            foreach (var item in list)
                            {
                                if (GatewayName != item.GatewayName)
                                {
                                    GatewayName = item.GatewayName;
                                    <tr>
                                        <td colspan="6"><h5><b>@item.GatewayName&nbsp;(@item.GWID)</b></h5></td>
                                        <td>&nbsp;</td>
                                    </tr>
                                }
                                <tr class="@item.GWID">
                                    <td>@item.TypeName</td>
                                    <td>@(item.IsRange ? item.MinValue.ToCash() : "--")</td>
                                    <td>@(item.IsRange ? item.MaxValue.ToString() : "--")</td>
                                    <td>@(item.IsRange ? "否" : "是")</td>
                                    <td>
                                        @(item.IsRange ? "--" : item.AmountSort.Substring(0, (item.AmountSort.Length - 2)).Replace("00,", ","))
                                    </td>
                                    <td>
                                        @*<span class="label @(item.Status? "label-success" : "label-danger")">@(item.Status ? "启用" : "停用")</span>*@
                                        <a name="btnStatus" class="btn btn-sm btn-default @(item.Status? "btn-success" : "btn-danger")" onclick="setPayTypeDisable(@(item.Status? 2 : 1), @item.DisableId, @item.TradeCode, @ViewBag.platformId)">@(item.Status ? "开启" : "关闭")</a>
                                    </td>
                                    <td>
                                        @Html.LinkWithRight(action: "UpdatePlatformPayType",
                                            value: "編輯",
                                            onclick: "setPayType(" + item.DisableId + ", " + item.TradeCode + ", '" + GatewayName + " " + item.TypeName + "', '" + item.MinValue + "','" + item.MaxValue + "'," + (item.IsRange ? 1 : 0) + ",'" + item.AmountSort + "', " + (item.Status ? 1 : 0) + ")",
                                            href: "#",
                                            cssName: "btn btn-sm default")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="platformPayTypeModal" tabindex="-1" role="dialog" aria-labelledby="platformPayTypeModal" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">请填入<span id="labName"></span>资讯</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="order_text">
                        <span>最小金额限制</span>
                    </div>
                    <input type="text" name="MinAmount" id="MinAmount" class="form-control input-medium" placeholder="请输入最小金额" value="" /><br />

                    <div class="order_text">
                        <span>最大金额限制</span>
                    </div>
                    <input type="text" name="MaxAmount" id="MaxAmount" class="form-control input-medium" placeholder="请输入最大金额" value="" /><br />

                    <div class="order_text">
                        <span>是否使用固定金额</span>
                    </div>
                    <select name="IsRange" id="IsRange">
                        <option value="1">固额</option>
                        <option value="0">非固额</option>
                    </select>
                    <br />

                    <div class="order_text">
                        <span>固定金额列表(请使用,(逗号)做区隔)</span>
                    </div>
                    <textarea rows="10" cols="80" name="AmountList" id="AmountList"></textarea>
                    <br />
                </div>
                <div class="modal-footer">
                    <input type="hidden" name="Id" id="Id" value="">
                    <input type="hidden" name="PayTypeId" id="PayTypeId" value="">
                    <input type="hidden" name="Status" id="Status" value="1" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                    <button type="button" class="btn btn-primary" onclick="setPlatformPayType()">确定</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section initScripts{
    <script>
        function setPayType(id, payTypeId, name, minAmount, maxAmount, isRange, amountList) {
            $('#Id').val(id);
            $('#PayTypeId').val(payTypeId);
            $('#labName').text(name);
            $('#MinAmount').val(minAmount / 100);
            $('#MaxAmount').val(maxAmount / 100);
            if (isRange == 1) {
                $('#IsRange option[value=0]').attr('selected','selected');
            }
            else {
                $('#IsRange option[value=1]').attr('selected','selected');
            }
            amountList = amountList.substr(0, (amountList.length - 2)).replace(/00,/g, ",");
            $('#AmountList').val(amountList);
            $('#platformPayTypeModal').modal('show');
        }

        function setPlatformPayType() {
            var id = $('#Id').val();
            var payTypeId = $('#PayTypeId').val();
            var platformId = $('#platformid').val();
            var minAmount = $('#MinAmount').val() * 100;
            var maxAmount = $('#MaxAmount').val() * 100;
            var isRange = $('#IsRange').val();
            var amountList = $('#AmountList').val().trim().replace(/,/g, "00,");
            if (amountList.length > 0) {
                amountList += "00";
            }
            $('#platformPayTypeModal').modal('hide');

            var option = {
                isAjax: true,
                isReload: true
            }
            var url = "UpdatePlatformPayType?id=" + id + "&payTypeId=" + payTypeId + "&platformId=" + platformId + "&minAmount=" + minAmount + "&maxAmount=" + maxAmount + "&isRange=" + isRange + "&amountList=" + amountList + "&status=1";
            swDelConfirmUrl(url,
                "确定修改此数据吗？",
                option);
        }

        function setOrderID(min) {
            $('#exampleModal').modal('show');
        }

        function setPayTypeDisable(type, id, payTypeId, platformId) {
            let result = [];
            $.ajax({
                cache: false,
                dataType: 'text',
                url: '/Payment/UpdatePayTypeDisable',
                data: {
                    type: type,
                    id: id,
                    payTypeId: payTypeId,
                    platformId: platformId,
                    newfun: 1
                },
                contentType: "application/text; charset=utf-8",
                type: 'get',
                success: function (val) {
                    const status = val.status
                    val
                    swal({
                        type: val ? 'success' : 'error',
                        title: '設定結果',
                    }).then((result) => {
                        location.reload();
                    })
                },
                error: function (err) {

                }
            });
        }

        $(function () {
            var pid = getQueryString("platformid")
            $("#platformid").children().each(function () {
                if ($(this).val() == pid) {
                    $(this).attr("selected", "true");
                }
            });
        })
    </script>
}
