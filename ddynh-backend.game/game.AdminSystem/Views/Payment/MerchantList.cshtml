@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
}

<style>
    .payGateway {
        display: flex;
    }

    .gateway_btn {
        display: flex;
        align-items: center;
        padding-left: 2%;
    }
</style>

<div class="row" id="pay_merchantlist">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                <div class="form-group">
                    <button type="button" id="search" name="search" class="btn btn-default" v-on:click="search"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>支付渠道</th>
                            <th>平台</th>
                            <th>商务号资讯</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in tableList">
                            <td>
                                {{item.GWName}}
                            </td>
                            <td>{{item.PlatformName}}</td>
                            <td style="max-width:500px; word-break: break-all; white-space: normal;">
                                {{item.InfoData}}
                            </td>
                            <td>{{(item.Status == 1)? 'Active' : 'Inactive'}}</td>
                            <td>
                                <a name="btnModify" class="btn btn-sm dark" :href="'/Payment/InfoSetting?gwID=@ViewBag.gwID&targetID='+item.ID+'&platformid='+item.PlatformId"> 修 改 </a>
                                <a name="btnStatus" class="btn btn-sm dark" :href="'/Payment/UpdateInfoStatus?gwID=@ViewBag.gwID&targetID='+item.ID+'&status='+((item.Status)?0:1)">{{(item.Status == 1)? '停用' : '啟用'}}</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="form-group" style="text-align:center;">
        <a id="btnModify" class="btn btn-sm dark" style="" onclick="" href="/Payment/InfoSetting?gwID=@ViewBag.gwID"> 新 增 </a>
        @Html.Back("/Payment/PayGatewayList")
    </div>
</div>

@section initScripts{
    <script>
        $(function () {
            var vApp = new Vue({
                el: '#pay_merchantlist',
                data: {
                    tableList: [],
                    platformid: 0,
                    infoList: [
                        '商户号编号',
                        '商户号密钥',
                        '加密密钥',
                        '初始向量',
                        '私钥档案',
                        '私钥密码',
                        '公钥档案',
                        '电子信箱',
                        '管理者帐号',
                        '密码',
                        '域名',
                        'Party编号',
                        'Account编号',
                        '多得宝公钥',
                        '支付金钥',
                        '支付密钥',
                        'App编号',
                        'Product编号',
                        '终端号',
                        '伺服器公钥',
                        'API网址',
                        'Token',
                        '验证密钥',
                        '安全码',
                        '存款API网址',
                        '提款API网址',
                        '查询订单网址',
                        '机构号'
                    ]
                },
                methods: {
                    search: function () {
                        var platformId = $('#platformid').val();
                        vApp.getTableList(platformId);
                    },
                    getTableList: function (platformid = '') {
                        vApp.tableList = [];
                        $.get('/payment/GetMerchantList?gwID=@ViewBag.gwID&platformid='+platformid, { '_r': Math.random() }, (data) => {
                            if (data instanceof Object) {
                                for (let obj of data.merchant) {
                                    var uuid = "";
                                    if (obj.Uuid != undefined) {
                                        console.log(typeof(obj.Uuid), obj.Uuid);
                                        uuid = obj.Uuid.toString().replace(/\"/g, "");
                                    }
                                    vApp.tableList.push({
                                        ID: obj.ID,
                                        GWID: obj.GWID,
                                        GWName: obj.GWName,
                                        PlatformName: obj.PlatformName,
                                        InfoData: obj.InfoData,
                                        Status: obj.Status,
                                        MerchantStatus: obj.MerchantStatus,
                                        PlatformId: obj.PlatformId
                                    });
                                }
                            }
                            else {
                                vApp.tableList = {};
                            }
                        });
                    }
                }
            });
            vApp.getTableList();
        })
    </script>
}

