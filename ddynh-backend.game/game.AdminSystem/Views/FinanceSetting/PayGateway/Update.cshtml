
@using FW.Core.Helper.Enum
@using game.Entity.Users
@using game.Infrastructure.Extensions
@using game.AdminSystem

@model game.AdminSystem.Models.ViewModels.PayGatewayAdminUpdateViewModel

@{


}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}


<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>支付厂商管理
                </div>
            </div>
            <div class="portlet-body form">

                <!-- BEGIN FORM-->
                <form id="myForm" method="post" class="form-horizontal form-bordered" novalidate="novalidate">
                    <div class="form-body">


                        <input type="hidden" value="@Model.ID" name="Id" id="Id" />


                        <div class="form-group last">
                            <label class="control-label col-md-3">第三方金流名称</label>
                            <div class="col-md-3">
                                <input type="text" id="GatewayName" name="GatewayName" class="form-control input-medium" value="@Model.GatewayName" placeholder="">
                            </div>
                        </div>


                        <div class="form-group last">
                            <label class="control-label col-md-3">第三方金流代码</label>
                            <div class="col-md-3">
                                <input type="text" id="GatewayCode" name="GatewayCode" class="form-control input-medium" value="@Model.GatewayCode" placeholder="" disabled>
                            </div>
                        </div>


                        <div class="form-group last">
                            <label class="control-label col-md-3">启用状态</label>
                            <div class="col-md-3">

                                @Html.Partial("_DropdownActiveStatus", new DropdownPartialSettingViewModel { DefaultSelectValue = Model.Status.ToString() })

                            </div>
                        </div>


                        <div class="form-group last">
                            <label class="control-label col-md-3">是否支援代收</label>
                            <div class="col-md-3">

                                @Html.Partial("_DropdownNormalBoolean", new DropdownPartialSettingViewModel { DefaultSelectValue = Model.SupportPayin ? "1" : "0", DOM_ElementName = "SupportPayin" })

                            </div>
                        </div>


                        <div class="form-group last" style="margin-bottom:25px;">
                            <label class="control-label col-md-3">是否支援代付</label>
                            <div class="col-md-3">

                                @Html.Partial("_DropdownNormalBoolean", new DropdownPartialSettingViewModel { DefaultSelectValue = Model.SupportPayout ? "1" : "0", DOM_ElementName = "SupportPayout" })


                                <div id="convertTypesPanel" style="margin-top:15px;display:none;">

                                    <div>
                                        <input type="checkbox" id="IsSupportt_Alipay_CheckText" name="IsSupportt_Alipay_CheckText" @(Model.IsSupportt_Alipay ? "checked='checked'" : "")  />
                                        <label for="IsSupportt_Alipay_CheckText">支援支付宝代付</label>
                                    </div>

                                    <div>
                                        <input type="checkbox" id="IsSupportt_Unionpay_CheckText" name="IsSupportt_Unionpay_CheckText" @(Model.IsSupportt_Unionpay? "checked='checked'" : "")) />
                                        <label for="IsSupportt_Unionpay_CheckText">支援银联代付</label>
                                    </div>

                                </div>


                            </div>
                        </div>



                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            <button id="btnOk" type="submit" class="btn dark" style="" onclick=""><i class="fa fa-file-o"></i> 确定</button>
                            @Html.Back(Url.Action("paygatewaylist", "payment"))
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>


@section initScripts
{
    <script>

       
        $("#myForm").validate({
            rules: {
                GatewayName: {
                    maxlength: 20
                }
            },
            messages: {
                Name: {
                    required: "不能为空",
                }
            }
        });



        $(function () {
            
            $("#SupportPayout").change(function ()
            {                
                displayConvertType();
            })

            //第一次進入的時候也要檢查
            displayConvertType();
        })


        function displayConvertType() {

            var selectedValue = $("#SupportPayout").val();
            
            if (selectedValue == '0')
            {
                $("#convertTypesPanel").hide();
            }
            else
            {
                $("#convertTypesPanel").show();
            }
        }








    </script>
}
