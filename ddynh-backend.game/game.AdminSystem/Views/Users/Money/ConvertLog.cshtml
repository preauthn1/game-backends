            $('.group-checkable').change(function () {
                var set = $(this).attr('data-set');
                var checked = $(this).is(':checked');
                $(set).each(function () {
                    if (checked) {
                        $(this).attr('checked', true);
                    } else {
                        $(this).attr('checked', false);
                    }
                });
                $.uniform.update(set);
            });

            $('#exampleModal .checkbox').change(function (data) {
                var checkbox = $('.target');
                var checked = $(data.target).is(':checked');
                var value = data.target.value;

                $(checkbox).each((index, item) => {
                    if (checked) {
                        if (item.value !== value) {
                            $(item).attr('checked', false);
                        }
                    }
                });
                $.uniform.update(checkbox);
            });

            $('#passedModal .checkbox').change(function (data) {
                var checkbox = $('.convert');
                var checked = $(data.target).is(':checked');
                var value = data.target.value;

                $(checkbox).each((index, item) => {
                    if (checked) {
                        if (item.value !== value) {
                            $(item).attr('checked', false);
                        }
                    }
                });
                $.uniform.update(checkbox);
            });
        })

		function exportexcel() {
			$("#convert_table").table2excel({
				exclude: ".noExl",
				name: "ConvertLog",
				filename: "ConvertLog" + new Date().toISOString().replace(/[\-\:\.]/g, "") + ".xls",
				fileext: ".xls",
				exclude_img: true,
				exclude_links: true,
				exclude_inputs: true,
			});
        }
