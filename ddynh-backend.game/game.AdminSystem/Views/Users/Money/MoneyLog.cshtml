
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Scripts/jquery.table2excel.js")"></script>
}


@{
    string defaultBeginTimeText = ViewBag.defaultBeginTime;
    string defaultEndTimeText = ViewBag.defaultEndTime;
}



<style>
    .content {
        padding: .5%;
        font-size: 1.2em;
        font-family: serif;
    }

    table td {
        font-size: 0.9em !important;
    }


    a.link {
        text-decoration: underline;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                @Html.Partial("~/Views/Shared/SourceType.cshtml")
                <div class="form-group">
                    <label>IP地址</label>
                    <input type="text" class="form-control input-small " id="ipAddress" name="ipAddress" placeholder="IP地址">
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" value="@defaultBeginTimeText" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" value="@defaultEndTimeText" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-default" onclick="search()"> 搜 索 </button>
                    <button type="button" class="btn btn-default" onclick="exportexcel()"> 汇出本页 </button>
                </div>
            </form>
            @Html.Partial("_message")
            <div class="content">
                <table id="money_table" class="display" style="width:100%"></table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>

		function createTable() {
			const url = '/money/GetMoneyLog'
			const thead = [{ "sTitle": "创建时间", "mData": "CreateTime" },
							{ "sTitle": "所属平台", "mData": "PlatformName" },
							{
								"sTitle": "用户ID", "mData": "UserID",
								"render": function (data, type, row) {
									return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
								}
							},
							{
								"sTitle": "帐号", "mData": "LoginName",
								"render": function (data, type, row) {
									return `<a class="link" target="_blank" href="/UserInfo/Search?loginName=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
								}
							},
							{ "sTitle": "用户等级", "mData": "GradeID", "className": "text_right" },
							{ "sTitle": "流通类型", "mData": "SourceName" },
							{ "sTitle": "当前数量", "mData": "CurrentAmount", "className": "text_right" },
							{ "sTitle": "更新的数量", "mData": "UpdateAmount", "className": "text_right" },
							{ "sTitle": "更新后数量", "mData": "TotalAmount", "className": "text_right" },
							{ "sTitle": "IP地址", "mData": "IPAddress" },
							{ "sTitle": "说明", "mData": "Memo" },
							{
								"sTitle": "",
								"mData": "TradeID",
								"className": "noExl",
								"mRender": function (data, type, full) {
									var delete_token = [REDACTED]"DeleteAreaGame", "post")`

									details_control = `<div class ="pointer details-control" data-toggle="tooltip" data-placement="left">
														   <div class ="btn-game "></div>
														   <span>牌局<span>
														   </div>`

									return `<div class="control">${details_control}<div>`
								}
							}]

			const loginName = $('#loginName').val()
			const userID = $('#userID').val()
			const sourceTypeGroup = $('#sourceTypeGroup').val()
			const sourceType = $('#sourceType').val()
			const ipAddress = $('#ipAddress').val()
			const beginTime = $('#beginTime').val()
			const endTime = $('#endTime').val()

			const data = {
				loginName: loginName,
				userID: userID,
				sourceTypeGroup: sourceTypeGroup,
				sourceType: sourceType,
				ipAddress: ipAddress,
				beginTime: beginTime,
				endTime: endTime
			}

			createDataTable('money', thead, url, data)
		}

		function search() {
			var errorMsg = validateFunc()
			if (errorMsg) {
				Msg.alert(errorMsg, 'danger')
				return false
			}

			createTable()
		}

		function exportexcel() {
			$("#money_table").table2excel({
				exclude: ".noExl",
				name: "MoneyLog",
				filename: "MoneyLog" + new Date().toISOString().replace(/[\-\:\.]/g, "") + ".xls",
				fileext: ".xls",
				exclude_img: true,
				exclude_links: true,
				exclude_inputs: true,
			});
		}

		var validateFunc = function () {
			//20190618 Eddie 取消檢查
			/*
			var validator = new Validator()
			validator.add([form_search.loginName, form_search.nickName, form_search.userID], [{
				strategy: 'isSomeNonEmpty',
				errorMsg: '账户信息不能全为空,请输入账号或者ID！'
			}])

			var errorMsg = validator.start()
			return errorMsg
			*/
		}

		$(function () {
			createTable()

			$('#money_table tbody').on('mouseover', '.details-control', function () {
				var tr = $(this).closest('tr')
				var tooltip = $(this).closest('[data-toggle="tooltip"]');
				var row = dataTable.row(tr)
				var data = row.data()

				if (data.TradeID != 0) {
					$.post('/money/GetPerGameLogByTradeID', { '_r': Math.random(), tradeID: data.TradeID }, function (data) {
						var qna = data.result
						var res = qna.join("</br>");

						tooltip.attr('data-original-title', res)
						tooltip.tooltip({
							'html': true,
							animation: true,
							delay: { "show": 500, "hide": 100 }
						}).tooltip("show")
					})
				} else {
					tooltip.tooltip({
						'html': true,
						animation: true,
						title: '无资料',
						delay: { "show": 500, "hide": 100 }
					}).tooltip("show")
				}
			})
		})
    </script>
}