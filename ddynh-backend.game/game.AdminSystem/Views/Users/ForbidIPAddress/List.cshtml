@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  FW.Core.Helper.PagedList<game.Entity.Game.ForbidIPAddress>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
@section RightTab {
    @Html.TabWithRight(action: "Add", controller: "ForbidIPAddress",onclick: "window.location.href ='/ForbidIPAddress/Add'")
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>IP地址起</label>
                    <input type="text" class="form-control input-small" id="ipAddress" name="ipAddress" placeholder="IP地址起">
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" id="createBeginTime" name="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@Convert.ToDateTime(DateTime.Now.AddDays(-30).ToShortDateString()).ToString("yyyy-MM-dd HH:mm")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="createEndTime" name="createEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
        
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th class="hide">编号</th>
                            <th>创建时间</th>
                            <th>IP地址起</th>
                            <th>IP地址迄</th>
                            <th>说明</th>
                            <th>过期时间</th>
                            <th>
                                操作
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                  <td class="hide">@item.Id</td>
                                    <td>@item.Createtime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.IPAddress</td>
                                    <td>@item.IPAddress2</td>
                                    <td>@item.Memo</td>
                                    <td>@item.ExpireTime.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @Html.LinkWithRight(action: "Del", onclick: "swDelConfirmUrl('/ForbidIPAddress/Del/" + item.Id+"')",href:"#")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}