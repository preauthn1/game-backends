        function ForbidUser(id) {
            swDelConfirmUrl("ForbidUser?userID=" + id, "确定要封锁此帐号吗?");
        }

        function ConfirmDeleteOrNot(id) {

            var text = prompt("若要刪除此項目，請輸入原因 (必填项目, 30字)", "");

            if (text == null) {
                return;
            }

            if (text == '') {
                alert('原因为必填项目');
                return;
            }

            if(text.length > 60)
            {
                alert('储存失败: 字数过多');
                return;
            }

            var postBody =
            {
                id: id,
                memo : text
            };

            $.ajax({
                cache: false,
                url: '/UserInfoFlowAmount/DeleteFlowAmountLimit',
                type: 'POST',
                data: postBody,
                success: function (data) {

                    if (data.IsSuccess) {

                        alert(data.Message);

                        //刷新Table
                        $("#flowAmountSearch")[0].click();

                    }
                    else {
                        alert(data.Message);
                    }

                },
                error: function (err) {
                    swal({
                        type: 'error',
                        title: '操作失败',
                        text: err
                    })
                }
            });


        }




    </script>
}