@using FW.Core.Helper.Enum
@using game.Entity.Users

@model UserInfoDetail
@{
    DateTime? beginTime = ViewBag.BeginTime;
    DateTime? endTime = ViewBag.EndTime;
    var strBeginTime = beginTime == null ? "" : beginTime.Value.ToString("yyyy-MM-dd HH:mm");
    var strEndTime = endTime == null ? "" : endTime.Value.ToString("yyyy-MM-dd HH:mm");
    string rangeDate = "不限";
    if (beginTime != null && endTime != null)
    {
        rangeDate = string.Format("{0}至{1}", beginTime.Value.ToString("yyyy-MM-dd HH:mm"), endTime.Value.ToString("yyyy-MM-dd HH:mm"));
    }
    else if (beginTime != null)
    {
        rangeDate = string.Format("{0}到现在", beginTime.Value.ToString("yyyy-MM-dd HH:mm"));
    }
    else if (endTime != null)
    {
        rangeDate = string.Format("{0}之前", endTime.Value.ToString("yyyy-MM-dd HH:mm"));
    }

    bool isDeleteFlowAmountPremission = Html.CheckFunctionPermissionExist("UserInfoFlowAmount", "DeleteFlowAmountLimit", "POST");
}

