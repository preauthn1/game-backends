                methods: {
                    createTable: function (userID, tag, timeInterval = null)
                    {
                        const url = vApp.urls[tag]

                        let beginTime = $(`#beginTime_${tag}`).val()
                        let endTime = $(`#endTime_${tag}`).val()

                        if (timeInterval != null)
                        {
                            if (Date.parse(timeInterval.beginTimeStr)) {
                                beginTime = timeInterval.beginTimeStr;
                            }
                            if (Date.parse(timeInterval.endTimeStr)) {
                                endTime = timeInterval.endTimeStr;
                            }
                        }

                        const opt = {
                            "ordering": false,
                            "searching": false,
                            "aoColumns": vApp.theadList[tag],
                            "processing": true,
                            "serverSide": true,
                            "ajax": {
                                "type": "POST",
                                "url": url,
                                "data": {
                                    '_r': Math.random(),
                                    'gameID': this.selectedGameID,
                                    'userID': userID,
                                    'beginTime': beginTime,
                                    'endTime': endTime,
                                    'status': this.selectedStatus
                                }
                            },
                            "destroy": true
                        }

                        if (tag == "changeLog") {
                            opt.ajax.data.type = 'Payment';
                        }

                        $(`#${tag}_table`).dataTable(opt)
                    },

                    exportReport: function (userID, tag) {
                        const url = vApp.urls[tag]
                        const reportUrl = vApp.reportUrl[tag];
                        const beginTime = $(`#beginTime_${tag}`).val()
                        const endTime = $(`#endTime_${tag}`).val()

                        $.ajax({
                            cache: false,
                            url: url,
                            type: "POST",
                            data: {
                                userID: userID,
                                beginTime: beginTime,
                                endTime: endTime,
                                submitType: 'Export'
                            },
                            success: function (data) {
                                window.location = reportUrl + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                            }
                        })
                    },

                    newOpenUrl: function (userID, tag) {

                        const reportUrl = vApp.reportUrl[tag];
                        const beginTime = $(`#beginTime_${tag}`).val()
                        const endTime = $(`#endTime_${tag}`).val()

                        var exportUrl = reportUrl + String.format('?userID={0}&beginTime={1}&endTime={2}' , userID , beginTime , endTime);
                        window.location = exportUrl;
                    },

                    selectGameID (gameID) {
                        this.$set(this, 'selectedGameID', gameID)
                    }
