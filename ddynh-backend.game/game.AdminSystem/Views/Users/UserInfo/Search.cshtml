                    <button v-if="isShow('convert')" v-on:click="showModal('convert')" class ="btn btn-outline-secondary">兑换记录</button>
                    <button v-if="isShow('game')" v-on:click="showModal('game')" class ="btn btn-outline-secondary">游戏记录(税收记录)</button>
                    <button v-if="isShow('perGame')" v-on:click="showModal('perGame')" class ="btn btn-outline-secondary">每局游戏记录</button>
                    <button v-if="isShow('changeLog')" v-on:click="showModal('changeLog')" class ="btn btn-outline-secondary">用户重置记录</button>
                    <button v-if="isShow('flowLimit')" v-on:click="showModal('flowLimit')" class ="btn btn-outline-secondary">稽核流水</button>
