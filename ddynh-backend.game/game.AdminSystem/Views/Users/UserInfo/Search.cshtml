                components: {
                    'records-bar': Recordsbar
                }
            });

            var validateFunc = function () {
                var validator = new Validator()
                validator.add([form_search.loginName, form_search.nickName, form_search.userID], [{
                    strategy: 'isSomeNonEmpty',
                    errorMsg: '账户信息不能全为空,请输入账号或者ID！'
                }])

                var errorMsg = validator.start()
                return errorMsg
            }

            var form = document.getElementById('form_search')
            form.onsubmit = function () {
                var errorMsg = validateFunc()
                if (errorMsg) {
                    alert(errorMsg)
                    return false
                }
            }
            var userID = `@ViewBag.userID`;
            if (userID) {
                $("#userID").val(userID)
            }
            fillFormData('form_search');

            //開啟相對應的Dialog
            var _tagModal = '@ViewBag.OpenTag' + "Modal";

            if ('@ViewBag.OpenTag') {
                $("#user@example.invalid").val('@ViewBag.BeginTime');
                $('a[data-target = "#' + _tagModal + '"]').click();
            }
        });
