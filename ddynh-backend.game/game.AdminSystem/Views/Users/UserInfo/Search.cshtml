                methods: {

                    loadTags: function () {

                        var urlTag = '/UserTag/GetUserTags?userID=' + '@userID';
                        var $temp = this;

                        //初始化資料
                        $.get(urlTag, null, function (res) {                                                                
                            $temp.tags = res;
                        });

                    },
                    
                    loadMemos: function () {

                        var urlMemo = '/UserTag/GetUserMemos?userID=' + '@userID'; 
                        
                        var $temp = this;

                        $.get(urlMemo, null, function (res) {                                                                
