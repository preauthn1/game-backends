                                        {
                                            <tr>
                                                <td>@g.Game.GameName</td>
                                                <td>@g.WinCount</td>
                                                <td>@g.LoseCount</td>
                                                <td>@g.DrawCount</td>
                                                <td>@g.Score.ToCash()</td>
                                                <td>@g.PayAmount.ToCash()/@g.BetAmount.ToCash()</td>
                                                <td>@(g.BetAmount == 0 ? "0.00%" : ((Math.Abs(g.PayAmount) * 1.0) / g.BetAmount * 1.0).ToString("#0.00%"))</td>
