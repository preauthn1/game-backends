                                            <td>@Model.StatGameInfo.Sum(m => m.LoseCount)</td>
                                            <td>@Model.StatGameInfo.Sum(m => m.DrawCount)</td>
                                            <td>@Model.StatGameInfo.Sum(m => m.Score).ToCash()</td>
                                            <td>@SiteHelper.GetTimeStr(Model.StatGameInfo.Sum(m => m.GameTime))</td>
                                            <td>　</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- END FORM-->
                </div>
            </div>
        </div>
    </div>
}
