                    deleteMemo: function (id) {

                        var temp = this;

                        var data =
                        {
                             id: id
                        };

                        if (confirm('是否确定删除所选项目？'))
                        {           
                            AjaxPostJson('/UserTag/DeleteUserMemo', data, function (response)
                            {
                                if (response.IsSuccess)
                                {
                                    alertSuccess(response.Message);
                                    temp.loadMemos();
                                }
                                else {
                                    alertError(response.Message);
                                }
                            });
