        function loadDetailLog(gametime, logid) {
            $("#text-Id").html('');
            $("#text-LogID").html('');
            $("#text-DealNo").html('');
            $("#text-ServerID").html('');
            $("#text-ServerName").html('');
            $("#text-GameName").html('');
            $("#text-TaxAmount").html('');
            $("#text-GameData").html('');
            $("#text-Param1").html('');
            $("#text-Param2").html('');
            $("#text-GameTime").html('');

            //加载详情
            $.get("/Game/GetPerGameLogByLogID", { logID: logid, gametime: gametime, r: Math.random() }, function (data) {
                var result = JSON.parse(data);
                $("#text-Id").html(result.Id);
                $("#text-LogID").html(result.Id);
                $("#text-DealNo").html(result.DealNo);
                $("#text-ServerID").html(result.ServerID);
                $("#text-ServerName").html(result.ServerName);
                $("#text-GameName").html(result.GameName);
                $("#text-TaxAmount").html(result.TaxAmount);
                $("#text-GameData").html(result.GameData.replace('\r\n', '').replace(/\r\n/g, '<br />'));
                $("#text-Param1").html(result.Param1);
                $("#text-Param2").html(result.Param2);
                $("#text-GameTime").html('【' + result.BeginTime + '】~【' + result.EndTime + '】');
            });

            $("#tbody-data").html('');

            //加载列表
            $.get("/Game/GetDetailLogByLogID", { logID: logid, gametime: gametime }, function (data) {
                var result = JSON.parse(data);
                var html = "";
                for (var i = 0; i < result.length; i++) {
                    html += "<tr>"
                        + " <td class='hide'>" + result[i].Id + "</td>"
                        + "<td>" + result[i].LogID + "</td>"
                        + "<td>" + result[i].UserType + "</td>"
                        //+ "<td>" + result[i].ServerID + "</td>"
                        + "<td>" + result[i].ServerName + "</td>"
                        + "<td>" + result[i].LastLogonIPAddress + "</td>"
                        //+ "<td>" + result[i].GameName + "</td>"
                        //+ "<td>" + result[i].DealNo + "</td>"
                        + "<td><a class='link' target='_blank' href='/UserInfo/Search?userId=" + result[i].UserID + "'>" + result[i].UserID + "</a></td>"
                        + "<td>" + result[i].LoginName + "</td>"
                        + "<td>" + result[i].RealName + "</td>"
                        + "<td>" + result[i].UnionpayRealName + "</td>"
                        + "<td>" + result[i].GradeID + "</td>"
                        + "<td>" + result[i].CurrentAmount + "</td>"
                        + "<td>" + result[i].UpdateAmount + "</td>"
                        + "<td>" + result[i].GameTime + "</td>"
                    html += "</tr>";
                }
                $("#tbody-data").html(html);
            });
        }

        function createMoneyDetailTable(userID, tradeID, tag) {
            const opt = {
                "ordering": false,
                "searching": false,
                "aoColumns": [
                               { "sTitle": "时间", "mData": "GameTime" },
                               { "sTitle": "牌局标识", "mData": "LogID" },
                               { "sTitle": "服务器编号", "mData": "ServerID" },
                               { "sTitle": "服务器名称", "mData": "ServerName" },
                               { "sTitle": "游戏名称	", "mData": "GameName" },
                               { "sTitle": "当前金币", "mData": "CurrentAmount" },
                               { "sTitle": "更新金币", "mData": "UpdateAmount" },
                               {
                                   "data": null,
                                   "mRender": function (data, type, full) {
                                       return `<div class="control">
                                                <div class ="pointer details-control" data-toggle="modal" data-target="#detailsModal" data-logid="${full.LogID}"
                                                    onclick="loadDetailLog('${full.GameTime}','${full.LogID}')">
                                                   <div class ="btn-list"></div>
                                                   <span>详情<span>
                                                 </div>
                                               <div>`
                                   }
                               }],
                "processing": true,
                "serverSide": true,
                "lengthChange": false,
                "paginate": false,
                "scrollY": "500px",
                "scrollCollapse": true,
                "ajax": {
                    "type": "POST",
                    "url": '/UserInfo/GetMoneyDetailLog',
                    "data": {
                        '_r': Math.random(),
                        'userID': userID,
                        'tradeID': tradeID
                    }
                },
                "destroy": true
            }
            $(`#${tag}_table`).dataTable(opt)
        }

