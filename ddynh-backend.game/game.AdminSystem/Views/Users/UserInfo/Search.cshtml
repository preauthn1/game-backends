                                            <td>汇总：</td>
                                            <td>@Model.GameInfo.Sum(m => m.WinCount)</td>
                                            <td>@Model.GameInfo.Sum(m => m.LoseCount)</td>
                                            <td>@Model.GameInfo.Sum(m => m.DrawCount)</td>
                                            <td>@Model.GameInfo.Sum(m => m.Score).ToCash()</td>
                                            <td>@Model.GameInfo.Sum(m => m.PayAmount)/@Model.GameInfo.Sum(m => m.BetAmount)</td>
                                            <td>
                                                @{
                                                    long longBetAmount = Model.GameInfo.Sum(m => m.BetAmount);
                                                    long longPayAmount = Model.GameInfo.Sum(m => m.PayAmount);
                                                    string validBet = longBetAmount == 0 ? "0.00%"
                                                        : ((Math.Abs(longPayAmount) * 1.0) / longBetAmount * 1.0).ToString("#0.00%"); }
                                                @validBet
                                            </td>
                                            <td>@(!String.IsNullOrEmpty(ViewBag.BankLog_15001) ? ViewBag.BankLog_15001 : "0")</td>
                                            <td>@SiteHelper.GetTimeStr(Model.GameInfo.Sum(m => m.GameTime))</td>
