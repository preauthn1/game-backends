                    exportReport: function (userID, tag) {
                        const url = vApp.urls[tag]
                        const reportUrl = vApp.reportUrl[tag];
                        const beginTime = $(`#beginTime_${tag}`).val()
                        const endTime = $(`#endTime_${tag}`).val()

                        $.ajax({
                            cache: false,
                            url: url,
                            type: "POST",
                            data: {
                                userID: userID,
                                beginTime: beginTime,
                                endTime: endTime,
                                submitType: 'Export'
                            },
                            success: function (data) {
                                window.location = reportUrl + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                            }
                        })
                    },

                    newOpenUrl: function (userID, tag) {

                        const reportUrl = vApp.reportUrl[tag];
                        const beginTime = $(`#beginTime_${tag}`).val()
                        const endTime = $(`#endTime_${tag}`).val()

                        var exportUrl = reportUrl + String.format('?userID={0}&beginTime={1}&endTime={2}' , userID , beginTime , endTime);
                        window.location = exportUrl;
                    },

