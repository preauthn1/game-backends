                            { "sTitle": "状态", "mData": "Status" },
                            { "sTitle": "时间", "mData": "CreateTime" },
                            { "sTitle": "操作时间", "mData": "UpdateTime" },
                            { "sTitle": "操作人", "mData": "UpdateBy" },
                            {
                                "sTitle": "备注", "mData": "Memo", "mRender": function (data, type, row) {

                                    var fullText = String.format('删除原因：{0}', row.Memo);
                                    var html = "";
                                    html = html + String.format('<div class="shortText" onclick="alert(\'{1}\')">{0}</div>', row.Memo, fullText);
                                    return html;
                                }
                            },
                            {
                                "sTitle": "操作",
                                "mData": "Status",
                                "mRender": function (data, type, row) {

                                    var html = "";
                                    if (isDeleteFlowAmountPremission && !row.IsDeleteDisabled)
                                    {
                                        html = html + String.format('<a id="" class="btn btn-sm dark" onclick="ConfirmDeleteOrNot({0})" >删除</a>', row.ID);
