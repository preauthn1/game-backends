@model List<game.Entity.Stat.GameTaxLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

@{ 
    var GroupByGameInfo = (List<game.AdminSystem.GameTaxLogGroupInfoViewModel>)ViewBag.GroupByGameInfo;
}

<style>
    .table > thead > tr > th {
        vertical-align: middle;
        text-align: center;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">

                    <input type="hidden" value="false" id="isExport" name="isExport" />

                    @Html.Partial("_PlatformSelect", false)
                    @Html.Partial("AdminAreaListMust", true)
                    <label>游戏</label>
                    @Html.DropDownList("gameID", DataService.Game(string.Empty, true), new { @class = "form-control input-small", id = "gameID" })
                </div>

                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off">
                </div>

                <div class="form-group">

                    <button type="submit" class="btn btn-default" onclick="global_changeExportType('false')"> 搜 索 </button>

                    <button type="submit" class="btn btn-default" onclick="global_changeExportType('true')"> 匯 出 </button>
                </div>

            </form>


            <div style="text-align:right;">
                <button class="btn" onclick="global_showMyModal()">各游戏总计</button>
            </div>


            <div class="table-scrollable">

                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th rowspan="2">统计时间</th>
                            <th rowspan="2">游戏编号</th>
                            <th rowspan="2">游戏名称</th>
                            <th colspan="5">用户金币</th>
                            <th colspan="4">机器人金币</th>
                            <th rowspan="2">奖池金额</th>
                            <th rowspan="2">操作</th>
                        </tr>
                        <tr>
                            <th>变化</th>
                            <th>输赢</th>
                            <th>税收</th>
                            <th>流水</th>
                            <th>
                                RTP<i class="fa fa-question-circle tooltips active" data-container="body" data-placement="right" data-html="true" data-original-title="返还金额/有效投注金额"></i>
                            </th>
                            <th>变化</th>
                            <th>输赢</th>
                            <th>税收</th>
                            <th>
                                RTP<i class="fa fa-question-circle tooltips active" data-container="body" data-placement="right" data-html="true" data-original-title="返还金额/有效投注金额"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd")</td>
                                    <td>@item.GameID</td>
                                    <td>@item.Game.GameName</td>
                                    <td class="algin-r">@item.Amount.ToCash()</td>
                                    <td class="algin-r">@((item.Amount + item.TaxAmount).ToCash())</td>
                                    <td class="algin-r">@item.TaxAmount.ToCash()</td>
                                    <td class="algin-r">@item.FlowAmount.ToCash()</td>
                                    <td class="algin-r">
                                        @{
                                            string validBet = item.BetAmount == 0 ? "0.00"
                                                : ((Math.Abs(@item.PayAmount) * 1.0) / item.BetAmount * 100).ToString("#0.00"); }
                                        @validBet%
                                    </td>
                                    <td class="algin-r">@item.RobotAmount.ToCash()</td>
                                    <td class="algin-r">@((item.RobotAmount + item.RobotTaxAmount).ToCash())</td>
                                    <td class="algin-r">@item.RobotTaxAmount.ToCash()</td>
                                    <td class="algin-r">
                                        @{
                                            string robotValidBet = item.RobotBetAmount == 0 ? "0.00"
                                                : ((Math.Abs(@item.RobotPayAmount) * 1.0) / item.RobotBetAmount * 100).ToString("#0.00"); }
                                        @robotValidBet%
                                    </td>
                                    <td class="algin-r">@item.PoolAmount.ToCash()</td>
                                    <td>
                                        @Html.LinkWithRight(action: "GameServerTaxLog", value: "详情", href: "GameServerTaxLog?gameID=" + item.GameID + "&beginTime=" + item.StatTime.ToString("yyyy-MM-dd") + "&endTime=" + item.StatTime.AddDays(1).ToString("yyyy-MM-dd"))
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model != null && Model.Count() > 0)
                    {
                        <tfoot>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="algin-r">@(Model.Sum(p => p.Amount).ToCash())</td>
                                <td class="algin-r">@(Model.Sum(p => p.Amount + p.TaxAmount).ToCash())</td>
                                <td class="algin-r">@(Model.Sum(p => p.TaxAmount).ToCash())</td>
                                <td class="algin-r">@(Model.Sum(p => p.FlowAmount).ToCash())</td>
                                <td class="algin-r">
                                    @{
                                        string validBet = Model.Sum(p => p.BetAmount) == 0 ? "0.00"
                                            : ((Math.Abs(Model.Sum(p => p.PayAmount)) * 1.0) / Model.Sum(p => p.BetAmount) * 100).ToString("#0.00"); }
                                    @validBet%
                                </td>
                                <td class="algin-r">@(Model.Sum(p => p.RobotAmount).ToCash())</td>
                                <td class="algin-r">@(Model.Sum(p => p.RobotAmount + p.RobotTaxAmount).ToCash())</td>
                                <td class="algin-r">@(Model.Sum(p => p.RobotTaxAmount).ToCash())</td>
                                <td class="algin-r">
                                    @{
                                        string robotValidBet = Model.Sum(p => p.RobotBetAmount) == 0 ? "0.00"
                                            : ((Math.Abs(Model.Sum(p => p.RobotPayAmount)) * 1.0) / Model.Sum(p => p.RobotBetAmount) * 100).ToString("#0.00"); }
                                    @robotValidBet%
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>




<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="modal_empty_template" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:1000px">

        <div class="modal-content" style="padding:15px;">


            <h4>
                <b>
                    各游戏总计
                </b>
            </h4>

            @{
                DateTime begin = ViewBag.BeginTime;
                DateTime end = ViewBag.EndTime;
            }

            <div style="text-align:center;font-size:14px;color:#4c75bf;padding:15px;">
                @begin.ToString("yyyy-MM-dd") - @end.ToString("yyyy-MM-dd")
            </div>

            <table class="table table-striped table-bordered table-hover progressTable">
                <thead>
                    <tr>
                        <th rowspan="2">游戏名称</th>
                        <th colspan="5">用户金币</th>
                        <th colspan="4">机器人金币</th>
                        <th rowspan="2">奖池金额</th>
                    </tr>
                    <tr>
                        <th>变化</th>
                        <th>输赢</th>
                        <th>税收</th>
                        <th>流水</th>
                        <th>
                            RTP<i class="fa fa-question-circle tooltips active" data-container="body" data-placement="right" data-html="true" data-original-title="返还金额/有效投注金额"></i>
                        </th>
                        <th>变化</th>
                        <th>输赢</th>
                        <th>税收</th>
                        <th>
                            RTP<i class="fa fa-question-circle tooltips active" data-container="body" data-placement="right" data-html="true" data-original-title="返还金额/有效投注金额"></i>
                        </th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in GroupByGameInfo)
                    {
                        <tr>
                            <td>@item.GameDisplayName</td>
                            <td class="algin-r">@item.Player_Balance_Amount.ToCash()</td>
                            <td class="algin-r">@item.Player_Balance_WinLoss.ToCash()</td>
                            <td class="algin-r">@item.Player_Balance_Tax.ToCash()</td>
                            <td class="algin-r">@item.Player_Balance_Flow.ToCash()</td>
                            <td class="algin-r">
                                @{
                                    string SummaryValidBet = item.Player_Balance_BetAmount == 0 ? "0.00"
                                        : ((Math.Abs(@item.Player_Balance_PayAmount) * 1.0) / item.Player_Balance_BetAmount * 100).ToString("#0.00"); }
                                @SummaryValidBet%
                            </td>
                            <td class="algin-r">@item.Robot_Balance_Amount.ToCash()</td>
                            <td class="algin-r">@item.Robot_Balance_Tax.ToCash()</td>
                            <td class="algin-r">@item.Robot_Balance_WinLoss.ToCash()</td>
                            <td class="algin-r">
                                @{
                                    string robotSummaryValidBet = item.Robot_Balance_BetAmount == 0 ? "0.00"
                                        : ((Math.Abs(@item.Robot_Balance_PayAmount) * 1.0) / item.Robot_Balance_BetAmount * 100).ToString("#0.00"); }
                                @robotSummaryValidBet%
                            </td>
                            <td class="algin-r">@item.PoolAmount.ToCash()</td>
                        </tr>
                    }

                </tbody>

            </table>


            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
            </div>

        </div>


    </div>
</div>




@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
            ShowProgress($(".progressTable"), "amountProgress", 300);
            ShowProgress($(".progressTable"), "amountProgress1", 300);
            ShowProgress($(".progressTable"), "amountProgress2", 300);
        })
    </script>
}