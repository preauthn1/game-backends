@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc

@model  FW.Core.Helper.PagedList<game.Entity.Users.UserInfo2>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_userPartial")

                <div class="form-group">
                    <label>用户等级</label>
                    <select class="form-control input-small" id="gradeID" name="gradeID">
                        <option>--不限--</option>
                        <option value="0">0</option>
                        @foreach (var item in ViewBag.GradeSettingList as List<game.Entity.Stat.GradeSetting>)
                        {
                            <option value="@item.Id">@item.Id</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>平台</label>
                    @Html.Partial("_DropdownPlatform", new DropdownPartialSettingViewModel(FirstOptionValueEnum.DefaultSelectAll))
                </div>

                @Html.Partial("_AreaSelectRelatePlatform")


                <div class="form-group">
                    <label>注册时间</label>
                    <input type="text" class="form-control " style="width:125px" id="regBeginTime" name="regBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:125px" id="regEndTime" name="regEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间">
                </div>
                <div class="form-group">
                    <label>最后登录时间</label>
                    <input type="text" class="form-control " style="width:125px" id="lastlogonBeginTime" name="lastlogonBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:125px" id="lastlogonEndTime" name="lastlogonEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间">
                </div>


                <div style="margin-top:5px;">

                    <div class="form-group">
                        <label>真实姓名</label>
                        <input type="text" class="form-control input-small" id="realName" name="realName" placeholder="真实姓名">
                    </div>

                    <div class="form-group">
                        <label>注册IP地址</label>
                        <input type="text" class="form-control input-small" id="regIpAddress" name="regIpAddress" placeholder="注册IP地址">
                    </div>

                    <div class="form-group">
                        <label>最后登录IP地址</label>
                        <input type="text" class="form-control input-small" id="lastlogonIPAddress" name="lastlogonIPAddress" placeholder="最后登录IP地址">
                    </div>
                    <div class="form-group">
                        <label>硬件类型</label>
                        <select class="form-control input-small" id="hdType" name="hdType">
                            <option>--不限--</option>
                            @foreach (var item in Enum.GetValues(typeof(game.Entity.Users.HDType)))
                            {
                                <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>硬件唯一码</label>
                        <input type="text" class="form-control input-small" id="hdCode" name="hdCode" placeholder="设备唯一码">
                    </div>

                </div>

                <div style="margin-top:5px;">

                    <div class="form-group">
                        <label>充值数量</label>
                        <input type="text" class="form-control " id="chargeAmountBegin" name="chargeAmountBegin" placeholder="开始范围">
                        到
                        <input type="text" class="form-control " id="chargeAmountEnd" name="chargeAmountEnd" placeholder="结束范围">
                    </div>

                    <div class="form-group">
                        <label>兑换数量</label>
                        <input type="text" class="form-control " id="convertAmountBegin" name="convertAmountBegin" placeholder="开始范围">
                        到
                        <input type="text" class="form-control " id="convertAmountEnd" name="convertAmountEnd" placeholder="结束范围">
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-default"> 搜 索 </button>
                    </div>

                </div>


            </form>


            <form id="formSubmit" method="get" onsubmit="SubmitIDs()">
                <div class="table-toolbar" style="margin:10px 0 5px 0;">
                    <div class="btn-group">
                        @Html.ButtonWithRight(id: "btnPassed", type: "submit", value: "批量封号", action: "BlockUser", cssName: "dark")
                    </div>
                </div>



                <div class="table-scrollable">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" class="group-checkable" data-set=".checkboxes">
                                </th>
                                <th>所属平台</th>
                                <th>所属渠道</th>
                                <th>用戶ID</th>
                                <th>封号</th>
                                <th>用戶帐号</th>

                                <th>金币数</th>
                                <th>累计充值</th>
                                <th>累计兑换</th>

                                <th>支付宝账号</th>
                                <th>支付宝姓名</th>
                                <th>銀聯账号</th>
                                <th>銀聯姓名</th>

                                <th>注册时间</th>
                                <th>注册IP地址</th>
                                <th>最后登录时间</th>
                                <th>最后登录IP地址</th>
                                <th>硬件类型</th>
                                <th>硬件唯一码</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model.PageData)
                                {
                            <tr>
                                <td><input type="checkbox" class="checkboxes" value="@item.UserID" name="Id"></td>
                                <td>@item.Area.Platform.Name</td>
                                <td>@item.Area.AreaName</td>
                                <td>
                                    <a target="_blank" href="/UserInfo/Search?userId=@item.UserID&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">
                                        @item.UserID
                                    </a>
                                </td>
                                <td>@(item.block == 0 ? "否" : "已封号")</td>
                                <td>@item.LoginName</td>

                                <td>@item.CashAmount.ToCash()</td>
                                <td>@item.SumCharge.ToCash()</td>
                                <td>@item.SumConvert.ToCash()</td>

                                <td>@item.AlipayAccount</td>
                                <td>@item.RealName</td>
                                <td>@item.UnionpayAccount</td>
                                <td>@item.UnionpayRealName</td>


                                <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.CreateIPAddress</td>
                                <td>@item.LastLogonTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.LastLogonIPAddress</td>
                                <td>@item.HDType.GetDisplayName()</td>
                                <td>@item.HDCode</td>
                            </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </form>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
            $('.group-checkable').change(function () {
                var set = $(this).attr('data-set');
                var checked = $(this).is(':checked');
                $(set).each(function () {
                    if (checked) {
                        $(this).attr('checked', true);
                    } else {
                        $(this).attr('checked', false);
                    }
                });
                $.uniform.update(set);
            })
        })

        function SubmitIDs() {
            if ($('.checkboxes:checked').size() < 1) {
                return false;
            }
            var value = prompt('确定要把选中帳號封號么：', '帐号异常');
            if (value === null) {
                return false;
            }

            var Ids = [];
            $('#formSubmit input:checkbox:checked[name="Id"]').each(function (i) {
                Ids.push(parseInt(this.value));
            });

            $.ajax({
                type: "GET",
                data: { Id: Ids, msg: value },
                traditional: true,
                url: "/UserStat/BlockUser",
                success: function (data) {
                    alert(data.msg);
                    window.location.reload();
                },
                error: function (err) {
                    alert("操作失敗");
                }
            })
        }
    </script>
}