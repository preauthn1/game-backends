@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Stat.ChargeKeepLog>


@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="formGet" name="formGet" method="get">
                @Html.Partial("_PlatformSelect", false)
                <select class="form-control input-small" id="hdType" name="hdType">
                    <option value="0">--不限--</option>
                    @foreach (var item in Enum.GetValues(typeof(game.Entity.Users.HDType)))
                    {
                        if (item.ToString() != "PC")
                        {
                            <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                        }
                    }
                </select>

                <div class="table-scrollable">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>所属平台</th>
                                <th>统计时间</th>
                                <th>装置</th>
                                <th>注册且充值人数</th>
                                <th>1日后留存率</th>
                                <th>2日后留存率</th>
                                <th>7日后留存率</th>
                                <th>30日后留存率</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Platform</td>
                                        <td>@item.StatTime.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (item.HDType == 2)
                                            {
                                                <span>Android</span>
                                            }
                                            else
                                            {
                                                <span>iOS</span>
                                            }

                                        </td>
                                        <td>@item.RegChargeUsers</td>
                                        <td>
                                            <span>@Math.Round(item.Day1Keep, 3) %</span>
                                        </td>
                                        <td>
                                            <span>@Math.Round(item.Day2Keep, 3) %</span>
                                        </td>
                                        <td>
                                            <span>@Math.Round(item.Day7Keep, 3) %</span>
                                        </td>
                                        <td>
                                            <span>@Math.Round(item.Day30Keep, 3) %</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </form>
        </div>
    </div>
</div>

@section initScripts{
    <script>
        $(function () {
            fillFormData('formGet');

            $('#hdType').change(function () {
                //console.log($(this).val());
                Submit();
            })

            $('#platformid').change(function () {
                //console.log($(this).val());
                Submit();
            })
        })

        function Submit() {
            $('#formGet').submit();
        }
    </script>
}