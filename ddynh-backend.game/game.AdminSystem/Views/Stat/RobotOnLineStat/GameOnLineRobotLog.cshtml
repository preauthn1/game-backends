@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Stat.GameOnLineRobotLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>游戏</label>
                    @Html.DropDownList("gameID", DataService.Game(), new { @class = "form-control input-small", id = "gameID" })
                </div>
                <div class="form-group">
                    <label>时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.AddMinutes(-30).ToString("yyyy-MM-dd HH:mm")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>统计时间</th>
                            <th>游戏</th>
                            <th>总在线人数</th>
                            <th>操作</th>                                          
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.Game.GameName</td>
                                    <td>@item.TotalCount</td>
                                    <td>
                                        @Html.LinkWithRight(action: "ServerOnLineRobotLog", value: "详情", href: "ServerOnLineRobotLog?gameID=" + item.GameID + "&beginTime=" + item.StatTime.AddMinutes(-7.5).ToString("yyyy-MM-dd HH:mm") + "&endTime=" + item.StatTime.AddMinutes(7.5).ToString("yyyy-MM-dd HH:mm"))
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}