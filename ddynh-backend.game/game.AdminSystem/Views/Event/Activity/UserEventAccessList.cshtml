@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}


<style>

    td a
    {
        text-decoration:underline !important;
    }

    .table-scrollable 
    {
        border:none !important;
    }

</style>

<div id="vApp">
    <div class="row">
        <div class="col-md-12">
            <div class="protlet-body">
                <div class="menu">
                    <div class="form-inline instructions" id="form_search">
                        <div class="form-group">
                            <label>使用者ID</label>
                            <input type="text" class="form-control " style="width:180px" id="userID_SearchA" value="" name="userID" autocomplete="off">
                        </div>

                        <div class="form-group">
                            <label>正式帐号</label>
                            <input type="text" class="form-control " style="width:180px" id="loginName_SearchA" value="" name="loginName" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label>时间范围</label>
                            <input type="text" class="form-control " style="width:180px" id="beginTime_SearchA" name="beginTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', readOnly: true })" placeholder="开始时间" value="">
                            到
                            <input type="text" class="form-control " style="width:180px" id="endTime_SearchA" value="" name="endTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" readOnly: true autocomplete="off">
                        </div>
                        <div class="form-group">
                            <input type="button" class="btn btn-default" v-on:click="getUserEventAccessList()" value="搜 索" />
                        </div>
                    </div>
                </div>
                <div class="table-scrollable">
                    <table id="eventAccessList_table" class="table table-striped table-bordered table-hover progressTable">
                        <thead>
                            <tr>
                                <th style="width:5%;">活动类型</th>
                                <th style="width:30%;">活动名称</th>
                                <th>用户ID</th>
                                <th>绑定帐号</th>
                                <th style="width:5%;">领取次数</th>
                                <th>更新时间</th>
                                <th style="width:10%;">动作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="row in tableList">
                                <td style="text-align:center">{{row.EventTypeName}}</td>
                                <td>{{row.EventName}}</td>
                                <td><a target="_blank" :href="'/UserInfo/Search?userId='+row.UserID+'&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))'">{{row.UserID}}</a></td>
                                <td>{{row.LoginName}}</td>
                                <td style="text-align:center">{{row.GrantTimes}}</td>
                                <td>{{row.StrUpdateTime}}</td>
                                <td style="text-align:center">
                                    <input type="button" class="btn btn-sm dark" value="領取明細" data-toggle="modal" data-target="#eventAccessModal" v-on:click="showDetail(row)">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Detail Modal-->
    <div class="modal fade" id="eventAccessModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width: 1200px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">活动领取历程</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="protlet-body">
                                <div class="menu">
                                    <div class="form-inline instructions" id="detail_search">                                       
                                        <div class="form-group">
                                            <label>使用者ID</label>
                                            <input type="text" class="form-control" style="width:180px" id="userID_Search_Detail" value="" name="userID" autocomplete="off">
                                            <input type="text" class="form-control" id="eventID_Search_Detail" value="" >
                                        </div>
                                        <div class="form-group">
                                            <label>时间范围</label>
                                            <input type="text" class="form-control " style="width:180px" id="beginTime_Search_Detail" name="beginTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间" value="">
                                            到
                                            <input type="text" class="form-control " style="width:180px" id="endTime_Search_Detail" value="" name="endTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" readOnly: true autocomplete="off">
                                        </div>
                                        <div class="form-group">
                                            <input type="button" class="btn btn-default" v-on:click="getLogDetail()" value="搜 索" />
                                        </div>
                                    </div>
                                </div>
                                <div class="table-scrollable">
                                    <table id="eventAccessDetail_table" class="table table-striped table-bordered table-hover progressTable"></table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End Detail Modal-->
</div>

@section initScripts{
    <script>
        $(function () {

            var vApp = new Vue({
                el: '#vApp',
                data: {
                    tableList: {}
                },
                methods: {
                    getUserEventAccessList: function () {
                        $.get('/Activity/GetUserEventAccessList',
                            { '_r': Math.random(), beginTime: $("#beginTime_SearchA").val(), endTime: $("#endTime_SearchA").val(), userID: $("#userID_SearchA").val(), loginName: $("#loginName_SearchA").val() }, function (data) {
                                if (data instanceof Array) {
                                    vApp.tableList = data;
                                }
                                else {
                                    vApp.tableList = {};
                                }
                            });
                    },
                    resetGrantTime: function (row) {
                        var option = {
                            isAjax: true,
                            method: 'post',
                            data: {
                                eventID: row.EventID,
                                userID: row.UserID
                            },
                            isReload: false,
                            callback: function () {
                                vApp.getUserEventAccessList();
                            }
                        }

                        swDelConfirmUrl('ResetGrantTime', '确定要重置领取次数么？', option);
                    },
                    showDetail: function (row) {
                        $("#userID_Search_Detail").val(row.UserID);
                        $("#eventID_Search_Detail").val(row.EventSettingID);

                        vApp.getLogDetail();
                    },
                    getLogDetail: function () {
                        var userID = $("#userID_Search_Detail").val();
                        var eventID = $("#eventID_Search_Detail").val();
                        var beginTime = $("#beginTime_Search").val();
                        var endTime = $("#endTime_Search_Detail").val();

                        const url = '/Activity/GetUserEventAccessDetail';
                        const thead = [
                                       { "sTitle": '活动类型', "mData": "EventTypeName" },
                                       { "sTitle": '活动名称', "mData": "EventName" },
                                       {
                                           "sTitle": '用户ID', "mData": "UserID",
                                           "render": function (data, type, row) {
                                               return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                                           }
                                       },
                                       { "sTitle": '绑定帐号', "mData": "LoginName" },
                                       {
                                           "sTitle": '活动期间', "mData": "StrStartTime",
                                           "render": function (data, type, row) {
                                               return data + " ~ " + row.StrEndTime;
                                           }
                                       },
                                       { "sTitle": '纪录时间', "mData": "StrCreateTime" },
                                       {
                                           "sTitle": "领取金额", "mData": "GiftCash",
                                           "render": function (data, type, row) {
                                               return ToCash(data);
                                           }
                                       },
                                       {
                                           "sTitle": "领取奖项", "mData": "GiftMemo",
                                           "render": function (data, type, row) {
                                               return data;
                                           }
                                       },
                                       { "sTitle": "IP位置", "mData": "IPAddress" }];

                        const data = {
                            userID: userID,
                            eventID: eventID,
                            beginTime: beginTime,
                            endTime: endTime
                        }
                        createDataTable('eventAccessDetail', thead, url, data);
                    }
                }
            });

            vApp.getUserEventAccessList();
        });
    </script>
}

