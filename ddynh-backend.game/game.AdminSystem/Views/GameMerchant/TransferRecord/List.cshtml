@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using game.Entity.Pay
@using game.AdminSystem.Models.ViewModels
@using game.Entity.Money
@using game.AdminSystem

@{ 
   
}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}


<style>

    .TransferStatus_0
    {
        color:#ff6a00;
    }

    .TransferStatus_9 , TransferStatus_99
    {
        color:#ff0000;
    }

</style>

<div class="row tableListPage">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">

                <div class="form-group">
                    <label>用户ID：</label>
                    <input type="text" id="UserID" name="UserID" class="form-control input-small" />
                </div>


                <div class="form-group">
                    <label>转账单号：</label>
                    <input type="text" id="OrderNo" name="OrderNo" class="form-control input-small" />
                </div>

                <div class="form-group">
                    <label>平台</label>
                    @Html.Partial("_DropdownPlatform", new DropdownPartialSettingViewModel(FirstOptionValueEnum.DefaultSelectAll))
                </div>

                <div class="form-group">
                    <label>游戏商：</label>
                    @Html.Partial("_DropdownGameMerchant", new DropdownPartialSettingViewModel(FirstOptionValueEnum.DefaultSelectAll))
                </div>


                <div class="form-group">
                    <label>建立时间：</label>
                    <input type="text" class="form-control " style="width:150px" id="BeginDate" name="BeginDate" value="@Convert.ToDateTime(DateTime.Now.Date).ToString("yyyy-MM-dd HH:mm")" id="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:150px" id="EndDate" name="EndDate" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间">

                </div>


                <div class="form-group">
                    <button type="button" class="btn btn-default" onclick="createTable()"> 搜 索 </button>
                </div>

                <div class="hr-s"></div>

            </form>

            <div class="content">
                <table id="myTable_table" class="display border-r" style="width:100%"></table>
            </div>

        </div>

    </div>

</div>


<a ></a>


@section initScripts{
    <script>
      
        function createTable() {

            const url = '/TransferRecord/GetList'
            const thead =
                [
                    { "sTitle": "转账单号", "mData": "OrderNo", "className": "algin-l" },

                    //{ "sTitle": "三方单号", "mData": "GameMerchantOrderNo", "className": "algin-l" },

                    { "sTitle": "游戏商", "mData": "GameMerchantText", "className": "algin-l" },
                    { "sTitle": "转账类型", "mData": "TransferTypeText", "className": "algin-l" },

                    {
                        "sTitle": "用户ID", "mData": "UserID",
                        "render": function (data, type, row) {
                            var url = String.format("/UserInfo/Search?userId={0}" ,row.UserID );
                            var html = String.format('<a id="" class="link-text" target="_blank" style="" href="{0}">{1}</a>', url , row.UserID); 
                            return html;
                        }
                    },

                    { "sTitle": "平台", "mData": "PlatformName", "className": "algin-l" },
                    { "sTitle": "转账金额", "mData": "AmountText", "className": "algin-r" },
                    {
                        "sTitle": "状态", "mData": "StatusText", "className": "algin-c",
                        "render": function (data, type, row) {
                            var html = String.format("<div class='TransferStatus_{0}'>{1}</div>" , row.Status , row.StatusText);
                            return html;
                        }
                    },
                    { "sTitle": "时间", "mData": "CreateTimeText", "className": "algin-c" },
                    { "sTitle": "IP位置", "mData": "CreateIPAddress", "className": "algin-l" },

                    //{
                    //    "sTitle": "操作", "mData": "Title",
                    //    "render": function (data, type, row) {
                    //        var html = "";
                    //        return html;
                    //    }
                    //}
                ]
                        
            var platformid = $('#platformid').val();
            var gameMerchantID = $('#gameMerchantID').val();
            var OrderNo = $('#OrderNo').val();
            var UserID = $('#UserID').val();

            //将表单上的筛选条件、下拉选单带入api
            const data =
            {
                platformid: platformid,
                GameMerchantID: gameMerchantID,
                OrderNo: OrderNo,
                UserID: UserID,
                BeginDate : $("#BeginDate").val(),
                EndDate : $("#EndDate").val(),
            }


            createDataTable('myTable', thead, url, data);
        }


        $(function () {            

            fillFormData('form_search');
            createTable();
        
        })






    </script>
}