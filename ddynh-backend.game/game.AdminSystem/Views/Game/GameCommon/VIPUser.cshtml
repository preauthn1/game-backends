@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }

    .color-red {
        color: red;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }

    .VIPUserAdd {
        display: flex;
        margin-top: 20px;
        
    }
</style>

<div class="row" id="VIPUserList">
    <div class="col-md-12">
        <div class="VIPUserAdd">
            <input type="text" class="form-control input-small col-md-1" placeholder="请输入玩家ID" value="" v-model="vipUser.NewUserID" />
            <input type="button" class="btn dark" value="监控添加" v-on:click="addVIPUser()" />
        </div>
        <div class="portlet box grey" style="margin-top:20px;">
            <div class="portlet-title">
                <div class="caption">监控名单</div>
            </div>
            <div class="portlet-body">
                <table class="table table-striped table-bordered table-hover progressTable" id="VIPUser_table"></table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#VIPUserList',
            data: {
                gameID: '@ViewBag.GameID',
                vipUser: {},
                datas: [],
                dataTable: null
            },
            methods: {
                getVIPUser: function () {
                    vApp.datas = [];
                    const head = [
                           {
                               "sTitle": "玩家ID", "mData": "UserID",
                               "render": function (data, type, row) {
                                   return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                               }
                           },
                           {
                               "sTitle": "总输赢", "mData": "TotalUserWinLose",
                               "render": function (data, type, row) {
                                   var value = data * -1;
                                   if (value < 0) {
                                       return `<span class="update_Red">${ToCash(value)}</span>`
                                   }
                                   return `<span class="update_Green">${ToCash(value)}</span>`
                               }
                           },
                           {
                               "sTitle": "今日输赢", "mData": "TodayUserWinLose",
                               "render": function (data, type, row) {
                                   var value = data * -1;
                                   if (value < 0) {
                                       return `<span class="update_Red">${ToCash(value)}</span>`
                                   }
                                   return `<span class="update_Green">${ToCash(value)}</span>`
                               }
                           },
                           { "sTitle": "总局数", "mData": "TotalAll" },
                           {
                               "sTitle": "指定放分金额", "mData": "AssignAmount",
                               "render": function (data, type, row) {
                                   return `<input type="text" id="AssignAmount_${row.UserID}" name="AssignAmount_${row.UserID}" class ="form-control input-medium" placeholder="" value="${ToCash(data)}" />`
                               }
                           },
                           {
                               "sTitle": "放分胜率(%)", "mData": "AssignRate",
                               "render": function (data, type, row) {
                                   const val = data > 6 ? 6 : data
                                   return `
                                    <select id="AssignRate_${row.UserID}" name="AssignRate_${row.UserID}" class ="form-control input-small" value="${val}">
                                        <option value="1" ${ val === 1 ? 'selected' : ''}>20%</option>
                                        <option value="2" ${ val === 2 ? 'selected' : ''}>30%</option>
                                        <option value="3" ${ val === 3 ? 'selected' : ''}>40%</option>
                                        <option value="4" ${ val === 4 ? 'selected' : ''}>70%</option>
                                        <option value="5" ${ val === 5 ? 'selected' : ''}>80%</option>
                                        <option value="6" ${ val === 6 ? 'selected' : ''}>90%</option>
                                    </select>`
                               }
                           },
                           {
                               "sTitle": "完成金额", "mData": "CompleteAmount",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           { "sTitle": "是否完成", "mData": "StrComplete" },
                           {
                               "sTitle": "开始/暂停", "mData": "Status",
                               "render": function (data, type, rowData, meta) {
                                   if (data == 0) {
                                       return `<a class="btn_link" href="#" onclick="vApp.editStatus(${meta.row},1)" >开始</a>`
                                   }
                                   return `<a class="btn_link" href="#" onclick="vApp.editStatus(${meta.row},0)" >暂停</a>`
                               }
                           },
                           {
                               "sTitle": "删除监控", "mData": "UserID",
                               "render": function (data, type, row) {
                                   return `<a class="btn_link_Red" href="#" onclick="vApp.delVIPUser(${data})" >删除</a>`
                               }
                           },
                           { "sTitle": "放分时间", "mData": "StrUpdateTime" },
                           { "sTitle": "操作人", "mData": "Operator" },
                           {
                               "sTitle": "操作", "mData": "UserID",
                               "render": function (data, type, row, meta) {
                                   vApp.datas[meta.row] = row;
                                   return `<button class="btn gray" href="#" onclick="vApp.saveVIPUser(${meta.row})">保存</a>`
                               }
                           },
                    ]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetVIPUser",
                            data: function (d) {
                                Object.assign(d, {
                                    'gameID': vApp.gameID,
                                });
                                return d;
                            }
                        },
                        "destroy": true
                    }
                    vApp.dataTable = $("#VIPUser_table").dataTable(opt)
                },
                addVIPUser: function () {

                    if (this.vipUser.NewUserID)
                        $.get('/GameCommon/AddVIPUser', { 'userID': vApp.vipUser.NewUserID }, function (result) {
                            alert(result.msg);
                            vApp.dataTable.DataTable().ajax.reload();
                        });
                },
                delVIPUser: function (userID) {
                    $.get('/GameCommon/DelVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.dataTable.DataTable().ajax.reload();
                    });
                },
                editStatus: function (rowIndex, status) {
                    var data = vApp.datas[rowIndex];
                    data.Status = status;
                    data.AssignAmount = ToCash(data.AssignAmount);
                    vApp.editVIPUser(data);
                },
                saveVIPUser: function (rowIndex) {
                    const data = vApp.datas[rowIndex];
                    const userID = data.UserID
                    const amount = $(`#AssignAmount_${userID}`).val();
                    const rate = $(`#AssignRate_${userID}`).val();

                    data.AssignAmount = amount
                    data.AssignRate = rate
                    vApp.editVIPUser(data);
                },
                editVIPUser: function (data) {
                    $.ajax({
                        type: "POST",
                        data: JSON.stringify(data),
                        contentType: 'application/json',
                        traditional: true,
                        url: "/GameCommon/EditVIPUser",
                        success: function (result) {
                            alert(result.msg);
                            vApp.dataTable.DataTable().ajax.reload();
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                }
            }
        });

        vApp.getVIPUser();
        setInterval(function () {
            vApp.dataTable.DataTable().ajax.reload();
        }, 30000);

    </script>
}