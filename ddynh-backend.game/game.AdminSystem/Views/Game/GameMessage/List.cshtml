@using FW.Core.Web.Mvc
@model List<game.Entity.Game.GameMessage>

@section RightTab
    {

}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)               
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th style="width:350px">公告内容</th>
                            <th>开始时间</th>
                            <th>结束时间</th>
                            <th>频率(单位秒)</th>                                                                                    
                            <th>状态</th>
                            <th>最后发送时间</th>                            
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (game.Entity.Game.GameMessage m in Model)
                        {
                            <tr>
                                <td>@m.Platform.Name</td>
                                <td>
                                    <div style="max-width:400px;min-width:300px;display:inline-block;word-break:break-all;white-space: normal;">
                                        @m.MsgContent
                                    </div>
                                </td>                                
                                <td>@m.BeginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@m.EndTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@m.Interval</td>                                
                                <td>@FW.Core.Helper.Enum.EnumExtensions.GetDisplayName(m.Status)</td>                          
                                <td>@(m.LastSendTime.HasValue ? m.LastSendTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "" )</td>                               
                                <td>
                                    @Html.LinkWithRight(action: "Edit", href: "/GameMessage/Edit/" + m.Id)
                                    @Html.LinkWithRight(action: "Del", onclick: "swDelConfirmUrl('/GameMessage/Del/" + m.Id + "')", href: "#")                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}