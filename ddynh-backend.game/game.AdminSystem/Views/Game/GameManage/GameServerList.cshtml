@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model List<game.Entity.Game.GameServerViewModel>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
}

<style>

    .count_0, .count_0 a {
        color: #CCC !important;
    }
</style>

<div class="row" id="serverList">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>游戏</label>
                    @Html.DropDownList("gameID", DataService.Game(), new { @class = "form-control input-small", id = "gameID", v_model = "selectedGameID" })
                </div>
                <div class="form-group">
                    <label>服务器名</label>
                    <select class="form-control input-medium" v-model="selectedServerId" name="serverID">
                        <option value="">全部</option>
                        <option v-for="item in filterServerList" :value="item.Id">{{item.ServerName}}</option>
                    </select>
                    @*<input type="text" class="form-control input-small" id="serverID" name="serverID" placeholder="服务器名" />*@
                </div>
                <div class="form-group">
                    <label>客户端连接地址</label>
                    <input type="text" class="form-control input-small" id="ClientAddr" name="ClientAddr" placeholder="IP地址" />
                </div>
                <div class="form-group">

                    <button type="submit" class="btn btn-default"> 搜 索 </button>

                </div>
            </form>



            <div style="margin-top:5px;">
                <span>其他操作：</span>
                <button type="button" class="btn btn-primary" onclick="global_showMyModal()"> 复制房间分配设置 </button>
            </div>

            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th>编号</th>
                            <th>游戏名称</th>
                            <th>服务器名</th>
                            <th>显示名称</th>
                            <th>客户端连接地址</th>
                            <th>通知地址</th>
                            <th>http地址</th>
                            <th class="algin-c">已分配平台</th>
                            <th>入场金币</th>
                            <th>最后更新时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                string styleCount = string.Format("count_{0}", item.PlatformCount);
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Game.GameName</td>
                                    <td>@item.ServerName</td>
                                    <td>@item.ShowName</td>
                                    <td>@item.ClientAddr</td>
                                    <td>@item.NotifyAddr</td>
                                    <td>@item.HttpAddr</td>
                                    <td class="algin-c @styleCount" title="@item.PlatformIDsText">

                                        <a class="link-text" href="@Url.Action("ListAndUpdate" , "GameServerTreeManagement" , new { serverID = item.Id , GameID= item.GameID })" target="_blank">
                                            @item.PlatformCount
                                        </a>

                                    </td>
                                    <td>@item.Money.ToCash()</td>
                                    <td>@item.LastUpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @Html.LinkWithRight(action: "EditGameServer", value: "编辑", href: "EditGameServer?id=" + item.Id)
                                        @Html.LinkWithRight(action: "Del", value: "删除", onclick: "swDelConfirmUrl('Del?id=" + item.Id + "')", href: "#")
                                        @Html.LinkWithRightHref(href: "/RobotServerConfig/List?gameID=" + item.GameID + "&serverID=" + item.Id, value: "机器人配置")
                                        @if (ConfigData.OperateServerGameIDs.Contains(item.GameID))
                                        {
                                            @Html.Link(href: string.Format(ConfigData.DicOperateServerGameIDs[item.GameID], item.Id), value: "管理桌子", cssName: "btn btn-sm dark")
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>




<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="modal_empty_template" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:700px">
        <div class="modal-content" style="padding:35px 35px;">

            <div class="form-group">
                <label>从哪个平台复制(资料源)</label>

                @{
                    var sourcePlatform = new DropdownPartialSettingViewModel(FirstOptionValueEnum.MustSelect);
                    sourcePlatform.DOM_ElementName = "templatePlatformID";
                }

                @Html.Partial("_DropdownPlatform", sourcePlatform)
            </div>

            <div class="form-group">
                <label>复制到此平台</label>
                @{
                    var instanceModel = new DropdownPartialSettingViewModel(FirstOptionValueEnum.MustSelect);
                    instanceModel.DOM_ElementName = "targetPlatformID";
                }

                @Html.Partial("_DropdownPlatform", instanceModel)
            </div>


            <div style="margin-top:25px;">

                <button class="btn btn-warning" onclick="copyServerRelationFromTemplate()">开始复制</button>

                <span id="myTip" class="glyphicon glyphicon-exclamation-sign" aria-hidden="true" style="color:#d08340;" title="" data-original-title="">
                </span>

                <span style="color:#d08340">
                    复制功能会先进行平台设置都清除再进行复制
                </span>

            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    关闭
                </button>
            </div>

        </div>
    </div>
</div>




@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');

            var vApp = new Vue({
                el: '#serverList',
                data: {
                    selectedGameID: '',
                    selectedServerId: '',
                    serverList: {},
                    filterServerList: {}
                },
                methods: {
                    getServerList: function () {
                        $.get('/GameManage/GameSelectServerList', {}, function (data) {
                            if (data instanceof Array) {
                                vApp.serverList = data;
                            }
                            else {
                                vApp.serverList = {};
                            }
                        });
                    }
                }
            });

            $("#gameID").change(function () {

                vApp.filterServerList = vApp.serverList.filter(function (item, index, array) {
                    return item.GameID == parseInt(vApp.selectedGameID);
                });
                vApp.selectedServerId = ''
            });

            vApp.getServerList();
        })


        function copyServerRelationFromTemplate()
        {            
            var templatePlatformID = $("#templatePlatformID").val();
            var targetPlatformID = $("#targetPlatformID").val();


            if (templatePlatformID == '' || targetPlatformID == '')
            {
                alert('请选择平台');
                return;
            }

            if (confirm("是否确定进行复制？")) {

                var platform = $("")

                $.ajax({
                    cache: false,
                    dataType: 'json',
                    data:
                    {
                        templatePlatformID: templatePlatformID,
                        targetPlatformID: targetPlatformID
                    },
                    url: '/GameServerDetailManage/CopyServerRelationFromTemplate',
                    type: 'POST',
                    success: function (data) {

                        if (data.IsSuccess) {
                            alert(data.Message);
                            location.reload();
                        }
                        else {
                            alert(data.Message);
                        }

                    },
                    error: function (err) {
                        swal({
                            type: 'error',
                            title: '操作失败',
                            text: err
                        })
                    }
                });

            }
        }





    </script>
}
