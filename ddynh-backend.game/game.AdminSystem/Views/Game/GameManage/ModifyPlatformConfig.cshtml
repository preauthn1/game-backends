@section initScripts{
    <script>

        $(function () {
            var vApp = new Vue({
                el: '#vApp',
                data: {
                    gameList: JSON.parse(`@Html.Raw(Json.Encode(@ViewBag.GamesSort))`),
                    GameSortList: '',
                    listLength: 0,
                    oldData: null,
                    newData: null
                },

                mounted: function () {
                    const init = this.init()
                    this.$set(this, 'oldData', init)
                },

                methods: {
                    init: function () {
                        var order= $("#sortable .ui-state-default").map(function() {
                            return { GameID: this.id, Sort: this.value };;
                        }).get()
                        this.$set(this, 'listLength', order.length)
                        return order
                    },

                    save: function () {
                        const old = JSON.stringify(vApp.oldData)
                        const newD = JSON.stringify(vApp.newData)
                        if (vApp.newData === null|| old === newD) {
                            this.$set(this, 'GameSortList', '')
                        } else {
                            this.$set(this, 'GameSortList',newD)
                        }
                        this.$nextTick(function () {
                            $("#form1").submit()
                        })
                    }
                }
            })

            $( "#sortable" ).sortable({
                update: function(event, ui) {
                    var res= $("#sortable .ui-state-default").map(function(index) {
                        const length = vApp.listLength
                        const sort = length - index
                        return { GameID: this.id, Sort: sort }
                    }).get()
                    vApp.$set(vApp, 'newData', res)
                }
            });

            $( "#sortable" ).disableSelection();

            var _scrollt = readCookie("scroll_t");
            $('#scrollDiv')[0].scrollTop = _scrollt;

            $('#form1').validate({
                rules: {
                    Name: {
                        required: true
                    },
                    UpGradeMsg: {
                        required: true,
                        maxlength: 128
                    },
                    AnnMsg: {
                        required: true,
                        maxlength: 128
                    },
                    PayTip: {
                        required: true,
                        maxlength: 128
                    },
                    FAQContent: {
                        required: true
                    },
                    GiftMoney: {
                        required: true,
                        number: true
                    },
                    DefaultMoney: {
                        required: true,
                        number: true
                    }
                },
                messages: {
                    GiftMoney: {
                        number: '只能使用数字'
                    },
                    DefaultMoney: {
                        number: '只能使用数字'
                    }
                }
            });

            $('#uiFlagIOS').click(function () {
                if ($(this).is(':checked')) {
                    $('.iosShow').hide();
                }
                else {
                    $('.iosShow').show();
                }
            });

            $('#uiFlagIOS,#uiFlagOnline,#uiFlagAgent,#uiFlagInvestment').click(function () {
                setUIFlag();
            });

            var setUIFlag = function () {
                var flag = '0';
                if ($('#uiFlagIOS').is(':checked')) {
                    $('[name="UIFlag"]').val('1000');
                }
                else {
                    if ($('#uiFlagOnline').is(':checked'))
                        flag += '1';
                    else
                        flag += '0';
                    if ($('#uiFlagAgent').is(':checked'))
                        flag += '1';
                    else
                        flag += '0';
                    if ($('#uiFlagInvestment').is(':checked'))
                        flag += '1';
                    else
                        flag += '0';

                    $('[name="UIFlag"]').val(flag);
                }
            };

            var uiFlag = '@Model.UIFlag';
            if (uiFlag) {
                if (uiFlag[0] == '1')
                    $('#uiFlagIOS').click();
                if (uiFlag[1] == '1')
                    $('#uiFlagOnline').click();
                if (uiFlag[2] == '1')
                    $('#uiFlagAgent').click();
                if (uiFlag[3] == '1')
                    $('#uiFlagInvestment').click();
            }

            $('.pay-sort .badge').click(function () {
                $(this).parent().prependTo('.pay-sort');
                setPaySort();
            });
            $('.pay-sort :checkbox').click(function () {
                setPaySort();
            });

            var setPaySort = function () {
                var sort = '';
                $('.pay-sort :checkbox:checked').each(function (i, e) {
                    sort += $(e).val() + ',';
                });
                if (sort != '')
                    sort = sort.substr(0, sort.length - 1);

                $('[name="PaySort"]').val(sort);
            };

            var paySort = '@Model.PaySort'.split(',');
            for (var i = paySort.length; i > 0; i--) {
                $('.pay-sort [data-value="' + paySort[i - 1] + '"]').prependTo('.pay-sort');
                $('.pay-sort :checkbox[value="' + paySort[i - 1] + '"]').click();
            }

            var payAmountConfig = '@Model.PayAmountConfig';
            if (payAmountConfig) {
                var configList = payAmountConfig.split('|');
                $(configList).each(function (i, e) {
                    var config = e.split(':');
                    $(':text[data-payway="' + config[0] + '"]').val(config[1]);
                });
            }

            $('#form1').submit(function () {
                if ($('.pay-sort :checkbox:checked').size() < 1) {
                    alert('至少需要选择一种支付方式');
                    return false;
                }

                var isEmpty = false;
                var config = '';
                $(':text[data-payway]').each(function (i, e) {
                    if ($(e).val() != '') {
                        config += $(e).data('payway') + ':' + $(e).val() + '|';
                    }
                });
                if (config != '')
                    config = config.substr(0, config.length - 1);

                $('[name="PayAmountConfig"]').val(config);
            });

            $('#scrollDiv').scroll(function () {
                if ($('#scrollDiv').html().length) {
                    document.cookie = "scroll_t=" + $('#scrollDiv').scrollTop();
                }
            });

            $("#add-advertisement-button").click(addAD);

            $("#edit-advertisement-button").click(editAD);

        })

        function readCookie(name) {
            var searchName = name + "=";
            var cookies = document.cookie.split(';');
            for (var i = 0 ; i < cookies.length ; i++) {
                var c = cookies[i];
                while (c.charAt(0) == ' ')
                    c = c.substring(1, c.length);
                if (c.indexOf(searchName) == 0)
                    return c.substring(searchName.length, c.length);
            }
            return null;
        }


        function changeFile(tag, event){

            var file = event.target.files[0];
            if (file === undefined) {
                $("#previewFile"+tag+"").attr('src', '');
                return;
            }

            var tmppath = URL.createObjectURL(file);
            $("#previewFile"+tag+"").attr('src', tmppath);
            $("#fileSize"+tag+"").val(file.size);
        }

        function createADTable() {
            const table =  $(`#AD_table`);
            const url = '/GameManage/GetAdvertisements'
            const columns = [
              { "sTitle": "图片", "mData": "Picture", "width": "15%",
                  "render": function (data, type, row) {
                      return "<img  src='"+data+"'>"
                  }
              },
              { "sTitle": "自订连结", "mData": "Link" },
              { "sTitle": "开启方式", "mData": "BehaviorName", "width": "15%"},
              { "sTitle": "状态", "mData": "StatusName","width": "8%" },
              { "sTitle": "建立时间", "mData": "StrCreateTime", "width": "10%"},
              { "sTitle": "操作", "mData": "Id",  "width": "15%",
                  "render": function (data, type, row){
                      return `<button type="button" class="btn dark edit" data-toggle="modal" data-target="#advertisement-editModal" onclick="appendData(this)">修改</button>
                  <button type="button" class="btn dark" onclick="deleteAD(this)">刪除</button>`;
                  }
              }
            ];

            const platformID = @Model.Id;
            const opt = {
                "ordering": false,
                "searching": false,
                "aoColumns": columns,
                "bProcessing": true,
                "serverSide": true,
                "bPaginate": false,
                "ajax": {
                    "type": "POST",
                    "url": url,
                    "data": {
                        '_r': Math.random(),
                        'platformID': platformID
                    }
                },
                "destroy": true
            }
            table.dataTable(opt)
        }

        function resetForm(tag){
            $("#advertisement-form"+tag+"")[0].reset();
            $("#previewFile"+tag+"").removeAttr("src");
            $("#flieMsg"+tag+"").text('');
            $("#linkMsg"+tag+"").text('');
            $("#fileSize"+tag+"").val(0);
        }

        function addAD(){
            if(!validate('')){return;}

            $.ajax({
                url: '@ViewBag.UploadAdvertisementUrl',
                type: "POST",
                data: new FormData($("#advertisement-form")[0]),
                contentType: false,
                processData: false,
                dataType: 'json',
                success: function (data) {
                    alert(data.msg);
                    createADTable();
                    $("#closeModel").click();
                }
            });
        }

        function appendData(ob){
            resetForm('Edit');
            const table = $('#AD_table').DataTable();
            const $tr = $(ob).closest('tr');
            const row = table.row($tr).data();

            $("#previewFileEdit").attr("src",row.Picture);
            $("#LinkEdit").val(row.Link);
            $("#BehaviorEdit").val(row.Behavior);
            $("#StatusEdit").val(row.Status);
            $("#IdEdit").val(row.Id);
            $("#PlatformIDEdit").val(row.PlatformID);
            $("#PictureEdit").val(row.Picture);
        }

        function editAD(){
            if(!validate('Edit')){return;}

            $.ajax({
                url: '@ViewBag.UploadAdvertisementUrl',
                type: "POST",
                data: new FormData($("#advertisement-formEdit")[0]),
                contentType: false,
                processData: false,
                dataType: 'json',
                success: function (data) {
                    alert(data.msg);
                    createADTable();
                    $("#closeEditModel").click();
                }
            });
        }

        function deleteAD(ob){
            const table = $('#AD_table').DataTable();
            const $tr = $(ob).closest('tr');
            const row = table.row($tr).data();

            var id= row.Id;
            var picture = row.Picture;
            var uploadURL = '@ViewBag.WebUrl';

            $.ajax({
                cache: false,
                dataType: 'json',
                url: '@ViewBag.DelAdvertisementUrl',
                data: {
                    adId: id,
                    picture: picture,
                    uploadURL: uploadURL
                },
                contentType: "application/x-www-form-urlencoded",
                type: 'POST',
                success: function (data) {
                    alert(data.msg);
                    createADTable();
                },
                error: function (err) {
                }
            });
        }

        function validate(tag){
            const link = $("#Link"+tag+"").val();
            const file = $("#File"+tag+"").val();
            const previewFile = $("#previewFile"+tag+"").attr('src');

            var result = true;

            //if(!link){
            //    $("#linkMsg"+tag+"").text("*请输入连结");
            //    result = false;
            //}
            if(!file && !previewFile){
                $("#flieMsg"+tag+"").text("*请选择图片");
                result = false;
            }

            if(file){
                var imgSize = $("#fileSize"+tag+"").val();

                if(imgSize > 1*1024*1024){
                    $("#flieMsg"+tag+"").text("*图片不可超过1M");
                    result = false;
                }
            }
            return result;
        }



    </script>
}