                    const columns = [
                      {
                          "sTitle": "图片", "mData": "Picture", "width": "15%",
                          "render": function (data, type, row) {
                              return `<div class="areaConfig_ad__image_contain"><div class="areaConfig_ad__image" style="background-image: url('${data}');"></div></div>`
                          }
                      },
                      { "sTitle": "自订连结", "mData": "Link" },
                      { "sTitle": "开启方式", "mData": "BehaviorName", "width": "15%" },
                      { "sTitle": "状态", "mData": "StatusName", "width": "8%" },
                      { "sTitle": "建立时间", "mData": "StrCreateTime", "width": "10%" },
                      {
                          "sTitle": "操作", "mData": "Id", "width": "15%",
                          "render": function (data, type, row) {
                              return `<button type="button" class="btn dark edit" data-toggle="modal" data-target="#advertisement-modal" onclick="editAD_action(this)">修改</button>
                                      <button type="button" class="btn dark" onclick="deleteAD(this)">刪除</button>`;
                          }
                      }
                    ]

                    var table = $('#AD_table').dataTable({
                        "aaData": this.advertisements.filter((x) => x.AreaID == areaID),
                        "ordering": false,
                        "searching": false,
                        "aoColumns": columns,
                        "bPaginate": false,
                        "destroy": true
                    })

                    this.$set(this, 'adDataTable', table)
                },
                imageUrl(id) {
                    const res = this.systemConfig.gameListIcon.filter((x) => x.GameID == id)
                    if (res.length > 0) return res[0].Image
                    return ''
                },
                jsonEscape(str) {
                    return str.replace(/n/g, "\n").replace(/r/g, "\r").replace(/t/g, "\t");
                },

                savePlatform () {
                    if (this.isAddArea) if (!$("#form3").valid()) return false
                    this.$nextTick(function () {
                        this.$set(this, 'isSave', true)
                        $.post(`/GameManage/CreateNewPlatform`, {
                            PlatformID: this.platform.PlatformID,
                            PlatformName: this.platform.PlatformName,
                            AreaNum: this.platform.AreaNum,
                            Company: this.platform.Company
                        }, function (res) {
                            vApp.$set(vApp, 'isSave', false)
                            swal({
                                type: res.Result ? 'success' : 'error',
                                title: res.Message,
                            }).then((result) => {
                                vApp.reloadData()
                                if (vApp.isAddArea) vApp.closeArea()
                            })
                        })
                    })
                },
                saveArea() {
                    if (!$("#form1").valid()) return false
                    this.$nextTick(function () {
                        this.$set(this, 'isSave', true)
                        const FAQContent = this.$refs.FAQContent.value
                        const PayTips = this.$refs.PayTip.value
                        const AnnMsgShow = +vApp.submitForm.AnnMsgShow
						const SetDefault = +vApp.submitForm.SetDefault
						const ConvertPopupText = this.$refs.ConvertPopupText.value

                        vApp.gamelist = vApp.mergeIconID(vApp.gamelist)
                        vApp.newGamelist = vApp.mergeIconID(vApp.newGamelist)

                        const old = JSON.stringify(vApp.gamelist)
                        const newD = JSON.stringify(vApp.newGamelist)
                        const gameSortList = newD === 'null' ? old : newD

                        let promises = []

                        this.$set(vApp.submitForm, 'FAQContent', FAQContent)
                        this.$set(vApp.submitForm, 'PayTips', PayTips)
                        this.$set(vApp.submitForm, 'AnnMsgShow', AnnMsgShow)
						this.$set(vApp.submitForm, 'SetDefault', SetDefault)
						this.$set(vApp.submitForm, 'ConvertPopupText', ConvertPopupText)

                        let submitForm = _.cloneDeep(vApp.submitForm)

                        example.invalid.PlatformID = submitForm.PlatformID
                        example.invalid.SiteID = submitForm.Id

                        const deep = _.cloneDeep(this.arealist)
                        const data = _.filter(deep, function (o) {
                            return o.SetDefault === 1
                        })

                        if (data.length > 0) {
                            const areaConfig = submitForm.AreaConfig
                            const setDefault = data[0].AreaConfig
                            const res = _.defaultsDeep(areaConfig, setDefault)
                            submitForm.AreaConfig = res
                        }

                        const areaConfig = JSON.stringify(submitForm.AreaConfig)
                        submitForm.AreaConfig = areaConfig

                        const ShopNameID = $('#ShopNameID').val()
                        const AgentNameID = $('#AgentNameID').val()
                        this.$set(vApp.submitForm, 'ShopNameID', ShopNameID)
                        this.$set(vApp.submitForm, 'AgentNameID', AgentNameID)

                        const promise = new Promise((resolve, reject) => {
                            $.post(`/GameManage/UpdateAreaConfig`, {
                                Id: submitForm.Id,
                                PlatformID: submitForm.PlatformID,
                                AreaName: submitForm.AreaName,
                                ClientPlatform: submitForm.ClientPlatform,
                                Memo: submitForm.Memo,
                                IsGameCategoryFilterVisible: submitForm.IsGameCategoryFilterVisible,
                                ShowConvertLimit: submitForm.ShowConvertLimit,
                                ShowVIPAgent: submitForm.ShowVIPAgent,
                                ShowCS: submitForm.ShowCS,
                                ShowAllGameLimit: submitForm.ShowAllGameLimit,
                                PlaytimeCS: submitForm.PlaytimeCS,
                                PlaytimeConvert: submitForm.PlaytimeConvert,
                                PlaytimeVIPAgent: submitForm.PlaytimeVIPAgent,
                                FAQContent: submitForm.FAQContent,
                                PayTips: submitForm.PayTips,
                                UpGradeMsg: submitForm.UpGradeMsg,
                                GiftMoney: submitForm.GiftMoney,
                                GiftMoneyFlowLimit: submitForm.GiftMoneyFlowLimit,
                                DefaultMoney: submitForm.DefaultMoney,
                                DefaultMoneyFlowLimit: submitForm.DefaultMoneyFlowLimit,
                                ShopNameID: +ShopNameID,
								AgentNameID: +AgentNameID,
								ShowConvertPopup: submitForm.ShowConvertPopup,
								ConvertPopupText: submitForm.ConvertPopupText,
                                ShowConvertBindPhone: submitForm.ShowConvertBindPhone,
                                ShowAllGameBindPhone: submitForm.ShowAllGameBindPhone,
                                ShowVIPAgentBindPhone: submitForm.ShowVIPAgentBindPhone,
                                ShowCSBindPhone: submitForm.ShowCSBindPhone,
                                AnnMsg: submitForm.AnnMsg,
                                AnnMsgShow: submitForm.AnnMsgShow,
                                SetDefault: submitForm.SetDefault,
                                AreaConfig: submitForm.AreaConfig,
                                GameSortList: gameSortList
                            }, function (res) {
                                resolve()
                            })
                        })
                        promises.push(promise)


                        Promise.all(promises).then(values => {
                            this.$set(this, 'isSave', false)
                            if (vApp.isSync) vApp.syncAreaConfig()
                            this.$set(this, 'isSync', false)
                            swal({
                                type: 'success',
                                title: '操作成功',
                            }).then((result) => {
                                vApp.reloadData()
                                if (vApp.isAddArea) vApp.closeArea()
                            })
                        })

                    })
                },
                addArea () {
                    const deep = _.cloneDeep(this.defaultForm)
                    this.$set(this, 'submitForm', deep)
                    this.$set(this, 'defaultAreaID', null)
                    this.$set(this, 'isAddArea', true)

                    Object.keys(this.defaultForm.AreaConfig.systemConfig.payConfig).map(function (objectKey, index) {
                        $(`#uniform-${objectKey}`).find('span').removeClass('checked')
                        $(`#uniform-${objectKey}`).prop("checked", false)
                    })
                    $(`#uniform-SetDefault`).find('span').removeClass('checked')
                    $(`#uniform-SetDefault`).prop("checked", false)
                    $(`#uniform-AnnMsgShow`).find('span').removeClass('checked')
                    $(`#uniform-AnnMsgShow`).prop("checked", false)

                },
                closeArea () {
                    this.init()
                    this.$set(this, 'isAddArea', false)
                },

                closeGame() {
                    this.init()
                    this.$set(this, 'isAddGame', false)
                },
                addGame () {
                    this.$set(this, 'gameForm', {})
                    this.$set(this, 'defaultIconID', null)
                    this.$set(this, 'isAddGame', true)
                },

                saveGame () {
                    if (!$("#form2").valid()) return false

                    const GameManageAction = this.isAddGame ? 'InsertGameAliasName' : 'UpdGameAliasName'
                    $.post(`/GameManage/${GameManageAction}`, vApp.gameForm
                        , function (res) {
                            swal({
                                type: 'success',
                                title: res.Message,
                            }).then((result) => {
                                vApp.reloadData()
                                if (vApp.isAddGame) vApp.closeGame()
                            })
                        })
                },
                changeFile() {
                    const file = this.$refs.File.files[0]
                    if (file === void 0) {
                        this.$set(this.adForm, 'Picture', '')
                        return
                    }
                    var tmppath = URL.createObjectURL(file);
                    this.$set(this.adForm, 'Picture', tmppath)
                    $("#fileSize").val(file.size);
                },
                addNewGame () {
                    const _option = $(".option_newgame select option:selected")
                    if (_option.length == 0) return false

                    const gameId = +_option[0].value
                    const gameName = _option[0].text
                    const platformID = this.submitForm.PlatformID
                    const aeaID = this.defaultAreaID

                    const data = {
                        AliasName: null,
                        AreaID: aeaID,
                        GameID: gameId,
                        GameName: gameName,
                        IconID: null,
                        PlatformID: platformID,
                        Popular: 0,
                        Sort: 99,
                        Status: 1
                    }
                    this.gamelist.push(data)
                },
                delGame(item) {
                    const gameId = item.GameID
                    const id = item.Id
                    this.gamelist = this.gamelist.filter((x) => x.GameID != gameId)

                    $.post(`/AreaGameSetting/DeleteAreaGame`, {
                        ID: id
                    }, function (res) {
                    })
                },
                addAD() {
                    if (this.isAddAD) {
                        $.ajax({
                            url: '@ViewBag.InsertAdvertisementUrl',
                            type: "POST",
                            data: new FormData($("#advertisement-form")[0]),
                            contentType: false,
                            processData: false,
                            dataType: 'json',
                            success: function (data) {
                                $("#closeModel").click();
                                swal({
                                    type: 'success',
                                    title: data.msg
                                }).then((result) => {
                                    vApp.reloadData()
                                })
                            }
                        });
                    } else {
                        editAD()
                    }
                },
                reloadData () {
                    $.get(`/GameManage/ReloadAreaConfig`, function (res) {
                        vApp.arealist = res.areaList
                        vApp.searchlist = res.areaList.filter((x) => {
                            const areaName = x.AreaName
                            const areaID = `'${x.Id}'`
                            return vApp.searchArea === null ? true : ~areaName.indexOf(vApp.searchArea) || ~areaID.indexOf(vApp.searchArea)
                        })
                        vApp.searchGamelist = res.gameAliasName.filter((x) => {
                            const aliasName = x.AliasName
                            return vApp.searchGame === null ? true : ~aliasName.indexOf(vApp.searchGame)
                        })
                        vApp.advertisements = res.advertisements
                        vApp.gameAliasName = res.gameAliasName
                        vApp.gameJson = res.gameJson
                        vApp.createADTable(vApp.defaultAreaID)
                    })
                },
                openGameSetting() {
                    this.$set(this, 'isGameSetting', !this.isGameSetting)
                },
                getIconList(val) {
                    return this.gameAliasName.filter((x) => x.GameID == val)
                },
                mergeIconID (list) {
                    if (!list) return list

                    const option_aliasName = $(".option_aliasName select option:selected")
                    let data = list.map((x) => {
                        const temp = option_aliasName.filter((i, op) => {
                            const gameid = op.attributes['data-gameid']
                            return gameid.value == x.GameID
                        })
                        if (temp.length > 0) {
                            x.IconID = temp[0].value
                            return x
                        }
                    })

                    const option_popular = $(".option_popular select option:selected")
                    data = list.map((x) => {
                        const temp = option_popular.filter((i, op) => {
                            const gameid = op.attributes['data-gameid']
                            return gameid.value == x.GameID
                        })
                        if (temp.length > 0) {
                            x.Popular = temp[0].value
                            return x
                        }
                    })

                    const option_game = $(".option_game select option:selected")
                    data = list.map((x) => {
                        const temp = option_game.filter((i, op) => {
                            const gameid = op.attributes['data-gameid']
                            return gameid.value == x.GameID
                        })
                        if (temp.length > 0) {
                            x.GameID = +temp[0].value
                            return x
                        }
                    })

                    const option_status = $(".option_status select option:selected")
                    data = list.map((x) => {
                        const temp = option_status.filter((i, op) => {
                            const gameid = op.attributes['data-gameid']
                            return gameid.value == x.GameID
                        })
                        if (temp.length > 0) {
                            x.Status = temp[0].value
                            return x
                        }
                    })

                    return data
                },

                isSyncPlatform (platformID) {
                    this.$set(this, 'isSync', true)
                    this.saveArea()
                },

                syncAreaConfig () {
                    const platformID = this.submitForm.PlatformID
                    const areaID = this.submitForm.Id
                    $.post('/GameManage/SyncAreaConfig', { platformID, areaID }, function (res) {
                    })
                    },

                encode (str) {
                    if (str) {
                        return str.replace(/\<br>/g, "\n")
                    }
                },
                openADNew() {
                    this.$refs.File.value = ''
                    const copy = Object.assign({}, this.defaultAdForm)
                    this.$set(this, 'adForm', copy)
                    this.isAddAD = true
                },
                openAutoAddArea(platformID, areaID, areaName) {

                    this.authAddAreaForm.PlatformID = platformID
                    this.authAddAreaForm.AreaIdText = areaID
                    this.authAddAreaForm.AreaName = areaName
                    this.$set(this, 'defaultAreaID', null)
                    this.$set(this, 'isAutoAddArea', true)
                },
                closeAutoAddArea() {
                    let formData = _.cloneDeep(this.authAddAreaForm);
                    formData.default()
                    this.init()
                    this.$set(this, 'isAutoAddArea', false)
                },
                saveAutoAddArea() {
                    if (this.isAutoAddArea) if (!$("#form4").valid()) return false

                    var url = `/GameManage/AutoAddArea`;

                    var input = {
                        platformID: this.authAddAreaForm.PlatformID,
                        areaID: parseInt(this.authAddAreaForm.AreaIdText),
                        areaName: this.authAddAreaForm.AreaName,
                        areaNum: parseInt(this.authAddAreaForm.AreaNum)
                    };

                    $.post(url, input, function (res) {

                        swal({
                            type: res.Result,
                            title: res.Message,
                        }).then((result) => {
                            vApp.reloadData()
                            if (vApp.isAutoAddArea) vApp.closeAutoAddArea()
                        })
                    })
                }
            }
        })

        function editAD_action(ob) {
            vApp.isAddAD = false
            vApp.$refs.File.value = ""
            const table = $('#AD_table').DataTable();
            const $tr = $(ob).closest('tr');
            const row = table.row($tr).data();
            const id = row.Id;
            const picture = row.Picture;
            const link = row.Link;
            const behavior = row.Behavior
            const status = row.Status
            var uploadURL = '@ViewBag.WebUrl'

            vApp.adForm = Object.assign({}, {
                Id: id,
                Picture: picture,
                Link: link,
                Behavior: behavior,
                Status: status
            })
        }

        function editAD() {
            const item = new FormData($("#advertisement-form")[0])
            $.ajax({
                url: '@ViewBag.UploadAdvertisementUrl',
                type: "POST",
                data: item,
                contentType: false,
                processData: false,
                dataType: 'json',
                success: function (data) {
                    $("#closeModel").click();
                    swal({
                        type: 'success',
                        title: data.msg
                    }).then((result) => {
                        vApp.reloadData()
                    })
                }
            })
        }

        function deleteAD(ob) {
            const table = $('#AD_table').DataTable();
            const $tr = $(ob).closest('tr');
            const row = table.row($tr).data();

            var id = row.Id;
            var picture = row.Picture;
            var uploadURL = '@ViewBag.WebUrl';

            $.ajax({
                cache: false,
                dataType: 'json',
                url: '@ViewBag.DelAdvertisementUrl',
                data: {
                    adId: id,
                    picture: picture,
                    uploadURL: uploadURL
                },
                contentType: "application/x-www-form-urlencoded",
                type: 'POST',
                success: function (data) {
                    swal({
                        type: 'success',
                        title: data.msg
                    }).then((result) => {
                        vApp.reloadData()
                    })
                },
                error: function (err) {
                }
            });
        }

        function customizer(objValue, srcValue) {
            return _.isUndefined(objValue) ? srcValue : objValue;
        }

    </script>
}

