            watch: {
                defaultAreaID: function (val) {
                    if (val) {
                        this.getArealist(val)
                        this.getAreaGameSortById(val)
                    }
                },
                searchArea: function (value) {
                    vApp.searchlist = this.arealist.filter((x) => {
                        const areaName = x.AreaName
                        const areaID = `'${x.Id}'`
                        return value === null ? true : ~areaName.indexOf(value) || ~areaID.indexOf(value)
                    })
                },
                searchGame: function (value) {
                    vApp.searchGamelist = this.gameAliasName.filter((x) => {
                        const aliasName = x.AliasName
                        return value === null ? true : ~aliasName.indexOf(value)
                    })
                },
                defaultIconID: function (val) {
                    const item = this.gameAliasName.filter((x) => x.IconID == val)
                    if (item.length > 0) {
                        this.gameForm = Object.assign({}, item[0])
                    }
                }
            },

			computed: {
				PayTips: {
					get: function () {
						return this.encode(this.submitForm.PayTips)
					},
					set: function (value) {
						vApp.submitForm.PayTips = value
					}
				},
				FAQContent: {
					get: function () {
						return this.encode(this.submitForm.FAQContent)
					},
					set: function (value) {
						vApp.submitForm.FAQContent = value
					}
				},
				newGameJson: function () {
					const gamelist = this.gamelist.map((x) => x.GameID)
					return this.gameJson.filter((i) => !~gamelist.indexOf(i.Id))
				},
				ConvertPopupText: {
					get: function () {
						return this.encode(this.submitForm.ConvertPopupText)
					},
					set: function (value) {
						vApp.submitForm.ConvertPopupText = value
					}
				}
            },

            mounted: function () {
                this.$set(this, 'searchlist', this.arealist)
                this.$set(this, 'searchGamelist', this.gameAliasName)
                this.$set(this, 'areaJsonSetting', this.systemConfig.AreaJsonSetting)
            },

            created: function () {
                this.init()
                this.$nextTick(function () {
                    this.createSortable()
                })
            },

            methods: {
                init () {
                    if (this.arealist.length > 0) {
                        const areaID = _.get(this, 'arealist[0].Id')
                        this.$set(this, 'defaultAreaID', areaID)
                    }

                    if (this.gameAliasName.length > 0) {
                        const IconID = _.get(this, 'gameAliasName[0].IconID')
                        this.$set(this, 'defaultIconID', IconID)
                    }
                },
                chooseArea (id) {
                    this.$set(this, 'isAddArea', false)
                    this.$set(this, 'defaultAreaID', id)
                },

                choseIcon (IconID) {
                    this.$set(this, 'isAddGame', false)
                    this.$set(this, 'defaultIconID', IconID)
                },
                createSortable() {
                    if (this.isAdvanced) {
                        var el = document.getElementById('sortable')
                        Sortable.create(el, {
                            animation: 100,
                            onUpdate: function (evt) {
                                var res = $("#sortable .ui-state-default").map(function (index) {
                                    const length = vApp.gamelist.length
                                    const sort = length - index
                                    return { GameID: this.id, Sort: sort }
                                }).get()
                                vApp.$set(vApp, 'newGamelist', res)
                            }
                        })
                    }
                },
                getArealist(id) {
                    $.get('/GameManage/GetAreaById', { 'id': id, '_r': Math.random() }, function (res) {
                        let payItem = []
                        vApp.$set(vApp, 'defaultAreaID', id)
                        const defaults = _.partialRight(_.assignWith, customizer)
                        const setting = res
                        vApp.submitForm = Object.assign({}, setting)
                        vApp.submitForm.AreaConfig = defaults(setting.AreaConfig, vApp.defaultForm.AreaConfig)
                        example.invalid.PlatformID = vApp.submitForm.PlatformID
                        const deep = _.cloneDeep(vApp.submitForm.AreaConfig.systemConfig)

                        vApp.$nextTick(function () {
                            Object.keys(deep.payConfig).map(function (objectKey, index) {
                                var value = deep.payConfig[objectKey]
                                if (value == 1) {
                                    payItem.push(objectKey)
                                    $(`#uniform-${objectKey}`).find('span').addClass('checked');
                                    $(`#uniform-${objectKey}`).prop("checked", true);
                                } else {
                                    $(`#uniform-${objectKey}`).find('span').removeClass('checked');
                                    $(`#uniform-${objectKey}`).prop("checked", false);
                                }
                            })
                            
                            //checkbox的打勾要自己处理 (重置)
                            $(`#uniform-SetDefault`).find('span').removeClass('checked')
                            $(`#uniform-AnnMsgShow`).find('span').removeClass('checked')
                            $(`#uniform-IsGameCategoryFilterVisible`).find('span').removeClass('checked')


                            //checkbox自动打勾
                            if (vApp.submitForm.SetDefault === 1) $(`#uniform-SetDefault`).find('span').addClass('checked')
                            if (vApp.submitForm.AnnMsgShow === 1) $(`#uniform-AnnMsgShow`).find('span').addClass('checked')
                            if (vApp.submitForm.IsGameCategoryFilterVisible) $(`#uniform-IsGameCategoryFilterVisible`).find('span').addClass('checked')
                            
                            $(`#uniform-IsGameCategoryFilterVisible`).prop("checked", vApp.submitForm.IsGameCategoryFilterVisible === 1)
                            $(`#uniform-SetDefault`).prop("checked", vApp.submitForm.SetDefault === 1)
                            $(`#uniform-AnnMsgShow`).prop("checked", vApp.submitForm.AnnMsgShow === 1)
                        })
                        vApp.createADTable(id)
                    })
                },
                getAreaGameSortById (id) {
                    vApp.$set(vApp, 'gamelist', [])
                    vApp.$set(vApp, 'isLoading', false)

                    if (!id) {
                        const defaultArea = this.arealist.filter((x) => x.SetDefault == 1)
                        if (defaultArea.length > 0) {
                            id = defaultArea[0].Id
                        }
                    }
                    if (id) {
                        $.get('/GameManage/GetAreaGameSortById', { 'id': id, '_r': Math.random() }, function (res) {
                            vApp.$set(vApp, 'isLoading', true)
                            vApp.$set(vApp, 'gamelist', res)
                        })
                    }

                    this.$nextTick(function () {
                        this.createSortable()
                    })
                },

                createADTable (areaID) {
