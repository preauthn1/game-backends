@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/Component/target.js")"></script>
    <script src="https://example.invalid/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="https://example.invalid/ajax/libs/lodash.js/4.15.0/lodash.min.js"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Plugins/Vue/css/main.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/PageCss/ModifyAreaConfig.css")" rel="stylesheet" />
}

<!--平台同步設定的彈窗-->
@Html.Partial("_PopupSelectAreaModal")


<div class="areaConfig_contain" id="vApp">
    <v-loading v-if="isSave"></v-loading>
    <div class="areaConfig_contain__leftItem">
        <div>
            <div class="areaConfig_tool__contain">
                <div v-if="!isLoading" class="areaConfig_arealist__spinner areaConfig_flex">读取中</div>
                <div v-else-if="!isGameSetting && isLoading && !isAddArea && !isAutoAddArea" class="areaConfig_arealist__saveIcon areaConfig_flex" v-on:click="saveArea()">保存</div>
                <div v-else-if="!isGameSetting && !isAutoAddArea && isAddArea" class="areaConfig_arealist__saveIcon areaConfig_flex" v-on:click="savePlatform()">保存平台</div>
                <div v-else-if="!isAutoAddArea && isGameSetting" class="areaConfig_arealist__saveIcon areaConfig_flex" v-on:click="saveGame()">保存遊戲</div>
                <div v-else-if="isAutoAddArea" class="areaConfig_arealist__saveIcon areaConfig_flex" v-on:click="saveAutoAddArea()">新增渠道</div>

                <div v-if="!isGameSetting && !isAutoAddArea && isAdvanced" class="areaConfig_arealist__addIcon areaConfig_flex" v-on:click="addArea()">新增平台</div>
                <div v-else-if="isGameSetting" class="areaConfig_arealist__addIcon areaConfig_flex" v-on:click="addGame()">新增遊戲</div>

                <div v-if="isAddArea" class="areaConfig_arealist__undoIcon areaConfig_flex" v-on:click="closeArea()">取消</div>
                <div v-else-if="isGameSetting" class="areaConfig_arealist__undoIcon areaConfig_flex" v-on:click="closeGame()">取消</div>
                <div v-else-if="isAutoAddArea" class="areaConfig_arealist__undoIcon areaConfig_flex" v-on:click="closeAutoAddArea()">取消</div>
                <div v-else="isAddArea" class="areaConfig_arealist__undoIcon areaConfig_flex">取消</div>

                <div v-if="!isGameSetting" class="areaConfig_arealist__gamepadIcon areaConfig_flex" v-on:click="openGameSetting()">遊戲管理</div>
                <div v-else class="areaConfig_arealist__areaIcon areaConfig_flex" v-on:click="openGameSetting()">渠道管理</div>
            </div>
            <div class="areaConfig_searchBar__contain">
                <input v-if="!isGameSetting" class="frmSearch" type="text" placeholder="搜尋" v-model="searchArea">
                <input v-else class="frmSearch" type="text" placeholder="搜尋" v-model="searchGame">
            </div>
        </div>
        <div v-show="!isGameSetting" class="areaConfig_contain__arealist">
            <div v-if="isAddArea" class="areaConfig_n_flex">

            </div>
            <div v-if="isAutoAddArea" class="areaConfig_n_flex">

            </div>
            <div v-else class="areaConfig_arealist__item" v-for="(no , index) in searchlist" v-on:click="chooseArea(no.Id)"
                 v-bind:class="{'areaConfig_arealist__icon': no.SetDefault == 1 , 'js--active': no.Id == defaultAreaID}">
                <div style="color: blueviolet;">{{no.Id}}</div>
                <div>{{no.AreaName}}</div>
            </div>
        </div>
        <div v-show="isGameSetting" class="areaConfig_contain__gamelist">
            <div v-if="isAddGame">
            </div>
            <div v-else class="areaConfig_arealist__item" v-for="(no , index) in searchGamelist" v-on:click="choseIcon(no.IconID)"
                 v-bind:class="{'js--active': no.IconID == defaultIconID}">
                <div>{{no.AliasName}}</div>
            </div>
        </div>
    </div>

    <div class="areaConfig_contain__areasetting">
        <div v-show="!isGameSetting && !isAddArea && !isAutoAddArea" class="tab-content">
            <ul class="nav nav-tabs">
                <li class="active"><a data-toggle="tab" href="#platformForm">平台设定</a></li>
                <li><a data-toggle="tab" href="#AdForm">广告设定</a></li>
            </ul>
            <!-- 平台設定-->
            <div class="tab-pane active liDiv" id="platformForm">
                <form id="form1" ref="form1" method="post" class="form-horizontal form-bordered">
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">平台</label>
                        <div class="col-md-2">
                            <select class="form-control input-small" id="ClientPlatform" v-model="submitForm.PlatformID" v-bind:disabled="!isAddArea">
                                <option v-for="option in platformList"
                                        v-bind:value="option.Id"
                                        v-bind:selected="option.Id == submitForm.PlatformID">
                                    {{ option.Name }}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-8">

                            <a class="btn btn-sm btn-primary modal-pop" attr-modal-id="modal_empty_template" v-bind:attr-source-url="'/AreaConfigSync/ShowAreasCheckboxes?areaID='+ submitForm.Id">
                                平台设定同步
                            </a>

                            <button type="button" class="btn btn-primary" v-on:click="openAutoAddArea(submitForm.PlatformID,submitForm.Id,submitForm.AreaName)">自动新增渠道</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2">全平台预设</label>
                        <div class="col-md-10">
                            <input type="checkbox" id="SetDefault" name="SetDefault" v-model="submitForm.SetDefault" v-bind:value="submitForm.SetDefault" v-bind:disabled="!isAdvanced">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">渠道编号</label>
                        <div class="col-md-9">
                            <input type="text" id="AreaIdText" name="AreaIdText" class="form-control input-medium" v-model="submitForm.Id" v-bind:readonly="!isAddArea" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">渠道类型</label>
                        <div class="col-md-9">
                            <select class="form-control input-small" id="ClientPlatform" v-model="submitForm.ClientPlatform" v-bind:disabled="!isAdvanced">
                                <option v-for="option in options"
                                        v-bind:value="option"
                                        v-bind:selected="option == submitForm.ClientPlatform">
                                    {{ option }}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">渠道名称</label>
                        <div class="col-md-10">
                            <input type="text" name="AreaName" class="form-control input-medium" placeholder="请输入渠道名称" v-model="submitForm.AreaName" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2">公告开关</label>
                        <div class="col-md-10">
                            <input type="checkbox" id="AnnMsgShow" name="AnnMsgShow" v-model="submitForm.AnnMsgShow" v-bind:value="submitForm.AnnMsgShow">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2 xing">备注</label>
                        <div class="col-md-10">
                            <input type="text" id="Memo" name="Memo" class="form-control input-medium" v-model="submitForm.Memo" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-body">
                        <div class="form-group">
                            <label class="control-label col-md-2 xing">平台游戏排列顺序</label>
                            <div class="col-md-3">
                                <div class="gameSortList_contain">
                                    <ul id="sortable" class="gameitem_contain__sortable">
                                        <li v-if="no.Status == 1" style="background-repeat:round" class="ui-state-default" v-for="(no , index) in gamelist" v-bind:id="no.GameID" v-bind:value="no.Sort">
                                            <span>{{no.GameName}}</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-7">

                                <div class="gameitem_contain__newGame">

                                    <div style="display:inline-block;">
                                    </div>

                                    <div style="display:inline-block;">
                                        <input id="IsGameCategoryFilterVisible" type="checkbox" v-model="submitForm.IsGameCategoryFilterVisible" />
                                        <label for="IsGameCategoryFilterVisible">前台显示游戏分类筛选</label>
                                    </div>
                                </div>

                                <div class="gameitem_contain__newGame">

                                    <div class="gameitem_contain__iconItem option_newgame">
                                        <div class="nowrap">可新增游戏: </div>
                                        <select class="form-control">
                                            <option v-for="option in newGameJson"
                                                    v-bind:value="option.Id"
                                                    v-bind:data-gameID="option.Id">
                                                {{ option.Name }}
                                            </option>
                                        </select>
                                    </div>
                                    <input type="button" value="新增游戏" v-on:click="addNewGame" class="btn btn-light" />
                                </div>

                                <div v-for="(no , index) in gamelist" class="iconList gameitem_contain__iconItem">
                                    <div class="gameitem_contain__iconItem option_popular">
                                        <span class="nowrap">热门程度: </span>
                                        <select class="form-control" name="Popular" id="Popular">
                                            <option v-for="option in popularJson"
                                                    v-bind:value="option.Id"
                                                    v-bind:data-gameID="no.GameID"
                                                    v-bind:selected="option.Id == no.Popular">
                                                {{ option.Name }}
                                            </option>
                                        </select>
                                    </div>
                                    <div class="gameitem_contain__iconItem option_game">
                                        游戏名称:
                                        <select class="form-control" name="Game" id="Game" v-bind:disabled="!isAddArea">
                                            <option v-for="option in gameJson"
                                                    v-bind:value="option.Id"
                                                    v-bind:data-gameID="no.GameID"
                                                    v-bind:selected="option.Id == no.GameID">
                                                {{ option.Name }}
                                            </option>
                                        </select>
                                    </div>
                                    <div class="gameitem_contain__iconItem option_aliasName">
                                        显示名称:
                                        <select class="form-control input-small">
                                            <option v-for="option in getIconList(no.GameID)"
                                                    v-bind:value="option.IconID"
                                                    v-bind:data-gameID="no.GameID"
                                                    v-bind:selected="option.IconID == no.IconID">
                                                {{ option.AliasName }}
                                            </option>
                                        </select>
                                    </div>
                                    <div class="gameitem_contain__iconItem option_status">
                                        是否显示:
                                        <select class="form-control" name="Status" id="Status" v-bind:value="no.Status">
                                            <option v-bind:data-gameID="no.GameID" value="0">关闭</option>
                                            <option v-bind:data-gameID="no.GameID" value="1">开启</option>
                                        </select>
                                    </div>
                                    <input type="button" value="删除游戏" v-on:click="delGame(no)" class="btn btn-light" />
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 支付图像切换:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShopNameID" id="ShopNameID" v-bind:value="submitForm.ShopNameID">
                                <option value="1">商城</option>
                                <option value="2">支付</option>
                                <option value="3">充值</option>
                                <option value="4">商城充值</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 代理支付图像切换:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="AgentNameID" id="AgentNameID" v-bind:value="submitForm.AgentNameID">
                                <option value="1">代理支付</option>
                                <option value="2">VIP</option>
                            </select>
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="control-label col-md-2 xing">常见问题解答</label>
                        <div class="col-md-10">
                            <textarea rows="20" id="FAQContent" name="FAQContent" ref="FAQContent" class="form-control input-xxlarge" placeholder="请输入常见问题解答" v-model="FAQContent"> </textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">充值提示</label>
                        <div class="col-md-10">
                            <textarea rows="3" id="PayTip" name="PayTip" ref="PayTip" class="form-control input-xlarge" placeholder="请输入充值提示文本" v-model="PayTips"></textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2 xing">升级提示</label>
                        <div class="col-md-10">
                            <input type="text" id="UpGradeMsg" name="UpGradeMsg" class="form-control input-medium" placeholder="请输入升级提示" v-model="submitForm.UpGradeMsg" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">公告讯息</label>
                        <div class="col-md-10">
                            <input type="text" id="AnnMsg" name="AnnMsg" class="form-control input-medium" placeholder="请输入公告讯息" v-model="submitForm.AnnMsg" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">绑定帐号赠送金币</label>
                        <div class="col-md-10">
                            <input type="text" id="GiftMoney" name="GiftMoney" class="form-control input-medium" placeholder="请输入绑定帐号赠送金币" v-model="submitForm.GiftMoney" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">绑定赠送金币流水限制</label>
                        <div class="col-md-10">
                            <input type="text" id="GiftMoneyFlowLimit" name="GiftMoneyFlowLimit" class="form-control input-medium" placeholder="请输入绑定赠送金币流水限制" v-model="submitForm.GiftMoneyFlowLimit" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">注册预设金币</label>
                        <div class="col-md-10">
                            <input type="text" id="DefaultMoney" name="DefaultMoney" class="form-control input-medium" placeholder="请输入注册预设金币" v-model="submitForm.DefaultMoney" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">注册赠送金币流水限制</label>
                        <div class="col-md-10">
                            <input type="text" id="DefaultMoneyFlowLimit" name="DefaultMoneyFlowLimit" class="form-control input-medium" placeholder="请输入注册赠送金币流水限制" v-model="submitForm.DefaultMoneyFlowLimit" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>

                    <div v-if="isAddArea" class="form-group areaConfig_label">
                        <span>-------------------------- 以下未填写将自动填入 全平台预设 -----------------------------</span>
                    </div>
                    <div class="form-group" v-for="(item , index) in areaJsonSetting">
                        <label class="control-label col-md-2">{{item.name}}</label>
                        <div class="col-md-10">
                            <input v-if="item.input == 'text'" type="text" v-bind:id="item.key" class="form-control input-medium" v-bind:placeholder="item.placeholder" v-model="submitForm.AreaConfig.systemConfig[item.model][item.key]" v-bind:readonly="!isAdvanced" />
                            <input v-if="item.input == 'number'" type="number" v-bind:id="item.key" class="form-control input-medium" v-model="submitForm.AreaConfig.systemConfig[item.model][item.key]" min="0" max="2147483647" v-bind:readonly="!isAdvanced" />
                            <select v-if="item.input == 'select'" class="form-control input-small" v-model="submitForm.AreaConfig.systemConfig[item.model][item.key]" v-bind:disabled="!isAdvanced">
                                <option v-for="option in item.options"
                                        v-bind:value="option.value"
                                        v-bind:selected="option.value == submitForm.AreaConfig.systemConfig[item.model][item.key]">
                                    {{ option.name }}
                                </option>
                            </select>
                            <div v-if="item.input == 'checkboxlist'" class="checkbox-list">
                                <label class="checkbox-inline" v-for="data in item.list">
                                    <input type="checkbox" v-bind:id="data.key" v-model="submitForm.AreaConfig.systemConfig.payConfig[data.key]" v-bind:value="data.key" v-bind:disabled="!isAdvanced"> {{data.name}}
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 兑换未达成强制显示:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShowConvertPopup" id="ShowConvertPopup" v-model="submitForm.ShowConvertPopup">
                                <option value="0">关闭</option>
                                <option value="1">开启</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 兑换禁止提示文本:</label>
                        <div class="col-md-10">
                            <textarea rows="3" id="ConvertPopupText" name="ConvertPopupText" ref="ConvertPopupText" class="form-control input-xlarge" placeholder="请输入兑换禁止提示文本" v-model="submitForm.ConvertPopupText"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 绑定手机显示兑换:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShowConvertBindPhone" id="ShowConvertBindPhone" v-model="submitForm.ShowConvertBindPhone">
                                <option value="0">关闭</option>
                                <option value="1">开启</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 绑定手机显示所有游戏:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShowAllGameBindPhone" id="ShowAllGameBindPhone" v-model="submitForm.ShowAllGameBindPhone">
                                <option value="0">关闭</option>
                                <option value="1">开启</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 绑定手机显示VIP代理充值:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShowVIPAgentBindPhone" id="ShowVIPAgentBindPhone" v-model="submitForm.ShowVIPAgentBindPhone">
                                <option value="0">关闭</option>
                                <option value="1">开启</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing"> 绑定手机显示客服:</label>
                        <div class="col-md-2">
                            <select class="form-control" name="ShowCSBindPhone" id="ShowCSBindPhone" v-model="submitForm.ShowCSBindPhone">
                                <option value="0">关闭</option>
                                <option value="1">开启</option>
                            </select>
                        </div>
                    </div>



                    <div class="form-group">
                        <label class="control-label col-md-2 xing">到达金额显示兑换</label>
                        <div class="col-md-10">
                            <input type="text" id="ShowConvertLimit" name="ShowConvertLimit" class="form-control input-medium" placeholder="请输入到达金额显示兑换" v-model="submitForm.ShowConvertLimit" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2 xing">到达金额显示VIP代理充值</label>
                        <div class="col-md-10">
                            <input type="text" id="ShowVIPAgent" name="ShowVIPAgent" class="form-control input-medium" placeholder="VIP额度" v-model="submitForm.ShowVIPAgent" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2 xing">到达金额显示客服</label>
                        <div class="col-md-10">
                            <input type="text" id="ShowCS" name="ShowCS" class="form-control input-medium" placeholder="輸入额度" v-model="submitForm.ShowCS" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="control-label col-md-2 xing">到达金额显示所有游戏</label>
                        <div class="col-md-10">
                            <input type="text" id="ShowAllGameLimit" name="ShowAllGameLimit" class="form-control input-medium" placeholder="请输入到达金额显示所有游戏" v-model="submitForm.ShowAllGameLimit" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="control-label col-md-2 xing">游玩多少时间显示客服</label>
                        <div class="col-md-10">
                            <input type="text" id="PlaytimeCS" name="PlaytimeCS" class="form-control input-medium" placeholder="輸入分钟数" v-model="submitForm.PlaytimeCS" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">游玩多少时间显示兑换</label>
                        <div class="col-md-10">
                            <input type="text" id="PlaytimeConvert" name="PlaytimeConvert" class="form-control input-medium" placeholder="輸入分钟数" v-model="submitForm.PlaytimeConvert" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-2 xing">游玩多少时间显示VIP代理充值</label>
                        <div class="col-md-10">
                            <input type="text" id="PlaytimeVIPAgent" name="PlaytimeVIPAgent" class="form-control input-medium" placeholder="輸入分钟数" v-model="submitForm.PlaytimeVIPAgent" v-bind:readonly="!isAdvanced" />
                        </div>
                    </div>

                </form>
            </div>
            <!-- END FORM-->
            <!-- 廣告設定-->
            <div id="AdForm" class="tab-pane fade">
                <button type="button" class="btn btn-light" data-toggle="modal" data-target="#advertisement-modal" v-on:click="openADNew">新增</button>
                <div class="row liDiv">
                    <div class="col-md-12">
                        <table class="table table-bordered table-striped table-hover" id="AD_table"></table>
                    </div>
                </div>
            </div>
            <!-- END FORM-->
        </div>
        <div v-show="isAddArea" class="areaConfig_gameItem__contain">
            <form id="form3" ref="form3" method="post" class="form-horizontal form-bordered">
                <div class="form-group">
                    <label class="control-label col-md-2">平台号</label>
                    <div class="col-md-10">
                        <input type="text" name="PlatformID" class="form-control input-medium" v-model="platform.PlatformID" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-2">平台名称</label>
