@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using FW.Core.Helper

@model game.Entity.Game.WinAnnConfig
@{
    var existGameIds = SiteHelper.GetAPIResult<List<game.Entity.Game.WinAnnConfig>>("/Game/GetWinAnnConfig").Select(m => m.Id.ToString());
}

<div class="row">
    <div class="col-md-8 col-md-offset-2">        
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>新增游戏通知配置
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="form1" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">游戏ID</label>
                            <div class="col-md-8">                                
                                @Html.DropDownList("Id", DataService.Game(string.Empty, true).Where(m => !existGameIds.Contains(m.Value)), new { @class = "form-control input-medium" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">自动通知金额上限</label>
                            <div class="col-md-8">
                                <input type="text" name="UpperLimit" class="form-control input-medium" placeholder="请输入自动通知金额上限" />
                            </div>
                        </div>                                                                                                
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-4 col-md-8">
                            @Html.OkWithRight()
                            @Html.Back(Url.Action("List"))

                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>
@section initScripts{
    <script>
        $(function() {
            $("#form1").validate({
                rules: {
                    Id: {
                        required: true,
                        digits: true
                    },
                    UpperLimit: {
                        required: true,
                        digits: true
                    },                    
                }
            });
        })
    </script>
}