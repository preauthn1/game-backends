@using game.Entity.Game
@using FW.Core.Helper.Enum;

@model  List<HallVersionInfo>

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>版本管理
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="HallVersionForm" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">
                        <table class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>渠道编号</th>
                                    <th>大厅样版</th>
                                    <th>安卓临时版本号</th>
                                    <th>安卓真实版本号</th>
                                    <th>iOS 临时版本号</th>
                                    <th>iOS 真实版本号</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    foreach (var item in Model)
                                    {
                                        <tr class="tr-ta">
                                            @if (item.HallSkinID == HallSkinEnum.Default)
                                            {
                                                <td rowspan="@ViewBag.Rowspan">@Html.Label(item.PlatformName)</td>
                                            }

                                            <td>
                                                <input type="hidden" id="Skin" name="Skin" value="@((int)item.HallSkinID)" />
                                                <input type="hidden" id="PlatformID" name="PlatformID" value="@item.PlatformID" />
                                                @item.HallSkinName
                                            </td>
                                            <td>
                                                @Html.TextBox("AndroidVersion", string.IsNullOrEmpty(item.AndroidVersion)?"1.0.0":item.AndroidVersion.Trim(), new
                                                {
                                                    placeholder = "请输入安卓临时版本号",
                                                    data_platformid = item.PlatformID,
                                                    data_platformname = item.PlatformName,
                                                    data_skin = item.HallSkinName,
                                                    id = "_AndroidVersion",
                                                    @class = "form-control input-small"
                                                })
                                            </td>
                                            <td>
                                                @Html.TextBox("AndroidVersion2", string.IsNullOrEmpty(item.AndroidVersion2)?"1.0.0":item.AndroidVersion2.Trim(), new
                                                {
                                                    placeholder = "请输入安卓真实版本号",
                                                    data_platformid = item.PlatformID,
                                                    data_platformname = item.PlatformName,
                                                    data_skin = item.HallSkinName,
                                                    id = "_AndroidVersion2",
                                                    @class = "form-control input-small",
                                                    style = "background-color:yellow;"
                                                })
                                            </td>
                                            <td>
                                                @Html.TextBox("IOSVersion", string.IsNullOrEmpty(item.IOSVersion)?"1.0.0":item.IOSVersion.Trim(), new
                                                {
                                                    placeholder = "请输入iOS临时版本号",
                                                    data_platformid = item.PlatformID,
                                                    data_platformname = item.PlatformName,
                                                    data_skin = item.HallSkinName,
                                                    id = "_IOSVersion",
                                                    @class = "form-control input-small"
                                                })
                                            </td>
                                            <td>
                                                @Html.TextBox("IOSVersion2", string.IsNullOrEmpty(item.IOSVersion2)?"1.0.0":item.IOSVersion2.Trim(), new
                                                {
                                                    placeholder = "请输入iOS真实版本号",
                                                    data_platformid = item.PlatformID,
                                                    data_platformname = item.PlatformName,
                                                    data_skin = item.HallSkinName,
                                                    id = "_IOSVersion2",
                                                    @class = "form-control input-small",
                                                    style = "background-color:yellow;"
                                                })
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-6 col-md-9">
                            @Html.OkWithRight()
                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            $('#HallVersionForm').submit(() => {
                let errorMsg = '';
                $('[name=AndroidVersion]').each((i, e) => {
                    if (!verification($(e).val())) {
                        $(e).focus();
                        errorMsg = `安卓临时版本号内容错误(${$(e).data('platformname')} - ${$(e).data('skin')})`
                        return false;
                    }
                });

                $('[name=AndroidVersion2]').each(function (i, e) {
                    if (!verification($(e).val())) {
                        $(e).focus();
                        errorMsg = `安卓真实版本号内容错误(${$(e).data('platformname')} - ${$(e).data('skin')})`
                        return false;
                    }
                });

                $('[name=IOSVersion]').each(function (i, e) {
                    if (!verification($(e).val())) {
                        $(e).focus();
                        errorMsg = `iOS 临时版本号内容错误(${$(e).data('platformname')} - ${$(e).data('skin')})`
                        return false;
                    }
                })


                $('[name=IOSVersion2]').each(function (i, e) {
                    if (!verification($(e).val())) {
                        $(e).focus();
                        errorMsg = `iOS 真实版本号内容错误(${$(e).data('platformname')} - ${$(e).data('skin')})`
                        return false;
                    }
                })

                if (errorMsg) {
                    alert(errorMsg)
                    return false;
                }
            });
            function verification(str) {
                return /^[0-9]+\.?[0-9]+\.?[0-9]+\.?[0-9]*$/.test(str)
            }
        })
    </script>
}
