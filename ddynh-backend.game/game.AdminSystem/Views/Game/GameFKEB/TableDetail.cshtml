@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
}

<style>
    .info td > span {
        color: red;
    }

    .table > thead > tr > th {
        vertical-align: middle;
    }

    .color-red {
        color: red;
    }

    .popover {
        max-width: 600px;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }
</style>

<div id="vApp">
    <div class="row">


        <div class="super_back_btn_row">
            @Html.Back(Url.Action("TableList", new { serverID = ViewBag.ServerID }))
        </div>

        <div class="col-md-12">
            <div style="margin-top:20px; text-align:center;">
                <a class="btn btn-sm dark" v-on:click="showEditPool()" data-toggle="modal" data-target="#editPool">编辑水池</a>
                @*<a class="btn btn-sm dark" v-on:click="showEditWaterRate()" data-toggle="modal" data-target="#editWaterRate">编辑注水率</a>*@
                <a class="btn btn-sm dark" data-toggle="modal" data-target="#setWinPrize">指定开奖</a>
            </div>
            <div class="portlet box grey" style="margin-top:20px;">

                <div class="portlet-title">
                    <div class="caption">游戏信息</div>
                </div>
                <div class="portlet-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="info" style="width:100%;">
                                <tr>
                                    <td style="width:20%;">当前游戏状态：<span>{{tableStatus[tableDetail.Status]}}</span></td>
                                    <td style="width:20%;">总收益：<span>{{ToCash(tableDetail.SumEarnAmount)}}</span></td>
                                    <td style="width:20%;">上局收益：<span>{{ToCash(tableDetail.LastEarnAmount)}}</span></td>
                                    <td style="width:20%;">开奖结果：<span>{{tableDetail.Status==3?tableDetail.CurentOpenResult:''}}</span></td>
                                    <td style="width:20%;">开奖收益：<span>{{tableDetail.Status==3?ToCash(tableDetail.CurentOpenResultEarn):'0.00'}}</span></td>
                                </tr>
                                <tr>
                                    <td>当前水池金额：<span>{{ToCash(tableDetail.PoolCurrentAmount)}}</span></td>
                                    <td>水池注水率：<span>{{tableDetail.PopWaterRate}}%</span></td>
                                    <td>当前游戏总人数：<span>{{tableDetail.GameUserCount+tableDetail.RobotCount}}</span></td>
                                    <td>当前玩家人数：<span>{{tableDetail.GameUserCount}}</span></td>
                                    <td>当前机器人人数：<span>{{tableDetail.RobotCount}}</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">最新下注情况</div>
                </div>
                <div class="portlet-body">
                    <table class="table table-hover" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th style="width:12%;">&nbsp;</th>
                                <th style="width:11%;">顺</th>
                                <th style="width:11%;">天</th>
                                <th style="width:11%;">地</th>
                                <th style="width:11%;">顺天地</th>
                                <th style="width:11%;">顺天</th>
                                <th style="width:11%;">顺地</th>
                                <th style="width:11%;">天地</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>玩家</td>
                                <td class="color-red">{{ToCash(sum.UserShun)}}</td>
                                <td class="color-red">{{ToCash(sum.UserTian)}}</td>
                                <td class="color-red">{{ToCash(sum.UserDi)}}</td>
                                <td class="color-red">{{ToCash(sum.UserShunTianDi)}}</td>
                                <td class="color-red">{{ToCash(sum.UserShunTian)}}</td>
                                <td class="color-red">{{ToCash(sum.UserShunDi)}}</td>
                                <td class="color-red">{{ToCash(sum.UserTianDi)}}</td>
                            </tr>
                            <tr>
                                <td>机器人</td>
                                <td class="color-red">{{ToCash(sum.RobotShun)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotTian)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotDi)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotShunTianDi)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotShunTian)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotShunDi)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotTianDi)}}</td>
                            </tr>
                            <tr>
                                <td>总计</td>
                                <td class="color-red">{{ToCash(sum.TotalShun)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalTian)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalDi)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalShunTianDi)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalShunTian)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalShunDi)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalTianDi)}}</td>
                            </tr>
                            <tr>
                                <td>开奖收益</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultShun)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultTian)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultDi)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultShunTaiDi)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultShunTai)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultShunDi)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultTianDi)}}</td>
                            </tr>
                            <tr>
                                <td>开奖[庄]收益</td>
                                <td colspan="7" class="color-red">{{ToCash(tableDetail.OpenResultZhuang)}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">庄家信息</div>
                </div>
                <div class="portlet-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="info" style="width:100%;">
                                <tr>
                                    <td style="width:16%;">庄家类型：<span>{{bankerType[tableDetail.ZhuangType]}}</span></td>
                                    <td style="width:17%;">
                                        庄家昵称：
                                        <span v-if="tableDetail.ZhuangType==0">{{tableDetail.ZhuangNickName}}</span>
                                        <a v-else v-on:mouseenter="showUserDetailInfo($event,tableDetail.ZhuangUserID)" v-on:mouseleave="hideUserDetailInfo()" target="_blank" :href="'/UserInfo/Search?userID=' + tableDetail.ZhuangUserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{tableDetail.ZhuangNickName}}</a>
                                    </td>
                                    <td style="width:16%;">庄家ID：<span>{{tableDetail.ZhuangUserID}}</span></td>
                                    <td style="width:17%;">初始上庄金币：<span>{{ToCash(tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                    <td style="width:17%;">当前剩余金币：<span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount)}}</span></td>
                                    <td style="width:17%;">金币变化量：<span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount-tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">玩家信息</div>
                </div>
                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th rowspan="3" style="width: 5%;">玩家类型</th>
                                <th rowspan="3" style="width: 5%;">昵称</th>
                                <th rowspan="3" style="width: 5%;">ID</th>
                                <th rowspan="3" style="width: 7%;">初始金币</th>
                                <th rowspan="3" style="width: 7%;">当前金币</th>
                                <th rowspan="3" style="width: 7%;">游戏总输赢</th>
                                <th rowspan="3" style="width: 7%;">总充值</th>
                                <th rowspan="3" style="width: 7%;">总兑换</th>
                                <th rowspan="3" style="width: 7%;">总输赢</th>
                                <th colspan="1" style="border-right-color: white;">指定开奖 <span style="color:red;">{{tableDetail.BetTime}}</span></th>
                                <th colspan="10">
                                    <label>
                                        <input type="radio" name="WinPrize" value="0" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 庄
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="1" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 顺
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="2" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 天
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="3" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 地
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="5" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 顺天
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="6" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 顺地
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="7" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 天地
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="4" v-on:change="confirmSetWinPrize()" v-model="setWinPrizeInfo.WinPrize" /> 顺天地
                                    </label>
                                </th>
                            </tr>
                            <tr>
                                <th colspan="11"> 当前下注 </th>
                            </tr>
                            <tr>
                                <th style="width:10%;">顺</th>
                                <th style="width:10%;">天</th>
                                <th style="width:10%;">地</th>
                                <th style="width:10%;">总</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="user in tableDetail.UserInfo">
                                <td>{{userType[user.UserType]}}</td>
                                <td>{{user.NickName}}</td>
                                <td><a v-on:mouseenter="showUserDetailInfo($event,user.UserID)" v-on:mouseleave="hideUserDetailInfo()" target="_blank" :href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'" :style="vipUser.indexOf(user.UserID)>-1?'color:red;':''">{{user.UserID}}</a></td>
                                <td>{{ToCash(user.InitMoney)}}</td>
                                <td>{{ToCash(user.CurrentMoney)}}</td>
                                <td class="color-red">{{ToCash(user.GameScore)}}</td>
                                <td class="color-red">{{ToCash(user.SumCharge)}}</td>
                                <td class="color-red">{{ToCash(user.SumConvert)}}</td>
                                <td>
                                    <div>
                                        <span class="update_Red" v-if="((user.SumCharge - user.SumConvert - user.CurrentMoney) *-1) < 0">{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)*-1)}}</span>
                                        <span class="update_Green" v-else>{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)*-1)}}</span>
                                    </div>
                                </td>
                                <td class="color-red">{{ToCash(user.BetInfoShun)}}</td>
                                <td class="color-red">{{ToCash(user.BetInfoTian)}}</td>
                                <td class="color-red">{{ToCash(user.BetInfoDi)}}</td>
                                <td class="color-red">{{ToCash(user.BetInfoShun+user.BetInfoTian+user.BetInfoDi)}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
    <!--指定开奖-->
    <div class="modal fade" id="setWinPrize" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">指定开奖</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-6 control-label">编辑桌号：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableNO}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">当前状态：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableStatus[tableDetail.Status]}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">请指定本局开奖类型：</label>
                            <div class="col-md-6">
                                <div class="radio-list">
                                    <label>
                                        <input type="radio" name="WinPrize" value="0" v-model="setWinPrizeInfo.WinPrize" /> 庄<span style="color:red;">{{ToCash(tableDetail.OpenResultZhuang)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="1" v-model="setWinPrizeInfo.WinPrize" /> 顺<span style="color:red;">{{ToCash(tableDetail.OpenResultShun)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="2" v-model="setWinPrizeInfo.WinPrize" /> 天<span style="color:red;">{{ToCash(tableDetail.OpenResultTian)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="3" v-model="setWinPrizeInfo.WinPrize" /> 地<span style="color:red;">{{ToCash(tableDetail.OpenResultDi)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="5" v-model="setWinPrizeInfo.WinPrize" /> 顺天<span style="color:red;">{{ToCash(tableDetail.OpenResultShunTai)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="6" v-model="setWinPrizeInfo.WinPrize" /> 顺地<span style="color:red;">{{ToCash(tableDetail.OpenResultShunDi)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="7" v-model="setWinPrizeInfo.WinPrize" /> 天地<span style="color:red;">{{ToCash(tableDetail.OpenResultTianDi)}}</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="WinPrize" value="4" v-model="setWinPrizeInfo.WinPrize" /> 顺天地<span style="color:red;">{{ToCash(tableDetail.OpenResultShunTaiDi)}}</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">返回</button>
                    <button type="button" class="btn btn-primary" v-on:click="confirmSetWinPrize()">确定</button>
                </div>
            </div>
        </div>
    </div>
    <!--编辑水池-->
    <div class="modal fade" id="editPool" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">编辑水池</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-6 control-label">编辑桌号：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableNO}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">当前房间水池金额：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{ToCash(tableDetail.PoolCurrentAmount)}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">选择修改桌号：</label>
                            <div class="col-md-6">
                                <select class="form-control input-small" v-model="editPoolInfo.EditTableNo">
                                    <option :value="tableNO">当前</option>
                                    <option value="-1">全部</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">修改金额：</label>
                            <div class="col-md-6">
                                <input type="text" class="form-control input-small" placeholder="请输入修改金额" value="" v-model="editPoolInfo.EditPoolCurrentAmount" />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">返回</button>
                    <button type="button" class="btn btn-primary" v-on:click="confirmEditPool()">确定</button>
                </div>
            </div>
        </div>
    </div>
    <!--编辑注水率-->
    <div class="modal fade" id="editWaterRate" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">编辑注水率</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-6 control-label">编辑桌号：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableNO}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">当前房间注水率：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableDetail.PopWaterRate}}%</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">选择修改桌号：</label>
                            <div class="col-md-6">
                                <select class="form-control input-small" v-model="editWaterRateInfo.EditTableNo">
                                    <!-- <option :value="tableNO">当前</option> -->
                                    <option value="-1">全部</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">修改注水率：</label>
                            <div class="col-md-6">
                                <input type="range" class="form-control input-small" max="100" min="0" step="1" v-model="editWaterRateInfo.EditPopWaterRate" style="padding:0;" />
                                <span>{{editWaterRateInfo.EditPopWaterRate}}%</span>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">返回</button>
                    <button type="button" class="btn btn-primary" v-on:click="confirmEditWaterRate()">确定</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#vApp',
            data: {
                serverID: '@ViewBag.ServerID',
                tableNO: '@ViewBag.TableNO',
                tableStatus: ['下注中', '开奖中', '开奖动画', '结算动画', '等待开始游戏'],
                bankerType: ['系统', '机器人上庄', '玩家上庄'],
                prizeType: ['庄', '顺', '天', '地', '顺天地', '顺天', '顺地', '天地'],
                userType: ['机器人', '玩家'],
                tableDetail: {},
                sum: {},
                vipUser: [],
                setWinPrizeInfo: {},
                editPoolInfo: {},
                editWaterRateInfo: {},
                mouseEnterElement: false,
                mouseEnterUserId: 0
            },
            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getTableDetail: function () {
                    $.get('/GameFKEB/GetTableDetail', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, '_r': Math.random() }, function (data) {
                        if (data instanceof Object) {
                            if (data.TableDetail.UserInfo.length < 1) {
                                $('body>.popover').remove();
                            }
                            data.TableDetail.UserInfo = new ArrayEx(data.TableDetail.UserInfo);
                            data.TableDetail.UserInfo.Sort('UserType', false);
                            data.TableDetail.UserInfo = data.TableDetail.UserInfo.ToList(function (e) { return e; });
                            vApp.tableDetail = data.TableDetail;
                            vApp.sum = data.Sum;
                            vApp.vipUser = data.VIPUser;
                        }
                        else {
                            vApp.tableDetail = {};
                            vApp.sum = {};
                            vApp.vipUser = [];
                        }
                    });
                },
                showUserDetailInfo: function (event, userID) {
                    this.mouseEnterElement = true;
                    this.mouseEnterUserId = userID;
                    $('body>.popover').remove();
                    setTimeout(function () {
                        if (vApp.mouseEnterElement && vApp.mouseEnterUserId == userID) {
                            $.get('/GameManage/GetUserInfoById', { 'userID': userID, '_r': Math.random() }, function (data) {
                                var strHtml = '<table class="info" style="width:560px;">\
                                <tr>\
                                    <td><img style="height:64px;" src="/Content/HeadIcon/sprite_' + data.FaceID + '.png"></td>\
                                    <td>ID：<span>' + data.Id + '</span></td>\
                                    <td>账号：<span>' + data.LoginName + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>等级：<span>' + data.GradeID + '</span></td>\
                                    <td>注册时间：<span>' + data.CreateTime + '</span></td>\
                                    <td>最后登录时间：<span>' + data.LastLogonTime + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>累计登录次数：<span>' + data.SumLoginTimes + '</span></td>\
                                    <td>真实姓名：<span>' + data.RealName + '</span></td>\
                                    <td>支付宝账号：<span>' + data.AlipayAccount + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>渠道：<span>' + data.AreaName + '</span></td>\
                                    <td>平台：<span>' + data.PlatformName + '</span></td>\
                                    <td>总金额数：<span>' + ToCash(data.AllCoinAmount) + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>累计充值数：<span>' + ToCash(data.SumCharge) + '</span></td>\
                                    <td>累计税收数：<span>' + ToCash(data.SumTax) + '</span></td>\
                                    <td>累计兑换数：<span>' + ToCash(data.SumConvert) + '</span></td>\
                                </tr>\
                            </table>';
                                $(event.target).popover({ title: '玩家详细信息', container: 'body', placement: 'top', content: strHtml, html: true });
                                $(event.target).popover('show');
                            });
                        }
                    }, 750);
                },
                hideUserDetailInfo: function () {
                    this.mouseEnterElement = false;
                    $('body>.popover').remove();
                },
                showEditPool: function (table) {
                    this.editPoolInfo = { 'EditTableNo': this.tableNO };
                },
                showEditWaterRate: function (table) {
                    this.editWaterRateInfo = { 'EditTableNo': this.tableNO, 'EditPopWaterRate': this.tableDetail.PopWaterRate };
                },
                confirmSetWinPrize: function () {
                    if (this.setWinPrizeInfo.WinPrize) {
                        $.get('/GameFKEB/SetWinPrize', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, 'winPrize': vApp.setWinPrizeInfo.WinPrize, '_r': Math.random() }, function (msg) {
                            if (msg.result) {
                                alert('恭喜您，修改成功！');
                                $('#setWinPrize').modal('hide');

                                vApp.setWinPrizeInfo = {};
                                $('input[type="radio"][name="WinPrize"]').closest("span").removeClass('checked');
                            }
                            else {
                                alert('修改失败！');
                            }
                        });
                    }
                },
                confirmEditPool: function () {
                    if (this.editPoolInfo.EditPoolCurrentAmount) {
                        if (confirm('您正在将水池金额修改为　' + vApp.editPoolInfo.EditPoolCurrentAmount)) {
                            $.get('/GameFKEB/EditPool', { 'serverID': vApp.serverID, 'tableNo': vApp.editPoolInfo.EditTableNo, 'poolAmount': vApp.editPoolInfo.EditPoolCurrentAmount, '_r': Math.random() }, function (msg) {
                                if (msg.result) {
                                    alert('恭喜您，修改成功！');
                                    $('#editPool').modal('hide');
                                }
                                else {
                                    alert('修改失败！');
                                }
                            });
                        }
                    }
                },
                confirmEditWaterRate: function () {
                    if (this.editWaterRateInfo.EditPopWaterRate) {
                        if (confirm('您正在将水池注水率修改为　' + vApp.editWaterRateInfo.EditPopWaterRate + '%')) {
                            $.get('/GameFKEB/EditWaterRate', { 'serverID': vApp.serverID, 'tableNo': vApp.editWaterRateInfo.EditTableNo, 'popWaterRate': vApp.editWaterRateInfo.EditPopWaterRate, '_r': Math.random() }, function (msg) {
                                if (msg.result) {
                                    alert('恭喜您，修改成功！');
                                    $('#editWaterRate').modal('hide');
                                }
                                else {
                                    alert('修改失败！');
                                }
                            });
                        }
                    }
                }
            }
        });

        vApp.getTableDetail();
        setInterval(function () {
            vApp.getTableDetail();
        }, 1000);
    </script>
}