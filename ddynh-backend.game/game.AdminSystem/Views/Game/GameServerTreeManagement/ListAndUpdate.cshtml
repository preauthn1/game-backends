@using FW.Core.Helper.Enum
@using game.AdminSystem.Models.ViewModels


@model GameServerTreeManagementViewModel

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
}


@{
    int platformCount = Model.Platforms.Count();

    int width = 135;
    int maxWidth = 250 + width * platformCount;

    string query_gameID = Request.QueryString["GameID"];
}



<style>
    .lightlyColor td {
        color: #CCC;
    }

    .btn-grey, .btn-grey:hover {
        color: #DDD !important;
    }

    .form .btn {
        border-radius: 5px !important;
    }



    .js_collapse:hover {
        opacity: .8;
    }
</style>


<div class="row">




    <div style="">
        <div class="portlet-body form" style="padding:5px 35px !important;">

            <h4 style="font-weight:700 !important;margin-bottom:25px;">
                伺服器分配平台设置
            </h4>


            <div style="        position: fixed;
        right: 25px;
        bottom: 95px;
        font-size: 14px;
        cursor: pointer;
        z-index: 99999;
        font-weight: 700;
        padding: 5px;
        border: solid 1px #EEE;
        border-radius: 5px !important;" onclick="openAll()">
                <div>展開</div>
                <div>全部</div>
            </div>


            <div style="position:fixed;right:25px;bottom:40px;font-size:14px;cursor:pointer;z-index:99999;font-weight:700;color:#29329c;padding:5px;border:solid 1px #EEE;border-radius:5px !important;" onclick="closeAll()">
                <div>缩合</div>
                <div>全部</div>
            </div>


            @foreach (var eachGame in Model.GameItems)
            {
                <div id="GameID_@(eachGame.GameID)" class="js_collapse" style="border-bottom:solid 3px #EEE;padding:5px;cursor:pointer;margin-top:10px;" onclick="collapse_item('@eachGame.GameID')">


                    <div style="display: inline-block;min-width: 35px;font-size: 14px; font-weight: 700; color: #222">
                        @eachGame.GameID
                    </div>


                    <div style="display: inline-block;min-width: 100px;font-size: 14px;font-weight: 400;color: #888">
                        @eachGame.GameName
                    </div>

                </div>

                <div id="user@example.invalid" class=" hiddDiv  isClose" style="padding: 10px 25px;display:none;margin-bottom:20px;">

                    <table class="table table-hover" style="width:@(maxWidth)px;">
                        <thead>
                            <tr>
                                <th style="width:250px;">
                                    伺服器
                                </th>

                                @foreach (var item in Model.Platforms)
                                {
                                    <th style="text-align:center;width:@(width)px;">
                                        @item.Name
                                        <div style="font-size: 10px; color: #AAA; font-weight: 400;text-align:center;">
                                            @item.Id
                                        </div>
                                    </th>
                                }

                            </tr>
                        </thead>

                        @foreach (var eachServers in eachGame.Servers)
                        {
                            <tr>

                                <td>
                                    <div style="display:inline-block;color:#999;width:30px;">
                                        @eachServers.ServerID
                                    </div>

                                    <span title="@string.Format("最低入场金币 {0} " , eachServers.MinMoney)">
                                        @eachServers.ServerName
                                    </span>
                                </td>


                                @foreach (var item in Model.Platforms)
                                {
                                    string text = string.Format("{0} ({1})", item.Name, item.Id);

                                    bool isEnable = eachServers.AvailablePlatformIDs.Contains(item.Id);
                                    <td style="text-align:center;">

                                        @if (isEnable)
                                        {
                                            <button class="btn btn-sm btn-success" title="@text" onclick="changeStatus(this ,'@item.Id','@eachServers.ServerID')">已设置</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-grey" title="@text" onclick="changeStatus(this ,'@item.Id','@eachServers.ServerID')">关闭中</button>
                                        }
                                    </td>
                                }

                            </tr>
                        }

                    </table>

                </div>
            }



        </div>
    </div>

</div>


@section initScripts{



    @if (!string.IsNullOrWhiteSpace(query_gameID))
    {
        <script>
            $(function () {

                var elementID = "#GameID_" + '@query_gameID';

                $([document.documentElement, document.body]).animate({

                    scrollTop: $(elementID).offset().top - 150

                }, 500);

                collapse_item('@query_gameID');

            });

        </script>
    }


    <script>

        $(function () {


        });


        function changeStatus(target, platformID, serverID) {
            
            var model =
            {
                ServerID: serverID,
                PlatformID: platformID
            };

            $.ajax({
                cache: false,
                url: '/GameServerDetailManage/ReverseCurrentStatus',
                type: 'POST',
                contentType: "application/json",
                dataType: "json",
                data: JSON.stringify(model),
                success: function (data) {

                    var isEnable = data.ResultObject.afterStatus == 1;

                    if (isEnable) {
                        $(target).text('已设置');
                        $(target).addClass('btn-success');
                        $(target).removeClass('btn-grey');
                    }
                    else {
                        $(target).text('关闭中');
                        $(target).addClass('btn-grey');
                        $(target).removeClass('btn-success');
                    }

                },
                error: function (err) {
                    swal({
                        type: 'error',
                        title: '操作失败',
                        text: err
                    })
                }
            });
        }



        function openAll() {
            $(".hiddDiv.isClose").each(function () {
                $(this).show();
                $(this).removeClass("isClose");
            });
        }


        function closeAll() {
            $(".hiddDiv").each(function () {
                $(this).hide();
                $(this).addClass("isClose");
            });
        }


        function collapse_item(gameID) {
            var targetElementID = "#hidden_" + gameID;

            if ($(targetElementID).hasClass("isClose")) {
                $(targetElementID).show();
                $(targetElementID).removeClass("isClose");
            }
            else {
                $(targetElementID).hide();
                $(targetElementID).addClass("isClose");
            }
        }


        function collapse_item(gameID) {
            var targetElementID = "#hidden_" + gameID;

            if ($(targetElementID).hasClass("isClose")) {
                $(targetElementID).show();
                $(targetElementID).removeClass("isClose");
            }
            else {
                $(targetElementID).hide();
                $(targetElementID).addClass("isClose");
            }
        }


    </script>
}