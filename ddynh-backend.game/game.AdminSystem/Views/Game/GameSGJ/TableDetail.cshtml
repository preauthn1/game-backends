@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#vApp',
            data: {
                serverID: '@ViewBag.ServerID',
                tableNO: '@ViewBag.TableNO',
                tableStatus: ['下注中', '开奖中', '结算动画', '等待开始游戏'],
                bankerType: ['系统', '机器人上庄', '玩家上庄'],
                prizeType: ['', '华为 x10', '华为 x3', '腾讯 x30', '腾讯 x3', '阿里 x100', '网易 x5', '360 x10', '360 x3', '京东 x10', '京东 x3', '崩盘黑', '', '', '网易 x3', '百度 x40', '百度 x3', '阿里 x50', '', '小米 x20', '小米 x3'],
                userType: ['机器人', '玩家'],
                tableDetail: {},
                sum: {},
                vipUser: [],
                setWinPrizeInfo: {},
                editPoolInfo: {},
                editWaterRateInfo: {},
                mouseEnterElement: false,
                mouseEnterUserId: 0,
                black: { addBlackUserID: '', blackList: [], deleteList: [] },
                white: { addWhiteUserID: '', whiteList: [], deleteList: [] },
                filterTag: true,
                gameID: '@ViewBag.GameID',
                showName: '@ViewBag.ShowName'
            },
            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getTableDetail: function () {
                    $.get('/GameSGJ/GetTableDetail', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, 'filterTag': vApp.filterTag, '_r': Math.random() }, function (data) {
                        if (data instanceof Object) {
                            if (data.TableDetail.UserInfo.length < 1) {
                                $('body>.popover').remove();
                            }
                            data.TableDetail.UserInfo = new ArrayEx(data.UserInfo);
                            data.TableDetail.UserInfo.Sort('UserType', false);
                            data.TableDetail.UserInfo = data.TableDetail.UserInfo.ToList(function (e) { return e; });
                            vApp.tableDetail = data.TableDetail;
                            vApp.sum = data.Sum;
                            vApp.vipUser = data.VIPUser;

                            if (vApp.tableDetail.BetTime <= 0) {
                                $("#WinPrizeMsg").text("");
                                vApp.setWinPrizeInfo = {};
                                $('input[type="radio"][name="WinPrize"]').closest("span").removeClass('checked');
                            }
                        }
                        else {
                            vApp.tableDetail = {};
                            vApp.sum = {};
                            vApp.vipUser = [];
                        }
                    });
                },
                showUserDetailInfo: function (event, userID) {
                    this.mouseEnterElement = true;
                    this.mouseEnterUserId = userID;
                    $('body>.popover').remove();
                    setTimeout(function () {
                        if (vApp.mouseEnterElement && vApp.mouseEnterUserId == userID) {
                            $.get('/GameManage/GetUserInfoById', { 'userID': userID, '_r': Math.random() }, function (data) {
                                var strHtml = '<table class="info" style="width:560px;">\
                                <tr>\
                                    <td><img style="height:64px;" src="/Content/HeadIcon/sprite_' + data.FaceID + '.png"></td>\
                                    <td>ID：<span>' + data.Id + '</span></td>\
                                    <td>账号：<span>' + data.LoginName + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>等级：<span>' + data.GradeID + '</span></td>\
                                    <td>注册时间：<span>' + data.CreateTime + '</span></td>\
                                    <td>最后登录时间：<span>' + data.LastLogonTime + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>累计登录次数：<span>' + data.SumLoginTimes + '</span></td>\
                                    <td>真实姓名：<span>' + data.RealName + '</span></td>\
                                    <td>支付宝账号：<span>' + data.AlipayAccount + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>渠道：<span>' + data.AreaName + '</span></td>\
                                    <td>平台：<span>' + data.PlatformName + '</span></td>\
                                    <td>总金额数：<span>' + ToCash(data.AllCoinAmount) + '</span></td>\
                                </tr>\
                                <tr>\
                                    <td>累计充值数：<span>' + ToCash(data.SumCharge) + '</span></td>\
                                    <td>累计税收数：<span>' + ToCash(data.SumTax) + '</span></td>\
                                    <td>累计兑换数：<span>' + ToCash(data.SumConvert) + '</span></td>\
                                </tr>\
                            </table>';
                                $(event.target).popover({ title: '玩家详细信息', container: 'body', placement: 'top', content: strHtml, html: true });
                                $(event.target).popover('show');
                            });
                        }
                    }, 750);
                },
                hideUserDetailInfo: function () {
                    this.mouseEnterElement = false;
                    $('body>.popover').remove();
                },
                showSetPrize: function () {
                    this.setWinPrizeInfo.WinPrize = undefined;
                    $('label.active').removeClass('active');
                },
                showEditPool: function (table) {
                    this.editPoolInfo = { 'EditTableNo': this.tableNO };
                },
                showEditWaterRate: function (table) {
                    this.editWaterRateInfo = { 'EditTableNo': this.tableNO, 'EditPopWaterRate': this.tableDetail.PopWaterRate };
                },
                confirmSetWinPrize: function () {
                    if (this.setWinPrizeInfo.WinPrize) {
                            $.get('/GameSGJ/SetWinPrize', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, 'winPrize': vApp.setWinPrizeInfo.WinPrize, '_r': Math.random() }, function (msg) {
