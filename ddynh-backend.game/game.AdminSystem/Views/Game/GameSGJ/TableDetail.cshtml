@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .info td > span {
        color: red;
    }

    .table > thead > tr > th {
        vertical-align: middle;
    }

    .color-red {
        color: red;
    }

    .popover {
        max-width: 600px;
    }

    .btn-group-vertical > .btn-default {
        padding: 2px 10px;
        text-align: left;
    }

    #radioBtn .notActive {
        color: #3276b1;
        background-color: #fff;
    }

    .heightFixed {
        height: 450px;
        overflow: auto;
    }

    .search-group {
        display: flex;
        align-items: center;
        padding: 2%;
    }

        .search-group div {
            padding: 1%;
        }

    #WinPrizeLog_table_wrapper {
        max-height: 500px;
        overflow: auto;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }
</style>

<div id="vApp">
    <div class="row">


        <div class="super_back_btn_row">
            @Html.Back(Url.Action("TableList", new { serverID = ViewBag.ServerID }))
        </div>

        <div class="col-md-12">
            <div style="margin-top:20px; text-align:center;">
                <a class="btn btn-sm dark" v-on:click="getWhiteList()" data-toggle="modal" data-target="#whiteList">白名單</a>
                <a class="btn btn-sm dark" v-on:click="getBlackList()" data-toggle="modal" data-target="#blackList">黑名單</a>
                <a class="btn btn-sm dark" v-on:click="showEditPool()" data-toggle="modal" data-target="#editPool">编辑水池</a>
                <a class="btn btn-sm dark" v-on:click="showEditWaterRate()" data-toggle="modal" data-target="#editWaterRate">编辑注水率</a>
                @* <a class="btn btn-sm dark" v-on:click="showSetPrize()" data-toggle="modal" data-target="#setWinPrize">指定开奖</a>*@
                <a class="btn btn-sm dark" v-on:click="createWinPrizeLogTable()" data-toggle="modal" data-target="#showWinPrizeLog">指定开奖操作查询</a>
            </div>

            <div class="portlet box grey" style="margin-top:20px;">
                <div class="portlet-title">
                    <div class="caption">游戏信息</div>
                </div>
                <div class="portlet-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="info" style="width:100%;">
                                <tr>
                                    <td style="width:15%;">当前游戏状态：<span>{{tableStatus[tableDetail.Status]}}</span></td>

                                    <!-- #48 临时注解 http://0.0.0.0/redmine/issues/48
                                <td style="width:15%;">总收益：<span>{{ToCash(tableDetail.SumEarnAmount)}}</span></td>
                                <td style="width:15%;">上局收益：<span>{{ToCash(tableDetail.LastEarnAmount)}}</span></td>
                                -->
                                    <td style="width:15%;">  系統稅收：<span>{{ToCash(tableDetail.SysTaxIncome)}}</span></td>
                                    <td style="width:15%;">开奖结果：<span>{{tableDetail.Status==2?tableDetail.CurentOpenResult:''}}</span></td>
                                    <td style="width:25%;">开奖收益：<span>{{tableDetail.Status==2?ToCash(tableDetail.CurentOpenResultEarn):'0.00'}}</span></td>
                                    <td style="width:15%;">注水金额：<span>{{ToCash(tableDetail.ZhuShuiMoney)}}</span></td>
                                    <td>水池剩馀金额：<span>{{ToCash(tableDetail.PoolCurrentAmount)}}</span></td>
                                </tr>
                                <tr>

                                    <td>水池注水率：<span>{{tableDetail.PopWaterRate}}%</span></td>
                                    <td>当前游戏总人数：<span>{{tableDetail.GameUserCount+tableDetail.RobotCount}}</span></td>
                                    <td>当前玩家人数：<span>{{tableDetail.GameUserCount}}</span></td>
                                    <td>当前机器人人数：<span>{{tableDetail.RobotCount}}</span></td>
                                    <td></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">最新下注情况</div>
                </div>
                <div class="portlet-body">
                    <table class="table table-hover" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th style="width:12%;">&nbsp;</th>
                                <th style="width:11%;">网易</th>
                                <th style="width:11%;">华为</th>
                                <th style="width:11%;">京东</th>
                                <th style="width:11%;">360</th>
                                <th style="width:11%;">小米</th>
                                <th style="width:11%;">腾讯</th>
                                <th style="width:11%;">百度</th>
                                <th style="width:11%;">阿里</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>玩家</td>
                                <td class="color-red">{{ToCash(sum.UserApple)}}</td>
                                <td class="color-red">{{ToCash(sum.UserOrange)}}</td>
                                <td class="color-red">{{ToCash(sum.UserMango)}}</td>
                                <td class="color-red">{{ToCash(sum.UserBell)}}</td>
                                <td class="color-red">{{ToCash(sum.UserWatermelon)}}</td>
                                <td class="color-red">{{ToCash(sum.UserDobuleStar)}}</td>
                                <td class="color-red">{{ToCash(sum.User77)}}</td>
                                <td class="color-red">{{ToCash(sum.UserBar)}}</td>
                            </tr>
                            <tr>
                                <td>机器人</td>
                                <td class="color-red">{{ToCash(sum.RobotApple)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotOrange)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotMango)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotBell)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotWatermelon)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotDobuleStar)}}</td>
                                <td class="color-red">{{ToCash(sum.Robot77)}}</td>
                                <td class="color-red">{{ToCash(sum.RobotBar)}}</td>
                            </tr>
                            <tr>
                                <td>总计</td>
                                <td class="color-red">{{ToCash(sum.TotalApple)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalOrange)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalMango)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalBell)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalWatermelon)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalDobuleStar)}}</td>
                                <td class="color-red">{{ToCash(sum.Total77)}}</td>
                                <td class="color-red">{{ToCash(sum.TotalBar)}}</td>
                            </tr>
                            <tr>
                                <td>开奖[大]收益</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultApple)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultOrange)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultMango)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultBell)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultWatermelon)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultDobuleStar)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResult77)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultBar)}}</td>
                            </tr>
                            <tr>
                                <td>开奖[小]收益</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultAppleMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultOrangeMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultMangoMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultBellMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultWatermelonMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultDobuleStarMin)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResult77Min)}}</td>
                                <td class="color-red">{{ToCash(tableDetail.OpenResultBarMin)}}</td>
                            </tr>
                            <tr>
                                <td>开奖[LuckLose]收益</td>
                                <td colspan="8" class="color-red">{{ToCash(tableDetail.OpenResultLuckLose)}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">庄家信息</div>
                </div>
                <div class="portlet-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="info" style="width:100%;">
                                <tr>
                                    <td style="width:16%;">庄家类型：<span>{{bankerType[tableDetail.ZhuangType]}}</span></td>
                                    <td style="width:17%;">
                                        庄家昵称：
                                        <span v-if="tableDetail.ZhuangType==0">{{tableDetail.ZhuangNickName}}</span>
                                        <a v-else v-on:mouseenter="showUserDetailInfo($event,tableDetail.ZhuangUserID)" v-on:mouseleave="hideUserDetailInfo()" target="_blank" href="'/UserInfo/Search?userID=' + tableDetail.ZhuangUserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{tableDetail.ZhuangNickName}}</a>
                                    </td>
                                    <td style="width:16%;">庄家ID：<span>{{tableDetail.ZhuangUserID}}</span></td>
                                    <td style="width:17%;">初始上庄金币：<span>{{ToCash(tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                    <td style="width:17%;">当前剩余金币：<span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount)}}</span></td>
                                    <td style="width:17%;">金币变化量：<span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount-tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">玩家信息</div>
                    <div class="form-group" style="float: right;">
                        <div class="input-group">
                            <span>只看玩家</span>
                            <div id="radioBtn" class="btn-group">
                                <a class="btn btn-primary btn-sm active" v-on:click="filterUserType(true)" data-toggle="filter" data-title="Y">開</a>
                                <a class="btn btn-primary btn-sm notActive" v-on:click="filterUserType(false)" data-toggle="filter" data-title="N">關</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th rowspan="3" style="width: 5%;">玩家类型</th>
                                <th rowspan="3" style="width: 5%;">昵称</th>
                                <th rowspan="3" style="width: 5%;">ID</th>
                                <th rowspan="3" style="width: 7%;">初始金币</th>
                                <th rowspan="3" style="width: 7%;">当前金币</th>
                                <th rowspan="3" style="width: 7%;">游戏总输赢</th>
                                <th rowspan="3" style="width: 7%;">总充值</th>
                                <th rowspan="3" style="width: 7%;">总兑换</th>
                                <th rowspan="3" style="width: 7%;">总输赢</th>
                                <th colspan="1" style="border-right-color: white;">
                                    指定开奖 <span style="color:red;">{{tableDetail.BetTime}}</span>
                                    <div><span style="color:red;" id="WinPrizeMsg"></span></div>
                                </th>
                                <th colspan="10">
                                    <label v-on:click="setWinPrizeInfo.WinPrize=1">
                                        <input type="radio" name="WinPrize" value="1" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/orange.png" style="width: 20px; height: 20px;" />
                                        x10
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=2">
                                        <input type="radio" name="WinPrize" value="2" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/orange.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=3">
                                        <input type="radio" name="WinPrize" value="3" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/dobulestar.png" style="width: 20px; height: 20px;" />
                                        x30
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=4">
                                        <input type="radio" name="WinPrize" value="4" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/dobulestar.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=6">
                                        <input type="radio" name="WinPrize" value="6" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/apple.png" style="width: 20px; height: 20px; " />
                                        x5
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=14">
                                        <input type="radio" name="WinPrize" value="14" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/apple.png" style="width: 20px; height: 20px; " />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=7">
                                        <input type="radio" name="WinPrize" value="7" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/bell.png" style="width: 20px; height: 20px;" />
                                        x10
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=8">
                                        <input type="radio" name="WinPrize" value="8" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/bell.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=9">
                                        <input type="radio" name="WinPrize" value="9" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/mango.png" style="width: 20px; height: 20px;" />
                                        x10
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=10">
                                        <input type="radio" name="WinPrize" value="10" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/mango.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=15">
                                        <input type="radio" name="WinPrize" value="15" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/77.png" style="width: 20px; height: 20px;" />
                                        x40
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=16">
                                        <input type="radio" name="WinPrize" value="16" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/77.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=19">
                                        <input type="radio" name="WinPrize" value="19" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/watermelon.png" style="width: 20px; height: 20px;" />
                                        x20
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=20">
                                        <input type="radio" name="WinPrize" value="20" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/watermelon.png" style="width: 20px; height: 20px;" />
                                        x3
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=5">
                                        <input type="radio" name="WinPrize" value="5" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/bar.png" style="width: 20px; height: 20px; " />
                                        x100
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=17">
                                        <input type="radio" name="WinPrize" value="17" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/bar.png" style="width: 20px; height: 20px; " />
                                        x50
                                    </label>
                                    <label v-on:click="setWinPrizeInfo.WinPrize=11">
                                        <input type="radio" name="WinPrize" value="11" v-on:click="confirmSetWinPrize()" />
                                        <img src="~/Content/SGJPrize/lucky.png" style="width: 20px; height: 20px;" />
                                        无奖
                                    </label>
                                </th>
                            </tr>
                            <tr>
                                <th colspan="11"> 当前下注 </th>
                            </tr>
                            <tr>
                                <th style="width: 6.5%;">网易</th>
                                <th style="width: 6.5%;">华为</th>
                                <th style="width: 6.5%;">京东</th>
                                <th style="width: 6.5%;">360</th>
                                <th style="width: 6.5%;">小米</th>
                                <th style="width: 6.5%;">腾讯</th>
                                <th style="width: 6.5%;">百度</th>
                                <th style="width: 6.5%;">阿里</th>
                                <th style="width: 7%;">总</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="user in tableDetail.UserInfo">
                                <td>{{userType[user.UserType]}}</td>
                                <td>{{user.NickName}}</td>
                                <td><a v-on:mouseenter="showUserDetailInfo($event,user.UserID)" v-on:mouseleave="hideUserDetailInfo()" target="_blank" href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'" style="vipUser.indexOf(user.UserID)>-1?'color:red;':''">{{user.UserID}}</a></td>
                                <td>{{ToCash(user.InitMoney)}}</td>
                                <td>{{ToCash(user.CurrentMoney)}}</td>
                                <td class="color-red">{{ToCash(user.GameScore)}}</td>
                                <td class="color-red">{{ToCash(user.SumCharge)}}</td>
                                <td class="color-red">{{ToCash(user.SumConvert)}}</td>
                                <td>
                                    <div>
                                        <span class="update_Red" v-if="((user.SumCharge - user.SumConvert - user.CurrentMoney) *-1) < 0">{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)*-1)}}</span>
                                        <span class="update_Green" v-else>{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)*-1)}}</span>
                                    </div>
                                </td>
                                <td v-bind:class="{'color-red':user.BetInfoUserApple > 0 }">{{ToCash(user.BetInfoUserApple)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserOrange > 0 }">{{ToCash(user.BetInfoUserOrange)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserMango > 0 }">{{ToCash(user.BetInfoUserMango)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserBell > 0 }">{{ToCash(user.BetInfoUserBell)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserWatermelon > 0 }">{{ToCash(user.BetInfoUserWatermelon)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserDobuleStar > 0 }">{{ToCash(user.BetInfoUserDobuleStar)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUser77 > 0 }">{{ToCash(user.BetInfoUser77)}}</td>
                                <td v-bind:class="{'color-red':user.BetInfoUserBar > 0 }">{{ToCash(user.BetInfoUserBar)}}</td>
                                <td v-bind:class="{'color-red':(user.BetInfoUserApple+user.BetInfoUserOrange+user.BetInfoUserMango+user.BetInfoUserBell+user.BetInfoUserWatermelon+user.BetInfoUserDobuleStar+user.BetInfoUser77+user.BetInfoUserBar) > 0 }">{{ToCash(user.BetInfoUserApple+user.BetInfoUserOrange+user.BetInfoUserMango+user.BetInfoUserBell+user.BetInfoUserWatermelon+user.BetInfoUserDobuleStar+user.BetInfoUser77+user.BetInfoUserBar)}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!--指定开奖-->
    <div class="modal fade" id="setWinPrize" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">指定开奖</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-6 control-label">编辑桌号：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableNO}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">当前状态：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{tableStatus[tableDetail.Status]}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 control-label">请指定本局开奖类型：</label>
                            <div class="col-md-6">
                                <div class="btn-group-vertical" data-toggle="buttons" style="width:180px;">
                                    <label class="btn btn-default" v-on:click="setWinPrizeInfo.WinPrize=1">
                                        <input type="radio" name="WinPrize" value="1" class="toggle" />
                                        <img src="~/Content/SGJPrize/orange.png" style="width: 30px; height: 30px;" />
                                        x10
                                        <span style="color:red; float:right; margin:6px 0;">{{ToCash(tableDetail.OpenResultOrange)}}</span>
                                    </label>
                                    <label class="btn btn-default" v-on:click="setWinPrizeInfo.WinPrize=2">
                                        <input type="radio" name="WinPrize" value="2" class="toggle" />
                                        <img src="~/Content/SGJPrize/orange.png" style="width: 30px; height: 30px;" />
                                        x3
                                        <span style="color:red; float:right; margin:6px 0;">{{ToCash(tableDetail.OpenResultOrangeMin)}}</span>
