@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model FW.Core.Helper.PagedList<game.Entity.Message.ReceiveUser>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <label>发送时间</label>
                    <input type="text" class="form-control " style="width:180px" id="sendTimeBegin" name="sendTimeBegin" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="sendTimeEnd" name="sendTimeEnd" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm' })" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="display:none">编号</th>
                       
                            <th>发送时间</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>消息编号</th>
                            <th>消息内容</th>
                            <th>消息状态</th>
               
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td style="display:none">@item.Id</td>
                                    <td>@(item.ReadTime!=null?item.ReadTime.Value.ToString("yyyy-MM-dd HH:mm:ss"):"--")</td>
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.User)
                                    <td>@item.Message.Id</td>
                                    <td><div style="width:100%;white-space:normal;min-width:300px;">@item.Message.MsgContent</div> </td>
                                    <td>@item.Status.GetDisplayName()</td>
                      
                                    <td>
                                        @Html.LinkWithRight(action: "DelOutbox",value:"删除", href: "#", onclick: "swDelConfirmUrl('DelOutbox?msgID=" + item.MsgID + "&userID="+item.User.Id+"')")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}