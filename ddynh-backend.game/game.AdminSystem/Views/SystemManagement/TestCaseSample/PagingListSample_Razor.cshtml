@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using game.Entity.Pay
@using game.AdminSystem.Models.ViewModels

@model  FW.Core.Helper.PagedList<game.AdminSystem.Models.ViewModels.PromotionEventListPageViewModel>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<style>

    table td {
        padding: 10px 7px !important;
    }

    .row {
        margin-left: 0px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("_AreaSelectRelatePlatform")

                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>

            </form>

            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>活动名称</th>
                            <th>活动备注</th>
                            <th>渠道名称</th>
                            <th class="algin-c">开启状态</th>
                            <th class="algin-c">首页中显示</th>
                            <th class="algin-c">公告页显示</th>
                            <th>建立时间</th>
                            <th>更新时间</th>
                            <th>更新人员</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model.PageData ?? new List<PromotionEventListPageViewModel>())
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.AreaName</td>
                                <td>@item.Memo</td>
                                <td class="algin-c">@item.Status</td>
                                <td class="algin-c">@item.IsHomePageVisible</td>
                                <td class="algin-c">@item.IsAnnounementPageVisible</td>
                                <td>@item.CreateTime</td>
                                <td>@item.UpdateTime</td>
                                <td>@item.UpdateBy</td>
                                <td></td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


@section initScripts{
    <script>


    </script>
}
