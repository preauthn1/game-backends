@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using game.Entity.Pay
@using game.AdminSystem.Models.ViewModels
@using game.Entity.Money
@using game.AdminSystem

@{ 
   
}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}


<style>


    .dataTables_length
    {
        display:none;
    }

</style>


<div class="row tableListPage">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">

                <div class="form-group">
                    <label>三方商户</label>
                    @Html.Partial("_DropdownGameMerchant", new DropdownPartialSettingViewModel(FirstOptionValueEnum.DefaultSelectAll))
                </div>


                <div class="form-group">
                    <label>啟用狀態</label>

                    <select id="status" name="status" class="form-control input-small">
                        <option value="">--不限--</option>
                        <option value="1">启用</option>
                    </select>

                </div>



                <div class="form-group">
                    <button type="button" class="btn btn-default" onclick="createTable()"> 搜 索 </button>
                </div>



                <div class="hr-s"></div>

            </form>

            <div class="content">
                <table id="myTable_table" class="display border-r" style="width:100%"></table>
            </div>

        </div>

    </div>

</div>


@section initScripts{
    <script>
      
        function createTable() {

            const urlEdit = '/GameMerchantJobSetting/Update';
            const url = '/GameMerchantJobSetting/GetList'
            const thead =
                [                   
                    { "sTitle": "类型", "mData": "JobType", "className": "algin-l" , "width": "5%" },
                    { "sTitle": "类型名称", "mData": "JobTypeText", "className": "algin-l" },         
                    { "sTitle": "指定平台", "mData": "PlatformText", "className": "algin-l" },                    
                    {
                        "sTitle": "游戏商编号", "mData": "GameMerchantName", "className": "algin-l", "render": function (data, type, row)
                        {
                            var html = "";
                            html = html + String.format('<div class="" title="{0}" >{1}</div>', row.GameMerchantID , row.GameMerchantName);
                            return html;
                        }
                    },                    
                    { "sTitle": "备注", "mData": "Memo", "className": "algin-l" },           
                    { "sTitle": "触发排程网址", "mData": "JobAPIUrl", "className": "algin-l" },
                    { "sTitle": "启用", "mData": "IsEnableText", "className": "algin-c" , "width": "5%" },
                    { "sTitle": "下一次执行时间", "mData": "JobNextStarttTimeText", "className": "algin-l" },
                    { "sTitle": "最后一次执行时间", "mData": "LastExecutedTimeText", "className": "algin-l" },   
                    { "sTitle": "排程间隔时间(秒)", "mData": "JobIntervalSeconds", "className": "algin-l" },  
                ]

            
            //将表单上的筛选条件、下拉选单带入api
            const data =
            {
                gameMerchantID: $('#gameMerchantID').val(),
                status : $('#status').val(),
            }

            createDataTable('myTable', thead, url, data);
        }


        $(function () {            

            fillFormData('form_search');
            createTable();
        
        })






    </script>
}