@using FW.Core.Web.Mvc
@using FW.Core.Helper
@using game.Entity.Agent
@model PagedList<TransferLog>

@{
    var sourceList = ViewBag.SourceList as List<AgentTransferType>;
}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", true)
                <div class="form-group">
                    <label>代理名称</label>
                    <input type="text" class="form-control input-small" id="name" name="name" placeholder="代理名称">
                </div>
                <div class="form-group">
                    <label>流通类型</label>
                    <select class="form-control input-small" id="sourceID" name="sourceID">
                        <option value="">--不限--</option>
                        @foreach (var item in sourceList)
                        {
                            <option value="@item.Id">@item.SourceName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" id="createBeginTime" name="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="createEndTime" name="createEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover ">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>所属渠道</th>
                            <th>创建时间</th>
                            <th>代理名称</th>
                            <th>流通类型</th>
                            <th>交易对象</th>
                            <th>当前数量</th>
                            <th>交易对象当前数量</th>
                            <th>更新数量</th>
                            <th>IP地址</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.PageData != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.PlatformName</td>
                                    <td>@item.AreaName</td>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.AgentName</td>
                                    <td>@item.SourceName</td>
                                    <td>@(item.TargetAgentID != null ? "代理：" + item.TargetName : "玩家:" + item.TargetUserID)</td>
                                    <td>@item.SelfAmount.ToCash()</td>
                                    <td>@item.RelationAmount.ToCash()</td>
                                    <td>@item.UpdateAmount.ToCash()</td>
                                    <td>@item.IPAddress</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @if (Model != null && Model.PageData != null)
                        {
                            @Html.Pager(Model)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}