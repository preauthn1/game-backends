@using FW.Core.Helper
@using FW.Core.Web.Mvc
@using game.Entity.Agent
@model PagedList<AgentApplyInfo>
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                <div class="form-group">
                    <label>名称</label>
                    <input type="text" class="form-control input-small" id="name" name="name" placeholder="名称">
                </div>
                <div class="form-group">
                    <label>手机号</label>
                    <input type="text" class="form-control input-small" id="tel" name="tel" placeholder="手机号">
                </div>
                <div class="form-group">
                    <label>QQ号</label>
                    <input type="text" class="form-control input-small" id="qq" name="qq" placeholder="QQ号">
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control" style="width:180px" id="createBeginTime" name="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control" style="width:180px" id="createEndTime" name="createEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>创建时间</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>名称</th>
                            <th>手机号</th>
                            <th>QQ号</th>
                            <th>微信号</th>
                            <th>备注</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.PageData != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                        <tr>
                            <td>@item.Platform.Name</td>
                            <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.User)
                            <td>@item.Name</td>
                            <td>@item.Tel</td>
                            <td>@item.QQ</td>
                            <td>@item.WXNo</td>
                            <td>@item.Memo</td>
                            <td>
                                @Html.LinkWithRight(action: "Delete", value: "删除", href: "javascript:void(0);", onclick: "DeleteApply(" + item.Id + ")")
                                @(Html.LinkWithRight(controller: "agentuser", action: "Add", href: "/agentuser/add?Id=" + @item.Id))
                            </td>
                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @if (Model != null)
                        {
                            @Html.Pager(Model)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        });
        function DeleteApply(id) {
            swDelConfirmUrl("/AgentApply/Delete/" + id, "确定要删除该申请吗?");
        }
    </script>
}