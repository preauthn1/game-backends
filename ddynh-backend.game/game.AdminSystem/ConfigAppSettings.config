

<appSettings>
  
  <add key="aspnet:MaxJsonDeserializerMembers" value="150000" />
  <add key="webpages:Version" value="0.0.0.0" />
  <add key="webpages:Enabled" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />

  <!--game api位置-->
  <add key="GameAPIUrl" value="http://localhost:5264/api/v1/" />
  <!--與後端API溝通需要的 id & key 值, 需與後端一致 -->
  <add key="GameAPIID" value="1" />
  <add key="GameAPIKey" value="123" />

  <!--显示中1个金币与数据存储的比例,如：100表示 显示的一个金币在数据中存储的是100个金币 -->
  <add key="CoinShowRate" value="100" />

  <!-- 推送telegram訊息的api位置與機器人token -->
  <add key="TGServerIP" value="http://0.0.0.0:8080/Sendmessage.ashx" />
  <add key="TGServerToken" value="[TG_BOT_TOKEN_REDACTED]" />

  <!--可以在管理后台操作房间的游戏编号，多个用逗号隔开-->
  <add key="OperateServerGameID" value="       2@/GameQZNN/TableList?serverID={0}       ,3@/GameZJH/SuperTool?serverID={0}       ,9@/GameSGJ/TableList?serverID={0}       ,11@/GameLHD/TableDetail?serverID={0}&amp;tableNo=0       ,13@/GameBJL/TableList?serverID={0}       ,18@/GameFKEB/TableList?serverID={0}       ,19@/GameBRNN/TableDetail?serverID={0}&amp;tableNo=0       ,20@/GameHHDZ/TableDetail?serverID={0}&amp;tableNo=0       ,21@/GameHHNN/TableDetail?serverID={0}&amp;tableNo=0       ,14@/GameBY/SuperTool?serverID={0},2008@/GameBJL/TableList?serverID={0}" />
  <add key="ProtoBufMD5Key" value="abc123" />

  <!--不紀錄adminlog的action-->
  <add key="DisableLogAction" value="_UserQuestionLog_GetUnReplyQuestionCount_GET,_UserQuestionLog_GetLogonQuestionCount_GET,_Money_GetConvertLogCount_GET,_Warning_ExistWarning_GET,_UserInfo_OnlineVipUserCount_GET,_UserInfo_GetPlatformDownloadIncorrectCount_GET" />

  <!--上传文件目录-->
  <add key="uploadFolder" value="E:\shiquan\web\game\game.WebSite" />
  <!--上传文件基地址-->
  <add key="uploadFileBaseUrl" value="http://localhost:9230" />
  <!--网站域名-->
  <add key="webSiteHost" value="http://localhost:9230/" />
  <!--是否要金鑰驗證-->
  <add key="NeedVerification" value="False" />
  <!--金鑰驗證Tag-->
  <add key="QRCodeTag" value="LogInQRCode:100" />

  <!--AEPay Auth mars-->
  <add key="AEPayAuth" value="0c13cd5258954b819cbdb0a1e1cb31e6" />
  <!--AEPay URL mars-->
  <add key="AEPayUrl" value="https://example.invalid" />

  <!--客服功能图片存取位置-->  
  <!--<add key="ImageUrl" value="http://localhost:9332" />
  <add key="UploadApi_Internal_IP" value="http://localhost:9332" />-->


  <!--客服功能图片存取位置（版控上請保持這個）-->
  <add key="ImageUrl" value="http://0.0.0.0" />
  <add key="UploadApi_Internal_IP" value="http://0.0.0.0" />


  <!--QA、UAT環境會設置這個 影響layout畫面上方提示當前環境　-->
  <add key="Enviroment" value="Local開發" />
  <add key="Enviroment_Top_Color" value="#343035" />




  <!--開發環境專用_自動登入　-->
  <add key="AutoLogin_ComputerNames" value="DESKTOP-EMCG6HU\\user,DESKTOP-EMCG6HU\\user2,MSI\\marshall" />
  <add key="AutoLogin_Account" value="admin" />
  <add key="AutoLogin_Password" value="terpro123!@#" />



</appSettings>