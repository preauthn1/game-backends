
@{
    Layout = null;
    var errMessage =  ViewBag.ErrorMessage;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>error</title>
</head>
<body>
    <style type="text/css">
        body {
            margin: 0;
            padding: 0;
            background: #000 url('/Content/bg.png') center center fixed no-repeat;
            -moz-background-size: cover;
            background-size: cover;
        }
    </style>
    <table width="100%" height="100%">
        <tr>
            <td align="center">
                <font color="white">
                    <H1>支付发生错误，请关闭页面重新再试！</H1>
                    <H2>
                    @if (!String.IsNullOrEmpty(errMessage))
                    {
                        @Html.Raw(errMessage)
                    }
                    </H2>
                </font>
            </td>
        </tr>
    </table>
</body>
</html>
