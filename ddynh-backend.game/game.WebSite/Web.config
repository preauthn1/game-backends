<?xml version="1.0" encoding="utf-8"?>
<!--
  有关如何配置 example.invalid 应用程序的详细信息，请访问
  http://example.invalid/fwlink/?LinkId=301880
  -->
<configuration>
  
  
  <!--改成吃外部的檔案設定 -->
  <appSettings configSource="ConfigAppSettings.config" />

  <connectionStrings configSource="ConfigDbConn.config" />
  
  
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="120000" executionTimeout="3600" />
  </system.web>

  <system.webServer>
    
    <!-- 允许后台管理广告图片跨域設定, 填入后台ip与端口-->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>
 
      <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
 
          <dependentAssembly>
 
              <assemblyIdentity name="Newtonsoft.Json" publicKeyToken=[REDACTED]" culture="neutral" />
 
              <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
 
          </dependentAssembly>
 
      </assemblyBinding>
 
  </runtime>
</configuration>
