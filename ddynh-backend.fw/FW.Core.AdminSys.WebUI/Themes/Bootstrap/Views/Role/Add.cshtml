@using FW.Core.AdminSys.WebUI
@{ 
     List<SelectListItem> listOrg = ViewBag.OrgDropdown;
}

<style>
    #OrgID
    {
        width: 200px;
    }
</style>

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>新增角色
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="addRoleFrm" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">

                        <div class="form-group">
                            <label class="control-label col-md-3">角色名称</label>
                            <div class="col-md-5">
                                <input type="text" class="form-control input-medium" name="roleName" id="roleName">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="control-label col-md-3">预设权限角色范本</label>
                            <div class="col-md-5">
                                <input type="checkbox" class="form-control input-medium" name="IsTemplateForCopyCheckBox" id="IsTemplateForCopyCheckBox" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">所属组织</label>
                            <div class="col-md-5">

                                @Html.DropDownList("OrgID", listOrg, new { @class = "form-control input-small", id = "OrgID" })

                            </div>
                        </div>

                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                            @Html.Back(@Url.Action("List"))
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>
@section initScripts
{
    <script>
        $(function () {
            $("#addRoleFrm").validate({
                rules: {
                    roleName: {
                        required: true,
                        minlength: 2,
                        maxlength: 99
                    }
                },
                messages: {
                    roleName: {
                        required: "角色名称不能为空",
                        minlength: "角色名长度不能低于2个字符",
                        maxlength:"角色名长度不能超出99个字符"
                    }
                }
            });
        })
    </script>
}

