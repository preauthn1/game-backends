@using FW.Core.Web.Mvc
@model FW.Core.Helper.PagedList<FW.Core.AdminSys.Provider.Entity.AdminLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
<style>
    .flex_box {
        display: flex !important;
        align-items: center;
        margin-right: .5%;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="form-inline">
            <form class="form-inline flex_box" id="form_search" method="get">
                <div class="form-group flex_box">
                    <label class="control-label">用户名</label>
                    <div>
                        <input type="text" id="loginName" name="loginName" class="form-control" placeholder="">
                    </div>
                </div>
                <div class="form-group flex_box">
                    <label class="control-label">IP</label>
                    <div>
                        <input type="text" id="ipAddress" name="ipAddress" class="form-control" placeholder="">
                    </div>
                </div>
                <div class="form-group flex_box">
                    <label class="control-label">说明</label>
                    <div>
                        <input type="text" id="memo" name="memo" class="form-control" placeholder="">
                    </div>
                </div>
                <div class="form-group flex_box">
                    <label class="control-label">时间从</label>
                    <div>
                        <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")">
                    </div>
                </div>

                <div class="form-group flex_box">
                    <label class="control-label">到</label>
                    <div>
                        <input type="text" class="form-control " style="width:180px" id="endTime" value="@DateTime.Now.ToString(" yyyy-MM-dd HH:mm")" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                    </div>
                </div>

                <div class="form-group flex_box">
                    <input type="submit" class="btn btn-default" value=" 查 询 " />
                </div>
            </form>
        </div>

        <div class="table-scrollable">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>用户ID</th>
                        <th>用户名</th>
                        <th>说明</th>
                        <th>访问路径</th>
                        <td>数据</td>
                        <th>IP地址</th>
                        <th>时间</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var log in Model.PageData)
                        {
                            string loginName = "";
                            if (log.User != null)
                            {
                                loginName = log.User.LoginName;
                            }
                            <tr>
                                <td>@log.UserID</td>
                                <td>@loginName</td>
                                <td>@log.Memo</td>
                                <td>
                                    <div title="@log.Id">
                                        @log.Url
                                    </div>                                    
                                </td>
                                <td title="@log.Data">@FW.Core.Helper.StringHelper.TruncateString(log.Data, 120)</td>
                                <td>@log.IPAddress</td>
                                <td>@log.WriteTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="row rpager">
            <div class="pager">
                <div class="pagerc">
                    @Html.Pager(Model)
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search')
        })
    </script>
}