@using FW.Core.AdminSys.WebUI
@{
    FW.Core.AdminSys.Provider.Entity.AdminUser user = ViewBag.user;
    List<FW.Core.AdminSys.Provider.Entity.Role> roles = ViewBag.roles;
    List<FW.Core.AdminSys.Provider.Entity.TargetRolesAssinRightCountModel> roleAssignRightCount = ViewBag.roleAssignRightCount;
    List<int> urs = ViewBag.userRoles;
}
<form method="post">
    <div class="row">
        <div class="col-md-12 ">
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-globe"></i>修改账号 [ @user.LoginName ] 角色
                    </div>
                </div>
                <div class="portlet-body">
                    <div class="dataTables-wrapper">
                        <div class="row" style="margin-left: 10px; margin-right: 10px">
                            @Html.OkWithRight()
                            @Html.Back(@Url.Action("List"))
                            @Html.PartialViewOrEmptyDefault("_CacheHintText")

                            <input type="hidden" name="id" value="@user.UserID" />
                        </div>

                        <div class="table-scrollable">
                            <table class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>角色ID</th>
                                        <th>角色名</th>
                                        <th>已分配功能(项)</th>
                                    </tr>
                                </thead>
                                @foreach (var role in roles)
                                {
                                    string checkedSign = "";

                                    var match = roleAssignRightCount.FirstOrDefault(z => z.RoleID == role.RoleID);

                                    if (urs.Contains(role.RoleID))
                                    {
                                        checkedSign = "checked";
                                    }
                                    <tr>
                                        <td><input type="checkbox" name="ck" value="@role.RoleID" @checkedSign /></td>
                                        <td>@role.RoleID</td>
                                        <td>@role.RoleName</td>
                                        <td>
                                            <a href="Admin/Role/RoleRight?roleID=5"></a>
                                            
                                            
                                            @(match == null ? 0 : match.TotalRightCount)
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>


                    </div>

                </div>

            </div>
        </div>
    </div>
    </form>



