@using FW.Core.AdminSys.WebUI

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>修改密码
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="mdPwdFrm" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="control-label col-md-3">新密码</label>
                            <div class="col-md-3">
                                <input type="password" id="password" name="password" class="form-control input-medium" placeholder="请输入新密码">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">确认新密码</label>
                            <div class="col-md-5">
                                <input type="password" id="rePassword" name="rePassword" class="form-control input-medium" placeholder="请再次输入新密码">
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                            @Html.Cancel()
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>

@section initScripts
{
    <script>
        $(function () {
            $.validator.addMethod("isRequired", function (value, element) {

                if ($("#tgChatid").val() == "" && value == "") {
                    return false;
                }
                return true;

            });

            $("#mdPwdFrm").validate({
                rules: {
                    password: {
                        isRequired: true,
                        minlength: 6,
                        maxlength:16
                    },
                    rePassword: {
                        isRequired: true,
                        equalTo: "#password",
                        minlength: 6,
                        maxlength:16
                    }
                },
                messages: {
                    password: {
                        isRequired: "请填写密码",
                        minlength: "密码至少为6位字符",
                        maxlength:"密码不能超出16位字符"
                    },
                    rePassword: {
                        isRequired: "请再次输入密码",
                        equalTo: "两次输入密码不一致",
                        minlength: "密码至少为6位字符",
                        maxlength: "密码不能超出16位字符"
                    }
                }
            });
        })
    </script>
}