@model FW.Core.AdminSys.Provider.Entity.QuickAction

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>修改收藏
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="addQAFrm" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">

                        <div class="form-group last">
                            <label class="control-label col-md-3">功能名称</label>
                            <div class="col-md-3">
                                <input type="text" id="name" name="name" value="@Model.Name" class="form-control input-medium" placeholder="请输入功能名称">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">页面地址</label>
                            <div class="col-md-3">
                                <input type="text" id="url" name="url" value="@Model.Url" class="form-control input-medium" placeholder="请输入页面地址">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">排序</label>
                            <div class="col-md-3">
                                <input type="text" id="sort" name="sort" value="@Model.Sort" class="form-control input-small" placeholder="请输入排序值">
                            </div>
                        </div>

                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                            @Html.Back()
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>

@section initScripts
{
    <script>
        $(function () {
            $("#addQAFrm").validate({
                rules: {
                    name: {
                        required: true,
                        minlength: 2,
                        maxlength: 32
                    },
                    url: {
                        required: true,
                        minlength: 2,
                        maxlength: 512
                    },
                    sort: {
                        required: true,
                        number: true
                    }
                }
            });
        })

    </script>
}