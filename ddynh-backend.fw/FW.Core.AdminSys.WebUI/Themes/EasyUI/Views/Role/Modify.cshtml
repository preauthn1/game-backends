@using KCKJ.Core.AdminSys.WebUI
@model KCKJ.Core.AdminSys.Provider.Entity.Role

<form method="post">
    <table width="800" cellpadding="2" cellspacing="2">
        <tr>
            <td align="right">角色ID:</td>
            <td>
                <input type="text" class="easyui-textbox" name="roleID" style="width:300px" value="@Model.RoleID"  readonly="readonly" />
            </td>
        </tr>
        <tr>
            <td align="right">角色名称:</td>
            <td>
                <input type="text" class="easyui-textbox" name="roleName" style="width:300px" value="@Model.RoleName" data-options="required:true,missingMessage:'角色名称不能为空'" />
            </td>
        </tr>
        <tr>
            <td></td>
            <td align="left">
                @Html.OkWithRight()
                @Html.Back(@Url.Action("List"))
            </td>
        </tr>
    </table>
</form>