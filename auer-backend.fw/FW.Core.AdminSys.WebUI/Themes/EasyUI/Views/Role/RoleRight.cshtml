@using KCKJ.Core.AdminSys.WebUI
@{
    KCKJ.Core.AdminSys.Provider.Entity.Role role = ViewBag.role;

    List<int> rrs = ViewBag.roleRights;
}

<form method="post">
    <div style="padding-left:350px;padding-bottom:20px;padding-top:20px"><h2>@role.RoleName</h2></div>
    <div style="margin-top:15px;margin-left:20px;margin-bottom:10px">
        @Html.OkWithRight()
        @Html.Back(@Url.Action("List"))
        <input type="hidden" name="roleID" value="@role.RoleID" />
</div>
<div>
    @{Html.RenderAction("RightTree", "Right", new { checkedRights = rrs });}
</div>
</form>
