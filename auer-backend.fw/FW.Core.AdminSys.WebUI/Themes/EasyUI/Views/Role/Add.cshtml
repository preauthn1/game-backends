        <tr>
            <td align="right">角色名称:</td>
            <td>
                <input type="text" name="roleName" class="easyui-textbox" style="width:300px" value="" data-options="required:true,missingMessage:'角色名称不能为空'" />
            </td>
        </tr>
        <tr>
            <td></td>
