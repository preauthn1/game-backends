@using KCKJ.Core.AdminSys.WebUI
<form method="post">
    <table width="800" cellpadding="2" cellspacing="2">

        <tr>
            <td align="right">确认密码:</td>
            <td>
                <input type="text" name="password" class="easyui-textbox" value="" style="width:300px" data-options="required:true,missingMessage:'密码不能为空',validType:['length[6,16]']" />
            </td>
        </tr>

        <tr>
            <td align="right">确认密码:</td>
            <td>
                <input type="text" name="rePassword" class="easyui-textbox" value="" style="width:300px" data-options="required:true,missingMessage:'密码不能为空',validType:['length[6,16]']" />
            </td>
        </tr>

        <tr>
            <td></td>
            <td align="left">
                @Html.OkWithRight()
            </td>
        </tr>
    </table>

