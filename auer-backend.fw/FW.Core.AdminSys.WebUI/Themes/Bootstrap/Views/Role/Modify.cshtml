@using FW.Core.AdminSys.WebUI
@model FW.Core.AdminSys.Provider.Entity.Role

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>修改角色
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="addRoleFrm" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">

                        <div class="form-group">
                            <label class="control-label col-md-3">角色ID</label>
                            <div class="col-md-3">
                                <input type="text" class="form-control input-medium" name="roleID" value="@Model.RoleID" readonly="readonly">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">角色名称</label>
                            <div class="col-md-5">
                                <input type="text" class="form-control input-medium" name="roleName" value="@Model.RoleName">
                            </div>
                        </div>

                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                            @Html.Back(@Url.Action("List"))
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>

@section initScripts
{
    <script>
        $(function () {
            $("#addRoleFrm").validate({
                rules: {
                    roleName: {
                        required: true,
                        minlength: 2,
                        maxlength: 16
                    }
                },
                messages: {
                    roleName: {
                        required: "角色名称不能为空",
                        minlength: "角色名长度不能低于2个字符",
                        maxlength: "角色名长度不能超出16个字符"
                    }
                }
            });
        })
    </script>
}
