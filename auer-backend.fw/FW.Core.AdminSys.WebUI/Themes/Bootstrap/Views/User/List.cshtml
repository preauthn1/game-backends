@using FW.Core.Web.Mvc
@model FW.Core.Helper.PagedList<FW.Core.AdminSys.Provider.Entity.AdminUser>

@{
    var dicUserType = ViewBag.UserType;

} 

<div class="row">
    <div class="col-md-12 ">

        <div class="table-scrollable">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>用户ID</th>
                        <th>用户名</th>
                        <th>用户显示名称</th>
                        <th>用户角色</th>
                        <th>状态</th>
                        <th>创建时间</th>
                        <th>最后登录时间</th>
                        <th>最后登录IP</th>
                        <th>金钥</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.PageData)
                    {
                        <tr>
                            <td>@user.UserID</td>
                            <td>@user.LoginName</td>
                            <td>@user.DisplayName</td>
                            <td>@dicUserType[user.UserType]</td>
                            <td>@user.Status</td>
                            <td>@user.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@user.LastLogonTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@user.LastLogonIPAddress</td>
                            <td>@user.SecretKey</td>
                            <td>
                                @Html.ModifyLinkWithRightHref(href: Url.Action("Modify", new { id = user.UserID }))
                                &nbsp;&nbsp;
                                @Html.LinkWithRight(href: "#", action: "Del", onclick: "del(" + @user.UserID + ")")
                                &nbsp;&nbsp;
                                @Html.LinkWithRight(action: "UserRight", method: "Get", value: "用户权限", href: Url.Action("UserRight", new { id = user.UserID }))
                                &nbsp;&nbsp;
                                @Html.LinkWithRight(action: "UserRole", method: "Get", value: "用户角色", href: Url.Action("UserRole", new { id = user.UserID }))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row rpager">
            <div class="pager">
                <div class="pagerc">
                    @Html.Pager(Model)
                </div>
            </div>
        </div>
    </div>
</div>


@section initScripts
    {
    <script>
        function del(id) {
            if (confirm('您确认想要删除记录吗？')) {
                var url = "@Url.Action("Del")";
                url = url + "?id=";
                url = url + id;
                window.location.href = url;
            };
        }
    </script>
}

