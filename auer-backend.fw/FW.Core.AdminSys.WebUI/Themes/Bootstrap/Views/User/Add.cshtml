@{
    List<SelectListItem> listArea = ViewBag.UserType;
}

<style>
    .secretCss {
        border-style: none;
        width: 50px;
        margin-left: 20px;
    }

    input[type="text"]:disabled {
     cursor: no-drop;
     box-shadow: 40px 40px 40px 40px #ffffff inset;
    }
</style>

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>新增用户
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="addUserFrom" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">

                        <div class="form-group last">
                            <label class="control-label col-md-3">用户帐号</label>
                            <div class="col-md-3">
                                <input type="text" id="loginName" name="loginName" class="form-control input-medium" placeholder="请输入用户帐号">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">显示名称</label>
                            <div class="col-md-3">
                                <input type="text" id="displayName" name="displayName" class="form-control input-medium" placeholder="请输入显示名称">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">密码</label>
                            <div class="col-md-3">
                                <input type="password" id="password" name="password" class="form-control input-medium" placeholder="请输入密码">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">确认密码</label>
                            <div class="col-md-3">
                                <input type="password" id="rePassword" name="rePassword" class="form-control input-medium" placeholder="请再次输入密码">
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">使用者类别</label>
                            <div class="col-md-3">
                                @Html.DropDownList("UserType", listArea, new { @class = "form-control input-small", id = "UserType" })
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="control-label col-md-3">金钥</label>
                            <div class="col-md-3">
                                <input type="hidden" id="secretKey" name="secretKey">
                                <button id="btnQRCode" type="button" class="btn" onclick="GetQRCode()" style="">產生QRCode</button>
                                <img id="imgQRCode" src="" class="rounded float-right" alt="" />
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                            @Html.Back()
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>

@section initScripts
{
    <script>
        $("#addUserFrom").validate({
            rules: {
                loginName: {
                    required: true,
                    minlength: 1,
                    maxlength: 16
                },
                password: {
                    required: true,
                    minlength: 6,
                    maxlength: 16
                },
                rePassword: {
                    required: true,
                    minlength: 6,
                    maxlength: 16,
                    equalTo: "#password"
                }
            },
            messages: {
                loginName: {
                    required: "用户名不能为空",
                    minlength: "用户名长度至少为1位字符",
                    maxlength: "用户名长度不能超出16位字符"
                },
                password: {
                    required: "密码不能为空",
                    minlength: "密码长度至少为6位字符",
                    maxlength: "密码长度不能超出16位字符"
                },
                rePassword: {
                    required: "请再次输入密码",
                    minlength: "密码长度至少为6位字符",
                    maxlength: "密码长度不能超出16位字符",
                    equalTo: "两次输入密码不一致"
                }
            }
        });

        function GetQRCode() {
            const url = "/User/GetQRCode";

            $.getJSON(url, {}, function (result) {
                if (result.success) {
                    $("#imgQRCode").attr('src', result.url);
                    $("#secretKey").val(result.key);
                }
            });
        }
    </script>
}