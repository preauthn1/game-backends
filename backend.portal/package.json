{
	"name": "backend.portal",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"serve": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js serve --hot",
		"build": "vue-cli-service build",
		"lint": "vue-cli-service lint",
		"dev": "yarn && yarn serve --mode development",
		"prod": "yarn && yarn serve --mode production --sourcemap=false",
		"staging": "yarn && yarn serve --mode staging"
	},
	"dependencies": {
		"@mdi/font": "^4.7.95",
		"@types/js-cookie": "^2.2.4",
		"@types/qs": "^6.9.0",
		"@types/sortablejs": "^1.10.2",
		"@types/vue2-datepicker": "^3.3.0",
		"axios": "^0.19.0",
		"chart.js": "^2.9.3",
		"core-js": "3.22.5",
		"javascript-obfuscator": "^4.1.0",
		"js-cookie": "^2.2.1",
		"material-icons": "^0.3.1",
		"sortablejs": "^1.10.2",
		"tiptap-vuetify": "^2.24.0",
		"ts-md5": "^1.3.1",
		"tslint-config-prettier": "^1.18.0",
		"tslint-plugin-prettier": "^2.0.1",
		"vue": "^2.6.11",
		"vue-class-component": "^7.1.0",
		"vue-clipboard2": "^0.3.1",
		"vue-country-flag": "^1.3.1",
		"vue-html2canvas": "^0.0.4",
		"vue-i18n": "^8.15.1",
		"vue-json-excel": "^0.3.0",
		"vue-notification": "^1.3.20",
		"vue-property-decorator": "^8.3.0",
		"vue-router": "^3.1.3",
		"vue-uuid": "^2.0.2",
		"vue2-datepicker": "^3.3.0",
		"vuetify": "~2.5.0",
		"vuex": "^3.1.2",
		"vuex-class": "^0.3.2",
		"webpack-obfuscator": "2.6",
		"xlsx": "^0.16.9",
		"xlsx-js-style": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "17.0.34",
		"@types/webpack-env": "1.16.4",
		"@vue/cli-plugin-babel": "^4.1.1",
		"@vue/cli-plugin-pwa": "^4.1.1",
		"@vue/cli-plugin-router": "^4.1.1",
		"@vue/cli-plugin-typescript": "^4.1.1",
		"@vue/cli-plugin-vuex": "^4.1.1",
		"@vue/cli-service": "^4.1.1",
		"lint-staged": "^9.5.0",
		"sass": "~1.32.6",
		"sass-loader": "^8.0.0",
		"stylus": "^0.54.7",
		"stylus-loader": "^3.0.2",
		"typescript": "4.9.5",
		"vue-cli-plugin-vuetify": "2.4.8",
		"vue-template-compiler": "^2.6.11",
		"vuetify-loader": "^1.4.3"
	},
	"gitHooks": {
		"pre-commit": "fnm exec --using=.node-version node ./node_modules/lint-staged/bin/lint-staged"
	},
	"lint-staged": {
		"*.ts": [
			"vue-cli-service lint",
			"git add"
		],
		"*.vue": [
			"vue-cli-service lint",
			"git add"
		]
	}
}
