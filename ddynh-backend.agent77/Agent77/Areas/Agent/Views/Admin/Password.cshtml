@{
    ViewBag.Title = "修改密码";
}

@model Repository.ViewModel.ModifyPWD

<div class="box box-primary">
    <!-- /.box-header -->
    <form action="@Url.Action("Password", "Admin", new { Area = "Agent" })" class="form-horizontal" method="post">
        <div class="box-body"> 
            <div class="form-group">
                <label class="col-sm-12">旧密码</label>
                <div class="col-sm-12">
                    @Html.PasswordFor(x => x.OldPassword, new { @class = "form-control", maxlength = "40" })   
                    @Html.ValidationMessageFor(x => x.OldPassword)                
                </div>
            </div>           
            <div class="form-group">
                <label class="col-sm-12">新密码</label>
                <div class="col-sm-12">
                    @Html.PasswordFor(x => x.Password, new { @class = "form-control", maxlength = "40" })
                    @Html.ValidationMessageFor(x => x.Password)                 
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12">确认新密码</label>
                <div class="col-sm-12">
                    @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", maxlength = "40" })
                    @Html.ValidationMessageFor(x => x.ConfirmPassword)                    
                </div>
            </div>  
            <div class="form-group">              
                <div class="col-sm-12">
                    <button type="submit" class="btn btn-primary btn-block">确认修改</button>
                </div>
            </div>  
        </div>
    </form>
</div>

@section head{
    <!-- iCheck -->
    <link rel="stylesheet" href="~/Areas/Agent/Content/plugins/iCheck/square/blue.css">
}
@section scripts{  
    <!-- iCheck -->
    <script src="/Areas/Agent/Content/plugins/iCheck/icheck.min.js"></script>
    <!-- Page script -->   
}

