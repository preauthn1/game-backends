@{
    ViewBag.Title = "我的代理";
}

@Html.Action("Index", "Customer")

<div class="box box-primary">
    <!-- form start -->

    <div class="box-body">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-lg-1 col-md-2 col-sm-2 col-xs-12">玩家ID</label>
                <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
                    <input type="text" class="form-control" id="subUserID">
                </div>

                <label class="col-lg-2 col-md-3 col-sm-3 col-xs-12">加入日期</label>
                <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtStartTime">
                </div>

                <label class="col-lg-1 col-md-1 col-sm-1 col-xs-12">到</label>
                <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtEndTime">
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-1 col-md-2 col-sm-2 col-xs-12">
                    <button type="button" id="btnQuery" class="btn btn-primary btn-block">搜索</button>
                </div>
                <div class="col-lg-1 col-md-2 col-sm-2 col-xs-12">
                    <button type="button" id="btnExcel" class="btn btn-primary btn-block">汇出</button>
                </div>
            </div>
        </div>
        <hr class="hr-sm1">
        
        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>玩家ID</th>
                        <th>推广等级</th>
                        <th>总税收</th>
                        <th>总收益</th>
                        <th>总提领</th>
                        <th>申请提领总额</th>
                        <th>可提领金额</th>
                        <th>加入日期</th>
                        <th>状态</th>
                        <th>上层玩家</th>                        
                        <th>所在地区</th>
                        <th>操作</th>
                    </tr>
                </thead>
            </table>
        </div>
        <!-- /.box-body -->       
    </div>
</div>

<!-- /.box -->
@section scripts{
    <!-- Page script -->
    <script type="text/javascript">
        $(function () {

            //DataTable
            var table =
                $('#example1').DataTable({
                    "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                    "searching": false,
                    "autoWidth": false,
                    "serverSide": true,
                    "deferLoading": 0,
                    "ajax": {
                        method : 'post',
                        url: '@Url.Action("SubUserInfo", "Customer")',
                        data:function(d)
                        {
                            d.subUserID = $('#subUserID').val();
                            d.dtStartTime = $('#dtStartTime').val();
                            d.dtEndTime = $('#dtEndTime').val();
                        },
                        "dataSrc": function (json) {
                            if (json.success == false)
                                swal("错误", json.message, "error");

                            return json.data;
                        }
                    },
                    columns: [
                        { name: "UserID", data: "UserID" },
                        { name: "UserLevel", data: "UserLevel" },
                        { name: "SumTaxTotal", data: "SumTaxTotal" },
                        { name: "SumTaxBonus", data: "SumTaxBonus" },
                        { name: "SumTaxConvert", data: "SumTaxConvert" },
                        { name: "SumTaxPerformed", data: "SumTaxPerformed" },
                        { name: "UnWithDrawTotal", data: "UnWithDrawTotal" },
                        {
                            name: "CreateTime",
                            data: null,
                            render: function (data, type, row, meta) {
                                return moment(data.CreateTime).format("YYYY-MM-DD HH:mm");
                            }
                        },
                        { name: "Status", data: "Status" },
                        { name: "TopUserID", data: "TopUserID" },
                        { name: "NickName", data: "NickName" },
                        {
                            orderable: false,
                            data: function (data, type, row) {
                                return '<a class="btn btn-sm btn-success" href="/Agent/Customer/Edit/' + data.UserID + '">編輯</a>';
                            }
                        }
                    ],
                    responsive: true
                });

            $('#btnQuery').click(function () {
                table.draw();
            });

            $('#btnExcel').click(function () {
                var fieldArr = ['subUserID','dtStartTime','dtEndTime'];
                var url = '@Url.Action("SubUserInfoExcel", "Customer")' + '?' + GetInputUrlString(fieldArr);
                location.href = url;
            });

            function GetInputUrlString(fieldArr) {
                var inputString = '';
                for (i = 0; i < fieldArr.length; i++) {
                    if (i != 0) {
                        inputString += '&';
                    }
                    inputString += fieldArr[i] + '=' + $('#' + fieldArr[i]).val();
                }
                return inputString;
            }
        })
    </script>
}
