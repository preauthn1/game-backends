@{     
    string brandName = System.Configuration.ConfigurationManager.AppSettings["brandName"] ?? "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@(brandName)代理系统</title>
    <link rel="SHORTCUT ICON" href="~/favicon.ico" type="image/x-icon">
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.6 -->
    <link rel="stylesheet" href="~/Areas/Agent/Content/bootstrap/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://example.invalid/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://example.invalid/ajax/libs/ionicons/2.0.1/css/ionicons.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://example.invalid/ajax/libs/limonte-sweetalert2/6.10.3/sweetalert2.css" />
    <!-- AdminLTE Skins. Choose a skin from the css/skins
         folder instead of downloading all of them to reduce the load. -->
    <link rel="stylesheet" href="~/Areas/Agent/Content/dist/css/skins/_all-skins.min.css">
    <!-- daterange picker -->
    <link href="~/Areas/Agent/Content/plugins/daterangepicker/daterangepicker.css" rel="stylesheet" />
    <!-- DataTables -->
    <link href="https://example.invalid/1.10.19/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://example.invalid/responsive/2.2.3/css/responsive.dataTables.min.css" rel="stylesheet" />
    @RenderSection("head", required: false)


    <!-- Theme style -->
    <link rel="stylesheet" href="~/Areas/Agent/Content/dist/css/AdminLTE.min.css">
    <link href="@Url.Content("~/Content/SiteCustom.css")" rel="stylesheet" />

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://example.invalid/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://example.invalid/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <style type="text/css">
        .field-validation-error {
            color: #dd4b39;
        }

        .user-panel > .image > img {
            max-width: 80px;
        }

        .user-panel > .info {
            left: 90px;
        }
    </style>
</head>

<body class="hold-transition skin-green-light layout-boxed sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <header class="main-header">
            <!-- Logo -->
            <a href="@Url.Action("Index", "Admin")" class="logo">
                <!-- mini logo for sidebar mini 50x50 pixels -->
                <span class="logo-mini"></span>
                <!-- logo for regular state and mobile devices -->
                <span class="logo-lg">@(brandName)代理系统</span>
            </a>
            <!-- Header Navbar: style can be found in header.less -->
            <nav class="navbar navbar-static-top">
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </a>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        <li><a href="@Url.Action("Password", "Admin")"><i class="fa fa-edit"></i><span>修改密码</span></a></li>
                        <li><a href="@Url.Action("LogOut", "Admin")"><i class="fa fa-sign-out"></i><span>退出登录</span></a></li>
                        <!-- Control Sidebar Toggle Button -->
                    </ul>
                </div>
            </nav>
        </header>
        <!-- =============================================== -->
        <!-- Left side column. contains the sidebar -->
        <aside class="main-sidebar">
            <!-- sidebar: style can be found in sidebar.less -->
            <section class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel">
                    <div class="pull-left image">                 
                        @if (string.IsNullOrEmpty(UserHelper.User.QRURL))
                        {
                            var platformAreas = UserHelper.PlatformArea ?? new List<PlatformArea>();
                            string platformsHint = string.Join(",",platformAreas.Select(x => x.PlatformID).Distinct());

                            <img src="~/Areas/Agent/Content/dist/img/avatar5.png" class="img-circle" alt="User Image" title="@platformsHint"  >
                        }
                        else
                        {
                            <img src="/QRCode/GetLiveQRCode?url=@UserHelper.User.QRURL" alt="User Image" style="cursor:pointer" onclick="window.open(this.src);">
                        }
                        
                    </div>
                    <div class="pull-left info">
                        @if (@UserHelper.User.Role == RoleType.Agent)
                        {    
                            <p>@UserHelper.User.UserID</p>
                        }
                        else
                        {
                            <p title="@UserHelper.User.UserID" >
                                @UserHelper.User.NickName
                            </p>
                        }
                        <p> @(UserHelper.User.Role.ToDescription())</p>
                        @if (!string.IsNullOrEmpty(UserHelper.User.QRURL))
                        {
                        <button id="clipboard_qrurl" class="btn btn-success btn-sm btn-block btn-flat" data-clipboard-text="@UserHelper.User.QRURL">复制链接</button>  
                        }
                    </div>
                </div>
                <!-- sidebar menu: : style can be found in sidebar.less -->
                <section class="sidebar" style="height: auto;">             
                    <!-- sidebar menu: : style can be found in sidebar.less -->
                    @Html.Partial("_MainNavigation") 
                </section>
            </section>
            <!-- /.sidebar -->
        </aside>
        <!-- =============================================== -->
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <section class="content-header">
                <h1>
                    @ViewBag.Title
                </h1>
                <ol class="breadcrumb">
                    <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
                    <li class="active">Dashboard</li>
                </ol>
            </section>
            <!-- Main content -->
            <section class="content">
                @Html.Partial("_Alerts")                               
                @Html.Partial("_ValidationSummary")
                <!-- Default box -->
                @RenderBody()
                <!-- /.box -->
            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->       
        <!-- Add the sidebar's background. This div must be placed
             immediately after the control sidebar -->
        <div class="control-sidebar-bg"></div>
    </div>
    <!-- ./wrapper -->
    <!-- jQuery 2.2.3 -->
    <script src="/Areas/Agent/Content/plugins/jQuery/jquery-2.2.3.min.js"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
    <!-- clipboard -->
    <script src="~/Scripts/clipboard.min.js"></script>
    <!-- Bootstrap 3.3.6 -->
    <script src="/Areas/Agent/Content/bootstrap/js/bootstrap.min.js"></script>
    <!-- SlimScroll -->
    <script src="/Areas/Agent/Content/plugins/slimScroll/jquery.slimscroll.min.js"></script>
    <!-- FastClick -->
    <script src="/Areas/Agent/Content/plugins/fastclick/fastclick.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://example.invalid/ajax/libs/limonte-sweetalert2/6.10.3/sweetalert2.js"></script>
    <!-- AdminLTE App -->
    <script src="/Areas/Agent/Content/dist/js/app.min.js"></script>
    <!-- AdminLTE for demo purposes -->
    <script src="/Areas/Agent/Content/dist/js/demo.js"></script>
    <!-- InputMask -->
    <script src="~/Areas/Agent/Content/plugins/input-mask/jquery.inputmask.js"></script>
    <script src="~/Areas/Agent/Content/plugins/input-mask/jquery.inputmask.date.extensions.js"></script>
    <script src="~/Areas/Agent/Content/plugins/input-mask/jquery.inputmask.extensions.js"></script>
    <!-- DataTables -->
    <script src="https://example.invalid/1.10.19/js/jquery.dataTables.min.js"></script>
    <script src="https://example.invalid/responsive/2.2.3/js/dataTables.responsive.min.js"></script>
    <!-- daterangepicker -->
    <script src="~/Areas/Agent/Content/plugins/daterangepicker/moment.min.js"></script>
    @RenderSection("scripts", required: false)

    <script type="text/javascript">
        $.ajaxSetup({
            statusCode: {
                403: function () {
                    window.location.href = "@Url.Action("LogOut", "Admin", new { Area = "Agent" })";
                }
            },
            error: function (xhr, statusText, err) {
                if (xhr.status == '403')
                    alert("登入已逾時，請重新登入");
                else
                    alert('error');
            }
        });

        $(".alert-custom").delay(5000).animate({
            "height": "0px",
            "opacity": 0,
            "padding": 0,
            "margin-bottom": 0
        }, 1500,
        function ()
        {
            $(this).remove();            
        });

        //問號類的icon 都會顯示
        $(".glyphicon-question-sign").tooltip();


        new ClipboardJS('#clipboard_qrurl').on('success', function (e) {          
            alert(e.text);
            e.clearSelection();
        });
    </script>

</body>
</html>