@{
    ViewBag.Title = "充值兑换记录";
}

@Html.Action("Index", "Profit")

<div class="box box-primary">
    <!-- form start -->
    <div class="box-body">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-lg-2 col-md-3 col-sm-3 col-xs-12">统计日期</label>
                <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtStartTime">
                </div>
                <label class="col-lg-1 col-md-1 col-sm-1 col-xs-12">到</label>
                <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtEndTime">
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-1 col-md-2 col-sm-2 col-xs-12">
                    <button type="button" id="btnQuery" class="btn btn-primary btn-block">搜索</button>
                </div>
            </div>
        </div>
        <hr class="hr-sm1">

        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>                      
                        <th>用户ID</th>
                        <th>充值</th>
                        <th>兑换</th>
                        <th>库存金币</th>
                        <th>净利润</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- /.box -->
@section scripts{
    <!-- Page script -->
    <script type="text/javascript">
        $(function () {

            //DataTable
            var table =
                $('#example1').DataTable({
                    "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                    "searching": false,
                    "autoWidth": false,
                    "serverSide": true,
                    "deferLoading": 0,
                    "order": [[4, 'desc']],
                    "ajax": {
                        method: 'post',
                        url: '@Url.Action("WithdrawDetail", "Profit")',
                        data: function (d) {                   
                            d.dtStartTime = $('#dtStartTime').val();
                            d.dtEndTime = $('#dtEndTime').val();
                        },
                        "dataSrc": function (json) {
                            if (json.success == false)
                                swal("错误", json.message, "error");

                            return json.data;
                        }
                    },
                    columns: [
                        { name: "UserID", data: "UserID" },
                        { name: "ChargeAmount", data: "ChargeAmount" },
                        { name: "ConvertAmount", data: "ConvertAmount" },
                        { name: "StorageAmount", data: "StorageAmount" },
                        { name: "BonusAmount", data: "BonusAmount" }
                    ],
                    responsive: true
                });

                $('#btnQuery').click(function () {            
                    table.draw();
                });
        })
    </script>
}

