@{
    ViewBag.Title = "平台比例設定";
}

@model List<ProfitAgent_GetSystemRateDaylimit>

@Html.Action("Index", "Profit")

<div class="box box-primary">
    <!-- form start -->

    <div class="box-body">
        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>平台</th>
                        <th>分成比例</th>
                        <th>提领天数</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- 選項部分 -->
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PlatformName</td>
                                <td>@(item.Rate * 0.1)%</td>
                                <td>@item.WithDrawDayLimit</td>  
                                <td>                                 
                                    <button type="button" class="btn btn-sm btn-success" 
                                            data-toggle="modal" 
                                            data-target="#modal-default"                                        
                                            data-platformID="@(item.PlatformID)"
                                            data-rate="@(item.Rate * 0.1)"
                                            data-withDrawDayLimit="@(item.WithDrawDayLimit)"
                                            data-platformName="@(item.PlatformName)">编辑</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- /.box-body -->
    </div>
</div>

<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("SystemRateDaylimit", "Profit", new { Area = "Agent" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                <div class="modal-header bg-light-blue-active text-white">
                    <h5 class="modal-title" id="exampleModalLabel">设定视窗</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="col-sm-12">平台</label>
                        <div class="col-sm-12">
                            <input class="form-control" id="PlatformName" name="PlatformName" type="text" disabled>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-12">分成比例</label>
                        <div class="col-sm-12">
                            <input class="form-control" id="UserRate" name="UserRate" max="100" min="0" step="0.01" type="number">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-12">提领天数</label>
                        <div class="col-sm-12">
                            <input class="form-control" id="WithDrawDayLimit" name="WithDrawDayLimit" max="1000" min="0" step="1" type="number">
                        </div>
                    </div>
                    <input type="hidden" id="PlatformID" name="PlatformID">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light text-dark" data-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">确认</button>
                </div>
            }
        </div>
    </div>
</div>



<!-- /.box -->
@section scripts{
    <!-- Page script -->
    <script type="text/javascript">
        $(function () {

            //DataTable
            $('#example1').DataTable({
                "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                "searching": false,
                responsive: true
            });

            $('#modal-default').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
              

                var platformID = button.data('platformid');             
                var platformName = button.data('platformname');               
                var rate = button.data('rate');               
                var withDrawDayLimit = button.data('withdrawdaylimit');
                

                var modal = $(this);
                modal.find('#PlatformID').val(platformID);
                modal.find('#PlatformName').val(platformName);
                modal.find('#UserRate').val(rate);
                modal.find('#WithDrawDayLimit').val(withDrawDayLimit);
            });
        })
    </script>
}
