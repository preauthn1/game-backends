<appSettings>

  <add key="webpages:Version" value="0.0.0.0" />
  <add key="webpages:Enabled" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  <!--显示中1个金币与数据存储的比例,如：100表示 显示的一个金币在数据中存储的是100个金币 -->
  <add key="CoinShowRate" value="100" />
  <!--资料快取时间(分)-->
  <add key="CacheTime" value="120" />
  <!--game api位置-->
  <add key="GameAPIUrl" value="http://0.0.0.0:100/api/v1/" />
  <!--與後端API溝通需要的 id & key 值, 需與後端一致 -->
  <add key="GameAPIID" value="1" />
  <add key="GameAPIKey" value="123" />
  <!-- SMS轉發位置-->
  <add key="SendSMSUrl" value="http://0.0.0.0/SMS/Send" />
  <add key="brandName" value="DD" />
  
</appSettings>

