@{
    ViewBag.Title = "审核代理申请";
}

@Html.Action("Index", "Profit")

<div class="box box-primary">
    <!-- form start -->

    <div class="box-body">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-lg-1 col-md-2 col-sm-2 col-xs-12">用戶ID</label>
                <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
                    <input type="text" class="form-control" id="intTargetID">
                </div>

                <label class="col-lg-1 col-md-2 col-sm-2 col-xs-12">申请日期</label>
                <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtStartTime">
                </div>

                <label class="col-lg-1 col-md-2 col-sm-2 col-xs-12">到</label>
                <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
                    <input type="date" class="form-control" id="dtEndTime">
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-1 col-md-2 col-sm-2 col-xs-12">
                    <button type="button" id="btnQuery" class="btn btn-primary btn-block">搜索</button>
                </div>
            </div>
        </div>
        <hr class="hr-sm1">

        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>申请玩家ID</th>
                        <th>昵称</th>
                        <th>上级ID</th>                       
                        <th>申请日期</th>
                        <th>状态</th>
                        <th>更新日期</th>
                        <th>审核ID</th>                      
                        <th>操作</th>
                    </tr>
                </thead>
            </table>
        </div>
        <!-- /.box-body -->
    </div>
</div>

<div class="modal fade fade" id="Applymodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("AgentApply", "Profit", new { Area = "Agent" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
            <div class="modal-header bg-light-blue-active text-white">
                <h5 class="modal-title" id="exampleModalLabel">确认视窗</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ApplyUser" name="id">      
                <input type="hidden" id="Status" name="status" value="1">      
                確認審核通过?                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary bg-light text-dark" data-dismiss="modal">取消</button>
                <button type="submit" id="Delete" class="btn btn-primary">确认</button>
            </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="RefuseModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("AgentApply", "Profit", new { Area = "Agent" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                <div class="modal-header bg-light-blue-active text-white">
                    <h5 class="modal-title" id="exampleModalLabel">确认视窗</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="ApplyUser" name="id">
                    <input type="hidden" id="Status" name="Status" value="2">
                    確認<b>拒绝</b>通过?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light text-dark" data-dismiss="modal">取消</button>
                    <button type="submit" id="Delete" class="btn btn-primary">确认</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- /.box -->
@section scripts{
    <!-- Page script -->
    <script type="text/javascript">
        $(function () {

            //DataTable
            var table =
                $('#example1').DataTable({
                    "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                    "searching": false,
                    "autoWidth": false,
                    "serverSide": true,
                    "deferLoading": 0,
                    "order": [[ 3, 'desc' ]],
                    "ajax": {
                        method: 'post',
                        url: '@Url.Action("AgentApplyList", "Profit")',
                        data: function (d) {                         
                            d.dtStartTime = $('#dtStartTime').val();
                            d.dtEndTime = $('#dtEndTime').val();
                            d.intTargetID = $('#intTargetID').val();
                        },
                        "dataSrc": function (json) {
                            if (json.success == false)
                                swal("错误", json.message, "error");

                            return json.data;
                        }
                    },
                    columns: [
                        { name: "ApplyUser", data: "ApplyUser" },
                        { name: "NickName", data: "NickName" },
                        { name: "TopUserID", data: "TopUserID" },                        
                        {
                            name: "CreateTime",
                            data: null,
                            render: function (data, type, row, meta) {
                                return moment(data.CreateTime).format("YYYY-MM-DD HH:mm");
                            }
                        },
                        { name: "Status", data: "Status" },                      
                        {
                            name: "UpdateTime",
                            data: null,
                            render: function (data, type, row, meta) {
                                return moment(data.CreateTime).format("YYYY-MM-DD HH:mm");
                            }
                        },
                        { name: "Account", data: "Account" }, 
                        {
                            orderable: false,
                            visible: @(UserHelper.User.Role == RoleType.Biz ? "true":"false"),
                            data: function (data, type, row) {
                                if (data.StatusNo == 0)
                                    return '<button class="btn btn-sm btn-success" data-toggle="modal" data-target="#Applymodal" data-whatever="' + data.ApplyUser + '">通过</button> ' +
                                           '<button class="btn btn-sm" data-toggle="modal" data-target="#RefuseModal" data-whatever="' + data.ApplyUser + '">拒绝</button>';
                                else
                                    return '<button class="btn btn-sm btn-success" disabled data-toggle="modal" data-target="#Applymodal" data-whatever="' + data.ApplyUser + '">通过</button> ' +
                                           '<button class="btn btn-sm" disabled data-toggle="modal" data-target="#RefuseModal" data-whatever="' + data.ApplyUser + '">拒绝</button>';
                            }
                        }
                    ],
                    responsive: true
                });

            $('#btnQuery').click(function () {
                table.draw();
            });

            $('#Applymodal, #RefuseModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget)
                var recipient = button.data('whatever')
              
                var modal = $(this)
                modal.find('#ApplyUser').val(recipient);
            });          
        })
    </script>
}

