
@{
    Layout = null;
}

@model UserAgent_GetAgentExecInfo

@if (UserHelper.User.Role == RoleType.Agent)
{
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box bg-blue-gradient">
                <span class="info-box-icon"><i class="fa fa-fw fa-star"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">推广等级</span>
                    <span class="info-box-number">Lv:@(Model.AgentLevel) @(((UserLevel)Model.AgentLevel).ToDescription())</span>

                    <div class="progress">
                        <div class="progress-bar" style="width: @(Model.Rate)%"></div>
                    </div>
                    <span class="progress-description">
                        @(Model.AgentUserAmount) / @(Model.AgentAmount) @(Model.Rate)%
                    </span>
                </div>
                <!-- /.info-box-content -->
            </div>
        </div>
        <!-- /.col -->
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-red"><i class="fa fa-fw fa-cny"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">今日税收</span>
                    <span class="info-box-number">@(Model.AgentTaxAmount.ToCash())</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>
        <!-- /.col -->
        <!-- fix for small devices only -->
        <div class="clearfix visible-sm-block"></div>

        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-green"><i class="fa fa-fw fa-money"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">今日收益</span>
                    <span class="info-box-number">@(Model.AgentTaxBonus.ToCash())</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-yellow-active"><i class="fa fa-fw fa-user"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">推广人数</span>
                    <span class="info-box-number">@(string.Format("{0:N0}", Model.AgentTotalUser))</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>
    </div>
}
else
{
    <div class="row"> 
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-blue-gradient"><i class="fa fa-fw fa-user"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">代理总人数</span>
                    <span class="info-box-number">@(string.Format("{0:N0}", Model.AgentTotalUser))</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-yellow-active"><i class="fa fa-fw fa-user"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">今日下载人数</span>
                    <span class="info-box-number">@(string.Format("{0:N0}", Model.AgentAgentUser))</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>       
        <!-- fix for small devices only -->
        <div class="clearfix visible-sm-block"></div>
        <!-- /.col -->
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-green"><i class="fa fa-fw fa-money"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">奖励总金额</span>
                    <span class="info-box-number">@(Model.AgentTaxBonus.ToCash())</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div> 
        <!-- /.col -->
        <div class="col-md-3 col-sm-6 col-xs-12">
            <div class="info-box">
                <span class="info-box-icon bg-red"><i class="fa fa-fw fa-cny"></i></span>

                <div class="info-box-content">
                    <span class="info-box-text">提现总金额</span>
                    <span class="info-box-number">@(Model.WithDrawAmount.ToCash())</span>
                </div>
                <!-- /.info-box-content -->
            </div>
            <!-- /.info-box -->
        </div>               
    </div>
}