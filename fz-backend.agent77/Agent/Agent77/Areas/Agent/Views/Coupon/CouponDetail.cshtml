@{
    ViewBag.Title = "我的代理";
}
@model Coupon_DailyReportModel

<div class="box box-primary">
    <!-- form start -->

    <div class="box-body">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-lg-1 col-md-2 col-sm-2 col-xs-12">礼码序号</label>
                <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
                    <input type="text" class="form-control" id="coupon_code">
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-1 col-md-2 col-sm-2 col-xs-12">
                    <button type="button" id="btnQuery" class="btn btn-primary btn-block">搜索</button>
                </div>
            </div>
        </div>
        <hr class="hr-sm1">

        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>礼码序号</th>
                        <th>兑换玩家ID</th>
                        <th>赠送金额</th>
                        <th>发送日期</th>
                    </tr>
                </thead>
            </table>
        </div>
        <!-- /.box-body -->
    </div>
</div>

<!-- /.box -->
@section scripts{
    <!-- Page script -->
    <script type="text/javascript">
        $(function () {

            //DataTable
            var table =
                $('#example1').DataTable({
                    "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                    "searching": false,
                    "autoWidth": false,
                    "serverSide": true,
                    "deferLoading": 0,
                    "ajax": {
                        method: 'post',
                        url: '@Url.Action("CouponDetail", "Coupon")',
                        data: function (d) {
                            d.coupon_code = $('#coupon_code').val();
                        },
                        "dataSrc": function (json) {
                            if (json.success == false) {
                                return [];
                                swal("错误", json.message, "error");
                            }
                            return json.data.data;
                        }
                    },
                    columns: [
                        { name: "CouponCode", data: "CouponCode" },
                        { name: "UserID", data: "UserID" },
                        { name: "Amount", data: "Amount" },
                        {
                            name: "UseDate",
                            data: null,
                            render: function (data, type, row, meta) {
                                if (!data.UseDate) {
                                    return "";
                                }
                                return moment(data.UseDate).format("YYYY-MM-DD");
                            }
                        }
                    ],
                    responsive: true
                });

            $('#btnQuery').click(function () {
                table.draw();
            });
        })
    </script>
}
