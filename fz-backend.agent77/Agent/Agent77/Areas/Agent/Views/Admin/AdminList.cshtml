@{
    ViewBag.Title = "管理员列表";
}

@model List<AdminListModel>

<div class="box box-primary">
    <!-- form start -->

    <div class="box-body">  
        <!-- 查詢結果 -->
        <div class="box-header">
            <h3 class="box-title">搜索结果</h3>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>账号</th>
                        <th>状态</th>
                        <th>身份</th>
                        <th>注册时间</th>
                        <th>平台</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- 選項部分 -->
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Account</td>
                                <td>@(item.Status==1?"开启":"停用")</td>
                                <td>@item.AdminType.ToDescription()</td>                             
                                <td>@item.CreateTime.ToString("yyyy-MM-dd hh:mm")</td>
                                <td>
                                    <button class="btn btn-sm" data-toggle="modal" data-target="#Applymodal" data-whatever="@(item.ID)">明细</button>                                  
                                </td>
                                <td>                                  
                                    @Html.ActionLink("編輯", "EditAgentUser", new { ID = item.ID, Account = item.Account, Status = item.Status, AdminType = (int)item.AdminType }, new { @class= "btn btn-sm btn-success" })
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- /.box-body -->
    </div>
</div>

<div class="modal fade fade" id="Applymodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">            
            <div class="modal-header bg-light-blue text-white">
                <h5 class="modal-title" id="exampleModalLabel">平台明细</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">              
                <table class="table table-hover table-striped">
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary bg-light text-dark" data-dismiss="modal">取消</button>                   
            </div>         
        </div>
    </div>
</div>

<!-- /.box -->
@section scripts{   
    <!-- Page script -->
    <script type="text/javascript">
        var $Applymodal_table = $('#Applymodal table');

        $(function () {

            //DataTable
            $('#example1').DataTable({
                "language": { "url": "/Areas/Agent/Content/plugins/datatables/Chinese.json" },
                columns: [
                            null,
                            null,
                            null,
                            null,
                            { width: "60" },
                            { width: "60"}
                         ],
                responsive: true
            });

            $('#Applymodal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget)
                var recipient = button.data('whatever')            
             

                $.ajax({
                    type: 'post',
                    cache: false,
                    async: true,
                    dataType: 'json',
                    dataType: 'json',
                    url: '@Url.Action("AdminPlatform", "Admin")',
                    data: { id: recipient },
                    success: function (data) {                       
                        $Applymodal_table.empty();

                        $.each(data, function (i, item) { 
                            $Applymodal_table.append('<tr><td>' + item.PlatformName + '</td></tr>');
                        });
                    }
                });
            });
        })
    </script>
}

