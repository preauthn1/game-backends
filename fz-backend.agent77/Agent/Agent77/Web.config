<configuration> 
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://example.invalid/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" requirePermission="false" />
  </configSections>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>   
  </system.webServer>  
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=(LocalDb)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\aspnet-Agent-20190412061538.mdf;Initial Catalog=aspnet-Agent-20190412061538;Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="AdminSysEntities" connectionString="metadata=res://*/Models.AdminSys.csdl|res://*/Models.AdminSys.ssdl|res://*/Models.AdminSys.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=0.0.0.0;initial catalog=AdminSys;user id=sa;password=[REDACTED];MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="CenterDBEntities" connectionString="metadata=res://*/Models.CenterDB.csdl|res://*/Models.CenterDB.ssdl|res://*/Models.CenterDB.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=0.0.0.0;initial catalog=CenterDB;user id=sa;password=[REDACTED];MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="ClubEntities" connectionString="metadata=res://*/Models.Club.csdl|res://*/Models.Club.ssdl|res://*/Models.Club.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=0.0.0.0;initial catalog=Club02;user id=sa;password=[REDACTED];MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="0.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!--显示中1个金币与数据存储的比例,如：100表示 显示的一个金币在数据中存储的是100个金币 -->
    <add key="CoinShowRate" value="100" />
    <!--资料快取时间(分)-->
    <add key="CacheTime" value="120" />
    <!--game api位置-->
    <add key="GameAPIUrl" value="http://0.0.0.0:100/api/v1/" />
    <!--與後端API溝通需要的 id & key 值, 需與後端一致 -->
    <add key="GameAPIID" value="1" />
    <add key="GameAPIKey" value="123" />
    <!-- SMS轉發位置-->
    <add key="SendSMSUrl" value="http://0.0.0.0/SMS/Send"/>
  </appSettings>
  <!--
    如需 web.config 變更的說明，請參閱 http://example.invalid/fwlink/?LinkId=235367。

    您可以在 <httpRuntime> 標記上設定下列屬性。
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Agent/Admin/Login" timeout="2280" />
    </authentication>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
    <!--<roleManager defaultProvider="CustomRoleProvider" enabled="true" cacheRolesInCookie="true" maxCachedResults="256">
      <providers>
        <clear/>
        <add name="CustomRoleProvider" type="Agent77.Modules.CustomRoleProvider, Agent77"/>
      </providers>           
    </roleManager>-->
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken=[REDACTED]" />
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken=[REDACTED]" />
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken=[REDACTED]" />
        <bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234" />
