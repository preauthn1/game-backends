<configuration>
  <connectionStrings>
    <add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>
    <!--商户编号密钥-->
    <add key="merId" value="10000005"/>
    <add key="md5_key" value="ce29d6b6304a6bdf4e43be677150162c"/>   

    <add key="withdrawUrl" value="https://example.invalid/paygateway/settlement"/>
    <!--银行打款回调位置-->
