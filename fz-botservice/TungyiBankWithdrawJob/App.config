<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- add name="dbConnection" connectionString="data source=0.0.0.0,1433;database=LogDB;uid=alan;pwd=[REDACTED];" providerName="System.Data.SqlClient"/> -->
    <add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>

    <!--fz商户编号密钥-->
    <add key="mchid" value="10003"/>
    <add key="mchkey" value="88f9783962ffd9213e34c4d27460423a"/>

    <!--统一支付银行打款订单建立位置-->
    <add key="withdrawUrl" value="http://0.0.0.0/withdraw/create"/>
    
    <!--统一支付银行打款回调位置-->
    <add key="callbackUrl" value="http://example.invalid/Convert/WithdrawCallback"/>
    <!--兑换商编号-->
    <add key="convert_gwid" value="1"/>
    <!--兑换类型(1:支付宝;2:银联)-->
    <add key="convert_type" value="2"/>   
    <!--测试模式(true:测试;false:正式)-->
    <add key="convert_Debug" value="true"/>
    
    <add key="fileLog" value="fileLog.log"/>
  </appSettings>
    
  <startup> 
      <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

</configuration>