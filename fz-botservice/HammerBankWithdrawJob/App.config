<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>
    <!--商户编号密钥-->    
    <add key="withdrawUrl" value="http://example.invalid/dfpay/dfPayOut" />
    <add key="pay_tiechuipay_merchantCode" value="M190714001" />
    <add key="pay_tiechuipay_agentCode" value="201806130001" />  
    <add key="pay_tiechuipay_channelCode" value="M008" />
    <add key="pay_tiechuipay_key" value="" />
    <add key="pay_tiechuipay_RSA_PublicKey" value="" />
    <add key="pay_tiechuipay_RSA_PrivateKey" value="" />


    <!--兑换商编号-->
    <add key="convert_gwid" value="3"/>
    <!--兑换类型(1:支付宝;2:银联)-->
    <add key="convert_type" value="2"/>
    <!--测试模式(true:测试;false:正式)-->
    <add key="convert_Debug" value="false"/>

    <add key="fileLog" value="fileLog.log"/>
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
</configuration>