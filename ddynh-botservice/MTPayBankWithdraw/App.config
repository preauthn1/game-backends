<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
      <add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
      <!--<add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>-->
    </connectionStrings>

    <appSettings>
        <!--商户号-->
        <add key="merId" value="GBP002101123" />
        <!--商户号密钥-->
        <add key="md5_key" value="B9C8EA1R987D43EE7RC0461ABCW5E123" />
    
        <!--下單接口-->
        <add key="withdrawUrl" value="https://example.invalid/payout" />
        <!--银行打款回调位置-->
      <add key="callbackUrl" value="http://example.invalid/Convert/MTWithdrawCallback" />
      <!--<add key="callbackUrl" value="http://example.invalid/Convert/MTWithdrawCallback" />-->

        <!--兑换商编号 需對照Payment.PayGateway-->
        <add key="convert_gwid" value="68"/>
        <!--兑换类型(1:支付宝;2:银联)-->
        <add key="convert_type" value="2"/>
        <!--测试模式(true:测试;false:正式)-->
        <add key="convert_Debug" value="false"/>
    </appSettings>

    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
</configuration>