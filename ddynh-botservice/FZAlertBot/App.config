<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="dbConnection" connectionString="data source=0.0.0.0,1433;database=CenterDB;uid=alan;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>

    <!-- alan test bot FZ -->
    <add key="bottoken" value="[TG_BOT_TOKEN_REDACTED]"/>
    <add key="chatid" value="-293006250"/>    
    <!-- alan test bot 986 -->
    <!--<add key="bottoken" value="[TG_BOT_TOKEN_REDACTED]"/>
    <add key="chatid" value="-1001458573375"/>-->
    
    
    <!-- 電報轉發位置-->
    <add key="sendAlertUrl" value="http://0.0.0.0:8080/sendmessage.ashx"/>
    

    <!--每小時充直總額電報監控是否啟用-->
    <add key="payTotalPerHourCheck" value="1"/>


    <!-- 支付充值成功率監控是否啟用 -->
    <add key="paySuccessRateCheck" value="1"/>
    <!-- 支付充值成功率警報底限 (%) -->
    <add key="paymentAlert" value="30"/>
    <!-- 支付成功率監控檢查週期 (min) -->
    <add key="paySuccessRateMonitorInterval" value="10"/>


    <!-- 支付狀態監控是否啟用 -->
    <add key="payOrderStatusCheck" value="1"/>
    <!-- 支付状态監控檢查週期 (min) -->
    <add key="payOrderStatusMonitorInterval" value="3"/>
    <!-- 支付狀態, 超過多少時間無任何訂單(min)-->
    <add key="payOrderSilenceTimeLimit" value="15"/>
    <!-- 支付狀態, 最後一筆訂單超過多少時間沒有完成充值(min) -->
    <add key="payOrderFailTimeLimit" value="60"/>

    <!-- 短信成功率監控是否啟用 -->
    <add key="smsSuccessRateCheck" value="1"/>
    <!-- 短信成功率警報底限 (%) -->
    <add key="smsAlert" value="80"/>
    <!-- 短信商户号FZ -->
    <add key="smsAppid" value="20829"/>
    <!-- 短信商户密钥FZ -->
    <add key="smsSignature" value="bbae493b7c4f435219a63284362b7953"/>
    <!-- 短信商户号986 -->
    <!--<add key="smsAppid" value="35695"/>-->
    <!-- 短信商户密钥986 -->
    <!--<add key="smsSignature" value="47176d5e208db5ebabe13c2c33207a21"/>-->
    
    <!-- 短信額度監控是否啟用 -->
    <add key="smsQuotaCheck" value="1"/>
    <!-- 短信額度数量警報底限 -->
    <add key="smsQuota" value="500"/>
    <!-- 短信檢查週期 (min) -->
    <add key="smsMonitorInterval" value="10"/>


    <!-- 兌換輸贏檢查監控是否啟用 -->
    <add key="convertWinLostCheck" value="1"/>    
    <!-- 兌換輸贏檢查週期 (sec)-->
    <add key="convertWinLostInterval" value="1"/>



    <!-- 註冊用戶監控是否啟用 -->
    <add key="userInfoCheck" value="1"/>
    <!-- 註冊用戶檢查週期 (sec)-->
    <add key="userInfoCheckInterval" value="3600"/>

    <!-- 线上用户数量监控是否启用 -->
    <add key="onlineUserCheck" value="1"/>
    <!-- 线上用户数量檢查週期 (sec)-->
    <add key="onlineUserCheckInterval" value="1800"/>






  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
  </startup>
</configuration>
