<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="dbConnection" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>
    <!--商户编号密钥-->
    <add key="agtId" value="19060586"/>
    <add key="merId" value="1906058675"/>
    <add key="md5_key" value="SuCTZAJWWhYiJMbjIMevGUAQnB16eyL9"/>
    <add key="priKey" value=""/>    
    
    <!--银行打款订单建立位置-->
    <add key="withdrawUrl" value="https://example.invalid/webwt/pay/gateway.do"/>
    <!--银行打款回调位置-->
    <add key="callbackUrl" value="http://example.invalid/Convert/HemaWithdrawCallback"/>
    <!--兑换商编号-->
    <add key="convert_gwid" value="2"/>
    <!--兑换类型(1:支付宝;2:银联)-->
