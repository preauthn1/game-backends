@model KCKJ.Core.AdminSys.Provider.AdminSysInfo
@using KCKJ.Core.AdminSys.WebUI
@{
    string message = ViewBag.message;    
}
@section head{
    <title>@Model.SystemName</title>
    }
@section css{
    <style type="text/css">
        .align-center {
            margin: 0 auto;
            width: 400px; 
            text-align: center;
            margin-top:150px;
        }
        .error {
            color: red;
            text-align: center;
            margin: 0 auto;
            width: 200px;
            padding-bottom:10px
        }
    </style>
}

<form action="@Url.Action("Logon")" method="post">
    <div class="align-center">
        <div style="margin:20px 0;">
        </div>
        <div class="easyui-panel" title="登陆" style="width: 400px; padding: 30px 60px; ">
            @if (!String.IsNullOrWhiteSpace(message))
            {
                <div class="error">@message</div>
            }
            <div style="margin-bottom:20px">
                <div>账号:</div>
                <input class="easyui-textbox" name="loginName" style="width:100%;height:32px" iconcls="icon-man" data-options="required:true,missingMessage:'用户名不能为空'">
            </div>
            <div style="margin-bottom:20px">
                <div>密码:</div>
                <input type="password" class="easyui-textbox" name="password" style="width:100%;height:32px" iconcls="icon-lock" data-options="required:true,missingMessage:'密码不能为空'">
            </div>
            <div>
                <a href="#" class="easyui-linkbutton" iconcls="icon-ok" style="width:100%;height:32px" onclick="$(document.forms[0]).submit()">登陆</a>
            </div>
        </div>
    </div>
</form>