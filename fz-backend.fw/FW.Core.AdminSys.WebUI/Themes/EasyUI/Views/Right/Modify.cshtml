@using KCKJ.Core.AdminSys.WebUI
@model KCKJ.Core.AdminSys.Provider.Entity.Right

<form method="post">
    <table width="800" cellpadding="2" cellspacing="2">
        <tr>
            <td align="right">父级ID:</td>
            <td>
                <input type="text" class="easyui-textbox" style="width:80px" readonly="readonly" value="@Model.ParentID" />
            </td>
        </tr>
        <tr>
            <td align="right">权限ID:</td>
            <td>
                <input type="text" class="easyui-textbox" name="rightID" style="width:80px" readonly="readonly" value="@Model.RightID" />
            </td>
        </tr>
        <tr>
            <td align="right">权限名称:</td>
            <td>
                <input type="text" name="RightName" class="easyui-textbox" value="@Model.RightName" style="width:300px"  data-options="required:true,missingMessage:'权限名称不能为空'" />
            </td>
        </tr>
        <tr>
            <td align="right">权限标识:</td>
            <td><input type="text" name="RightToken" class="easyui-textbox" value="@Model.RightToken" style="width:300px" data-options="required:true,missingMessage:'权限标识不能为空'" /></td>
        </tr>
        <tr>
            <td align="right">页面地址:</td>
            <td><input type="text" class="easyui-textbox" style="width:300px" value="@Model.PageUrl" name="PageUrl" /></td>
        </tr>
        <tr>
            <td align="right">权限类型:</td>
            <td>
                @{
                    string checkedPage = "";
                    if (Model.RightType == KCKJ.Core.AdminSys.Provider.Entity.RightType.PageRight) {
                        checkedPage = "checked";
                    }
                    string checkedFunc = "";
                    if (Model.RightType == KCKJ.Core.AdminSys.Provider.Entity.RightType.CommandRight)
                    {
                        checkedFunc = "checked"; 
                    }
                }
                <span><input type="radio" name="RightType" value="0" @checkedPage />页面</span>
                <span><input type="radio" name="RightType" value="1" @checkedFunc />功能</span>
            </td>
        </tr>
        <tr>
            <td align="right">排序:</td>
            <td><input type="text" name="Sort" class="easyui-textbox" style="width:100px" data-options="required:true" value="@Model.Sort" /></td>
        </tr>
        <tr>
            <td align="right">菜单显示:</td>
            <td>
            @{
                string checkedSign = "";
                if (Model.ShowInMenu) {
                    checkedSign = "checked=checked";
                }
            }
                <input type="checkbox" name="ShowInMenu" value="@Model.ShowInMenu.ToString()" @checkedSign onclick="        if ($(this).attr('checked') || $(this).prop('checked')) { $(this).val('true'); } else { $(this).val('false'); }" /></td>
        </tr>
        <tr>
            <td></td>
            <td align="left">
                @Html.ButtonWithRight(id: "btnOk", value: "确 定", method: "POST", style: "width:80px")
                @Html.Back(@Url.Action("List", new { parentID = @Model.ParentID}))
            </td>
        </tr>
    </table>

    <script>
        $(function () {
            $("#btnOk").click(function () {
                if ($("form").form("validate")) {
                    $("form").submit();
                }
            });

        })

    </script>
</form>