@using KCKJ.Core.AdminSys.WebUI
@model List<KCKJ.Core.AdminSys.Provider.Entity.Role>

<table class="easyui-datagrid" data-options="singleSelect:true,fitColumns:true" style="width:650px">
    <thead>
        <tr>
            <th data-options="field:'ck'"></th>
            <th data-options="field:'RoleID',width:50">编号</th>
            <th data-options="field:'RoleName',width:200">名称</th>
            <th data-options="field:'RoleRight',width:100"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td><input type="checkbox" name="ck" value="@role.RoleID" /></td>
                <td>@role.RoleID</td>
                <td>@role.RoleName</td>
                <td>
                    @Html.LinkWithRight(action: "RoleRight", method:"Get", value: "角色权限", href: Url.Action("RoleRight", new { roleID = role.RoleID }))
                </td>
            </tr>
        }
    </tbody>

</table>
<p style="margin-top:15px;float:left">
    @Html.AddWithRight()
    @Html.ModifyWithRight(href:"#")
    @Html.DeleteWithRight(href:"#")
</p>


<script>
    $(function () {
        $("#btnModify").click(function () {
            var id = $(":checkbox:checked").val();
            if (typeof id == "undefined") {
                $.messager.alert('提示', '请选择一项数据');
                return;
            }

            var url = "@Url.Action("Modify")";
            url = url + "?roleid=";
            url = url + id;
            window.location.href = url;
        });

        $("#btnDel").click(function () {
            var id = $(":checkbox:checked").val();
            if (typeof id == "undefined") {
                $.messager.alert('提示', '请选择一项数据');
                return;
            }

            $.messager.confirm('确认', '您确认想要删除记录吗？', function (r) {
                if (r) {
                    var url = "@Url.Action("Del")";
                    url = url + "?roleid=";
                    url = url + id;
                    window.location.href = url;
                    return;
                }
            });

        });

    })

</script>