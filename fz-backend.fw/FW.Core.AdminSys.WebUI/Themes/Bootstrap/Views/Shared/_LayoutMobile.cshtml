@using FW.Core.Engine
@using FW.Core.AdminSys.Provider
<!DOCTYPE html>
<html>
<!--[if IE 8]> <html lang="en" class="ie8 no-js"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9 no-js"> <![endif]-->
<!--[if !IE]><!-->
<html lang="en" class="no-js">
<!--<![endif]-->
<!-- BEGIN HEAD -->
<head>
    <meta charset="utf-8" />
    <title>
        @{
            var sysInfoProvider = EngineContext.Current.Resolve<ISysInfoProvider>();
            var sysInfo = sysInfoProvider.LoadSystemInfo();
        }
        @sysInfo.SystemName
    </title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="@Url.Content("~/Content/Bootstrap/main.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/plugins/font-awesome/css/font-awesome.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/plugins/bootstrap/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/plugins/uniform/css/uniform.default.css")" rel="stylesheet" type="text/css" />
    <!-- END GLOBAL MANDATORY STYLES -->
    <!-- BEGIN PAGE LEVEL STYLES -->
    @RenderSection("pageLevelStyles", false)
    <!-- END PAGE LEVEL STYLES -->
    <!-- BEGIN THEME STYLES -->
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/style-metronic.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/style.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/style-responsive.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/plugins.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/themes/grey.css")" rel="stylesheet" type="text/css" id="style_color" />
    <link href="@Url.Content("~/Content/Bootstrap/assets/css/custom.css")" rel="stylesheet" type="text/css" />
    @RenderSection("themeStyles", false)
    <!-- END THEME STYLES -->
    <!-- BEGIN JAVASCRIPTS(Load javascripts at bottom, this will reduce page load time) -->
    <!-- BEGIN CORE PLUGINS -->
    <!--[if lt IE 9]>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/respond.min.js")"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/excanvas.min.js")"></script>
    <![endif]-->
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery-1.10.2.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery-migrate-1.2.1.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/bootstrap/js/bootstrap.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/bootstrap-hover-dropdown/bootstrap-hover-dropdown.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery-slimscroll/jquery.slimscroll.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery.blockui.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery.cokie.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/uniform/jquery.uniform.min.js")" type="text/javascript"></script>
    <!-- END CORE PLUGINS -->
    <!-- BEGIN: Page level plugins -->
    @RenderSection("pageLevelPlugins", false)
    <!-- END: Page level plugins -->
    <script src="@Url.Content("~/Content/Bootstrap/assets/scripts/core/app.js")"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/scripts/custom/inbox.js")"></script>
    <script src="@Url.Content("~/Content/Bootstrap/assets/plugins/jquery-validation/dist/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/validator.js")"></script>
    <script src="@Url.Content("~/Scripts/common.js")"></script>
    <script src="@Url.Content("~/Plugins/layer-3.0.3/layer.js")"></script>
    <script src="@Url.Content("~/Plugins/sweetalert2/sweetalert2.min.js")"></script>
</head>
<!-- END HEAD -->
<!-- BEGIN BODY -->
<body class="page-header-fixed">
    <!-- BEGIN HEADER -->
    <div class="header navbar navbar-fixed-top" style="height:auto;">
        <!-- BEGIN TOP NAVIGATION BAR -->
        @{Html.RenderAction("Top", "Default");}
        <!-- END TOP NAVIGATION BAR -->
    </div>
    <!-- END HEADER -->
    <div class="clearfix">
    </div>
    <!-- BEGIN CONTAINER -->
    <div class="page-container">
        <!-- BEGIN SIDEBAR -->
        <div class="page-sidebar-wrapper">
            <div class="page-sidebar navbar-collapse collapse">
                <!-- BEGIN SIDEBAR MENU -->
                @{Html.RenderAction("MenuMobile", "Default");}
                <!-- END SIDEBAR MENU -->
            </div>
        </div>
        <!-- END SIDEBAR -->
        <!-- BEGIN CONTENT -->
        <div class="page-content-wrapper">
            <div class="page-content" style="min-height:600px !important;padding-top: 3px;">
                <!--BEGIN NAV-->
                <ul class="page-breadcrumb breadcrumb" style="margin-top: 0px;padding-top: 8px;padding-right: 0px;padding-left: 5px;margin-bottom: 10px;padding-bottom: 8px;">
                    <li class="btn-group" id="actionLogGroup">
                        @{Html.RenderAction("QuickAction", "System");}

                        <!--BEGIN ACTION LOG-->
                        <button style="display:none" type="button" class="btn blue dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-delay="1000" data-close-others="true">
                            <span>
                                最近操作记录
                            </span>
                            <i class="fa fa-angle-down"></i>
                        </button>
                        <ul style="display:none" class="dropdown-menu pull-right" role="menu" id="actionLog">

                            <li class="divider">
                            </li>
                            <li id="clear">
                                <a href="#" onclick="clearActionLog()">
                                    清空操作记录
                                </a>
                            </li>
                        </ul>
                        <!--END ACTION LOG-->
                        <!--BEGIN SAVE PAGE-->
                        <button type="button" class="btn blue dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-delay="1000" data-close-others="true">
                            <span>
                                我收藏的功能
                            </span>
                            <i class="fa fa-angle-down"></i>
                        </button>
                        <ul class="dropdown-menu pull-right" role="menu" id="actionLog">
                            @{Html.RenderAction("MyQuickAction", "System");}
                        </ul>
                        <!--END SAVE PAGE-->
                    </li>

                    <li>
                        <i class="fa fa-home"></i>
                        <a href="@Url.Action("Index", "Default")">
                            首页
                        </a>
                        <i class="fa fa-angle-right"></i>
                    </li>

                    @{Html.RenderAction("Nav", "Default");}

                    @RenderSection("NavItem", false)
                </ul>
                <!--END NAV-->
                <!--BEGIN TAB RIGHT-->
                <div class="clearfix" style="margin-bottom:3px">
                    <div class="btn-group" data-toggle="buttons">
                        @{Html.RenderAction("RightTab", "Default");}

                        @RenderSection("RightTab", false)
                    </div>
                    <a class="btn btn-default btn-show-search-condition" style="margin-top: 5px;width: 100%;" href="javascript:void(0);">展开(收起)搜索条件</a>
                </div>
                <!--END TAB RIGHT-->
                @RenderBody()
            </div>
        </div>
        <!-- END CONTENT -->
    </div>
    <!-- END CONTAINER -->
    <!-- BEGIN FOOTER -->
    <div class="footer">
        <div class="footer-inner">
            2014 &copy; Metronic by keenthemes.
        </div>
        <div class="footer-tools">
            <span class="go-top">
                <i class="fa fa-angle-up"></i>
            </span>
        </div>
    </div>
    <!-- END FOOTER -->

    <script>
        jQuery(document).ready(function () {
            // initiate layout and plugins
            App.init();

            //load action log
            loadActionLog();

            if ($('.col-md-12 form:first').size() > 0) {
                $('.btn-show-search-condition').on('click', function () {
                    $('.col-md-12 form:first').slideToggle();
                });
            }
            else {
                $('.btn-show-search-condition').remove();
            }

            $.cookie("sTimeOut", 2);
            inactivityTime();
        });

        //设置当前菜单高亮
        @{Html.RenderAction("MenuActiveMobile", "Default");}

        //jqeury validate extend
        jQuery.extend(jQuery.validator.messages, {
            required: "必选字段",
            remote: "请修正该字段",
            email: "请输入正确格式的电子邮件",
            url: "请输入合法的网址",
            date: "请输入合法的日期",
            dateISO: "请输入合法的日期 (ISO).",
            number: "请输入合法的数字",
            digits: "只能输入整数",
            creditcard: "请输入合法的信用卡号",
            equalTo: "请再次输入相同的值",
            accept: "请输入拥有合法后缀名的字符串",
            maxlength: jQuery.validator.format("请输入一个 长度最多是 {0} 的字符串"),
            minlength: jQuery.validator.format("请输入一个 长度最少是 {0} 的字符串"),
            rangelength: jQuery.validator.format("请输入 一个长度介于 {0} 和 {1} 之间的字符串"),
            range: jQuery.validator.format("请输入一个介于 {0} 和 {1} 之间的值"),
            max: jQuery.validator.format("请输入一个最大为{0} 的值"),
            min: jQuery.validator.format("请输入一个最小为{0} 的值")
        });

        //添加操作记录
        function addActionLog(name, href) {
            var logs = $.cookie("actionLog");
            var logObjs = [];
            if (typeof logs != "undefined" && logs != "") {
                logObjs = JSON.parse(logs);
            }
            var removeLogIndex = -1;
            $.each(logObjs, function (i, log) {
                if (log.name == name && log.href == href) {
                    removeLogIndex = i;
                    return;
                }
            });
            if (removeLogIndex != -1) {
                logObjs.splice(removeLogIndex, 1);
            }

            logObjs.push({ name: name, href: href });
            logObjs = logObjs.reverse();
            if (logObjs.length > 10) {
                logObjs.length = 10;
            }

            logObjs = logObjs.reverse();

            var logData = JSON.stringify(logObjs);
            $.cookie("actionLog", logData, { path: "/", expires: 365 });

        }

        //加载操作记录
        function loadActionLog() {
            $("#actionLog li[id!='clear']:not([class*='divider'])").remove();

            var logs = $.cookie("actionLog");
            if (typeof logs == "undefined" || logs == "") {
                $("#actionLogGroup").hide();
                return;
            }

            var logObjs = JSON.parse(logs);
            if (logObjs == null || logObjs.length == 0) {
                return;
            }
            $.each(logObjs, function (index, log) {
                $("#actionLog").prepend('<li><a href="' + log.href + '">' + log.name + '</a></li>');
            });

        }

        //清空操作记录
        function clearActionLog() {
            $.cookie("actionLog", "", { path: "/" })
            loadActionLog();
        }

        $("#actionFrm").validate({
            rules: {
                qa_pageName: {
                    requied: true,
                    minlength: 2,
                    maxlength: 32
                },
                qa_sort: {
                    required: true,
                    number: true
                }
            },
            submitHandler: function () {
                var pageurl = $("#qa_pageurl").val();
                var pagename = $("#qa_pagename").val();
                var sort = $("#qa_sort").val();

                var url = "@Url.Action("AddQuickActionFast", "System")";
                url = url + "?name=" + pagename;
                url = url + "&url=" + pageurl;
                url = url + "&sort=" + sort;

                $.get(url, function (data) {
                    $("#btnClosePage").click();
                    if (data == "true") {
                        $("#qa_save").hide();
                        $("#qa_cancel").show();
                    }
                });
            }
        });

        $("#qa_cancel").click(function () {
            var pageurl = "@Request.Url";
            var url = "@Url.Action("DelQuickActionFast", "System")";
            url = url + "?url=" + pageurl;

            $.get(url, function (data) {
                if (data == "true") {
                    $("#qa_save").show();
                    $("#qa_cancel").hide();
                }
            })

        });

        function inactivityTime() {
            window.onload = resetTimer;
            // DOM Events
            window.onmousemove = resetTimer;
            window.onkeypress = resetTimer;
            //window.onmousedown = resetTimer; // catches touchscreen presses
            //window.onclick = resetTimer;     // catches touchpad clicks
            //window.onscroll = resetTimer;    // catches scrolling with arrow keys

            function resetTimer() {
                if (!flag) { return; }

                var logs = $.cookie("sTimeOut");

                if (typeof logs != "undefined" && logs != "") {
                    $.removeCookie('sTimeOut');

                    var date = new Date();
                    var sessionTimeoutWarning = 120; //min
                    var sTimeout = parseInt(sessionTimeoutWarning) * 60 * 1000;

                    date.setTime(date.getTime() + sTimeout);
                    $.cookie("sTimeOut", sessionTimeoutWarning, { expires: date });
                }
                else {
                    confirm("閒置超过时间，请重新登入");
                    window.location = "/default/Logout";
                    flag = false;
                    return;
                }
            }
        };
    </script>
    @RenderSection("initScripts", false)

    <!-- END JAVASCRIPTS -->

</body>
<!-- END BODY -->
</html>
