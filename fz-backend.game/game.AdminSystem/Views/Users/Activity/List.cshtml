
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .instructions {
        flex: .6;
    }

        .instructions span {
            padding: 2%;
        }

    .menu {
        display: flex;
        justify-content: space-between;
        padding-bottom: 1%;
    }

    .table th {
        text-align: center;
    }
</style>

<div id="vApp">
    <div class="row">
        <div class="col-md-12">
            <div class="protlet-body">
                <div class="menu">
                    <div class="form-inline instructions" id="form_search">
                        <div class="form-group">
                            <label>时间范围</label>
                            <input type="text" class="form-control " style="width:180px" id="beginTime_Search" name="beginTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="">
                            到
                            <input type="text" class="form-control " style="width:180px" id="endTime_Search" value="" name="endTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label>状态</label>
                            <select class="form-control input-small" name="status_Search" id="status_Search">
                                <option value="1">開</option>
                                <option value="0">關</option>
                            </select>
                        </div>
                        @*<div class="form-group">
                            <label>活动名称</label>
                            <select class="form-control input-small" name="eventName_Search" id="eventName_Search">
                                <option value="">全部</option>
                                <option>登入奖励</option>
                                <option>五星评价</option>
                            </select>
                        </div>*@

                        <div class="form-group">
                            <input type="button" class="btn btn-default" v-on:click="getEventList()" value="搜 索" />
                        </div>
                    </div>
                    <div>
                        <button type="button" class="btn btn-light" style="width:100px; height:50px;" data-toggle="modal" data-target="#addEventModal" v-on:click="show_add()">新 增</button>
                    </div>
                </div>
                <div class="table-scrollable">
                    <table id="eventList_table" class="table table-striped table-bordered table-hover progressTable">
                        <thead>
                            <tr>
                                <th style="width:5%;">活动编号</th>
                                <th style="width:30%;">活动名称</th>
                                <th>开始时间</th>
                                <th>结束时间</th>
                                <th>最低储值金额</th>
                                <th style="width:5%;">状态</th>
                                <th style="width:10%;">动作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="row in tableList">
                                <td style="text-align:center">{{row.EventID}}</td>
                                <td>{{row.EventName}}</td>
                                <td>{{row.StrStartTime}}</td>
                                <td>{{row.StrEndTime}}</td>
                                <td style="text-align:right">{{ToCash(row.GiftCash)}}</td>
                                <td style="text-align:center">{{row.StatusName}}</td>
                                <td style="text-align:center">
                                    <input type="button" class="btn btn-sm dark" data-toggle="modal" data-target="#editEventModal" value="修改" v-on:click="show_edit(row)">
                                    <input type="button" class="btn btn-sm dark" value="刪除" v-on:click="deleteEvent(row.EventID)">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- add Modal-->
    <div class="modal fade" id="addEventModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">新增活动</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_Add" method="post" action="ModifyEvent" class="form-horizontal form-bordered">
                        <div class="form-body">
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">活动编号</label>
                                <div class="col-md-8">
                                    <input type="number" name="EventID" class="form-control input-medium" value="" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">活动名称</label>
                                <div class="col-md-8">
                                    <input type="text" name="EventName" class="form-control input-medium" placeholder="请输入活动名称" value="" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">开始时间</label>
                                <div class="col-md-8">
                                    <input type="text" class="form-control " style="width:180px" id="StartTime" name="StartTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString(" yyyy-MM-01 HH:mm")">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4">结束时间</label>
                                <div class="col-md-8">
                                    <input type="text" class="form-control " style="width:180px" id="EndTime" name="EndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false })" placeholder="结束时间" value="">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">最低储值金额</label>
                                <div class="col-md-8">
                                    <input type="text" name="GiftCash" class="form-control input-medium" placeholder="请输入最低金额" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">状态</label>
                                <div class="col-md-8">
                                    <select class="form-control input-small" name="Status">
                                        <option value="1">開</option>
                                        <option value="0">關</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn dark">储存</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--End add Modal-->

    <!-- Edit Modal-->
    <div class="modal fade" id="editEventModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">修改活动</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_Edit" method="post" action="ModifyEvent" class="form-horizontal form-bordered">
                        <div class="form-body">
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">活动编号</label>
                                <div class="col-md-8">
                                    <input type="number" name="EventID" class="form-control input-medium" value="" v-model="EventSetting.EventID" readonly="readonly" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">活动名称</label>
                                <div class="col-md-8">
                                    <input type="text" name="EventName" class="form-control input-medium" placeholder="请输入活动名称" v-model="EventSetting.EventName" value="" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">开始时间</label>
                                <div class="col-md-8">
                                    <input type="text" class="form-control " style="width:180px" name="StartTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString(" yyyy-MM-01 HH:mm")" v-model="EventSetting.StrStartTime">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4">结束时间</label>
                                <div class="col-md-8">
                                    <input type="text" class="form-control " style="width:180px" name="EndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false })" placeholder="结束时间" value="" v-model="EventSetting.StrEndTime">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">最低储值金额</label>
                                <div class="col-md-8">
                                    <input type="text" name="GiftCash" class="form-control input-medium" placeholder="请输入最低金额" v-model="EventSetting.strGiftCash" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">状态</label>
                                <div class="col-md-8">
                                    <select class="form-control input-small" name="Status" v-model="EventSetting.Status">
                                        <option value="1">開</option>
                                        <option value="0">關</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn dark">储存</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--End Edit Modal-->
</div>

@section initScripts{
    <script>
        $(function () {

            var vApp = new Vue({
                el: '#vApp',
                data: {
                    tableList: {},
                    EventSetting: {}
                },
                methods: {
                    ToCash: function (val) {
                        return ToCash(val);
                    },
                    getEventList: function () {
                        $.get('/Activity/GetEventList',
                            { '_r': Math.random(), beginTime: $("#beginTime_Search").val(), endTime: $("#endTime_Search").val(), status: $("#status_Search").val(), eventName: $("#eventName_Search").val() }, function (data) {
                                if (data instanceof Array) {
                                    vApp.tableList = data;
                                }
                                else {
                                    vApp.tableList = {};
                                }
                            });
                    },
                    deleteEvent: function (eventID) {
                        const status = -1;

                        var option = {
                            isAjax: true,
                            method: 'post',
                            data: {
                                status: status,
                                eventID: eventID
                            },
                            isReload: false,
                            callback: function () {
                                vApp.getEventList();
                            }
                        }

                        swDelConfirmUrl('ModifyEvent', '确定要删除活动么？', option);
                    },
                    show_add: function () {
                        $("#form_Add")[0].reset();
                    },
                    show_edit: function (rowData) {
                        vApp.EventSettin = {};
                        var giftCash = vApp.ToCash(rowData.GiftCash);
                        
                        vApp.EventSetting = rowData;
                        vApp.EventSetting.strGiftCash = giftCash;
                    }
                }
            });

            $("#form_Add").validate({
                rules: {
                    EventID: {
                        required: true
                    },
                    EventName: {
                        required: true,
                        maxlength: 32
                    },
                    StartTime: {
                        required: true
                    },
                    GiftCash: {
                        required: true,
                        number: true
                    },
                    Status: {
                        required: true
                    }
                },
                messages: {
                    GiftCash: {
                        number: '只能使用数字'
                    }
                }
            });

            $("#form_Edit").validate({
                rules: {
                    EventID: {
                        required: true
                    },
                    EventName: {
                        required: true,
                        maxlength: 32
                    },
                    StartTime: {
                        required: true
                    },
                    GiftCash: {
                        required: true,
                        number: true
                    },
                    Status: {
                        required: true
                    }
                },
                messages: {
                    GiftCash: {
                        number: '只能使用数字'
                    }
                }
            });

            vApp.getEventList();
        });
    </script>
}
