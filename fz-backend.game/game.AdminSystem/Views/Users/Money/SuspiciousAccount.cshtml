@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .instructions {
        flex: .6;
    }

        .instructions span {
            padding: 2%;
        }

    .menu {
        display: flex;
        justify-content: space-between;
        padding-bottom: 1%;
    }

    .table th {
        text-align: center;
    }
</style>


<div id="vSAcoountApp">
    <div class="row">
        <div class="col-md-12">
            <div class="protlet-body">
                <div class="menu">
                    <div class="form-inline instructions" id="form_search">
                        @*<div class="form-group">
                                <label>时间范围</label>
                                <input type="text" class="form-control " style="width:180px" id="beginTime_Search" name="beginTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="">
                                到
                                <input type="text" class="form-control " style="width:180px" id="endTime_Search" value="" name="endTime_Search" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                            </div>*@
                        <div class="form-group">
                            <label>姓名</label>
                            <input type="text" id="name_Search" name="name_Search" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>银行或淘宝帐号</label>
                            <input type="text" id="accountID_Search" name="accountID_Search" class="form-control" />
                        </div>
                        <div class="form-group">
                            <input type="button" class="btn btn-default" v-on:click="getList()" value="搜 索" />
                        </div>
                    </div>
                    <div>
                        <button type="button" class="btn btn-light" style="width:100px; height:50px;" data-toggle="modal" data-target="#addModal" v-on:click="show_add()">新 增</button>
                    </div>
                </div>
                <div class="table-scrollable">
                    <table id="eventList_table" class="table table-striped table-bordered table-hover progressTable">
                        <thead>
                            <tr>
                                <th style="width:20%;">姓名</th>
                                <th>银行或淘宝帐号</th>
                                <th>建立时间</th>
                                <th style="width:10%;">动作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="row in tableList">
                                <td style="text-align:center">{{row.Name}}</td>
                                <td>{{row.AccountID}}</td>
                                <td>{{row.StrCreateTime}}</td>
                                <td style="text-align:center">
                                    <input type="button" class="btn btn-sm dark" data-toggle="modal" data-target="#editModal" value="修改" v-on:click="show_edit(row)">
                                    <input type="button" class="btn btn-sm dark" value="刪除" v-on:click="deleteSuspicious(row.Id)">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- add Modal-->
    <div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">新增</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_Add" method="post" action="AddSuspicious" class="form-horizontal form-bordered">
                        <div class="form-body">
                            <div class="form-group">
                                <label class="control-label col-md-4">姓名</label>
                                <div class="col-md-8">
                                    <input type="text" name="Name" id="name_Add" class="form-control input-medium" placeholder="请输入姓名" value="" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4">银行或淘宝帐号</label>
                                <div class="col-md-8">
                                    <input type="text" name="AccountID" id="accountID_Add" accessKey="Add" class="form-control input-medium" placeholder="请输入帐号" value="" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn dark">储存</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--End add Modal-->
    <!-- Edit Modal-->
    <div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">修改</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_Edit" method="post" action="EditSuspicious" class="form-horizontal form-bordered">
                        <input type="hidden" name="Id" class="form-control input-medium" v-model="settings.Id" />
                        <div class="form-body">
                            <div class="form-group">
                                <label class="control-label col-md-4">姓名</label>
                                <div class="col-md-8">
                                    <input type="text" name="Name" id="name_Edit" class="form-control input-medium" placeholder="请输入姓名" v-model="settings.Name" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">银行或淘宝帐号</label>
                                <div class="col-md-8">
                                    <input type="text" name="AccountID" id="accountID_Edit" accessKey="Edit" class="form-control input-medium" placeholder="请输入帐号" v-model="settings.AccountID" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn dark">储存</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--End Edit Modal-->
</div>

@section initScripts{
    <script>
        $(function () {

            var vApp = new Vue({
                el: '#vSAcoountApp',
                data: {
                    tableList: {},
                    settings: {}
                },
                methods: {
                    ToCash: function (val) {
                        return ToCash(val);
                    },
                    getList: function () {
                        $.get('/Money/GetSuspicious',
                            { name: $("#name_Search").val(), accountID: $("#accountID_Search").val() }, function (data) {
                                if (data instanceof Array) {
                                    vApp.tableList = data;
                                }
                                else {
                                    vApp.tableList = {};
                                }
                            });
                    },
                    deleteSuspicious: function (Id) {

                        var option = {
                            isAjax: true,
                            method: 'post',
                            data: {
                                Id: Id
                            },
                            isReload: false,
                            callback: function () {
                                vApp.getList();
                            }
                        }

                        swDelConfirmUrl('DeleteSuspicious', '确定要删除么？', option);
                    },
                    show_add: function () {
                        $("#form_Add")[0].reset();
                    },
                    show_edit: function (rowData) {
                        vApp.settings = {};
                        vApp.settings = rowData;
                    }
                }
            });

            $("#form_Add").validate({
                rules: {
                    AccountID: {
                        required: true
                    }
                }
            });

            $("#form_Edit").validate({
                rules: {
                    AccountID: {
                        required: true
                    }
                }
            });

            vApp.getList();
        });
    </script>
}