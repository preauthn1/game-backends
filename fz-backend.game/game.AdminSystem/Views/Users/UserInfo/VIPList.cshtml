@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Users.VIPUserInfo>


<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>渠道名称</th>
                            <th>平台名称</th>
                            <th>注册时间</th>
                            <th>最后登录时间</th>
                            <th>最后登录IP</th>
                            <th>总金额数</th>
                            <th>累计充值数</th>
                            <th>累计税收数</th>
                            <th>累计兑换数</th>
                            <th>是否在游戏</th>
                            <th>所在游戏房间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", new game.Entity.Users.UserInfo() { Id = item.UserID, LoginName = item.LoginName, GradeID = item.GradeID })
                            <td>@item.AreaName</td>
                            <td>@item.PlatformName</td>
                            <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.LastLogonTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.LastLogonIPAddress</td>
                            <td>@item.AllCoinAmount.ToCash()</td>
                            <td>@item.SumCharge.ToCash()</td>
                            <td>@item.SumTax.ToCash()</td>
                            <td>@item.SumConvert.ToCash()</td>
                            <td>@(item.IsGame ? "是" : "否")</td>
                            <td>@item.ServerName</td>
                            <td>
                                @Html.LinkWithRight(action: "DeleteVIP", value: "删除", onclick: "DelConfirmUrl('DeleteVIP?userID=" + item.UserID + "')", href: "#")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>