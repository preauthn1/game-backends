@section pageLevelPlugins{
    <link rel="stylesheet" href="@Url.Content("~/Content/lan-emoji/css/lan-emoji.css")">
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Content/lan-emoji/js/lan-emoji.js")"></script>
    <script src="@Url.Content("~/Plugins/momentjs/moment.js")"></script>
    <link rel="stylesheet" href="https://example.invalid/releases/v5.0.10/css/all.css" integrity="sha384-+d0P83n9kaQMCwj8F4RJB66tzIwOKmrdb46+porD/OvrJ+37WqIM7UoBtwHO6Nlg" crossorigin="anonymous">
}

<style>

    html {
        overflow: hidden;
    }

    .main {
        display: flex;
        font-family: Helvetica Neue,Helvetica,Hiragino Sans GB,Microsoft YaHei,\\5FAE\8F6F\96C5\9ED1,Arial,sans-serif;
    }

    .content {
        display: flex;
        max-width: 1000px;
        min-width: 1000px;
        height: 765px;
    }

    .chat_panel {
        width: 280px;
        height: 100%;
        background-color: #2E3238;
    }

    .panel_header {
        display: flex;
        align-items: center;
        padding: 18px;
        background-color: #2E3238;
    }

    .account {
        padding-left: 5%;
        width: 100%;
        font-size: 1.3em;
        font-weight: 600;
        color: #fff;
    }

    .search_bar {
        display: flex;
        justify-content: space-between;
        position: relative;
        width: 244px;
        margin: 0 auto 6px;
    }

    .frm_search {
        width: 85%;
        height: 32px;
        line-height: 32px;
        border: 0;
        border-radius: 2px;
        -moz-border-radius: 2px;
        -webkit-border-radius: 2px;
        background-color: #26292e;
        color: #fff;
        padding-left: 30px;
        font-size: 12px;
    }

    .panel_tab {
        display: flex;
        height: 45px;
        background-color: #2E3238;
        border-bottom: 1px solid #292C33;
        cursor: pointer;
    }

    .panel_tab_assign {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        border-right: 1px solid #292C33;
    }

    .address_book {
        font-size: 2.2em;
        color: #fff;
        cursor: pointer;
    }

    .panel_tab_all {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .comment {
        font-size: 2.2em;
        color: #fff;
    }

    .active {
        color: #3CAF36;
    }


    .nav_view {
        height: 605px;
        overflow: auto;
        overflow-x: hidden;
        background-color: #2E3238;
    }

    .box_ft {
        height: 300px;
        background-color: #EEE;
    }

        .box_ft .toolbar {
            display: flex;
            align-items: center;
            height: 30px;
            padding: 5px 17px;
        }

        .box_ft .errMsg {
            padding: 1%;
            color: #D84A38;
            font-size: 1.2em;
        }

        .box_ft .editArea {
            flex: 1;
            margin-top: 10px;
            padding-left: 20px;
            border: 0;
            border-style: solid;
            font-size: 14px;
            overflow-y: auto;
            overflow-x: hidden;
            outline: none;
            background-color: #f5f5f5;
            max-width: 720px;
        }

        .box_ft .action {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            margin-top: 5px;
            padding-right: 5%;
            text-align: right;
        }

            .box_ft .action .labal {
                margin-left: 10px;
                margin-right: 7px;
                font-size: 1em;
                color: #888;
            }

    .box_disable {
        display: none;
    }

    .action_btn_send {
        background-color: #fff;
        color: #222;
        padding-left: 30px;
        padding-right: 30px;
    }


    .action_btn {
        display: inline-block;
        padding: 3px 34px;
        border: 1px solid #c1c1c1;
        border-radius: 4px !important;
        -moz-border-radius: 4px !important;
        -webkit-border-radius: 4px !important;
        font-size: 14px;
        cursor: pointer;
    }

    .smile {
        font-size: 2em;
        color: #878787;
        cursor: pointer;
    }

    .folder {
        margin-top: 1%;
        margin-left: 1%;
        font-size: 2em;
        color: #878787;
        cursor: pointer;
    }

    .contain {
        display: flex;
        flex: 1;
        flex-direction: column;
    }

    .title_wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 35px;
        border-bottom: 1px solid #D6D6D6;
        background-color: #eee;
        font-size: 1.5em;
    }

    .chat_main {
        flex: 1;
        padding: 2% 0 2% 0;
        height: 0;
        background-color: #EEE;
        overflow-x: hidden;
    }

    .chat_none {
        display: flex;
        flex-direction: column;
    }

    .chat_none_icon {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .chat_none_labal {
        font-size: .7em;
        color: #CCC;
    }

    .comments {
        font-size: 4em;
        color: #CCC;
    }


    .none {
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2em;
        font-weight: bold;
    }

    .chat_m {
        background-color: #B2E281;
        color: #000;
        font-size: 1.5em;
    }


    .chat_s {
        background-color: #E3E3E3;
        color: #000;
        font-size: 1.5em;
    }



    .chat_item {
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: 12px 18px 11px;
        border-bottom: 1px solid #292C33;
        cursor: pointer;
        color: #fff;
        font-size: 1.3em;
        font-weight: 700;
    }

        .chat_item span {
            padding: 0 5%;
            width: 6em;
        }

    .msg_cantant {
        display: flex;
        padding: 1%;
    }

    .msg_cantant_r {
        justify-content: flex-end;
    }

    .mwt_border {
        margin: 0 5% 0 5%;
        max-width: 300px;
        position: relative;
        border-radius: 4px !important;
    }

        .mwt_border .arrow_r_int {
            width: 0px;
            height: 0px;
            border-width: 15px;
            border-style: solid;
            border-color: transparent transparent transparent transparent;
            position: absolute;
            top: 6%;
            right: -30px;
        }

        .mwt_border .arrow_r_out {
            width: 0px;
            height: 0px;
            border-width: 15px;
            border-style: solid;
            border-color: transparent transparent transparent #B2E281;
            position: absolute;
            top: 6%;
            right: -29px;
        }


        .mwt_border .arrow_l_int {
            width: 0px;
            height: 0px;
            border-width: 15px;
            border-style: solid;
            border-color: transparent transparent transparent transparent;
            position: absolute;
            top: 6%;
            left: -30px;
        }

        .mwt_border .arrow_l_out {
            width: 0px;
            height: 0px;
            border-width: 15px;
            border-style: solid;
            border-color: transparent #E3E3E3 transparent transparent;
            position: absolute;
            top: 6%;
            left: -29px;
        }

    .span {
        padding: 5px;
        min-height: 50px;
        min-width: 25px;
        word-break: normal;
        width: auto;
        display: block;
        word-wrap: break-word;
        overflow: hidden;
    }


    .replyContent {
        margin-left: 1em;
        height: 765px;
        width: 400px;
        background-color: #EEE;
    }

    .replyList {
        height: calc(100% - 84px);
        overflow-y: scroll;
    }

    .reply_search_content {
        padding: 2% 4%;
    }

    .reply_search {
        width: 100%;
        height: 32px;
        line-height: 32px;
        border: 0;
        border-radius: 2px;
        -moz-border-radius: 2px;
        -webkit-border-radius: 2px;
        color: #000;
        padding-left: 30px;
        font-size: 12px;
    }

    .replyContent_wrap {
        padding: 1.5%;
        border-bottom: 1px solid #D6D6D6;
        background-color: #eee;
        font-size: 1.2em;
        cursor: pointer;
    }

    .Blink {
        animation: blinker 1.5s cubic-bezier(.5, 0, 1, 1) infinite alternate;
    }

    .infoCS {
        font-size: 10px;
        text-align: right;
        padding-left: 70%;
        padding-right: 15px;
    }

    .infoU {
        font-size: 10px;
        text-align: left;
        padding-left: 15px;
        padding-right: 15px;
    }

    .lableEdit {
        margin: 1% 3%;
        font-size: 14px;
    }

    .crossStyle {
        margin-right: 20px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none !important;
    }

    .replyMsg_btn {
        cursor: pointer;
        text-decoration: none !important;
    }

    .reply_contain {
        display: flex;
        flex-direction: column;
        height: 18em;
    }

    .reply_records {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .processed_btn {
        color: #759c84;
        cursor: pointer;
        text-decoration: none !important;
    }

    .face_img {
        height: 50px;
    }

    .lightbox {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        height: 714px;
        width: 100%;
        max-width: 720px;
        background-color: #000;
    }

    .updateImage {
        padding: 2%;
        width: 8em;
        max-width: 90%;
        cursor: pointer;
    }

    .lightbox__img {
        width: 50em;
        max-height: 60vh;
        object-fit: contain;
    }

    span.step {
        position: relative;
        bottom: 30%;
        right: 6%;
        background: #D54A38;
        border-radius: 0.8em !important;
        -moz-border-radius: 0.8em;
        -webkit-border-radius: 0.8em;
        color: #fff;
        display: inline-block;
        font-weight: bold;
        line-height: 1.6em;
        margin-right: 5px;
        text-align: center;
        width: 1.6em;
    }
</style>
<div class="main" id="chat">
    <div class="content">
        <div class="chat_panel">
            <div class="panel_header">
                <img style="height:40px;" v-bind:src="`/Content/HeadIcon/sprite_10.png`">
                <div class="account">客服: @ViewBag.LoginName</div>
            </div>
            <div class="search_bar">
                <input class="frm_search" type="text" placeholder="搜尋" v-model="searchUser">
                <i class="fas fa-plus-square address_book" v-on:click="addUser()"></i>
            </div>

            <div class="panel_tab">
                <div class="panel_tab_assign" v-on:click="changeTab('tab')">
                    <i class="far fa-comment comment" v-bind:class="{ active: !tabALL }"></i>
                    <span v-if="isNewCount > 0" class="step">{{isNewCount}}</span>
                </div>
                <div class="panel_tab_all" v-on:click="changeTab('all')">
                    <i class="far fa-address-book address_book" v-bind:class="{ active: tabALL }"></i>
                    <span v-if="isAllNewCount > 0" class="step">{{isAllNewCount}}</span>
                </div>
            </div>

            <div class="nav_view">
                <div v-for="item in searchlist" class="chat_item" v-on:click="getMessage(item.UserID)">
                    <img style="height:40px;" v-bind:src="`/Content/HeadIcon/sprite_${item.FaceID}.png`">
                    <span>
                        {{item.UserID}}
                    </span>
                    <div v-if="item.isNew"><i class="fa fa-circle text-danger Blink"></i>&nbsp; NEW </div>
                </div>
            </div>
        </div>
        <div class="contain">

            <div class="title_wrap">
                <div v-html="ConversationUser">
                </div>
            </div>
            <div class="chat_main" v-bind:class="{ none: msgList.length === 0 }">
                <div v-if="msgList.length === 0" class="chat_none">
                    <div class="chat_none_icon">
                        <i class="far fa-comments comments"></i>
                    </div>
                    <span class="chat_none_labal">未选择聊天室</span>
                </div>
                <div v-for="(it, index) in msgList">
                    <div v-if="it.type === 's' && it.Question !== ''">
                        <i class="infoU" v-html="it.CreateTime"></i>
                        <a class="replyMsg_btn" v-on:click.stop="AppenContent(it.Reply, index)">回复</a>
                        <a class="processed_btn" v-if="it.StatusCode == @ViewBag.UnHandled" v-on:click.stop="ModifyQuestion(it.Qid)">设为已处理</a>
                        <span v-else>已处理</span>
                        <div class="msg_cantant">
                            <img class="face_img" v-bind:src="`/Content/HeadIcon/sprite_${it.FaceID}.png`">
                            <div class="mwt_border chat_s">
                                <span class="arrow_l_int"></span>
                                <span class="arrow_l_out"></span>
                                <span v-if="!it.Image" class="span" v-text="it.Reply"></span>
                                <img v-else v-bind:src="ImageUrl + it.Image" class="updateImage" v-on:click="showImage(it.Image)" />

                            </div>
                        </div>
                    </div>
                    <div v-else-if="it.type === 'm'">
                        <i class="infoCS" v-html="it.HandleTime"></i>
                        <i v-text="it.DisplayName"></i>
                        <a style="margin-left:10px;" class="replyMsg_btn" v-on:click.stop="ReplyCancel(it)">刪除</a>
                        <div class="msg_cantant msg_cantant_r">
                            <div class="mwt_border chat_m">
                                <span class="arrow_r_int"></span>
                                <span class="arrow_r_out"></span>
                                <span v-if="!it.Image" class="span" v-text="it.Reply"></span>
                                <img v-else v-bind:src="ImageUrl + it.Image" class="updateImage" v-on:click="showImage(it.Image)" v-on:load="imageLoaded" />
                            </div>
                            <img class="face_img" v-bind:src="`/Content/HeadIcon/sprite_10.png`">
                        </div>
                    </div>
                </div>
            </div>
            <div v-bind:class="{ box_disable : msgList.length === 0 }" class="box_ft">
                <div id="emoji"></div>
                <div class="toolbar">
                    <i class="far fa-smile smile" id="btn"></i>
                    <label class="far fa-image folder">
                        <input id="upload_img" type="file" style="display:none;">
                    </label>
                    <div class="errMsg">{{errMsg}}</div>
                </div>
                <div class="reply_contain">
                    <div class="reply_records" v-if="replyMsgIndex !== null">
                        <label class="lableEdit fa fa-reply">{{labelEditText}}</label>
                        <a class="crossStyle fa fa-times" v-on:click.stop="ClearEdit()"></a>
                    </div>
                    <div contenteditable="true" id="editArea" name="editArea" class="editArea" v-on:keydown="setMessage($event)" v-on:keyup="setCtrl($event)"></div>
                </div>

                <div class="action">
                    <div class="labal">按Ctrl+Enter換行</div>
                    <div class="action_btn action_btn_send" v-on:click="setMessageEnter()">傳送</div>
                </div>
            </div>
            <div v-if="isLightbox" class="lightbox" v-on:click="showImage()">
                <img class="lightbox__img" />
            </div>
        </div>
    </div>


    <div class="replyContent">
        <div class="title_wrap">
            快速回覆
        </div>
        <div class="reply_search_content">
            <input type="text" class="reply_search" placeholder="搜尋" v-model="reply_search" />
        </div>
        <div class="replyList">
            <div v-for="list in replySearchList" class="replyContent_wrap" v-on:click="setReplyContent(list.Content)">
                {{list.Content}}
            </div>
        </div>
    </div>
</div>


@section initScripts{
    <script>
        var _emoji
        const option = {
            editor: 'editArea',
            btn: 'btn',
            icon: [{
                path: '/Content/lan-emoji/img/face',
                alias: {
                    1: "angry",
                    2: "blubb",
                    3: "boo",
                    4: "brains",
                    5: "dub",
                    6: "disappearing",
                    7: "dizzy",
                    8: "enjoying",
                    9: "evilish",
                    10: "graffiti",
                    11: "grin",
                    12: "niceday",
                    13: "fakesmile",
                    14: "inlove",
                    15: "kaboom",
                    16: "lll",
                    17: "meaw",
                    18: "ninja",
                    19: "OO",
                    20: "omg",
                    21: "onfire",
                    22: "ouchhurts",
                    23: "pissedoff",
                    24: "pleasant",
                    25: "seriousbusiness",
                    26: "sick",
                    27: "slow",
                    28: "snooty",
                    29: "something",
                    30: "tttt",
                    31: "want",
                    32: "gonnadie",
                    33: "wut",
                    34: "xx",
                    35: "xd",
                    36: "drunk",
                    37: "yarr",
                    38: "kiddingright",
                    39: "yuush",
                    40: "zzz"
                }
            }]
        }

        $(function () {
            var vApp = new Vue({
                el: '#chat',
                data: {
                    searchlist: [],
                    userlist: [],
                    assignUserList: [],
                    msgList: [],
                    replyContentList: [],
                    replySearchList: [],
                    ConversationUser: '',
                    reply_search: '',
                    isCtrl: false,
                    tabALL: false,
                    timeOutId: 0,
                    timeTableList: 0,
                    searchUser: '',
                    includeUser: '',
                    replyMsgIndex: null,
                    labelEditText: '',
                    errMsg: '',
                    isLightbox: false,
                    ImageUrl: `@ViewBag.ImageUrl`,
                    isNewCount: 0,
                    isAllNewCount: 0
                },

                watch: {
                    tabALL: function (value) {
                        var service = `@ViewBag.LoginName`
                        var list = value ? vApp.userlist : vApp.assignUserList

                        vApp.searchlist = list.filter((x) => {
                            var userID = x.UserID + ''
                            return ~userID.indexOf(vApp.searchUser)
                        })
                    },

                    searchUser: function (value) {
                        var list = vApp.tabALL ? vApp.userlist : vApp.assignUserList

                        vApp.searchlist = list.filter((x) => {
                            var userID = x.UserID + ''
                            return ~userID.indexOf(vApp.searchUser)
                        })
                    },

                    includeUser: function (old, value) {
                        vApp.getQuestionList()
                    },

                    reply_search: function (value) {
                        vApp.replySearchList = vApp.replyContentList.filter((x) => {
                            var Content = x.Content + ''
                            return ~Content.indexOf(vApp.reply_search)
                        })
                    },

                    ConversationUser: function (value) {
                        Vue.nextTick(function () {
                            vApp.emojiParse()
                            $('.chat_main').scrollTop(document.querySelector(".chat_main").scrollHeight)
                        })
                    },

                    msgList: {
                        handler: function (val, old) {
                            const newVal = val[val.length - 1]
                            const oldVal = old[old.length - 1]
                            if (oldVal === void 0) return
                            if (newVal.Reply !== oldVal.Reply) {
                                Vue.nextTick(function () {
                                    vApp.emojiParse()
                                    $('.chat_main').scrollTop(document.querySelector(".chat_main").scrollHeight)
                                })
                            }
                        },
                        deep: true
                    }
                },

                methods: {
                    getTableList: function () {
                        clearInterval(vApp.timeTableList)
                        var ajaxFn = function () {
                            vApp.getQuestionList()
                        };
                        ajaxFn()
                        vApp.timeTableList = setInterval(ajaxFn, 10000)
                    },

                    getQuestionList: function () {
                        $.post('/UserQuestionLog/GetQuestionUserName', { 'IncludeUser': vApp.includeUser, '_r': Math.random() }, function (data) {
                            vApp.$set(vApp, 'isNewCount', 0)
                            vApp.$set(vApp, 'isAllNewCount', 0)

                            var service = `@ViewBag.LoginName`
                            var assign = data.data.filter((item) => {
                                if (item.isNew) vApp.$set(vApp, 'isAllNewCount', vApp.isAllNewCount += 1)
                                if (item.isNew && item.HandlePerson === service) vApp.$set(vApp, 'isNewCount', vApp.isNewCount += 1)

                                return item.HandlePerson === service
                            })
                            vApp.userlist = data.data
                            vApp.assignUserList = assign
                            vApp.searchlist = vApp.tabALL ? data.data : assign
                            vApp.includeUser = ''
                        });
                    },
                    getReplyContent: function () {
                        $.post('/UserQuestionLog/GetReplyContent', { '_r': Math.random() }, function (data) {
                            vApp.replyContentList = data.result
                            vApp.replySearchList = data.result
                        });
                    },
                    addUser: function () {
                        this.$set(this, 'includeUser', this.searchUser)
                    },
                    getMessage: function (UserID) {
                        vApp.replyMsgIndex = null
                        vApp.labelEditText = ''
                        clearInterval(vApp.timeOutId)


                        var ajaxFn = function () {
                            $.ajax({
                                url: '/UserQuestionLog/GetReplayMessage',
                                type: 'post',
                                data: { '_r': Math.random(), UserID: UserID },
                                success: function (data) {
                                    var list = [];
                                    data.data.forEach(function (val) {
                                        var index = 1;
                                        list.push({ type: 's', Qid: val.QId, UserID: val.UserID, FaceID: val.FaceID, Question: val.Question, Reply: val.Question, ReplyContent: val.ReplyContent, CreateTime: val.CreateTime, NickName: val.NickName, DisplayName: val.DisplayName, HandleTime: val.HandleTime, Status: val.Status, StatusCode: val.StatusCode, Image: val.image })
                                        if (val.ReplyContent) {
                                            var split = val.ReplyContent.split("\r\n")

                                            split.forEach(function (reply) {
                                                if (reply) {
                                                    let replaceReply = reply.replace(/\n/g, "<br/>")
                                                    const substr = replaceReply.substring(4, 20)
                                                    const date = moment(substr, 'YYYY-MM-DD HH:ss', true)
                                                    const isValid = date.isValid()
                                                    const handleTime = isValid ? date.format('YYYY-MM-DD HH:ss') : val.HandleTime

                                                    const split = replaceReply.split(`time${handleTime}`)
                                                    if (split.length > 1) {
                                                        val.image = null
                                                        const img = split[1].split('imgs')
                                                        if (img.length > 1) {
                                                            val.image = img[1]
                                                            split[1] = img[1]
                                                        }
                                                        replaceReply = split[1]
                                                    }

                                                    list.push({ type: 'm', Qid: val.QId, UserID: val.UserID, Question: val.Question, ReplyContent: val.ReplyContent, Reply: replaceReply, CreateTime: val.CreateTime, NickName: val.NickName, DisplayName: val.DisplayName, HandleTime: handleTime, Status: val.Status, MsgIndex: index, Image: val.image })
                                                    index++;
                                                }
                                            })
                                        }
                                    });
                                    vApp.msgList = list
                                    var link = `<a class="link" target="_blank" href="/UserInfo/Search?userId=${UserID}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${UserID}</a>`
                                    vApp.ConversationUser = link;
                                }
                            })
                        }
                        ajaxFn()
                        vApp.timeOutId = setInterval(ajaxFn, 5000)
                    },
                    ReplyQuestion: function (reply) {
                        if (!reply) reply = $("#editArea").html($("#editArea").text())[0].textContent;
                        reply = reply.replace(/(\r\n|\n|\r)/gm, "").trim();
                        const dateNow = moment(Date.now()).format('YYYY-MM-DD HH:mm')
                        const data = vApp.msgList
                        const dataLength = data.length - 1
                        let index = vApp.replyMsgIndex

                        if (index === null) { index = dataLength }

                        const item = data[index]
                        const qid = item.Qid
                        const title = `关于您提交的问题'${item.Question}'的回复`
                        const userid = item.UserID
                        const replyContent = item.ReplyContent || ''
                        const msg = replyContent + `time${dateNow}` + reply + '\r\n'
                        vApp.errMsg = ''
                        const replaceMsg = msg.replace(/\<br\>/g, "\n")
                        $.post('/UserQuestionLog/ReplyQuestion',
                            {
                                '_r': Math.random(),
                                qid: qid,
                                userid: userid,
                                msg: replaceMsg,
                                title: title
                            }, function (data) {
                                const status = data.status
                                const msg = data.msg

                                if (data.status) {
                                    $('.editArea').empty()
                                    vApp.getMessage(userid)
                                } else {
                                    vApp.errMsg = msg
                                }
                            });
                    },
                    setReplyContent: function (reply) {
                        $('.editArea').empty()
                        $('.editArea').text(reply)
                    },
                    setCtrl: function () {

                        if (event.keyCode === 17) {
                            vApp.isCtrl = false
                        }

                        if (vApp.isCtrl === false && event.keyCode === 13) {
                            $('.editArea').empty()
                        }
                    },
                    setMessage: function (event) {

                        if (event.keyCode === 17) {
                            vApp.isCtrl = true
                        }

                        if (vApp.isCtrl === false && event.keyCode === 13) {
                            _emoji.emojiChange()
                            vApp.ReplyQuestion($('.editArea').html())
                            $('.editArea').empty()
                        }

                        if (vApp.isCtrl === true && event.keyCode === 13) {
                            document.execCommand('insertHTML', false, '<br><br>')
                            $('.editArea').scrollTop(document.querySelector(".editArea").scrollHeight)
                        }
                    },
                    setMessageEnter: function () {
                        _emoji.emojiChange()
                        vApp.ReplyQuestion($('.editArea').html())
                        $('.editArea').empty()
                    },
                    changeTab: function (tab) {
                        vApp.tabALL = tab === 'all'
                    },
                    AppenContent: function (content, index) {
                        vApp.replyMsgIndex = index

                        if (content.length > 43) {
                            content = `${content.substring(0, 43)} ...`
                        }
                        vApp.labelEditText = content
                    },

                    ClearEdit: () => {
                        vApp.replyMsgIndex = null
                        vApp.labelEditText = ''
                    },

                    ModifyQuestion: (id) => {
                        if (!id) { return }
                        AjaxGetJson('/UserQuestionLog/ModifyQuestionLog?flag=true&Id=' + id, "get", {}, false, {})
                    },
                    emojiParse () {
                        _emoji.emojiParse(document.querySelectorAll('.chat_main span'))
                    },
                    ReplyCancel: function (item) {

                        const qid = item.Qid
                        const msgIndex = item.MsgIndex;

                        $.post('/UserQuestionLog/ReplyCancel',
                           {
                               qid: qid,
                               msgIndex: msgIndex
                           }, function (data) {
                               if (data.status) {
                                   $('.editArea').empty()
                                   vApp.getMessage(item.UserID)
                               } else {
                                   vApp.errMsg = msg
                               }
                           });
                    },

                    showImage (url) {
                        vApp.isLightbox = !vApp.isLightbox
                        Vue.nextTick(function () {
                            if (url !== void 0) {
                                var index = url.lastIndexOf('/') + 1;
                                url = url.substring(0, index) + 'ORIG-' + url.slice(index);
                                $(".lightbox__img").attr("src", vApp.ImageUrl + url)
                            }
                        })
                    },
                    uploadFile () {
                        var data = new FormData();
                        var files = $("#upload_img").get(0).files;

                        if (files.length > 0) {
                            data.append("UploadedImage", files[0]);
                        }
                        var ajaxRequest = $.ajax({
                            type: "POST",
                            url: `@ViewBag.AdminUploadFileUrl`,
                            contentType: false,
                            processData: false,
                            dataType: "json",
                            data: data,
                        }).done(function (data, textStatus) {
                            if (data.imageUrl) {
                                vApp.ReplyQuestion(`imgs${data.imageUrl}`)
                            }
                        }).fail(function (jqXHR, textStatus) {
                            alert(jqXHR.responseText)
                        });
                    },
                    imageLoaded () {
                        $('.chat_main').scrollTop(document.querySelector(".chat_main").scrollHeight)
                    }
                }
            });
            vApp.getTableList()
            vApp.getReplyContent()
            _emoji = new emoji(option)

            $('#upload_img').on('change', function () {
                vApp.uploadFile()
            });

            document.addEventListener("mousedown", function (e) {
                if (e.target.id == "btn") {
                    e.preventDefault()
                }
            }, false);
        })
    </script>
}




