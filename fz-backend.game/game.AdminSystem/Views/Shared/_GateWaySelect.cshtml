@model bool
@{
    List<game.Entity.Pay.PayGateway> listGateway = DataService.GetGateway();  
}

@if (listGateway.Count > 0)
{
    if (Model)
    {
        <div class="form-group">
            <label class="control-label col-md-4 xing">第三方</label>
            <div class="col-md-8">
                <select class="form-control input-small" id="GWID" name="GWID">
                    @foreach (var p in listGateway)
                    {
                        <option value="@p.GWID">@p.GatewayName</option>
                    }
                </select>
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            <label>第三方</label>
            <select class="form-control input-small" id="GWID" name="GWID">
                <option value="">--不限--</option>
                @foreach (var p in listGateway)
                {
                    <option value="@p.GWID">@p.GatewayName</option>
                }
            </select>
        </div>
    }
}
