@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Stat.DayMaxGameOnLineUserLog>
@{
    var platformList = DataService.GetAllPlatform();
    platformList.Add(new game.Entity.Area.Platform() { Id = 0, Name = "全部" });
    var dicPlatform = platformList.ToDictionary(m => m.Id, m => m.Name);
}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                <div class="form-group">
                    <label>游戏</label>
                    @Html.DropDownList("gameID", DataService.Game(), new { @class = "form-control input-small", id = "gameID" })
                </div>
                <div class="form-group">
                    <label>时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>统计时间</th>
                            <th>游戏</th>
                            <th style="width:300px">总在线人数</th>
                            @*<th style ="width:300px">PC在线人数</th>*@
                            <th style="width:300px">IOS在线人数</th>
                            <th style="width:300px">Android在线人数</th>
                  
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@dicPlatform[item.PlatformID]</td>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.Game.GameName</td>
                                    <td class="p1" style="width:300px">@item.TotalCount</td>
                                    @*<td class="p2" style="width:300px">@item.PCCount</td>*@
                                    <td class="p3" style="width:300px">@item.IOSCount</td>
                                    <td class="p4" style="width:300px">@item.AndroidCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td>@Model.Sum(p => p.TotalCount)</td>
                            <td>@Model.Sum(p => p.PCCount)</td>
                            <td>@Model.Sum(p => p.IOSCount)</td>
                            <td>@Model.Sum(p => p.AndroidCount)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');

            ShowProgress($(".progressTable"), "p1", 300);
            ShowProgress($(".progressTable"), "p2", 300);
            ShowProgress($(".progressTable"), "p3", 300);
            ShowProgress($(".progressTable"), "p4", 300);
        })
    </script>
}