@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Stat.DayMaxTotalGameOnLineLog>
@{
    var platformList = DataService.GetAllPlatform();
    platformList.Add(new game.Entity.Area.Platform() { Id = 0, Name = "全部" });
    var dicPlatform = platformList.ToDictionary(m => m.Id, m => m.Name);
}
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}


<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", false)
                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            
                            <th class="hide">编号</th>
                            <th>所属平台</th>
                            <th>所属渠道</th>
                            <th>统计时间</th>
                            <th>总在线人数</th>
                     
                            <th>iOS在线人数</th>
                            <th>Android在线人数</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="hide">@item.Id</td>
                                    <td>@dicPlatform[item.PlatformID]</td>
                                    <td>@item.AreaName</td>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.TotalCount</td>
                                    <td>@item.IOSCount</td>
                                    <td>@item.AndroidCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}