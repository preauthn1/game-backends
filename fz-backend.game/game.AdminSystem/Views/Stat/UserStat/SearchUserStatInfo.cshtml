@{
    Dictionary<byte, string> searchType = new Dictionary<byte, string>();
    searchType.Add(1, "同IP注册数");
    searchType.Add(2, "同IP登录数");
    searchType.Add(3, "同Mac注册数");
    searchType.Add(4, "同Mac登录数");
    byte curSearchType = ViewBag.SearchType;
}
@model  Dictionary<string, string>

<style>
    .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline !important;
        color: #428bca !important;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>查询类型</label>
                    <select name="searchType" id="searchType" class="form-control input-small">
                        @foreach (var key in searchType.Keys)
                        {
                            <option value="@key">@searchType[key]</option>
                        }
                    </select>
                    <label>大于</label>
                    <input type="text" class="form-control input-medium" id="count" name="count" placeholder="数量(不能小于5)" value="5">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>编号</th>
                            <th>@(curSearchType <= 2 ? "IP" : "Mac")</th>
                            <th>数量</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int index = 0;}
                        @foreach (var item in Model)
                        {
                            index += 1;
                            <tr>
                                <td>@index</td>
                                <td>
                                    @if (curSearchType > 2)
                                    {
                                        <a target="_blank" href="/userstat/alluser?hdCode=@item" class="btn_link">@item.Key</a>
                                    }
                                    else
                                    {
                                        <a target="_blank" href="/userstat/alluser?regIpAddress=@item" class="btn_link">@item.Key</a>
                                    }
                                </td>
                                <td>
                                    @item.Value
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
            $("form").submit(function () {
                if (IsEmpty($("[name=count]").val()) || parseInt($("[name=count]").val()) < 5) {
                    alert("大于数必须大于等于5");
                    return false;
                }
            });
        });
    </script>
}