@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  FW.Core.Helper.PagedList<game.Entity.Warning.UserFocus>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
@{
    var warningTypeList = ViewBag.Type as List<game.Entity.Warning.WarningType>;
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>管理员编号</label>
                    <input type="text" class="form-control input-small" id="adminUserID" name="adminUserID" placeholder="管理员编号">
                </div>
                <div class="form-group">
                    <label>类型</label>
                    <select class="form-control input-small" name="typeID" id="typeID">
                        <option>--不限--</option>
                        @foreach (var item in warningTypeList)
                        {
                            <option value="@item.Id">@item.TypeName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                           <th>管理员编号</th>
                            <th>报警类型编号</th>
                            <th>报警类型</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.UserID</td>
                                    <td>@item.TypeID</td>
                                    <td>@item.WarningType.TypeName</td>
                                    <td>
                                        @Html.LinkWithRight(action: "DelUserFocus", onclick: "swDelConfirmUrl('/Warning/DelUserFocus?adminUserID=" + item.UserID + "&typeID="+item.TypeID+"')", href: "#")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}