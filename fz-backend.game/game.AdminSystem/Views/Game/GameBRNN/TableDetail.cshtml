@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Scripts/datatable_settiing.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
        cursor: pointer;
    }

    .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
        cursor: pointer;
    }

    .search-group {
        display: flex;
        align-items: center;
        padding: 2%;
    }

        .search-group div {
            padding: 1%;
        }

    .color-red {
        color: red;
    }

    #WinPrizeLog_table_wrapper {
        max-height: 500px;
        overflow: auto;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }

    .text_Center {
        text-align: center;
    }

    .text_Right {
        text-align: right;
    }


    .title_Color {
        background: gainsboro;
    }

    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }

    .backgroundColor-red {
        background-color: #f9baba;
    }

    .backgroundColor-green {
        background-color: #9bc7a0;
    }
    .flex_contain {
         display: flex;
        align-items: center;
        justify-content: center;
    }
    .VIPUserAdd {
        display: flex;
        margin-bottom: 20px;
    }
</style>

<div id="vApp">
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-6" style="padding:0;">
                <div class="portlet box grey" style="margin:20px;">
                    <div class="portlet-title">
                        <div class="caption">游戏信息</div>
                    </div>
                    <div class="portlet-body">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th colspan="6" class="text_center title_Color">游戏信息</th>
                                </tr>
                                <tr>
                                    <th class="col-md-1"> 游戏状态：</th>
                                    <td class="col-md-1"><span>{{tableStatus[tableDetail.Status]}}</span></td>
                                    <th class="col-md-1"> 当日抽水：</th>
                                    <td class="col-md-1">{{ToCash(info.TodayTax)}}</td>
                                    <th class="col-md-1">奖池金额：</th>
                                    <td class="col-md-1"><a class="btn_link_Red" href="#" v-on:click="showPoolLog()" data-toggle="modal" data-target="#editPool">{{ToCash(tableDetail.PoolCurrentAmount)}}</a></td>
                                </tr>
                                <tr>
                                    <th class="text_center title_Color">监控人数</th>
                                    <th class="text_center title_Color">今日人数</th>
                                    <td>
                                        <div v-on:click="showTodayRanking()" class="btn_link">今日输赢排行榜</div>
                                    </td>
                                    <th>
                                        <a class="btn_link" href="#" v-on:click="showFreeMoneyLog()" data-toggle="modal" data-target="#editFreeMoney">指定放分金额</a></th>
                                    <th>
                                        <span style="font-weight:bold" v-if="tableDetail.FanFengTarget > tableDetail.FanFengComplete">目标/目前放分：</span>
                                        <span v-else></span>
                                    </th>
                                    <td>
                                        <span v-if="tableDetail.FanFengTarget > tableDetail.FanFengComplete">{{ToCash(tableDetail.FanFengTarget)}} / {{ToCash(tableDetail.FanFengComplete)}}</span>
                                        <span v-else></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td rowspan="2" style="vertical-align: middle;" class="text_center">
                                        <div class="flex_contain">
                                            <div class="btn_link_Red" v-on:click="showVIPUser()">{{info.VipUser}}</div>
                                        </div>
                                       
                                    </td>
                                    <td rowspan="2" style="vertical-align: middle;" class="text_center">
                                        <div class="flex_contain">
                                            <div class="btn_link_Red" v-on:click="showTodayUser()">{{info.TodayUser}}</div>
                                        </div>
                                        
                                    </td>
                                    <th colspan="5" class="text_center title_Color">当前玩家下注金额</th>
                                </tr>
                                <tr>
                                    <th class="text_center">青龙</th>
                                    <th class="text_center">白虎</th>
                                    <th class="text_center">朱雀</th>
                                    <th class="text_center">玄武</th>

                                </tr>
                                <tr>
                                    <th class="text_Center title_Color">机器人数</th>
                                    <th class="text_Center title_Color">玩家人数</th>
                                    <td class="text_center"><span>{{ToCash(sum.UserChingLong)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserBaiHu)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserChuChueh)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserHsuanWu)}}</span></td>
                                </tr>
                                <tr>
                                    <td class="text_center"><span>{{tableDetail.RobotCount}}</span></td>
                                    <td class="text_center"><span>{{tableDetail.GameUserCount}}</span></td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">9局胜率: <span>{{tableDetail.ChingLongWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">9局胜率: <span>{{tableDetail.BaiHuWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">9局胜率: <span>{{tableDetail.ChuChuehWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">9局胜率: <span>{{tableDetail.HsuanWuWinRate}}</span>%</td>
                                </tr>
                                <tr>
                                    <th colspan="6" class="text_center title_Color">庄家信息</th>
                                </tr>
                                <tr>
                                    <th class="text_center">庄家类型</th>
                                    <th class="text_center">庄家昵称</th>
                                    <th class="text_center">庄家ID</th>
                                    <th class="text_center">初始上庄金币</th>
                                    <th class="text_center">当前剩余金币</th>
                                    <th class="text_center">金币变化量</th>
                                </tr>
                                <tr>
                                    <td class="text_center"><span>{{bankerType[tableDetail.ZhuangType]}}</span></td>
                                    <td class="text_center"><span>{{tableDetail.ZhuangNickName}}</span></td>
                                    <td class="text_center"><span>{{tableDetail.ZhuangUserID}}</span></td>
                                    <td class="text_center"><span>{{ToCash(tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(tableDetail.ZhuangCurrentMoneyAmount-tableDetail.ZhuangInitMoneyAmount)}}</span></td>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6" style="padding:0;">
                <div class="portlet box grey" style="margin:20px;">
                    <div class="portlet-title">
                        <div class="caption">九局开奖记录</div>
                    </div>
                    <div class="portlet-body">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th class="text_center"></th>
                                    <th class="text_center">青龙</th>
                                    <th class="text_center">白虎</th>
                                    <th class="text_center">朱雀</th>
                                    <th class="text_center">玄武</th>
                                    <th class="text_center">
                                        <a target="_blank" href="/GameBRNN/AssignReward?serverID=@ViewBag.ServerID&gameID=@ViewBag.GameID&tableNo=@ViewBag.TableNO" class="btn_link">指定9局开奖</a>
                                    </th>
                                    <th class="text_center">青龙</th>
                                    <th class="text_center">白虎</th>
                                    <th class="text_center">朱雀</th>
                                    <th class="text_center">玄武</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(data, index) in assignRewardDetail">
                                    <td class="text_center">{{showIDx(data.Idx, index)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Reward, 0)}">{{showAssign(data.Reward, 0)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Reward, 1)}">{{showAssign(data.Reward, 1)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Reward, 2)}">{{showAssign(data.Reward, 2)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Reward, 3)}">{{showAssign(data.Reward, 3)}}</td>
                                    <td class="text_center">{{data.StrStatus}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Description, 0)}">{{showAssign(data.Description, 0)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Description, 1)}">{{showAssign(data.Description, 1)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Description, 2)}">{{showAssign(data.Description, 2)}}</td>
                                    <td class="text_center" :style="{ backgroundColor: assignBackground(data.Description, 3)}">{{showAssign(data.Description, 3)}}</td>
                                </tr>
                                <tr>
                                    <th class="text_center">9局胜率：</th>
                                    <td class="text_center"><span>{{assignRate.ChingLongRate}}</span>%</td>
                                    <td class="text_center"><span>{{assignRate.BaiHuWinRate}}</span>%</td>
                                    <td class="text_center"><span>{{assignRate.ChuChuehRate}}</span>%</td>
                                    <td class="text_center"><span>{{assignRate.HsuanWuWin}}</span>%</td>
                                    <td colspan="5" class="text_center">
                                        <a v-if="assignRate.MainStatus == 1" class="btn_link_Red" v-on:click="cancelAssignReward()" href="#">取消指定9局开奖</a>
                                        <span v-else-if="assignRate.MainStatus == 0" class="color-red">已取消指定9局开奖</span>
                                        <span v-else class="color-red">暂无指定9局开奖</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="col-md-6">
                <div class="portlet box grey">
                    <div class="portlet-title">
                        <div class="caption">玩家信息(上局前50下注用户)</div>
                    </div>
                    <div class="portlet-body" style="height:435px; overflow:auto;">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>玩家ID</th>
                                    <th>监控</th>
                                    <th>携带金币</th>
                                    <th>总充值</th>
                                    <th>总兑换</th>
                                    <th>累计输赢</th>
                                    <th>9局胜率</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="user in tableDetail.LastGameUserBet">
                                    <td>
                                        <a target="_blank" :href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{user.UserID}}</a>
                                    </td>
                                    <td>
                                        <span v-if="user.IsVIP"><a class="btn_link_Red" href="#" v-on:click="delVIPUser(user.UserID)">删除监控</a></span>
                                        <span v-else="user.IsVIP"><a class="btn_link" href="#" v-on:click="addVIPUser(user.UserID)">增加监控</a></span>
                                    </td>
                                    <td>{{ToCash(user.CurrentMoney)}}</td>
                                    <td>{{ToCash(user.SumCharge)}}</td>
                                    <td>{{ToCash(user.SumConvert)}}</td>
                                    <td>{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)* -1)}}</td>
                                    <td><span>{{user.WinRate}}</span>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="col-md-6">
                <div class="portlet box grey">
                    <div class="portlet-title">
                        <div class="caption">当前下注</div>
                    </div>
                    <div class="portlet-body" style="height:435px; overflow:auto;">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>
                                        <a href="#" v-on:click="createWinPrizeLogTable()" data-toggle="modal" data-target="#showWinPrizeLog">指定开奖：</a>
                                        <span style="color:red;">{{tableDetail.BetTime}}</span>
                                    </th>
                                    <th colspan="6">
                                        <label>
                                            <input type="checkbox" name="WinPrize" v-on:change="clearRadio($event)" value="1" v-model="WinPrize.Check" /> 青龙
                                        </label>
                                        <label>
                                            <input type="checkbox" name="WinPrize" v-on:change="clearRadio($event)" value="2" v-model="WinPrize.Check" /> 白虎
                                        </label>
                                        <label>
                                            <input type="checkbox" name="WinPrize" v-on:change="clearRadio($event)" value="3" v-model="WinPrize.Check" /> 朱雀
                                        </label>
                                        <label>
                                            <input type="checkbox" name="WinPrize" v-on:change="clearRadio($event)" value="4" v-model="WinPrize.Check" /> 玄武
                                        </label>
                                        <label>
                                            <input type="radio" name="WinPrize" value="5" v-model="WinPrize.Radio" v-on:change="clearCheckBox()" /> 通杀
                                        </label>
                                        <label>
                                            <input type="radio" name="WinPrize" value="6" v-model="WinPrize.Radio" v-on:change="clearCheckBox()" /> 通赔
                                        </label>
                                        <label>
                                            <input type="radio" name="WinPrize" value="7" v-model="WinPrize.Radio" v-on:change="clearCheckBox()" /> 三胜一负
                                        </label>
                                        <label>
                                            <input type="radio" name="WinPrize" value="8" v-model="WinPrize.Radio" v-on:change="clearCheckBox()" /> 三负一胜
                                        </label>
                                        <label>
                                            <input type="radio" name="WinPrize" value="9" v-model="WinPrize.Radio" v-on:change="clearCheckBox()" /> 二胜二负
                                        </label>
                                        <button type="button" class="btn btn-default" v-on:click="setWinPrize()">确定</button>
                                    </th>
                                </tr>
                                <tr>
                                    <th><span style="color:red;" id="WinPrizeMsg">{{ winPrizeMsgLabel }}</span></th>
                                    <th>玩家ID</th>
                                    <th>青龙</th>
                                    <th>白虎</th>
                                    <th>朱雀</th>
                                    <th>玄武</th>
                                    <th style="width:10%;">9局胜率</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="user in tableDetail.UserInfo">
                                    <td>
                                        <span class="color-red" v-if="user.IsVIP">(已监控)</span>
                                        <span v-else="user.IsVIP">(未添加)</span>
                                    </td>
                                    <td>
                                        <a target="_blank" :href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{user.UserID}}</a>
                                    </td>
                                    <td v-bind:class="{'color-red':user.BetInfoChingLong > 0 }">{{ToCash(user.BetInfoChingLong)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoBaiHu > 0 }">{{ToCash(user.BetInfoBaiHu)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoChuChueh > 0 }">{{ToCash(user.BetInfoChuChueh)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoHsuanWu > 0 }">{{ToCash(user.BetInfoHsuanWu)}}</td>
                                    <td><span>{{user.WinRate}}</span>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @Html.Back(Url.Action("TableList", new { serverID = ViewBag.ServerID }))
    </div>
    <!--监控名单-->
    @Html.Partial("_VIPUser", false)
    <!--今日人数-->
    @Html.Partial("_todayUser", false)
    <!--今日输赢排行榜-->
    @Html.Partial("_todayRanking", false)
    <!--编辑水池-->
    @Html.Partial("_editPool", false)
    <!--指定开奖操作查询-->
    @Html.Partial("_winPrizeLog", false)
    <!--编辑放分-->
    @Html.Partial("_editFreeMoney", false)
</div>


@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#vApp',
            data: {
                serverID: '@ViewBag.ServerID',
                tableNO: '@ViewBag.TableNO',
                gameID: '@ViewBag.GameID',
                showName: '@ViewBag.ShowName',
                tableStatus: ['下注中', '开奖中', '开奖动画', '结算动画', '等待开始游戏'],
                bankerType: ['系统', '机器人上庄', '玩家上庄'],
                prizeType: ['', '青龙', '白虎', '朱雀', '玄武', '通杀', '通赔'],
                userType: ['机器人', '玩家'],
                tableDetail: {},
                sum: {},
                info: {},
                assignRewardDetail: {},
                assignRate: {},
                assignType: ['负', '胜'],
                WinPrize: { Check: [], Radio: '' },
                editPoolInfo: {},
                editFreeMoneyInfo: {},
                winPrizeMsgLabel: null,
                prizeLog_table: null,
                tableAssignRewardDetail: null,
                /*todayRanking*/
                selectedStatus: '',
                todayRanking_table: null,
                todayRanking_interval: null,
                /*todayUser*/
                todayUser_table: null,
                todayUser_interval: null,
                /*VIPUser*/
                NewUserID: null,
                VIPUser_table: null,
                VIPUser_interval: null,
            },


            watch: {
                selectedStatus (val, oldVal) {
                    vApp.todayRanking_table.DataTable().ajax.reload();
                },
                'tableDetail.BetTime' (val, oldVal) {
                    if (val < 3 && val >= 0) this.getAssignRewardDetail();
                }
            },

            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getTableDetail: function () {
                    $.get('/GameBRNN/GetTableDetail', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, '_r': Math.random() }, function (data) {
                        if (data instanceof Object) {
                            vApp.tableDetail = Object.assign({}, data.TableDetail);
                            vApp.sum = data.Sum;
                            example.invalid = example.invalid;

                            if (vApp.tableDetail.BetTime <= 0) {
                                vApp.winPrizeMsgLabel = ''
                                vApp.WinPrize.Radio = '';
                                vApp.WinPrize.Check = [];
                                $('input[type="checkbox"][name="WinPrize"]').closest("span").removeClass('checked');
                                $('input[type="radio"][name="WinPrize"]').closest("span").removeClass('checked');
                            }
                        }
                        else {
                            vApp.tableDetail = {};
                            vApp.sum = {};
                            example.invalid = {};
                        }
                    });
                },
                getAssignRewardDetail: function () {
                    $.get('/GameBRNN/GetAssignRewardDetail', { 'gameID': vApp.gameID, 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, '_r': Math.random() }, function (data) {

                        if (data instanceof Object) {
                            const history = data.History
                            vApp.assignRewardDetail = history.length > 0 ? history : data.AssignRewardDetail;
                            vApp.assignRate = data.Rate;
                        }
                        else {
                            App.assignRewardDetail = {};
                            vApp.assignRate = {};
                        }
                    });
                },
                showAssign: function (data, index) {
                    if (!data) {
                        return '';
                    }
                    return vApp.assignType[data.split(',')[index]];
                },
                showIDx: function (val, index) {
                    if (val === void 0) return `前${Math.abs(index - 9)}局`
                    return val + 1
                },
                assignBackground: function (data, index) {
                    if (!data) { return; }
                    var value = data.split(',')[index];
                    if (value == 1) {
                        return '#9bc7a0';
                    }
                    return '#f9baba';
                },
                cancelAssignReward: function () {
                    $.get('/GameCommon/CancelAssignReward', { 'gameID': vApp.gameID }, function (result) {
                        alert(result.msg);
                    });
                },
                createWinPrizeLogTable: function () {
                    const opt = datatable_opt.WinPrizeLogTable()
                    $("#WinPrizeLog_table").dataTable(opt)
                },
                editPool: function () {
                    if (this.editPoolInfo.Amount) {
                        $.get('/GameCommon/EditPoolAndFreeMoney', { 'serverID': vApp.serverID, 'tableNo': vApp.editPoolInfo.EditTableNo, 'poolAmount': vApp.editPoolInfo.Amount, 'type': 1 }, function (msg) {
                            if (msg.result) {
                                alert('恭喜您，修改成功！');
                                $('#editPool').modal('hide');
                            }
                            else {
                                alert('修改失败！');
                            }
                        });
                    }
                },
                showPoolLog: function () {
                    this.editPoolInfo = { EditTableNo: this.tableNO };
                    const opt = datatable_opt.PoolLog()
                    $("#PoolLog_table").dataTable(opt)
                },
                showFreeMoneyLog: function () {
                    this.editFreeMoneyInfo = {};
                    this.editFreeMoneyInfo = { EditTableNo: this.tableNO };
                    const opt = datatable_opt.ChangeLog()
                    $("#FreeMoney_table").dataTable(opt)
                },

                /*TodayRanking*/
                showTodayRanking: function () {
                    $('#todayRanking').modal('show');
                    this.getRankingList()
                    this.$set(this, 'todayRanking_interval', setInterval(function () {
                        vApp.todayRanking_table.DataTable().ajax.reload();
                    }, 15000))
                },

                /*TodayUser*/
                showTodayUser: function () {
                    $('#todayUser').modal('show');
                    this.getUserList()
                    this.$set(this, 'todayUser_interval', setInterval(function () {
                        vApp.todayUser_table.DataTable().ajax.reload();
                    }, 15000))
                },

                /*VIPUser*/
                showVIPUser: function () {
                    $('#VIPUser').modal('show');
                    this.getVIPUser()
                    this.$set(this, 'VIPUser_interval', setInterval(function () {
                        vApp.VIPUser_table.DataTable().ajax.reload();
                    }, 30000))
                },
                getRankingList: function () {
                    const opt = datatable_opt.TodayRanking()
                    this.$set(this, 'todayRanking_table', $("#TodayRanking_table").dataTable(opt))
                },
                getUserList: function () {
                    const opt = datatable_opt.TodayUser()
                    this.$set(this, 'todayUser_table', $("#TodayUser_table").dataTable(opt))
                },
                getVIPUser: function () {
                    vApp.datas = [];
                    const opt = datatable_opt.VIPUser()
                    this.$set(this, 'VIPUser_table', $("#VIPUser_table").dataTable(opt))
                },
                addNewUserID: function () {
                    if (this.NewUserID)
                        $.get('/GameCommon/AddVIPUser', { 'userID': vApp.NewUserID }, function (result) {
                            alert(result.msg);
                            vApp.VIPUser_table.DataTable().ajax.reload();
                        });
                },
                editStatus: function (rowIndex, status) {
                    var data = vApp.datas[rowIndex];
                    data.Status = status;
                    data.AssignAmount = ToCash(data.AssignAmount);
                    vApp.editVIPUser(data);
                },
                saveVIPUser: function (rowIndex) {
                    const data = vApp.datas[rowIndex];
                    const userID = data.UserID
                    const amount = $(`#AssignAmount_${userID}`).val();
                    const rate = $(`#AssignRate_${userID}`).val();

                    data.AssignAmount = amount
                    data.AssignRate = rate
                    vApp.editVIPUser(data);
                },
                editVIPUser: function (data) {
                    $.ajax({
                        type: "POST",
                        data: JSON.stringify(data),
                        contentType: 'application/json',
                        traditional: true,
                        url: "/GameCommon/EditVIPUser",
                        success: function (result) {
                            alert(result.msg);
                            vApp.VIPUser_table.DataTable().ajax.reload();
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                },

                addVIPUser: function (userID) {
                    $.get('/GameCommon/AddVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.restart()
                    });
                },
                delVIPUser: function (userID) {
                    $.get('/GameCommon/DelVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.restart()
                    });
                },

                restart () {
                    if (vApp.todayRanking_table !== null) vApp.todayRanking_table.DataTable().ajax.reload();
                    if (vApp.todayUser_table !== null) vApp.todayUser_table.DataTable().ajax.reload();
                    if (vApp.VIPUser_table !== null) vApp.VIPUser_table.DataTable().ajax.reload();
                },

                editFreeMoney: function () {
                    if (this.editFreeMoneyInfo.Amount) {
                        $.get('/GameCommon/EditPoolAndFreeMoney', { 'serverID': vApp.serverID, 'tableNo': vApp.editFreeMoneyInfo.EditTableNo, 'poolAmount': vApp.editFreeMoneyInfo.Amount, 'type': 2 }, function (msg) {
                            if (msg.result) {
                                alert('恭喜您，修改成功！');
                                $('#editFreeMoney').modal('hide');
                            }
                            else {
                                alert('修改失败！');
                            }
                        });
                    }
                },
                setWinPrize: function () {
                    var checkList = this.WinPrize.Check;
                    var radiotVal = this.WinPrize.Radio;
                    var names = [];
                    var result = [];

                    if (checkList.length > 0 || radiotVal != '') {

                        if (checkList.length > 0) {

                            checkList.forEach(function (i) {
                                names.push(vApp.prizeType[parseInt(i)]);
                            });
                            result = checkList;
                        }

                        if (radiotVal != '') {
                            names.push(vApp.prizeType[parseInt(radiotVal)]);
                            result.push(radiotVal);
                        }

                        $.ajax({
                            type: "GET",
                            data: {
                                'serverID': vApp.serverID,
                                'tableNo': vApp.tableNO,
                                'winPrize': result
                            },
                            traditional: true,
                            url: "/GameCommon/SetWinPrize",
                            success: function (msg) {
                                if (msg.result) {
                                    vApp.winPrizeMsgLabel = '*修改成功'
                                }
                                else {
                                    alert('修改失败！');
                                }
                            },
                            error: function (err) {
                                alert("操作失敗");
                            }
                        });
                    }
                },
                clearCheckBox: function () {
                    if (this.WinPrize.Radio == '') { return; }
                    if (this.WinPrize.Check.length == 0) { return; }

                    this.WinPrize.Check = [];
                    $('input[type="checkbox"][name="WinPrize"]').closest("span").removeClass('checked');
                },
                clearRadio: function (event) {
                    if (!event.target.checked) { return; }
                    if (this.WinPrize.Radio == '') { return; }

                    this.WinPrize.Radio = '';
                    $('input[type="radio"][name="WinPrize"]').closest("span").removeClass('checked');
                }
            }
        });

        vApp.getTableDetail();
        vApp.getAssignRewardDetail();
        setInterval(function () {
            vApp.getTableDetail();
        }, 1000);

        $(function () {
            $('#radioBtn a').on('click', function () {
                var sel = $(this).data('title');
                var tog = $(this).data('toggle');

                $('a[data-toggle="' + tog + '"]').not('[data-title="' + sel + '"]').removeClass('active').addClass('notActive');
                $('a[data-toggle="' + tog + '"][data-title="' + sel + '"]').removeClass('notActive').addClass('active');
            })

            $('#todayRanking').on('hidden.bs.modal', function () {
                window.clearInterval(vApp.todayRanking_interval)
                vApp.todayRanking_table = null
            });

            $('#todayUser').on('hidden.bs.modal', function () {
                window.clearInterval(vApp.todayUser_interval)
                vApp.todayUser_table = null
            });

            $('#VIPUser').on('hidden.bs.modal', function () {
                window.clearInterval(vApp.VIPUser_interval)
                vApp.VIPUser_table = null
            });
        });
    </script>
}