<div id="vApp">
    <div class="row">
        <div class="col-md-12">
            @*<div style="margin-top:20px; text-align:center;">
                <a class="btn btn-sm dark" v-on:click="createWinPrizeLogTable()" data-toggle="modal" data-target="#showWinPrizeLog">指定开奖操作查询</a>
            </div>*@
            <div class="col-md-5" style="padding:0;">
                <div class="portlet box grey" style="margin-top:20px;">
                    <div class="portlet-title">
                        <div class="caption">游戏信息</div>
                    </div>
                    <div class="portlet-body" >
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th colspan="7" class="text_center title_Color">游戏信息</th>
                                </tr>
                                <tr>
                                    <th class="col-md-1"> 游戏状态：</th>
                                    <td class="col-md-1"><span>{{tableStatus[tableDetail.Status]}}</span></td>
                                    <th class="col-md-1"> 当日抽水：</th>
                                    <td class="col-md-1">{{ToCash(info.TodayTax)}}</td>
                                    <th class="col-md-1">奖池金额：</th>
                                    <td><a class="btn_link_Red" href="#" v-on:click="showPoolLog()" data-toggle="modal" data-target="#editPool">{{ToCash(tableDetail.PoolCurrentAmount)}}</a></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <th class="text_center title_Color">监控人数</th>
                                    <th class="text_center title_Color">今日人数</th>
                                    <td colspan="2"><a target="_blank" href="/GameCommon/TodayRanking?gameID=@ViewBag.GameID&gameName=百家乐" class="btn_link">今日输赢榜</a></td>
                                    <th><a class="btn_link" href="#" v-on:click="showFreeMoneyLog()" data-toggle="modal" data-target="#editFreeMoney">指定放分金额</a></th>
                                    <th>
                                        <span style="font-weight:bold" v-if="tableDetail.FanFengTarget > tableDetail.FanFengComplete">放分进度：</span>
                                        <span v-else></span>
                                    </th>
                                    <td>
                                        <span v-if="tableDetail.FanFengTarget > tableDetail.FanFengComplete">{{ToCash(tableDetail.FanFengTarget)}} / {{ToCash(tableDetail.FanFengComplete)}}</span>
                                        <span v-else></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td rowspan="2" style="vertical-align: middle;" class="text_center">
                                        <a class="btn_link_Red" target="_blank" href="/GameCommon/VIPUser?gameID=@ViewBag.GameID">{{info.VipUser}}</a>
                                    </td>
                                    <td rowspan="2" style="vertical-align: middle;" class="text_center">
                                        <a target="_blank" href="/GameCommon/TodayUser?gameID=@ViewBag.GameID&gameName=百家乐" class="btn_link_Red">{{info.TodayUser}}</a>
                                    </td>
                                    <th colspan="5" class="text_center title_Color">当前玩家下注金额</th>
                                </tr>
                                <tr>
                                    <th class="text_center col-md-1">庄</th>
                                    <th class="text_center col-md-1">和</th>
                                    <th class="text_center col-md-1">闲</th>
                                    <th class="text_center col-md-1">庄对</th>
                                    <th class="text_center col-md-1">闲对</th>
                                </tr>
                                <tr>
                                    <th class="text_Center title_Color">机器人数</th>
                                    <th class="text_Center title_Color">玩家人数</th>
                                    <td class="text_center"><span>{{ToCash(sum.UserZhuang)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserHe)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserXian)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserZhuangDZ)}}</span></td>
                                    <td class="text_center"><span>{{ToCash(sum.UserXianDZ)}}</span></td>
                                </tr>
                                <tr>
                                    <td class="text_center"><span>{{tableDetail.RobotCount}}</span></td>
                                    <td class="text_center"><span>{{tableDetail.GameUserCount}}</span></td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">百局胜率: <span>{{tableDetail.ZhuangWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">百局胜率: <span>{{tableDetail.HeWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">百局胜率: <span>{{tableDetail.XianWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">百局胜率: <span>{{tableDetail.ZhuangDZWinRate}}</span>%</td>
                                    <td style="width:5%; vertical-align: middle;" class="text_center">百局胜率: <span>{{tableDetail.XianDZWinRate}}</span>%</td>
                                </tr>
                                <tr>
