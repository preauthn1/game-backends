                                <input type="text" class="form-control input-small" placeholder="请输入修改金额" value="" v-model="editPoolInfo.Amount" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary" v-on:click="editPool()">确定</button>
