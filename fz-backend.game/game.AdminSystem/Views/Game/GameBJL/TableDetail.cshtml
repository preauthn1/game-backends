                    <table id="FreeMoney_table" class="display" style="width:100%;"></table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#vApp',
            data: {
                serverID: '@ViewBag.ServerID',
                tableNO: '@ViewBag.TableNO',
                gameID: '@ViewBag.GameID',
                showName: '@ViewBag.ShowName',
                tableStatus: ['下注中', '开奖中', '开奖动画', '结算动画', '等待开始游戏'],
                bankerType: ['系统', '机器人上庄', '玩家上庄'],
                prizeType: ['', '庄', '闲', '和', '', '', '庄对', '闲对'],
                userType: ['机器人', '玩家'],
                tableDetail: {},
                sum: {},
                info: {},
                assignRewardDetail: {},
                assignRate: {},
                setWinPrizeInfo: {},
                editPoolInfo: {},
                editFreeMoneyInfo: {},
                winConfig: {
                    1: '庄',
                    10: '闲',
                    100: '和',
                    100001: '庄/庄對',
                    1000001: '庄/闲對',
                    1100001: '庄/庄對/闲對',
                    100100: '和/庄對',
                    1000100: '和/闲對',
                    1100100: '和/庄對/闲對',
                    100010: '闲/庄對',
                    1000010: '闲/闲對',
                    1100010: ' 闲/庄對/闲對'
                }
            },

            watch: {
                'tableDetail.BetTime' (val, oldVal) {
                    if (val < 3 && val >= 0) this.getAssignRewardDetail();
                }
            },

            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getTableDetail: function () {
                    $.get('/GameBJL/GetTableDetail', { 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, '_r': Math.random() }, function (data) {
                        if (data instanceof Object) {
                            vApp.tableDetail = data.TableDetail;
                            vApp.sum = data.Sum;
                            example.invalid = example.invalid;

                            if (vApp.tableDetail.BetTime <= 0) {
                                $("#WinPrizeMsg").text("");
                                vApp.setWinPrizeInfo = {};
                                $('input[type="checkbox"][name="WinPrize"]').closest("span").removeClass('checked');
                                $('input[type="radio"][name="WinPrize"]').closest("span").removeClass('checked');
                            }
                        }
                        else {
                            vApp.tableDetail = {};
                            vApp.sum = {};
                            example.invalid = {};
                        }
                    });
                },
                getAssignRewardDetail: function () {
                    $.get('/GameBJL/GetAssignRewardDetail', { 'gameID': vApp.gameID, 'serverID': vApp.serverID, 'tableNo': vApp.tableNO, '_r': Math.random() }, function (data) {

                        if (data instanceof Object) {
                            const history = data.History
                            vApp.assignRewardDetail = history.length > 0 ? history : data.AssignRewardDetail;
                            vApp.assignRate = data.Rate;
                        }
                        else {
                            App.assignRewardDetail = {};
                            vApp.assignRate = {};
                        }
                    });
                },
                cancelAssignReward: function () {
                    $.get('/GameCommon/CancelAssignReward', { 'gameID': vApp.gameID }, function (result) {
                        alert(result.msg);
                    });
                },
                showFatal: function (win) {
                    return `${vApp.winConfig[win]}`
                },
                showAssign:function(data){
                    if (!data) { return ''; }

                    if (data.indexOf(',') == -1) {
                        return vApp.prizeType[data];
                    }

                    var result = [];
                    var datas = data.split(',');
                    datas.forEach(function (item) {
                        result.push(vApp.prizeType[item]);
                    });
                    return result.join(', ');
                },
                createWinPrizeLogTable: function () {
                    const head = [
                               { "sTitle": "牌局ID", "mData": "LogID" },
                               { "sTitle": "修改人", "mData": "AdminUser" },
                               {
                                   "sTitle": "开奖类型", "mData": "PrizeType",
                                   "render": function (data, type, row) {
                                       if (data.indexOf(",") != -1) {
                                           var _array = data.split(',');
                                           for (var i = 0; i < _array.length; i++) {
                                               _array[i] = vApp.prizeType[_array[i]];
                                           }
                                           return _array.join(',');
                                       }

                                       return vApp.prizeType[data];
                                   }
                               },
                               { "sTitle": "创建时间", "mData": "StrCreateTime" },
                               { "sTitle": "修改时间", "mData": "StrUpdateTime" }]

                    const beginTime = $("#beginTimeLog").val();
                    const endTime = $("#endTimeLog").val();

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "lengthMenu": [20, 50, 100, 150],
                        "pageLength": 50,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetWinPrizeLog",
                            "data": {
                                '_r': Math.random(),
                                'ServerID': vApp.serverID,
                                'GameID': vApp.gameID,
                                'TableNo': vApp.tableNO,
                                'BeginTime': beginTime,
                                'EndTime': endTime
                            }
                        },
                        "destroy": true
                    }
                    $("#WinPrizeLog_table").dataTable(opt)
                },
                editPool: function () {
                    if (this.editPoolInfo.Amount) {
                        $.get('/GameCommon/EditPoolAndFreeMoney', { 'serverID': vApp.serverID, 'tableNo': vApp.editPoolInfo.EditTableNo, 'poolAmount': vApp.editPoolInfo.Amount, 'type': 1 }, function (msg) {
                            if (msg.result) {
                                alert('恭喜您，修改成功！');
                                $('#editPool').modal('hide');
                            }
                            else {
                                alert('修改失败！');
                            }
                        });
                    }
                },
                showPoolLog: function () {
                    this.editPoolInfo = { EditTableNo: this.tableNO };
                    const head = [
                               { "sTitle": "修改记录", "mData": "Result" },
                               { "sTitle": "修改人", "mData": "Operator" },
                               { "sTitle": "修改时间", "mData": "StrCreateTime" }]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetChangeLog",
                            "data": {
                                'type': 1,
                                'gameID': vApp.gameID,
                            }
                        },
                        "destroy": true
                    }
                    $("#PoolLog_table").dataTable(opt)
                },
                showFreeMoneyLog: function () {
                    this.editFreeMoneyInfo = {};
                    this.editFreeMoneyInfo = { EditTableNo: this.tableNO };
                    const head = [
                             { "sTitle": "修改记录", "mData": "Result" },
                             { "sTitle": "修改人", "mData": "Operator" },
                             { "sTitle": "修改时间", "mData": "StrCreateTime" }]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetChangeLog",
                            "data": {
                                'type': 2,
                                'gameID': vApp.gameID,
                            }
                        },
                        "destroy": true
                    }
                    $("#FreeMoney_table").dataTable(opt)
                },
                editFreeMoney: function () {
                    if (this.editFreeMoneyInfo.Amount) {
                        $.get('/GameCommon/EditPoolAndFreeMoney', { 'serverID': vApp.serverID, 'tableNo': vApp.editFreeMoneyInfo.EditTableNo, 'poolAmount': vApp.editFreeMoneyInfo.Amount, 'type': 2 }, function (msg) {
                            if (msg.result) {
                                alert('恭喜您，修改成功！');
                                $('#editFreeMoney').modal('hide');
                            }
                            else {
                                alert('修改失败！');
                            }
                        });
                    }
                },
                setWinPrize: function () {

                    if (!vApp.setWinPrizeInfo.assignZhuang && !vApp.setWinPrizeInfo.assignXian && !vApp.setWinPrizeInfo.assignRadio) {
                        return;
                    }

                    if ((vApp.setWinPrizeInfo.assignZhuang || vApp.setWinPrizeInfo.assignXian) && !vApp.setWinPrizeInfo.assignRadio) {
                        return;
                    }

                    var array = [];
                    array.push(vApp.setWinPrizeInfo.assignRadio);
                    if (vApp.setWinPrizeInfo.assignZhuang) {
                        array.push(6);
                    }
                    if (vApp.setWinPrizeInfo.assignXian) {
                        array.push(7);
                    }

                    $.ajax({
                        type: "GET",
                        data: {
                            'serverID': vApp.serverID,
                            'tableNo': vApp.tableNO,
                            'winPrize': array
                        },
                        traditional: true,
                        url: "/GameCommon/SetWinPrize",
                        success: function (msg) {
                            if (msg.result) {
                                $("#WinPrizeMsg").text("*修改成功");
                            }
                            else {
                                alert('修改失败！');
                            }
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                },
                addVIPUser: function (userID) {
                    $.get('/GameCommon/AddVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                    });
                },
                delVIPUser: function (userID) {
                    $.get('/GameCommon/DelVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                    });
                }
            }
        });

        vApp.getTableDetail();
        vApp.getAssignRewardDetail();
        setInterval(function () {
            vApp.getTableDetail();
        }, 1000);
    </script>
}