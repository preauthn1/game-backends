                        <div class="caption">玩家信息(上局前50下注用户)</div>
                    </div>
                    <div class="portlet-body" style="height:435px; overflow:auto;" >
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>玩家ID</th>
                                    <th>监控</th>
                                    <th>携带金币</th>
                                    <th>总充值</th>
                                    <th>总兑换</th>
                                    <th>累计输赢</th>
                                    <th>百局胜率</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="user in tableDetail.LastGameUserBet">
