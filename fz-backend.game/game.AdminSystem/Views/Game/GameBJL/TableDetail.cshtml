                                        <a target="_blank" :href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{user.UserID}}</a>
                                    </td>
                                    <td>
                                        <span v-if="user.IsVIP"><a class="btn_link_Red" href="#" v-on:click="delVIPUser(user.UserID)">删除监控</a></span>
                                        <span v-else="user.IsVIP"><a class="btn_link" href="#" v-on:click="addVIPUser(user.UserID)">增加监控</a></span>
                                    </td>
                                    <td>{{ToCash(user.CurrentMoney)}}</td>
                                    <td>{{ToCash(user.SumCharge)}}</td>
                                    <td>{{ToCash(user.SumConvert)}}</td>
                                    <td>{{ToCash((user.SumCharge - user.SumConvert - user.CurrentMoney)* -1)}}</td>
                                    <td><span>{{user.WinRate}}</span>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="col-md-3">
                <div class="portlet box grey" style="margin-top:20px;">
                    <div class="portlet-title">
                        <div class="caption">20局开奖记录</div>
                    </div>
                    <div class="portlet-body">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th class="text_center width6"></th>
                                    <th colspan="3" class="text_center"><a target="_blank" href="/GameBJL/AssignReward?serverID=@ViewBag.ServerID&gameID=@ViewBag.GameID&tableNo=@ViewBag.TableNO" class="btn_link">指定20局开奖</a></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="data in assignRewardDetail">
                                    <th class="text_center">{{data.Idx+1}}</th>
                                    <td v-if="data.StrStatus" class="text_center">{{showAssign(data.Reward)}}</td>
                                    <td v-if="data.StrStatus" class="text_center">{{data.StrStatus}}</td>
                                    <td v-if="data.StrStatus" class="text_center">{{showAssign(data.Description)}}</td>
                                    <td v-else class="text_center">
                                        {{showFatal(data.Description.toString(2))}}
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text_center">
                                        <a v-if="assignRate.MainStatus == 1" class="btn_link_Red" v-on:click="cancelAssignReward()" href="#">取消指定20局开奖</a>
                                        <span v-else-if="assignRate.MainStatus == 0" class="color-red">已取消指定20局开奖</span>
                                        <span v-else class="color-red">暂无指定20局开奖</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
            <div class="col-md-4">
                <div class="portlet box grey" style="margin-top:20px;">
                    <div class="portlet-title">
                        <div class="caption">当前下注</div>
                    </div>
                    <div class="portlet-body" style="height:770px; overflow:auto;">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th style="width: 10%;">
                                        <a href="#" v-on:click="createWinPrizeLogTable()" data-toggle="modal" data-target="#showWinPrizeLog">指定开奖：</a>
                                        <span style="color:red;">{{tableDetail.BetTime}}</span>
                                    </th>
                                    <th colspan="7">
                                        <label>
                                            庄
                                            <input type="radio" value="1" v-model="setWinPrizeInfo.assignRadio" name="WinPrize" />
                                        </label>
                                        <label>
                                            和
                                            <input type="radio" value="3" v-model="setWinPrizeInfo.assignRadio" name="WinPrize" />
                                        </label>
                                        <label>
                                            闲
                                            <input type="radio" value="2" v-model="setWinPrizeInfo.assignRadio" name="WinPrize" />
                                        </label>
                                        <label>
                                            庄对
                                            <input type="checkbox" value="6" v-model="setWinPrizeInfo.assignZhuang" name="WinPrize" />
                                        </label>
                                        <label>
                                            闲对
                                            <input type="checkbox" value="7" v-model="setWinPrizeInfo.assignXian" name="WinPrize" />
                                        </label>
                                        <button type="button" class="btn btn-default" v-on:click="setWinPrize()">确定</button>
                                    </th>
                                </tr>
                                <tr>
                                    <th><span style="color:red;" id="WinPrizeMsg"></span></th>
                                    <th style="width: 7%;">玩家ID</th>
                                    <th style="width: 7%;">庄</th>
                                    <th style="width: 7%;">和</th>
                                    <th style="width: 7%;">闲</th>
                                    <th style="width: 7%;">庄对</th>
                                    <th style="width: 7%;">闲对</th>
                                    <th style="width:10%;">百局胜率</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="user in tableDetail.UserInfo">
                                    <td>
                                        <span class="color-red" v-if="user.IsVIP">(已监控)</span>
                                        <span v-else="user.IsVIP">(未添加)</span>
                                    </td>
                                    <td>
                                        <a target="_blank" :href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{user.UserID}}</a>
                                    </td>
                                    <td v-bind:class="{'color-red':user.BetInfoZhuang > 0 }">{{ToCash(user.BetInfoZhuang)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoHe > 0 }">{{ToCash(user.BetInfoHe)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoXian > 0 }">{{ToCash(user.BetInfoXian)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoZhuangDZ > 0 }">{{ToCash(user.BetInfoZhuangDZ)}}</td>
                                    <td v-bind:class="{'color-red':user.BetInfoXianDZ > 0 }">{{ToCash(user.BetInfoXianDZ)}}</td>
                                    <td><span>{{user.WinRate}}</span>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">         
        </div>
        @Html.Back(Url.Action("TableList", new { serverID = ViewBag.ServerID }))
    </div>
    <!--编辑水池-->
    <div class="modal fade" id="editPool" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal.large modal-size">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">奖池金额</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-5 control-label">当前奖池金额：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{ToCash(tableDetail.PoolCurrentAmount)}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-5 control-label">平衡金额：</label>
                            <div class="col-md-6">
                                <span class="help-block">{{ToCash(tableDetail.WinLine)}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-5 control-label">修改金额：</label>
