@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/Component/target.js")"></script>
    <script src="https://example.invalid/ajax/libs/lodash.js/4.15.0/lodash.min.js"></script>
    <link href="@Url.Content("~/Plugins/Vue/css/main.css")" rel="stylesheet" type="text/css" />
}

<div class="row" id="vApp">
    <div class="col-md-8 col-md-offset-2">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>域名配置
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="form1" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">营运平台</label>
                            <div class="col-md-8">
                                <select class="form-control input-medium" id="company" name="company" v-model="company">
                                    <option v-for="option in companyList"
                                            v-bind:value="option.Id"
                                            v-bind:selected="option.Id == company">
                                        {{ option.Name }}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">支付域名</label>
                            <div class="col-md-8">
                                <input type="text" name="payment" class="form-control input-medium" placeholder="请输入支付域名" v-model="payment" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">游戏更新域名</label>
                            <div class="col-md-8">
                                <input type="text" name="update" class="form-control input-medium" placeholder="请输入游戏更新域名" v-model="update" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">代理域名</label>
                            <div class="col-md-8">
                                <input type="text" name="club" class="form-control input-medium" placeholder="请输入代理域名" v-model="club" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">客服域名</label>
                            <div class="col-md-8">
                                <input type="text" name="customer" class="form-control input-medium" placeholder="请输入客服域名" v-model="customer" />
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-3 col-md-9">
                            @Html.OkWithRight()
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>
@section initScripts{
    <script>
        var num = 0;
        $(function () {
            $("#form1").validate({
                rules: {
                    payment: {
                        required: true
                    },
                    update: {
                        required: true
                    },
                    club: {
                        required: true
                    },
                    customer: {
                        required: true
                    },
                    company: {
                        required: true
                    }
                }
            });
        })
        
        var vApp = new Vue({
            el: '#vApp',
            data: {
                companyList: JSON.parse(`@Html.Raw(Json.Encode(@ViewBag.CompanyList))`),
                company: null,
                payment: null,
                update: null,
                club: null,
                customer: null
            },
            watch: {
                company: function (val) {                   
                    this.getDomain(val)
                }
            },
            methods: {
                getDomain(id) {                  
                    $.get('/DomainConfig/GetSettingById', { 'id': id, '_r': Math.random() }, function (res) {                        
                        vApp.$set(vApp, 'payment', res.Payment)
                        vApp.$set(vApp, 'update', res.Update)
                        vApp.$set(vApp, 'club', res.Club)
                        vApp.$set(vApp, 'customer', res.Customer)
                    })
                }
            }
        })
    </script>
}