@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}
<style>
    .content {
        padding: .5%;
        font-size: 1.2em;
        font-family: serif;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <label>接收时间</label>
                    <input type="text" class="form-control " style="width:180px" id="sendTimeBegin" name="sendTimeBegin" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="sendTimeEnd" name="sendTimeEnd" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-default" onclick="search()"> 搜 索 </button>
                </div>
            </form>
            @Html.Partial("_message")
            <div class="content">
                <table id="inbox_table" class="display" style="width:100%"></table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>

        function createTable() {
            const url = '/Message/GetInbox'
            const thead = [{ "sTitle": "接收时间", "mData": "ReadTime" },
                            { "sTitle": "所属平台", "mData": "Platform" },
                            {
                                "sTitle": "用户ID", "mData": "UserID", "width": "8%",
                                "render": function (data, type, row) {
                                    return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                                }
                            },
                            {
                                "sTitle": "帐号", "mData": "LoginName", "width": "8%",
                                "render": function (data, type, row) {
                                    return `<a class="link" target="_blank" href="/UserInfo/Search?loginName=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                                }
                            },
                            { "sTitle": "用户等级", "mData": "GradeID", "className": "text_right" },
                            { "sTitle": "消息编号", "mData": "MsgID", "className": "text_right" },
                            { "sTitle": "消息内容", "mData": "MsgContent", "width": "30%", },
                            { "sTitle": "消息状态", "mData": "Status" },
                            {
                                "data": null,
                                "mRender": function (data, type, full) {

                                    var delete_token = [REDACTED]"DelInbox", "get")`
                                    var delete_control = ''

                                    if (delete_token === 'True') {
                                        delete_control = `
                                                           <div class ="pointer delete-control">
                                                            <div class ="btn-trash"></div>
                                                            <span>删除<span>
                                                           </div>`
                                    }

                                    return `<div class="control">${delete_control}<div>`
                                }
                            }]

            var loginName = $('#loginName').val()
            var userID = $('#userID').val()
            var sendTimeBegin = $('#sendTimeBegin').val()
            var sendTimeEnd = $('#sendTimeEnd').val()

            const data = {
                loginName: loginName,
                userID: userID,
                sendTimeBegin: sendTimeBegin,
                sendTimeEnd: sendTimeEnd
            }
            createDataTable('inbox', thead, url, data)
        }

        function search() {
            var errorMsg = validateFunc()
            if (errorMsg) {
                Msg.alert(errorMsg, 'danger')
                return false
            }
            createTable()
        }

        var validateFunc = function () {
            var validator = new Validator()
            validator.add([form_search.loginName, form_search.nickName, form_search.userID], [{
                strategy: 'isSomeNonEmpty',
                errorMsg: '账户信息不能全为空,请输入账号或者ID！'
            }])

            var errorMsg = validator.start()
            return errorMsg
        }

        $(function () {
            fillFormData('form_search');
            createTable()

            $('#inbox_table tbody').on('click', '.delete-control', function () {
                var tr = $(this).closest('tr');
                var row = dataTable.row(tr);
                var data = row.data()

                var option = {
                    isAjax: true,
                    isReload: false,
                    callback: function () {
                        dataTable.ajax.reload(null, false);
                    }
                }
                swDelConfirmUrl(`DelInbox?msgID=${data.MsgID}&userID=${data.UserID}`, '确定要刪除么？', option);
            })
        })
    </script>
}