@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
}

<style>
    .color-red {
        color: red;
        font-size: 16px;
        font-weight: bold;
    }

    .zjhTool_contain {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1%;
    }

    .zjhTool_contain_label {
        display: flex;
        align-items: center;
        font-size: 16px;
        font-weight: 600;
    }

    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }
</style>

<div id="vApp">
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-9" style="padding:0;">
                <div class="portlet box grey" style="margin-top:20px;">
                    <div class="portlet-title">
                        <div class="caption">游戏信息</div>
                    </div>
                    <div class="portlet-body">

                        <div class="zjhTool_contain">
                            <div class="zjhTool_contain_label">
                                <span class="text_center">房间：　</span>
                                <select class="form-control input-small color-red" value="" v-model="spaceID">
                                    <option value="3">初级场</option>
                                    <option value="27">中级场</option>
                                    <option value="28">高级场</option>
                                </select>
                            </div>
                            <div class="zjhTool_contain_label">
                                <span class="text_center">桌号：　</span>
                                <input list="tableNo" class="form-control input-small color-red" v-model="tableNo" />
                                <datalist id="tableNo">
                                    <option v-for="no in tableList">{{no}}</option>
                                </datalist>
                            </div>
                            <div class="zjhTool_contain_label">
                                <span class="text_center">发牌规则：　</span>
                                <button type="button" class="btn btn-info" v-bind:class="{'btn-danger':FapaiRule === 1 }" v-on:click="changeFapaiRule(FapaiRule)">
                                    {{FapaiRuleList[FapaiRule]}}
                                </button>
                            </div>
                            <div class="zjhTool_contain_label">
                                <a target="_blank" class="btn_link" v-bind:href="'/GameZJH/VIPUser?serverID=' + spaceID">监控名单</a>
                            </div>
                        </div>
                        <table id="ZJH_table" class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>玩家ID</th>
                                    <th>累计充值</th>
                                    <th>累计兑换</th>
                                    <th>累计输赢</th>
                                    <th>今日充值</th>
                                    <th>今日兑换</th>
                                    <th>今日累计输赢</th>
                                    <th>桌号</th>
                                    <th>绑定手机</th>
                                    <th>绑定支付宝</th>
                                    <th>手中牌</th>
                                    <th>牌型</th>
                                    <th>添加监控</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="user in onlineUserList">
                                    <td>
                                        <a target="_blank" v-bind:href="'/UserInfo/Search?userID=' + user.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{user.UserID}}</a>
                                    </td>
                                    <td>{{ToCash(user.SumCharge)}}</td>
                                    <td>{{ToCash(user.SumConvert)}}</td>
                                    <td>{{ToCash(user.SumWinLose)}}</td>
                                    <td>{{ToCash(user.TodayCharge)}}</td>
                                    <td>{{ToCash(user.TodayConvert)}}</td>
                                    <td>{{ToCash(user.TodayWinLose)}}</td>
                                    <td>{{user.TableNo}}</td>
                                    <td>{{user.LoginName}}</td>
                                    <td>{{user.AlipayAccount}}</td>
                                    <td>{{user.CurrentCard}}</td>
                                    <td>{{user.CurrentCardType}}</td>
                                    <td>
                                        <span v-if="user.IsVIP"><a class="btn_link_Red" href="#" v-on:click="delVIPUser(user.UserID)">删除监控</a></span>
                                        <span v-else="user.IsVIP"><a class="btn_link" href="#" v-on:click="addVIPUser(user.UserID)">增加监控</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="portlet box grey" style="margin-top:20px;">
                    <div class="portlet-title">
                        <div class="caption">数据统计</div>
                    </div>
                    <div class="portlet-body">
                        <table class="table table-striped table-bordered table-hover" style="margin-bottom:0px;">
                            <thead>
                                <tr>
                                    <th>豹子</th>
                                    <th>顺金</th>
                                    <th>金花</th>
                                    <th>顺子</th>
                                    <th>对子</th>
                                    <th>单牌</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span>{{BaoZiCount.Rate}}</span>%</td>
                                    <td><span>{{SunJinCount.Rate}}</span>%</td>
                                    <td><span>{{JiaHuaCount.Rate}}</span>%</td>
                                    <td><span>{{SunZiCount.Rate}}</span>%</td>
                                    <td><span>{{DuiZiCount.Rate}}</span>%</td>
                                    <td><span>{{SanPaiCount.Rate}}</span>%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>


@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#vApp',
            data: {
                serverID: '@ViewBag.ServerID',
                gameID: '@ViewBag.GameID',
                spaceID: '@ViewBag.ServerID',
                tableNo: '',
                tableList: {},
                onlineUserList: {},
                BaoZiCount: {},
                SunJinCount: {},
                JiaHuaCount: {},
                SunZiCount: {},
                DuiZiCount: {},
                SanPaiCount: {},
                ajax_table: null,
                FapaiRule: 1,
                FapaiRuleList: {
                    1: '大牌规则',
                    2: '一般规则'
                }
            },
            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getTableDetail: function () {
                    $.get('/GameZJH/GetTableDetail', { 'serverID': vApp.spaceID, 'tableNo': vApp.tableNo }, function (data) {
                        if (data.TableList) {
                            vApp.tableList = data.TableList;
                            vApp.onlineUserList = data.OnlineUserList;
                            vApp.BaoZiCount = data.BaoZiCount;
                            vApp.SunJinCount = data.SunJinCount;
                            vApp.JiaHuaCount = data.JiaHuaCount;
                            vApp.SunZiCount = data.SunZiCount;
                            vApp.DuiZiCount = data.DuiZiCount;
                            vApp.SanPaiCount = data.SanPaiCount;
                            vApp.FapaiRule = data.FapaiRule;
                        }
                        else {
                            vApp.tableList = {};
                            vApp.onlineUserList = {};
                            vApp.BaoZiCount = {};
                            vApp.SunJinCount = {};
                            vApp.JiaHuaCount = {};
                            vApp.SunZiCount = {};
                            vApp.DuiZiCount = {};
                            vApp.SanPaiCount = {};
                        }
                    });
                },
                addVIPUser: function (userID) {
                    $.get('/GameZJH/AddVIPUser', { 'userID': userID }, function (result) {
                        swal({
                            type: 'success',
                            title: result.msg,
                        }).then((result) => {
                            vApp.getTableDetail();
                        })
                    });
                },
                delVIPUser: function (userID) {
                    $.get('/GameZJH/DelVIPUser', { 'userID': userID }, function (result) {
                        swal({
                            type: 'success',
                            title: result.msg,
                        }).then((result) => {
                            vApp.getTableDetail();
                        })
                    });
                },

                changeFapaiRule: function (fapaiRule) {
                    const rule = fapaiRule == 1 ? 2 : 1;
                    $.get('/GameZJH/EditFapaiRule', { 'serverID': vApp.spaceID, 'fapaiRule': rule }, function (result) {
                        swal({
                            type: 'success',
                            title: '修改成功',
                        }).then((result) => {
                            vApp.getTableDetail();
                        })
                    });
                }
            }
        });

        vApp.getTableDetail();
        setInterval(function () {
            vApp.getTableDetail();
        }, 1500);

    </script>
}