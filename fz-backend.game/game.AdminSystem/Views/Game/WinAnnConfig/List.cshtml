@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model List<game.Entity.Game.WinAnnConfig>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>游戏编号</th>
                            <th>游戏名称</th>
                            <th>自动通知金额上限</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.GameInfo.GameName</td>
                                <td>@item.UpperLimit.ToCash()</td>
                                <td>
                                    @Html.LinkWithRight(action: "Edit", value: "编辑", href: "Edit?id=" + item.Id)
                                    @Html.LinkWithRight(action: "Delete", value: "删除", onclick: "swDelConfirmUrl('Delete?id=" + item.Id + "')", href: "#")
                                </td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>