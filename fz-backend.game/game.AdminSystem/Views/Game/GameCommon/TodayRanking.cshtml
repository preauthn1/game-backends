@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }

    .fontSize {
        font-size: 16px;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }
</style>

<div class="row" id="todayRankingList">
    <div class="col-md-12">
        <div class="protlet-body" style="margin-top:20px;">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>状态</label>
                    <select v-model="selectedStatus" class="form-control input-small fontSize">
                        <option value="1">在线</option>
                        <option value="0">离线</option>
                        <option></option>
                    </select>
                </div>
            </form>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">@(ViewBag.GameName)今日输赢排行榜</div>
                </div>
                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover progressTable" id="TodayRanking_table"></table>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#todayRankingList',
            data: {
                gameID: '@ViewBag.GameID',
                showName: '@ViewBag.ShowName',
                selectedStatus: {}
            },
            methods: {
                getRankingList: function () {
                    const head = [
                           {
                               "sTitle": "玩家ID", "mData": "UserID",
                               "render": function (data, type, row) {
                                   return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                               }
                           },
                           {
                               "sTitle": "今日输赢", "mData": "TodayUserWinLose",
                               "render": function (data, type, row) {
                                   var value = data * -1;
                                   if (value < 0) {
                                       return `<span class="update_Red">${ToCash(value)}</span>`
                                   }
                                   return `<span class="update_Green">${ToCash(value)}</span>`
                               }
                           },
                           { "sTitle": "总胜率(%)", "mData": "TotalWinRate", },
                           { "sTitle": "今日局数", "mData": "TodayAll" },
                           { "sTitle": "今日胜局", "mData": "TodayWin" },
                           { "sTitle": "今日胜率(%)", "mData": "TodayWinRate" },
                           { "sTitle": "是否在线", "mData": "StrOnline" },
                           { "sTitle": "上线时间", "mData": "StrLoginTime" },
                           { "sTitle": "下线时间", "mData": "StrLogoutTime" },
                           {
                               "sTitle": "增删监控", "mData": "VIPUserID",
                               "render": function (data, type, row) {
                                   if (data == 0) {
                                       return `<a class="btn_link" href="#" onclick="vApp.addVIPUser(${row.UserID})" >增加监控</a>`
                                   }
                                   return `<a class="btn_link_Red" href="#" onclick="vApp.delVIPUser(${data})" >删除监控</a>`
                               }
                           }]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetTodayRanking",
                            "data": {
                                'gameID': vApp.gameID,
                                'online': vApp.selectedStatus
                            }
                        },
                        "destroy": true
                    }
                    $("#TodayRanking_table").dataTable(opt)
                },
                addVIPUser: function (userID) {
                    $.get('/GameCommon/AddVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.getRankingList();
                    });
                },
                delVIPUser: function (userID) {
                    $.get('/GameCommon/DelVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.getRankingList();
                    });
                }
            }
        });

        vApp.getRankingList();
        setInterval(function () {
            vApp.getRankingList();
        }, 10000);

    </script>
}