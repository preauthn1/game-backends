@using FW.Core.Helper
@using FW.Core.Web.Mvc
@using game.Entity.Agent
@model PagedList<AgentUserInfo>
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                <div class="form-group">
                    <label>是否在客户端显示</label>
                    <select class="form-control input-small" id="isShow" name="isShow">
                        <option value="">--不限--</option>
                        <option value="@(true)">是</option>
                        <option value="@(false)">否</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>游戏账号ID</label>
                    <input type="text" class="form-control input-small" id="userID" name="userID" placeholder="游戏账号ID">
                </div>
                <div class="form-group">
                    <label>名称</label>
                    <input type="text" class="form-control input-small" id="name" name="name" placeholder="名称">
                </div>
                <div class="form-group">
                    <label>微信号</label>
                    <input type="text" class="form-control input-small" id="wxno" name="wxno" placeholder="微信号">
                </div>
                <div class="form-group">
                    <label>QQ号</label>
                    <input type="text" class="form-control input-small" id="qq" name="qq" placeholder="QQ号">
                </div>
                <div class="form-group">
                    <label>分组名称</label>
                    <input type="text" class="form-control input-small" id="groupName" name="groupName" placeholder="分组名称">
                </div>
                <div class="form-group">
                    <label>最后登录时间</label>
                    <input type="text" class="form-control" style="width:180px" id="loginBeginTime" name="loginBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control" style="width:180px" id="loginEndTime" name="loginEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间"  autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>登录名</th>
                            <th>名称</th>
                            <th>微信号</th>
                            <th>QQ号</th>
                            <th>游戏账号ID</th>
                            <th>分组名称</th>
                            <th>最后登录IP</th>
                            <th>最后登录时间</th>
                            <th>是否显示</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.PageData != null)
                    {
                        foreach (var item in Model.PageData)
                        {
                        <tr>
                            <td>@item.Platform.Name</td>
                            <td>@item.LoginName</td>
                            <td>@item.Name</td>
                            <td>@item.WXNo</td>
                            <td>@item.QQ</td>
                            <td><a class="link" target="_blank" href="/UserInfo/Search?userId=@(item.UserID)&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">@item.UserID</a></td>
                            <td>@item.GroupName</td>
                            <td>@item.LastLoginIP</td>
                            <td>@item.LastLoginTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(item.IsShow ? "是" : "否")</td>
                            <td>
                                @Html.LinkWithRight(action: "Modify", value: "修改", href: "/AgentUser/Modify/" + item.Id)
                            </td>
                        </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                    @if (Model != null)
                    {
                        @Html.Pager(Model)
                    }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        });
    </script>
}