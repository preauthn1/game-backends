@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using game.AdminSystem.Controllers.WebSite
@using NPOI.SS.Formula.Functions

@model FW.Core.Helper.PagedList<game.Entity.Customer.QuestionType>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>类型名称</label>
                    <input type="text" class="form-control input-small" id="name" name="name" placeholder="问题类型">
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <td>编号</td>
                            <td>问题类型</td>
                            <td>二级类型</td>
                            <td>操作</td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.PageData != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.TypeName</td>
                                    <td> 
                                        @{
                                            if (!string.IsNullOrEmpty(item.ChildTypeFileds))
                                            {
                                                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CustomerController.Fileds>>(item.ChildTypeFileds);
                                                foreach (var c in list)
                                                {
                                                    <span>@c.Value,</span>
                                                }
                                            } 
                                        } 
                                    </td>
                                    <td>
                                        @Html.LinkWithRight(action: "EditQuestionType", href: "/Customer/EditQuestionType/" + item.Id)
                                        @Html.LinkWithRight(action: "DeleteQuestionType", onclick: "return DelConfirmUrl('/Customer/DeleteQuestionType/" + item.Id + "')")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}
