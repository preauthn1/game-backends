@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using game.Entity.Customer

@model FW.Core.Helper.PagedList<game.Entity.Customer.QuestionList>
@{
    List<game.Entity.Customer.QuestionSites> siteList = example.invalid as List<game.Entity.Customer.QuestionSites>;
    List<QuestionType> typeList = ViewBag.TypeList as List<QuestionType>;
}
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}


<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <label>问题标题</label>
                    <input type="text" class="form-control input-small" id="questionName" name="questionName" placeholder="问题标题">
                </div>
                <div class="form-group">
                    <label>联系人</label>
                    <input type="text" class="form-control input-small" id="contactName" name="contactName" placeholder="联系人">
                </div>
                <div class="form-group">
                    <label>联系电话</label>
                    <input type="text" class="form-control input-small" id="contactPhone" name="contactPhone" placeholder="联系人">
                </div>
                <div class="form-group">
                    <label>记录人</label>
                    <input type="text" class="form-control input-small" id="createUserName" name="createUserName" placeholder="联系人">
                </div>
                <div class="form-group">
                    <label>站点</label>
                    <select class="form-control input-small" id="siteId" name="siteId">
                        <option>--不限--</option>
                        @foreach (var item in siteList)
                        {
                            <option value="@item.Id">@item.SiteName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>处理状态</label>
                    <select class="form-control input-small" id="handleStatus" name="handleStatus">
                        <option>--不限--</option>
                        @foreach (var item in Enum.GetValues(typeof(game.Entity.Customer.HandleStatus)))
                        {
                            <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>问题类型</label>
                    <select class="form-control input-small" id="questionType" name="questionType">
                        <option>--不限--</option>
                        @foreach (var item in typeList)
                        {
                            <option value="@item.Id">@item.TypeName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <td>创建时间</td>
                            <td>问题类型</td>
                            <td>问题标题</td>
                            <td>客户端类型</td>
                            <td>信息来源</td>
                            <td>用户ID</td>
                            <td>账号</td>
                            <td>昵称</td>
                            <td>联系人姓名</td>
                            <td>联系人电话</td>
                            <td>分站</td>
                            <td>创建人</td>
                            <td>状态</td>
                            <td>操作</td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model!=null&&Model.PageData!=null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.QuestionType.TypeName</td>
                                    <td>@item.Title</td>
                                    <td>@item.ClientType.GetDisplayName()</td>
                                    <td>@item.Origin.GetDisplayName()</td>
                                    <td>@item.UserID</td>
                                    <td>@(item.UserInfo==null?"":item.UserInfo.LoginName)</td>
                                    <td>@(item.UserInfo == null ? "" : item.UserInfo.NickName)</td>
                                    <td>@item.ContactName</td>
                                    <td>@item.ContactPhone</td>
                                    <td>@example.invalid.SiteName</td>
                                    <td>@item.CreateUserName</td>
                                    <td> @item.HandleStatus.GetDisplayName()</td>
                                    <td>
                                        @if (item.HandleStatus !=game.Entity.Customer.HandleStatus.Finsh)
                                        {
                                            @Html.LinkWithRight(action: "QuestionEdit", value: "编辑", href: "/Customer/QuestionEdit/" + item.Id)
                                        }
                                        @Html.LinkWithRight(action: "QuestionHandle", value: "操作", href: "/Customer/QuestionHandle/" + item.Id)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @if (Model != null)
                        {
                            @Html.Pager(Model)
                        }
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}
