

@model  List<game.Entity.Stat.DailyMoneyLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaListMust", true)
                
                <div class="form-group">
                    <label>时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.AddDays(-3).ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default" name="btnSearch" value="search"> 搜 索 </button>
                    <button type="submit" class="btn btn-default" name="btnSearch" value="today"> 今日数据 </button>
                    <button type="submit" class="btn btn-default" name="btnSearch" value="yesterday"> 前日数据 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>注册</th>
                            <th style="width:300px">充值</th>
                            <th style="width:300px">兑换</th>
                            <th style="width:300px">兑换比例</th>
                            <th style="width:300px">金币变化</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.stattime</td>
                                    <td style="width:300px">@item.TotalRegCount</td>
                                    <td style="width:300px">@item.Charge</td>
                                    <td style="width:300px">@item.Convert</td>
                                    <td style="width:300px">@item.Rate</td>
                                    <td style="width:300px">@item.DiffAmount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}