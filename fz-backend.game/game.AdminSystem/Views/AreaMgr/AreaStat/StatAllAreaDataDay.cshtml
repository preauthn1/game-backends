@using FW.Core.Web.Mvc;
@model  FW.Core.Helper.PagedList<game.Entity.Stat.AreaDataDay>
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/fontawesome/css/fontawesome.min.css")" rel="stylesheet">
}

<style>
    .modal-size {
        width: 85vw;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", false)
                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control" autocomplete="off" style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间">
                </div>
                <div class="form-group">
                    <input type="hidden" name="sortName" id="sortName" value="@ViewBag.CurrentSort" />
                    <input type="hidden" name="sortLifting" id="sortLifting" />
                    <button type="submit" class="btn btn-default" name="btnSearch" value="search"> 搜 索 </button>
                    <button type="submit" class="btn btn-default" name="btnSearch" value="today"> 今日数据 </button>
                    <button type="submit" class="btn btn-default" name="btnSearch" value="yesterday"> 前日数据 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th class="hide">编号</th>
                            <th>所属平台</th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="Area" onclick="submitForm('@game.Entity.AdminSys.SortName.Area')">所属渠道</a>
                            </th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="StatTime" onclick="submitForm('@game.Entity.AdminSys.SortName.StatTime')">统计时间</a>
                            </th>
                            <th>
								<a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="ChargeAmount" onclick="submitForm('@game.Entity.AdminSys.SortName.ChargeAmount')">充值金额(第三方+币商+闪付)</a>
                            </th>
                            <th>当日新增充值金额</th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="TotalRegCount" onclick="submitForm('@game.Entity.AdminSys.SortName.TotalRegCount')">註冊用戶人数</a>
                            </th>                            
                            <th>註冊用戶充值人数</th>
                            <th>每日充值人数</th>
                            <th>币商充值</th>
                            <th>币商充值人数</th>
                            <th>
                                <a style="font-weight:bold;" name="Sort" href="#" id="ConvertAmount" onclick="submitForm('@game.Entity.AdminSys.SortName.ConvertAmount')">兑换金额</a>
                            </th>                           
                            <th>兑换人数</th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="DAU" onclick="submitForm('@game.Entity.AdminSys.SortName.DAU')">活跃人数</a>
                            </th>                            
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="TotalLoginIP" onclick="submitForm('@game.Entity.AdminSys.SortName.TotalLoginIP')">注册IP数</a>
                            </th>
                            <th>
                                <a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="TotalBindUser" onclick="submitForm('@game.Entity.AdminSys.SortName.TotalBindUser')">绑定手机数</a>
                            </th>
                            <th>次日留存率</th>
                            <th>三日留存率</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                var xml = new System.Xml.XmlDocument();
                                xml.LoadXml(string.Format("<ArrayOfGameTaxDetail>{0}</ArrayOfGameTaxDetail>", item.GameTaxDetail));
                                var hasGameTaxDetail = !string.IsNullOrWhiteSpace(item.GameTaxDetail);
                                var totalCharg = item.OldCharge + item.NewCharge;
                                var totalLogin = item.NewLogin + item.OldLogin;
                                <tr>
                                    <td class="hide">@item.Id</td>
                                    <td>@item.PlatformName</td>
                                    <td>@item.AreaName</td>
                                    @if (item.StatTime.ToString("yyyy-MM-dd").Equals("1900-01-01"))
                                    {
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td>@item.StatTime.ToString("yyyy-MM-dd")</td>
                                    }
                                    <td>
                                        <div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldCharge.ToCash()，新用户：@item.NewCharge.ToCash()">
                                            @if (totalCharg > 0)
                                            {
                                                <a href="#" onclick="getUserInfo(@item.AreaID, @item.PlatformID, '@item.StatTime.ToString("yyyy-MM-dd HH:mm:ss")', @totalCharg, 'null')">@totalCharg.ToCash()</a>
                                            }
                                            else
                                            {
                                                @totalCharg.ToCash();
                                            }
                                        </div>
                                    </td>
                                    <td>@item.TotalNewCharge.ToCash()</td>
                                    <td>@item.TotalRegCount</td>
                                    <td>@item.NewOrderUser</td>
                                    <td>@item.Total_OrderUser</td>
                                    <td>@item.TotalAgentChargeAmount.ToCash()</td>
                                    <td>@item.TotalAgentChargeUser</td>
                                    <td><div data-toggle="tooltip" data-placement="left" title="老用户：@item.OldConvert.ToCash()，新用户：@item.NewConvert.ToCash()">@((item.OldConvert + item.NewConvert).ToCash())</div></td>
                                    <td>@item.TotalConvertUser</td>
                                    <td>@item.DAU</td>                                 
                                    <td>@item.TotalLoginIP</td>
                                    <td>@item.TotalBindUser</td>
                                    <td>@item.OneDayKeep</td>
                                    <td>@item.OneThirdDayKeep</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>

            <!-- MoneyPerGameLog Modal-->
            <div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-lg modal.large modal-size" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="userModalLabel">使用者資訊</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <table id="user_table" class="display" style="width:100%"></table>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');

            $('#platformid').change();

            $('[data-toggle="tooltip"]').tooltip();

            $('[data-toggle="tooltipcustom"]').each(function (i, e) {
                if ($(e).data('hasdetail') == '1') {
                    $(e).children('div').tooltip({ 'html': true, 'title': $(e).children('p').html(), 'placement': 'left' });
                }
            });

            $("a[name='Sort']").removeClass();
            if ("@ViewBag.SortLifting" == "True") {
                $('#@ViewBag.CurrentSort').addClass("fa fa-sort-up");
            }
            else {
                $('#@ViewBag.CurrentSort').addClass("fa fa-sort-down");
            }
        })

        function getUserInfo(areaID, platformID, startTime, totalCharge, totalLogin) {

            var columns = [
                 { "sTitle": "所属渠道", "mData": "Area.AreaName" },
                 {
                     "sTitle": "用户ID", "mData": "UserID",
                     "render": function (data, type, row) {

                         return '<a class="link" target="_blank" href="/UserInfo/Search?userId=' + data + '&beginTime=' + startTime + '&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">' + data + '</a>';
                     }
                 },
				{ "sTitle": "充值金额 (第三方+币商+闪付)", "mData": "SumChargeByQuery" },
                 { "sTitle": "累计充值金额", "mData": "SumCharge" },
                 { "sTitle": "累计兑换金额", "mData": "SumConvert" },
                 { "sTitle": "现金数", "mData": "Amount" },
                 { "sTitle": "性别", "mData": "Sex" },
                 { "sTitle": "硬件类型", "mData": "HDType" },
                 { "sTitle": "硬件唯一码", "mData": "HDCode" },
                 { "sTitle": "用户类型", "mData": "UserType" },
                 { "sTitle": "创建时间", "mData": "CreateTime" },
                 { "sTitle": "注册IP地址", "mData": "CreateIPAddress" },
                 { "sTitle": "最后登录时间", "mData": "LastLogonTime" },
                 { "sTitle": "最后登录IP地址", "mData": "LastLogonIPAddress" }
            ];

            const opt = {
                "ordering": false,
                "searching": false,
                "aoColumns": columns,
                "processing": true,
                "serverSide": true,
                "pageLength": 50,
                "ajax": {
                    "type": "POST",
                    "url": '/UserStat/GetUserInfo',
                    "data": {
                        '_r': Math.random(),
                        'areaID': areaID,
                        'platformID': platformID,
                        'startTime': startTime,
                        'totalCharge': totalCharge,
                        'totalLogin': totalLogin
                    }
                },
                "destroy": true
            }
            $(`#user_table`).dataTable(opt);
            $(`#userModal`).modal('show');
        }

        function submitForm(sortColumn) {
            var _sortLifting = ("@ViewBag.SortLifting" == "True");
            _sortLifting = !_sortLifting;

            $('#sortName').val(sortColumn);
            $('#sortLifting').val(Number(_sortLifting));
            $('#form_search').submit();
        }

    </script>
}