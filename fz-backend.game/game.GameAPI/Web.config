<?xml version="1.0" encoding="utf-8"?>
<!--
  有关如何配置 example.invalid 应用程序的详细信息，请访问
  http://example.invalid/fwlink/?LinkId=301879
  -->
<configuration>
  <configSections>
    <section name="engineConfig" type="FW.Core.Engine.EngineConfigHandler, FW.Core.Engine" requirePermission="false"/>
    <section name="logConfig" type="FW.Core.Logger.LogConfigHandler, FW.Core.Logger" requirePermission="false"/>
    <section name="dbConfig" type="FW.Core.Repository.DatabaseConfigHandler, FW.Core.Repository" requirePermission="false"/>
    <section name="apiConfig" type="FW.Core.Web.WebAPI.APIConsumerConfigHandler, FW.Core.Web"/>
    <section name="userRightConfig" type="FW.Core.Auth.UserRight.UserRightConfigHandler, FW.Core.Auth"/>
    <section name="authConfig" type="FW.Core.Auth.AuthorizeRule.Mvc.ConfigMvcTokenAuthorizeRuleProvider, FW.Core.Auth"/>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" requirePermission="false"/>
  </configSections>
  <engineConfig>
    <injectDlls>game.Service.dll</injectDlls>
    <engineProvider>FW.Core.Engine.AutofacEngineProvider, FW.Core.Engine</engineProvider>
  </engineConfig>
  <logConfig>
    <enable>Info,Error,Debug,Fatal,Warn</enable>
  </logConfig>
  <dbConfig transaction="false">
    <database name="CenterDB" connectionString="data source=0.0.0.0;database=CenterDB;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
    <database name="LogDB" connectionString="data source=0.0.0.0;database=LogDB;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
    <database name="PerGameLog" connectionString="data source=0.0.0.0;database=PerGameLog;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
    <database name="AdminSys" connectionString="data source=0.0.0.0;database=AdminSys;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
    <database name="Notify" connectionString="data source=0.0.0.0;database=Notify;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
    <database name="WebSite" connectionString="data source=0.0.0.0;database=WebSite;uid=sa;pwd=[REDACTED];" write="1" read="1" offline="0"/>
  </dbConfig>
  <apiConfig>
    <api id="1" key="123"></api>
  </apiConfig>
  <userRightConfig>
    <user name="1">
      <userRole>website</userRole>
    </user>
  </userRightConfig>
  <authConfig>
    <rule controller="*" allowRoles="*"/>
    <!--<rule controller="*" denyUsers="?"  />-->
  </authConfig>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0"/>
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
  </entityFramework>
  <appSettings>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.5"/>
    <httpRuntime maxQueryStringLength="4096" targetFramework="4.5"/>
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule"/>
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <remove name="OPTIONSVerbHandler"/>
      <remove name="TRACEVerbHandler"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="4096" />
      </requestFiltering>
    </security>    
    
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Http" publicKeyToken=[REDACTED]" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="example.invalid.Http.Formatting" publicKeyToken=[REDACTED]" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
			</dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken=[REDACTED]"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken=[REDACTED]"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken=[REDACTED]"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken=[REDACTED]"/>
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken=[REDACTED]"/>
        <bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken=[REDACTED]" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
      </dependentAssembly>      
      
    </assemblyBinding>
  </runtime>
</configuration>
