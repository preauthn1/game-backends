<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Standard iPhone -->
    <link rel="apple-touch-icon" sizes="57x57" href="/Content/image/apple-touch-icon.png" />
    <!-- Retina iPhone -->
    <link rel="apple-touch-icon" sizes="114x114" href="/Content/image/apple-touch-icon.png" />
    <!-- Standard iPad -->
    <link rel="apple-touch-icon" sizes="72x72" href="/Content/image/apple-touch-icon.png" />
    <!-- Retina iPad -->
    <link rel="apple-touch-icon" sizes="144x144" href="/Content/image/apple-touch-icon.png" />

    <style>

        html, body {
            margin: 0;
            height: 100%;
        }
    </style>
</head>
<body>


    @RenderBody()

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
    @RenderSection("initScripts", required: false)
</body>
</html>
