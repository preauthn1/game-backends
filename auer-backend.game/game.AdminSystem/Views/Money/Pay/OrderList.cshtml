@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using game.Entity.Pay

@model  FW.Core.Helper.PagedList<OrderListDTO>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<style>
    .order_text {
        font-size: 1.5em;
        padding: 1%;
    }

    textarea {
        width: 100%;
        height: 12vh;
        resize: none;
    }
    .stat_text_toolbar {
        margin: 10px 0 5px 0;
    }
    .stat_text_contain {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .stat_text {
        display: flex;
        align-items: center;
        font-size: 16px;
    }

    .stat_text .title {
        margin-right: 4px;
    }

    .stat_text .red {
        color: red;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", true)
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <label>订单编号</label>
                    <input type="text" class="form-control input-small" id="orderID" name="orderID" placeholder="订单编号">
                </div>
                <div class="form-group">
                    <label>IP地址</label>
                    <input type="text" class="form-control input-small" id="ipAddress" name="ipAddress" placeholder="IP地址">
                </div>

                @Html.Partial("_GateWaySelect", false)

                <div class="form-group">
                    <label>支付类型</label>
                    <select class="form-control input-small" id="payTypeID" name="payTypeID">
                        <option>--不限--</option>
                        @foreach (var item in Enum.GetValues(typeof(PayType)))
                        {
                            if (item.GetDisplay())
                            {
                                <option value="@((int)item)">@item.GetDisplayName()</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>支付状态</label>
                    <select class="form-control input-small" id="status" name="status">
                        <option>--不限--</option>
                        @foreach (var item in Enum.GetValues(typeof(CDOrderStatus)))
                        {
                            <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>时间</label>
                    <select class="form-control input-small" id="timeType" name="timeType">
                        <option value="0">创建时间</option>
                        <option value="1">完成时间</option>
                    </select>
                    <input type="text" class="form-control " style="width:180px" value="@Convert.ToDateTime(DateTime.Now.ToShortDateString()).ToString("yyyy-MM-dd HH:mm:ss")" id="createBeginTime" name="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="createEndTime" name="createEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss', isShowClear: false, readOnly: true })" placeholder="结束时间">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                    <button type="submit" class="btn btn-default" name="submitType" value="Export"> 匯 出 </button>
                </div>
            </form>
            <div class="stat_text_toolbar">
				<div class="stat_text_contain">
					<div class="stat_text">
						<div class="title">支付金额:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_totalChargeAmount"]).ToCash()</div>
					</div>
					<div class="stat_text">
						<div class="title">充值金币数量:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_totalPointAmount"]).ToCash()</div>
					</div>
					<div class="stat_text">
						<div class="title">充值人数:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_totalChargeUser"])</div>
					</div>
					<div class="stat_text">
						<div class="title">新用户支付金额:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_newTotalChargeAmount"]).ToCash()</div>
					</div>
					<div class="stat_text">
						<div class="title">新用户充值金币数量:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_newTotalPointAmount"]).ToCash()</div>
					</div>
					<div class="stat_text">
						<div class="title">新用户充值人数:</div>
						<div class="red"> @Convert.ToInt64(Model.OutputData["_newTotalChargeUser"])</div>
					</div>
				</div>
            </div>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>创建时间</th>
                            <th>回调时间</th>
                            <th>订单号</th>
                            <th>支付平台商</th>
                            <th>支付类型</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>支付金额</th>
							<th>充值金币数量</th>
                            <th>补单金额</th>
                            <th>订单状态</th>
                            <th>IP地址</th>
                            <th>交易标识</th>
                            <th style="width:550px">第三方交易数据</th>

                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
						<tr>
							<td>@item.PlatformName</td>
							<td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
							@if (item.LastUpdateTime != null)
							{
								<td>@item.LastUpdateTime.Value.ToString("yyyy-MM-dd HH:mm:ss")</td>
							}
							else
							{
								<td></td>
							}
							<td>@item.OrderID</td>
							<td>@item.GatewayName</td>
							<td>@item.PayTypeID.GetDisplayName()</td>
							<td>
								<a target="_blank" href="/UserInfo/Search?userId=@item.UserID&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">
									@item.UserID
								</a>
							</td>
							<td>
								<a target="_blank" href="/UserInfo/Search?loginName=@item.LoginName&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">
									@item.LoginName.ToString()
								</a>
							</td>
							<td>@item.UserLevel</td>
							<td>
								@Html.FormatAmount(item.Amount.ToString())
							</td>
							<td>
								@Html.FormatAmount(item.PointAmount.ToString())
							</td>
							<td>
								@Html.FormatAmount(item.ClaimAmount.ToString())
							</td>
							<td>@item.Status.GetDisplayName()</td>
							<td>@item.IPAddress</td>
							<td>@(item.TransID == null ? "" : @item.TransID)</td>
							<td style="width:550px">
								<div style="width:550px;  word-break: break-all;white-space:normal;min-width:300px;max-height:50px;overflow:hidden">
									@(item.TransData == null ? "" : @item.TransData)
								</div>
							</td>

							<td>
								@if (item.Status == CDOrderStatus.Waiting)
								{
									@Html.LinkWithRight(action: "FinishOrder", value: "手动完成充值", onclick: "setOrderID('" + item.OrderID + "')", href: "#")
								}
							</td>
						</tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->

    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">请填入交易资讯</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Order_ID" id="Order_ID" value="0">
                    <div class="order_text">
                        <span>第三方交易记录编号</span>
                    </div>

                    <input type="text" name="TransID" id="TransID" class="form-control input-medium" placeholder="请输入第三方交易记录编号" value="0000">

                    <div class="order_text">
                        <span>第三方交易数据</span>
                    </div>

                    <textarea id="TransData" name="TransData" placeholder="请输入第三方交易数据">手动完成充值</textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                    <button type="button" class="btn btn-primary" onclick="FinishOrder()">确定</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
        function FinishOrder() {
            const orderID = $('#Order_ID').val();
            const transID = $('#TransID').val();
            const transData = $('#TransData').val();
            $('#exampleModal').modal('hide');

            var option = {
                isAjax: true,
                isReload: true
            }
            swDelConfirmUrl("FinishOrder?orderID=" + orderID + "&transID=" + transID + "&transData=" + transData
                , "确定手动完成此充值吗？", option);
        }

        function setOrderID(id) {
            $('#Order_ID').val(id);
            $('#exampleModal').modal('show');
        }
    </script>
}