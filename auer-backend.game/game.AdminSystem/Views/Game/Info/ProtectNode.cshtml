@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}


<div id="ProtectNodeVApp">
    <div class="row">
        <div class="col-md-12">
            <div class="protlet-body">
                <div class="menu">
                    <div class="form-inline instructions" id="form_search">
                        <div class="form-group">
                            <label>用戶ID</label>
                            <input type="text" id="userID_Search" name="userID_Search" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>节点IP</label>
                            <input type="text" id="userIP_Search" name="userIP_Search" class="form-control" />
                        </div>
                        <div class="form-group">
                            <input type="button" class="btn btn-default" v-on:click="getDataList()" value="搜 索" />
                        </div>
                    </div>
                </div>
                <div style="margin: 10px 0 !important;">
                    <table id="protectNode_table" class="table table-striped table-bordered table-hover progressTable"></table>
                </div>
            </div>
        </div>
    </div>
</div>


@section initScripts{
    <script>
        $(function () {

            var vApp = new Vue({
                el: '#ProtectNodeVApp',
                data: {
                    tableList: {},

                },
                methods: {
                    getDataList: function () {
                        var userID = $("#userID_Search").val();
                        var ip = $("#userIP_Search").val();

                        const url = '/Info/GetProtectNode';
                        const thead = [
                                       { "sTitle": '编号', "mData": "Id" },
                                       {
                                           "sTitle": '用戶ID', "mData": "UserID",
                                           "render": function (data, type, row) {
                                               if (data == 0) {
                                                   return data;
                                               }

                                               return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                                           }
                                       },
                                       { "sTitle": '类型', "mData": "StrAction" },
                                       { "sTitle": '失敗時备援IP', "mData": "BackupNodeIP" },
                                       { "sTitle": "收到的节点IP", "mData": "NodeIP" },
                                       { "sTitle": 'Token', "mData": "Token" },
                                       { "sTitle": "登入状态", "mData": "StrStatus" },
                                       { "sTitle": "IP", "mData": "UserIP" },
                                       { "sTitle": "來源", "mData": "UserFrom" },
                                       { "sTitle": "MAC", "mData": "HDCode" },
                                       { "sTitle": "备注", "mData": "Memo" },
                                       { "sTitle": "添加时间", "mData": "StrCreateTime" }];

                        const data = {
                            userID: userID,
                            ip: ip
                        }

                        createDataTable('protectNode', thead, url, data);
                    }
                }
            });

            vApp.getDataList();
        });
    </script>
}