@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
     .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }

     .color-red {
        color: red;
        font-size: 16px;
        font-weight: bold;
    }

    .reward_search_contain {
        display: flex;
        align-items:center;
        justify-content:start;
        padding: 1%;
        border: 1px solid #ddd;
    }

    .reward_search_label {
        padding: 0 2%;
        font-size: 1.3em;
        font-weight: 900;
    }
</style>

<div class="row" id="RewardList">
    <div class="col-md-12">
        <div class="portlet box grey" style="margin-top:20px;">
            <div class="portlet-title">
                <div class="caption">监控名单</div>
            </div>
            <div class="portlet-body">
                <div class="reward_search_contain">
                    <div class="reward_search_label">房间</div>
                    <div>
                        <select class="form-control input-medium color-red" v-model="spaceID">
                            <option value="">全选</option>
                            <option value="1">初级场</option>
                            <option value="2">中级场</option>
                            <option value="3">高级场</option>
                            <option value="4">富豪场</option>
                            <option value="5">皇家场</option>
                        </select>
                    </div>
                    <div>
                        <select class="form-control input-small" value="" v-model="status">
                            <option value="">全部</option>
                            <option value="1">放分中</option>
                            <option value="0">暂停</option>
                        </select>
                    </div>
                    <div></div>
                </div>
                <table class="table table-striped table-bordered table-hover progressTable" id="FishReward_table"></table>
            </div>
        </div>
    </div>
    <!--编辑-->
    <div class="modal fade" id="editReward" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal.large modal-size">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="myModalLabel">编辑</h4>
                </div>
                <div class="modal-body">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-5 control-label">鱼名称：</label>
                            <div class="col-md-6">
                                <span>{{editData.FishName}}</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-5 control-label">指定放分金额：</label>
                            <div class="col-md-6">
                                <input value="" class="form-control input-small" v-model="editData.Amount" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-5 control-label">爆率：</label>
                            <div class="col-md-6">
                                <select class="form-control input-medium" value="" v-model="editData.Rate">
                                    <option value="20">20% 急速杀分</option>
                                    <option value="50">50% 快速杀分</option>
                                    <option value="80">80% 慢速杀分</option>
                                    <option value="110">110% 极慢放分</option>
                                    <option value="150">150% 慢放分</option>
                                    <option value="200">200% 快放分</option>
                                    <option value="300">300% 快速放分</option>
                                    <option value="500">500% 极快放分</option>
                                    <option value="10000">10000% 鱼秒死</option>
                                </select>
                                <span style="color:red;">{{errMsg}}</span>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                    <button type="button" class="btn dark" v-on:click="editVIPUser(editData)">确定</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#RewardList',

            data: {
                datas: [],
                editData: {},
                spaceID: '',
                status: '',
                errMsg: '',
                dataTable: null
            },

            watch: {
                spaceID (val, oldVal) {
                    vApp.dataTable.DataTable().ajax.reload();
                },

                status (val, oldVal) {
                    vApp.dataTable.DataTable().ajax.reload();
                }
            },

            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getReward: function () {
                    vApp.datas = [];

                    const head = [
                           {
                               "sTitle": "房间", "mData": "FlagName"
                           },
                           {
                               "sTitle": "鱼名称", "mData": "FishName"
                           },
                           {
                               "sTitle": "放分金额", "mData": "Amount",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "完成金额", "mData": "FinishAmount",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           { "sTitle": "爆率(%)", "mData": "Rate" },
                           { "sTitle": "是否完成", "mData": "StrFinish" },
                           {
                               "sTitle": "开始/暂停", "mData": "Status",
                               "render": function (data, type, rowData, meta) {
                                   if (data == 0) {
                                       return `<a class="btn_link" href="#" onclick="vApp.editStatus(${meta.row},1)" >开始</a>`
                                   }
                                   return `<a class="btn_link_Red" href="#" onclick="vApp.editStatus(${meta.row},0)" >暂停</a>`
                               }
                           },
                           { "sTitle": "放分时间", "mData": "StrCreateTime" },
                           { "sTitle": "完成时间", "mData": "StrFinishTime" },
                           { "sTitle": "操作人", "mData": "Operator" },
                           {
                               "sTitle": "操作", "mData": "UserID",
                               "render": function (data, type, rowData, meta) {
                                   vApp.datas[meta.row] = rowData;
                                   return `<button class="btn gray" href="#" onclick="vApp.showEdit(${meta.row})" data-toggle="modal" data-target="#editReward" >编辑</a>`
                               }
                           },

                    ]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameBY/GetSystemReward",
                            data: function (d) {
                                Object.assign(d, {
                                    'flagID': vApp.spaceID,
                                    'status': vApp.status
                                });
                                return d;
                            }
                        },
                        "destroy": true
                    }
                    vApp.dataTable = $("#FishReward_table").dataTable(opt)
                },
                showEdit: function (rowIndex) {
                    vApp.editData = vApp.datas[rowIndex];
                    vApp.editData.Amount = ToCash(vApp.editData.Amount);
                },
                editStatus: function (rowIndex, status) {

                    var data = vApp.datas[rowIndex];
                    if (data.Amount == 0) { return; }

                    data.Status = status;
                    data.Amount = ToCash(data.Amount);

                    $.ajax({
                        type: "POST",
                        data: JSON.stringify(data),
                        contentType: 'application/json',
                        traditional: true,
                        url: "/GameBY/UpdateSystemRewardStatus",
                        success: function (result) {
                            alert(result.msg);
                            vApp.dataTable.DataTable().ajax.reload();
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                },
                editVIPUser: function (data) {

                    if (data.Amount > 0 && data.Rate < 100) {
                        vApp.errMsg = "*爆率需大于100";
                        return;
                    }

                    if (data.Amount < 0 && data.Rate > 100) {
                        vApp.errMsg = "*爆率需小于100";
                        return;
                    }

                    $.ajax({
                        type: "POST",
                        data: JSON.stringify(data),
                        contentType: 'application/json',
                        traditional: true,
                        url: "/GameBY/EditSystemReward",
                        success: function (result) {
                            alert(result.msg);
                            vApp.dataTable.DataTable().ajax.reload();
                            $('#editReward').modal('hide');
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                }
            }
        });

        vApp.getReward();
        setInterval(function () {
            vApp.dataTable.DataTable().ajax.reload();
        }, 10000);

    </script>
}