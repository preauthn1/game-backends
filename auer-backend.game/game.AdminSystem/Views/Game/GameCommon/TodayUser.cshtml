@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }

    .update_Red {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: red;
    }

    .update_Green {
        color: white;
        padding: 0px 10px 0px 10px;
        background-color: #58ae63;
    }

    .width6 {
        width: 6%;
    }
</style>

<div class="row" id="todayUserList">
    <div class="col-md-12">
        <div class="protlet-body" style="margin-top:20px;">
            <form class="form-inline" id="form_search" method="get"></form>
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">@(ViewBag.GameName)今日人数</div>
                </div>
                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover progressTable" id="TodayUser_table"></table>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#todayUserList',
            data: {
                gameID: '@ViewBag.GameID',
                showName: '@ViewBag.ShowName'
            },
            methods: {
                getUserList: function () {
                    const head = [
                           {
                               "sTitle": "玩家ID", "mData": "UserID",
                               "render": function (data, type, row) {
                                   return `<a class="link" target="_blank" href="/UserInfo/Search?userId=${data}&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">${data}</a>`
                               }
                           },
                           {
                               "sTitle": "总充值", "mData": "TotalSumCharge",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "总兑换", "mData": "TotalSumConvert",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "用户金币", "mData": "UserCash",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "总输赢", "mData": "TotalUserWinLose",
                               "render": function (data, type, row) {
                                   var value = data * -1;
                                   if (value < 0) {
                                       return `<span class="update_Red">${ToCash(value)}</span>`
                                   }
                                   return `<span class="update_Green">${ToCash(value)}</span>`
                               }
                           },
                           {
                               "sTitle": "今日充值", "mData": "TodaySumCharge",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "今日兑换", "mData": "TodaySumConvert",
                               "render": function (data, type, row) {
                                   return ToCash(data);
                               }
                           },
                           {
                               "sTitle": "今日输赢", "mData": "TodayUserWinLose",
                               "render": function (data, type, row) {
                                   var value = data * -1;
                                   if (value < 0) {
                                       return `<span class="update_Red">${ToCash(value)}</span>`
                                   }
                                   return `<span class="update_Green">${ToCash(value)}</span>`
                               }
                           },
                           { "sTitle": "局数", "mData": "TotalAll" },
                           { "sTitle": "总胜局", "mData": "TotalWinCount" },
                           { "sTitle": "总负局", "mData": "TotalLoseCount" },
                           { "sTitle": "总胜率(%)", "mData": "TotalWinRate" },
                           { "sTitle": "今日局数", "mData": "TodayAll" },
                           { "sTitle": "今日胜局", "mData": "TodayWin" },
                           { "sTitle": "今日胜率(%)", "mData": "TodayWinRate" },
                           { "sTitle": "是否在线", "mData": "StrOnline" },
                           { "sTitle": "上线时间", "mData": "StrLoginTime", "class": "width6" },
                           { "sTitle": "下线时间", "mData": "StrLogoutTime", "class": "width6" },
                           {
                               "sTitle": "增删监控", "mData": "VIPUserID",
                               "render": function (data, type, row) {
                                   if (data == 0) {
                                       return `<a class="btn_link" href="#" onclick="vApp.addVIPUser(${row.UserID})" >增加监控</a>`
                                   }
                                   return `<a class="btn_link_Red" href="#" onclick="vApp.delVIPUser(${data})" >删除监控</a>`
                               }
                           }]

                    const opt = {
                        "ordering": false,
                        "searching": false,
                        "aoColumns": head,
                        "processing": true,
                        "serverSide": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "ajax": {
                            "type": "POST",
                            "url": "/GameCommon/GetTodayUserList",
                            "data": {
                                'gameID': vApp.gameID,
                            }
                        },
                        "destroy": true
                    }
                    $("#TodayUser_table").dataTable(opt)
                },
                addVIPUser: function (userID) {
                    $.get('/GameCommon/AddVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.getUserList();
                    });
                },
                delVIPUser: function (userID) {
                    $.get('/GameCommon/DelVIPUser', { 'userID': userID }, function (result) {
                        alert(result.msg);
                        vApp.getUserList();
                    });
                }
            }
        });

        vApp.getUserList();
        setInterval(function () {
            vApp.getUserList();
        }, 10000);

    </script>
}