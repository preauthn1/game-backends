@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model List<game.Entity.Game.Game>

<div class="row">
    <div class="col-md-4 ">
        <div class="protlet-body">
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>编号</th>
                            <th>游戏名称</th>
                            <th>状态</th>
                            <th style="width:100px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.GameName</td>
                                    <td>@(item.Status == 1 ? "正常" : "维护中")</td>
                                    <td>@Html.LinkWithRight(action: "SetGameStatus", value: item.Status == 0 ? "设置正常" : "设置维护中", href: "SetGameStatus?gameID=" + item.Id + "&status=" + (item.Status == 0 ? "1" : "0"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}
