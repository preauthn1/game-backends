@using FW.Core.AdminSys.WebUI
@model  List<game.Entity.Area.Platform>
@{
   FW.Core.AdminSys.Provider.Entity.AdminUser user = ViewBag.user;
   List<int> rrs = ViewBag.userPlatformIDs;
}
<style type="text/css">
    .ul_tree li {
        border-top: 1px solid #ddd;
    }

        .ul_tree li p {
            margin: auto;
            height: 35px;
            line-height: 35px;
        }

            .ul_tree li p:hover {
                background: #eaeaea;
            }

    .odd-even {
        background: #f9f9f9;
    }

    .ul_tree > li > ul {
        display: none;
    }
</style>
<form method="post">
    <div class="row">
        <div class="col-md-12 ">
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-globe"></i> 修改账号 [ @user.LoginName ] 平台
                    </div>
                </div>
                <div class="portlet-body">
                    <div class="dataTables-wrapper">
                        <div class="row" style="margin-left:10px;margin-right:10px">
                            @Html.OkWithRight()
                            @Html.Back(@Url.Action("AdminList"))
                            <input type="hidden" name="adminID" value="@user.UserID" />
                        </div>
                        <div class="table-scrollable">
                            <h4>
                                <input type="checkbox" name="chk_all" id="tree_all" /> 全选
                            </h4>
                            <ul class="ul_tree">
                            @foreach (var platform in Model)
                            {
                                string checkedSign = "";
                                if (rrs.Contains(platform.Id))
                                {
                                    checkedSign = "checked=checked";
                                }
                                <li>
                                    <p class="tree-control">
                                        <input type="checkbox" name="ap" value="@platform.Id" @checkedSign />
                                        <span class="tree-control">@platform.Name</span>
                                    </p>
                                </li>
                            }
                            </ul> 
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script type="text/javascript">
    $(function () {
        //奇偶显示
        background_show();
        //选择
        $(".ul_tree li>p>input").click(function () {
            var _this = $(this);
            if (_this.prop("checked")) {
                var allcheckbox = $(".ul_tree input[type=checkbox]");
                var checkedlen = allcheckbox.filter(":checked").length;
                if (allcheckbox.length == checkedlen) {
                    $("#tree_all").prop("checked", true);
                }
            }
            else {
                $("#tree_all").prop("checked", false);
            }
        });
        //全选
        $("#tree_all").click(function () {
            var _this = $(this);
            if (_this.prop("checked")) {

                var checkboxs = $(".ul_tree input:not(:checked)");
                checkbox_change(checkboxs, true);
            }
            else {
                var checkboxs = $(".ul_tree input:checked");
                checkbox_change(checkboxs, false);
            }

        });
        //开始时全选设计
        startcheckall_set();
    })
    //选择时改变checkbox的选项和显示
    function checkbox_change(checkboxs, ischecked) {
        checkboxs.each(function () {
            var _this_ = $(this);
            _this_.prop("checked", ischecked);
            if (ischecked) {
                _this_.parent("span").addClass("checked");
            }
            else {
                _this_.parent("span").removeClass("checked");
            }
        });
    }
    //奇偶背景显示
    function background_show() {
        var p = $(".ul_tree p:even");
        p.addClass("odd-even");
    };
    //页面加载时全选选项设置
    function startcheckall_set() {
        var checkboxs = $(".ul_tree input[type=checkbox]");
        var checkedlen = checkboxs.filter(":checked").length;;
        if (checkboxs.length == checkedlen) {
            checkbox_change($("#tree_all"), true);
        }
    }
</script>