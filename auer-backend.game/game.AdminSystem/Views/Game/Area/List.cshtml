@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@model  List<game.Entity.Area.Area> 

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", true)
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>平台编号</th>
                            <th>所属平台</th>
                            <th>渠道编号</th>
                            <th>渠道名称</th>
                            <th>渠道说明</th>
                            <th>排序值</th>
                            <th>QRCode分享位置</th>
                            <th>显示兑换的充值金额</th>
                            <th>顯示其他遊戲的充值金額</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            <td>@item.PlatformID</td>
                            <td>@item.Platform.Name</td>
                            <td>@item.Id</td>
                            <td>@item.AreaName</td>
                            <td>@item.Memo</td>
                            <td>@item.Sort</td>  
                            <td>@item.ShareURL</td>  
                            <td>@item.ShowConvertLimit.ToCash()</td> 
                            <td>@item.ShowAllGameLimit.ToCash()</td> 
                            <td>
                                @Html.LinkWithRight(value: "编辑", action: "Edit", href: "Edit?id=" + item.Id)
                                @Html.LinkWithRight(value: "删除", action: "Delete", onclick: "swDelConfirmUrl('Delete?id=" + item.Id + "')", href: "#")
                            </td>
                        </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}