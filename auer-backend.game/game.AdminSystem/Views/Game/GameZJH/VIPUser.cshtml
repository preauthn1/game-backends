@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .portlet-body .btn_link {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: #428bca;
    }

    .portlet-body .btn_link_Red {
        padding-left: 5px;
        font-weight: bold;
        text-decoration: underline;
        color: red;
    }
</style>

<div class="row" id="VIPUserList">
    <div class="col-md-12">
        <div style="margin-top:20px;">
            <input type="text" class="form-control input-small col-md-1" placeholder="请输入玩家ID" value="" v-model="vipUser.NewUserID" />
            <input type="button" class="btn dark" value="监控添加" v-on:click="addVIPUser()" />
        </div>
    </div>
    <div class="col-md-12">

        <div class="portlet box grey" style="margin-top:20px;">
            <div class="portlet-title">
                <div class="caption">监控名单</div>
            </div>
            <div class="portlet-body">
                <form class="form-inline" style="margin-top:20px;">
                    <div class="form-group">
                        <label>显示玩家</label>
                        <input type="text" class="form-control input-small" value="" v-model="filterUserID" placeholder="请输入玩家ID">
                    </div>
                </form>
                <table class="table table-striped table-bordered table-hover progressTable" id="ZJHVIPUser_table">
                    <thead>
                        <tr>
                            <th>玩家ID</th>
                            @*<th>下局输赢</th>*@
                            <th>下局指定牌型</th>
                            <th>下局连续输赢局数</th>
                            <th>下局指定进入桌号</th>
                            <th>是否完成</th>
                            <th>开始/暂停</th>
                            <th>删除监控</th>
                            <th>操作人</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="(data, index) in dataList">
                            <td>
                                <a target="_blank" :href="'/UserInfo/Search?userID=' + data.UserID + '&beginTime=@(DateTime.Now.ToString("yyyy-MM-01 HH:mm"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))'">{{data.UserID}}</a>
                            </td>
                            @*<td>
                                <select class="form-control input-small" v-model="data.NextWinLose" v-on:change="editVIPUser(data)">
                                    <option v-for="option in NextWinLoseSelect" v-bind:value="option.value">{{option.text}}</option>
                                </select>
                            </td>*@
                            <td>
                                <select class="form-control input-small" v-model="data.NextType" v-on:change="editVIPUser(data)">
                                    <option v-for="option in NextTypeSelect" v-bind:value="option.value">{{option.text}}</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control input-small" v-model="data.NextWinLoseNum" v-on:change="editVIPUser(data)">
                                    <option v-for="option in NextWinLoseNumSelect" v-bind:value="option.value">{{option.text}}</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control input-small" v-model="data.NextTable" v-on:change="editVIPUser(data)">
                                    <option value="">未指定</option>
                                    <option v-for="item in tableList">{{item}}</option>
                                </select>
                            </td>
                            <td>{{data.StrFinish}}</td>
                            <td>
                                <a v-if="data.Status == 0" class="btn_link" href="#" v-on:click="editStatus(data,1)">开始</a>
                                <a v-else class="btn_link" href="#" v-on:click="editStatus(data, 0)">暂停</a>
                            </td>
                            <td>
                                <a class="btn_link_Red" href="#" v-on:click="delVIPUser(data.UserID)">删除</a>
                            </td>
                            <td>{{data.Operator}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        var vApp = new Vue({
            el: '#VIPUserList',
            data: {
                serverID:'@ViewBag.ServerID',
                vipUser: {},
                dataList: {},
                tableList:{},
                filterUserID: '',
                NextTypeSelect: [
                     { text: '豹子', value: 1 },
                     { text: '顺金', value: 2 },
                     { text: '顺子', value: 4 },
                     { text: '对子(9-A)', value: 5 },
                     { text: '对子(2-8)', value: 6 },
                     { text: '单张', value: 7 },
                     { text: 'A/K金花', value: 11 },
                     { text: '非A/K金花', value: 12 },
                     { text: '未指定', value: 99 }],
                NextWinLoseSelect: [
                    { text: '输', value: 0 },
                    { text: '赢', value: 1 },
                    { text: '未指定', value: 99 }],
                NextWinLoseNumSelect: [
                     { text: '输1局', value: -1 },
                     { text: '连输2局', value: -2 },
                     { text: '连输5局', value: -5 },
                     { text: '连输8局', value: -8 },
                     { text: '赢1局', value: 1 },
                     { text: '连赢2局', value: 2 },
                     { text: '连赢5局', value: 5 },
                     { text: '连赢8局', value: 8 },
                     { text: '未指定', value: 99 }]
            },
            methods: {
                ToCash: function (val) {
                    return ToCash(val);
                },
                getVIPUser: function () {

                    $.get('/GameZJH/GetVIPUser', { 'userID': vApp.filterUserID, 'serverID': vApp.serverID }, function (data) {
                        if (data) {
                            vApp.dataList = data.Result;
                            vApp.tableList = data.TableList;
                        }
                        else {
                            vApp.dataList = {};
                            vApp.tableList = {};
                        }
                    });
                },
                addVIPUser: function () {

                    if (this.vipUser.NewUserID)
                        $.get('/GameZJH/AddVIPUser', { 'userID': vApp.vipUser.NewUserID }, function (result) {
                            vApp.getVIPUser();
                        });
                },
                delVIPUser: function (userID) {
                    $.get('/GameZJH/DelVIPUser', { 'userID': userID }, function (result) {
                        vApp.getVIPUser();
                    });
                },
                editStatus: function (data, status) {
                    data.Status = status;
                    vApp.editVIPUser(data);
                    vApp.getVIPUser();
                },
                editVIPUser: function (data) {

                    $.ajax({
                        type: "POST",
                        data: JSON.stringify(data),
                        contentType: 'application/json',
                        traditional: true,
                        url: "/GameZJH/EditVIPUser",
                        success: function (result) {
                            vApp.getVIPUser();
                            $('#editVIP').modal('hide');
                        },
                        error: function (err) {
                            alert("操作失敗");
                        }
                    });
                }
            }
        });

        vApp.getVIPUser();
        setInterval(function () {
            vApp.getVIPUser();
        }, 10000);

    </script>
}