@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model List<game.Entity.Stat.UserGameTotalRank>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">                
                <div class="form-group">
                    <label>游戏</label>
                    @Html.DropDownList("gameID", DataService.Game(string.Empty, true), new { @class = "form-control input-small", id = "gameID" })
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">

                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th>排名</th>
                            <th>用户ID</th>
                            <th>总局数</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            var i = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>第@(i++)名</td>
                                    <td>@item.UserID</td>
                                    <td>@item.Total</td> 
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}

