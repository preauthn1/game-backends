@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model List<game.Entity.Stat.SystemGainLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-01")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th>统计时间</th>
                            <th>充值金额</th>    
                            <th>游戏金币变化</th>                          
                            <th>提现</th>                                                      
                            <th>赠送</th>
                            <th>平台收益</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd")</td>
                                    <td>@item.ChargeAmount.ToCash()</td>
                                    <td>机器人：@item.RobotTaxAmount.ToCash()，用户：@((-item.TaxAmount).ToCash())　@Html.LinkWithRight(action: "GameTaxLog", value: "详情", href: "GameTaxLog?beginTime=" + item.StatTime.ToString("yyyy-MM-dd") + "&endTime=" + item.StatTime.ToString("yyyy-MM-dd"))</td>
                                    <td>金额：@item.ConvertAmount.ToCash()，手续费：@item.ConvertTax.ToCash()，真实手续费：@item.ConvertRealTax.ToCash()</td>
                                    <td>@item.GiveAmount.ToCash()</td>
                                    <td>@((-item.TaxAmount + item.ConvertTax - item.ConvertRealTax).ToCash())</td>
                                </tr>
                            }
                        }
                    </tbody>                
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}