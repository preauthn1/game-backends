
@model List<game.Entity.Stat.SumMoneyLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group">
                    <label>统计时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-01")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover progressTable">
                    <thead>
                        <tr>
                            <th class="hide">编号</th>
                            <th>统计时间</th>
                            <th>系统现金</th>                            
                            <th>系统保險箱</th>
                            <th>系统总金币</th>                                                        
                            <th>总流入</th>
                            <th>总流出</th>
                            <th>净流入</th>
                            <th>用戶现金</th> 
                            <th>用戶保險箱</th>
                            <th>用戶总金币</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="hide">@item.Id</td>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.CashAmount.ToCash()</td>                                    
                                    <td>@item.BankAmount.ToCash()</td>
                                    <td class="amountProgress">@((item.BankAmount + item.CashAmount).ToCash())</td>
                                    <td>@item.SumIn.ToCash()</td>
                                    <td>@item.SumOut.ToCash()</td>
                                    <td>@((item.SumIn + item.SumOut).ToCash())</td>
                                    <td>@item.UserCashAmount.ToCash()</td> 
                                    <td>@item.UserBankAmount.ToCash()</td> 
                                    <td class="amountProgress">@((item.UserCashAmount + item.UserBankAmount).ToCash())</td>
                                </tr>
                            }
                        }
                    </tbody>                
                </table>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');

            ShowProgress($(".progressTable"), "amountProgress", 300); ShowProgress($(".progressTable"), "amountProgress2", 300); ShowProgress($(".progressTable"), "amountProgress3",300);
        })
    </script>
}