@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  List<game.Entity.Stat.KeepLog>
@{
    var platformList = DataService.GetAllPlatform();
    platformList.Add(new game.Entity.Area.Platform() { Id = 0, Name = "全部" });
    var dicPlatform = platformList.ToDictionary(m => m.Id, m => m.Name);
}

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">         
                @Html.Partial("_PlatformSelect", false)       
                <div class="form-group">
                    <label>登录时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@Convert.ToDateTime(DateTime.Now.AddDays(-1)).ToString("yyyy-MM-dd")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            <th>统计时间</th>
                            <th>注册人数</th>
                            <th>1日后留存率</th>
                            <th>2日后留存率</th>
                            <th>7日后留存率</th>
                            <th>30日后留存率</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@dicPlatform[item.PlatformID]</td>
                                    <td>@item.StatTime.ToString("yyyy-MM-dd")</td>
                                    <td>@item.RegCount</td>
                                    <td>
                                        @if (item.OneDayKeep != null && item.OneDayKeep != 0 && item.RegCount != 0)
                                        {
                                            <span>@(Math.Round((decimal)item.OneDayKeep/ item.RegCount,3))</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TwoDayKeep != null && item.TwoDayKeep != 0 && item.RegCount != 0)
                                        {
                                            <span>@(Math.Round((decimal)item.TwoDayKeep / item.RegCount, 3))</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.WeekKeep != null && item.WeekKeep != 0 && item.RegCount != 0)
                                        {
                                            <span>@(Math.Round((decimal)item.WeekKeep / item.RegCount, 3))</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.MonthKeep != null && item.MonthKeep != 0 && item.RegCount != 0)
                                        {
                                            <span>@(Math.Round((decimal)item.MonthKeep / item.RegCount, 3))</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div> 
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}