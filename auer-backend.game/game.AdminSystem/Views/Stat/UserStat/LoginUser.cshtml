@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  FW.Core.Helper.PagedList<game.Entity.Users.UserInfo>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_userPartial")
                <div class="form-group">
                    <label>最后登录IP地址</label>
                    <input type="text" class="form-control input-small" id="lastlogonIPAddress" name="lastlogonIPAddress" placeholder="最后登录IP地址">
                </div>
                <div class="form-group">
                    <label>最后登录时间</label>
                    <input type="text" class="form-control " style="width:180px" id="lastlogonBeginTime" value="@DateTime.Now.ToString("yyyy-MM-dd 00:mm")" name="lastlogonBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="lastlogonEndTime" name="lastlogonEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>硬件类型</label>
                    <select class="form-control input-small" id="hdType" name="hdType">
                        <option>--不限--</option>
                        @foreach (var item in Enum.GetValues(typeof(game.Entity.Users.HDType)))
                        {
                            <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
                @*<div class="form-group">
                    <label>硬件唯一码</label>
                    <input type="text" class="form-control input-small" id="hdCode" name="hdCode" placeholder="设备唯一码">
                </div>*@

                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>所属平台</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>性别</th>
                            <th>硬件类型</th>
                            <th>硬件唯一码</th>
                            <th>用户类型</th>
                            <th>最后登录时间</th>
                            <th>最后登录IP地址</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.Area.Platform.Name</td>
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item)
                                    <td>@item.Sex.GetDisplayName()</td>
                                    <td>@item.HDType.GetDisplayName()</td>
                                    <td>@item.HDCode</td>
                                    <td>@item.UserType.GetDisplayName()</td>
                                    <td>@item.LastLogonTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.LastLogonIPAddress</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}