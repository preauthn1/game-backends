@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc

@model  FW.Core.Helper.PagedList<game.Entity.Users.RegUserInfo>

@section pageLevelPlugins{
	<script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
	<link href="@Url.Content("~/Content/fontawesome/css/fontawesome.min.css")" rel="stylesheet">
}

<style>
	.flexbox {
		display: flex;
		padding: .2%;
		font-size: 2em;
	}

		.flexbox div {
			padding: 0 18px;
		}

	.red {
		color: red;
	}
</style>

<div class="row">
	<div class="col-md-12">
		<div class="protlet-body">
			<form class="form-inline" id="form_search" method="get">
				@Html.Partial("_userPartial")
				@Html.Partial("_PlatformSelect", false)
				@Html.Partial("AdminAreaList", true)
				<div class="form-group">
					<label>用户类型</label>
					<select class="form-control input-small" id="userType" name="userType">
						<option>--不限--</option>
						@foreach (var item in Enum.GetValues(typeof(game.Entity.Users.UserType)))
						{
							if (item.ToString().ToLower() != "rebot")	//排除機器人
							{
								<option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
							}
						}
					</select>
				</div>
				<div class="form-group">
					<label>注册IP地址</label>
					<input type="text" class="form-control input-small" id="regIpAddress" name="regIpAddress" placeholder="注册IP地址">
				</div>

				<div class="form-group">
					<label>注册时间</label>
					<input type="text" class="form-control " style="width:180px" id="regBeginTime" name="regBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")">
					到
					<input type="text" class="form-control " style="width:180px" id="regEndTime" name="regEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
				</div>

				<div class="form-group">
					<label>硬件类型</label>
					<select class="form-control input-small" id="hdType" name="hdType">
						<option>--不限--</option>
						@foreach (var item in Enum.GetValues(typeof(game.Entity.Users.HDType)))
						{
							<option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
						}
					</select>
				</div>
				<div class="form-group">
					<input type="hidden" name="sortName" id="sortName" value="@ViewBag.CurrentSort" />
					<input type="hidden" name="sortLifting" id="sortLifting" />
					<button type="submit" class="btn btn-default" name="submitType"> 搜 索 </button>
					<button type="submit" class="btn btn-default" name="submitType" value="Export"> 匯 出 </button>
				</div>
			</form>

			<div class="flexbox">
				<div>注册人数: <span class="red">@ViewBag.RegCount</span> </div>
				<div>充值人数: <span class="red">@ViewBag.ChargeCount</span></div>
			</div>
			<div class="table-scrollable">
				<table class="table table-striped table-bordered table-hover">
					<thead>
						<tr>
							<th class="hide">编号</th>
							<th>所属渠道</th>
							@Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
							<th>
								<a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="ChargeAmount" onclick="submitForm('@game.Entity.AdminSys.SortName.ChargeAmount')">充值金额</a>
							</th>
							<th>现金数</th>
							<th>性别</th>
							<th>硬件类型</th>
							<th>硬件唯一码</th>
							<th>用户类型</th>
							<th>
								<a class="fa fa-sort-down" style="font-weight:bold;" name="Sort" href="#" id="StatTime" onclick="submitForm('@game.Entity.AdminSys.SortName.StatTime')">创建时间</a>
							</th>
							<th>注册IP地址</th>
							<th>归属地</th>

							<th>最后登录时间</th>
							<th>最后登录IP地址</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null)
						{
							foreach (var item in Model.PageData)
							{
								<tr>
									<td class="hide">@item.Id</td>
									<td>@item.Area.AreaName</td>
									<td>
										<a target="_blank" href="/UserInfo/Search?userId=@item.Id&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">
											@item.Id
										</a>
									</td>
									<td>
										@{string strShowFlag = System.Configuration.ConfigurationManager.AppSettings["ShowCompleteLoginName"] ?? "0";}
										@if (strShowFlag == "1")
										{
										<a target="_blank" href="/UserInfo/Search?loginName=@item.LoginName&beginTime=@(DateTime.Now.AddMinutes(-10).ToString("yyyy-MM-dd HH:mm:ss"))&endTime=@(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))">
											@item.LoginName
										</a>
										}
										else
										{
										<span>xxxxxxxx</span>
										}
									</td>
									<td>@item.GradeID</td>
									<td>@Math.Floor(double.Parse(item.SumCharge.ToCash()))</td>
									<th>@item.cashamount.ToCash()</th>
									<td>@item.Sex.GetDisplayName()</td>
									<td>@item.HDType.GetDisplayName()</td>
									<td>@item.HDCode</td>
									<td>@item.UserType.GetDisplayName()</td>
									<td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
									<td>@item.CreateIPAddress</td>
									<td>@item.Location</td>
									<td>@item.LastLogonTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
									<td>@item.LastLogonIPAddress</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
			<div class="row rpager">
				<div class="pager">
					<div class="pagerc">
						@Html.Pager(Model)
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section initScripts{
	<script>
		$(function () {
			fillFormData('form_search');

			$("a[name='Sort']").removeClass();
			if ("@ViewBag.SortLifting" == "True") {
				$('#@ViewBag.CurrentSort').addClass("fa fa-sort-up");
			}
			else {
				$('#@ViewBag.CurrentSort').addClass("fa fa-sort-down");
			}
		})

		function submitForm(sortColumn) {
			var _sortLifting = ("@ViewBag.SortLifting" == "True");
			_sortLifting = !_sortLifting;

			$('#sortName').val(sortColumn);
			$('#sortLifting').val(Number(_sortLifting));
			$('#form_search').submit();
		}
	</script>
}