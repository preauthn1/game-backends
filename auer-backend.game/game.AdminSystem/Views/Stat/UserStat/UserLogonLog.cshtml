@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using FW.Core.Helper

@model PagedList<game.Entity.Users.LogonLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <label>登入时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" value="@DateTime.Now.ToString("yyyy-MM-dd 00:00")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>                            
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>硬件类型</th>
                            <th>硬件码</th>
                            <th>客户端版本</th>
                            <th>IP地址</th>
                            <th>广场服务器编号</th>                            
                            <th>是否被挤</th>
                            <th>保存密码</th>
                            <th>是否选择保存密码</th>
                            <th>登入时间</th>
                            <th>登出时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>                                    
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.User)
                                    <td>@item.HDType.GetDisplayName()</td>
                                    <td>@item.HDCode</td>
                                    <td>@item.Version</td>
                                    <td>@item.IPAddress</td>
                                    <td>@item.PlazaServerID</td>
                                    <td>@(item.Kick ? "是" : "否")</td>
                                    <td>@item.SavePwd</td>
                                    <td>@(item.SelectSavePwd ? "是" : "否")</td>                                    
                                    <td>@item.LoginTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.LogoutTime.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}