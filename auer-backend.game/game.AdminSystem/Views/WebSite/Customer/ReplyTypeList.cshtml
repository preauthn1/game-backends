@model List<game.Entity.Customer.ReplyType>

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            @*<td>编号</td>*@
                            <td>排序值</td>
                            <td>类型名称</td>
                            <td>操作</td>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            @*<td>@item.Id</td>*@
                            <td>@item.Sort</td>
                            <td>@item.TypeName</td>
                            <td>
                                @Html.LinkWithRight(value: "修改", action: "ReplyTypeEdit", href: "/Customer/ReplyTypeEdit/" + item.Id)
                                @Html.LinkWithRight(value: "删除", action: "ReplyTypeDelete", href: "#", onclick: "DelConfirmUrl('/Customer/ReplyTypeDelete/" + item.Id + "')")
                                @Html.LinkWithRight(value: "内容列表", action: "ReplyContentList", href: "/Customer/ReplyContentList?replyTypeID=" + item.Id)
                                @Html.LinkWithRight(value: "添加内容", action: "ReplyContentAdd", href: "/Customer/ReplyContentAdd?replyTypeID=" + item.Id)
                            </td>
                        </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>