@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using FW.Core.Helper
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="portlet box grey">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-globe"></i>新增封锁IP
                </div>
            </div>
            <div class="portlet-body form">
                <!-- BEGIN FORM-->
                <form id="form1" method="post" class="form-horizontal form-bordered">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">IP地址起</label>
                            <div class="col-md-8">
                                <input type="text" name="IPAddress" class="form-control input-medium" placeholder="请输入IP地址" value="" />
                            </div> 
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">IP地址迄</label>
                            <div class="col-md-8">
                                <input type="text" name="IPAddress2" class="form-control input-medium" placeholder="请输入IP地址" value="" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">备注</label>
                            <div class="col-md-8">
                                <textarea rows="3" name="Memo" id="Memo" class="form-control input-medium" placeholder="备注"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4 xing">过期时间</label>
                            <div class="col-md-8">
                                <input type="text" name="ExpireTime" class="form-control  input-medium" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd' })" placeholder="过期时间" value="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-offset-5 col-md-9">
                            @Html.OkWithRight()
                            @Html.Back(Url.Action("List"))
                        </div>
                    </div>
                </form>

                <!-- END FORM-->
            </div>
        </div>

    </div>
</div>
@section initScripts{
    <script type="text/javascript" src="/Plugins/Uploadify/Upload.js"></script>
    <script>
        var num = 0;
        $(function () {
            $("#form1").validate({
                rules: {
                    IPAddress: {
                        required: true
                        , maxlength: 15
                    },
                    Memo: {
                        required: true,
                        minlength:5,
                        maxlength: 1024
                    }, EndTime: {
                        required: true
                    }
                }
            });
        })
    </script>
}