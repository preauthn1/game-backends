											"render": function (data, type, row) {
												if (data == '0.00') {
													return '<span class="update_Gray">' + data + '<span>'
												}
												return data;
											}
										},
										{ "sTitle": '总兑换', "mData": "SumConvert", "className": "text_right", "bSortable": true, "sName": 1 },
