										{ "sTitle": "房间", "mData": "ServerID" },
										{ "sTitle": "游戏赢", "mData": "WinCount" },
										{ "sTitle": "游戏输", "mData": "LoseCount" },
										{ "sTitle": "时间", "mData": "LastLogonTime" }]

						const data = {
							gameID: vApp.selectedGameID,
							serverID: vApp.selectedServerId
						}

						var sortColumn = 0;
						var sortDes = 'asc';

						if ('@ViewBag.column' != '') {
							sortColumn = parseInt('@ViewBag.column')
						}
						if ('@ViewBag.sortDes' != '') {
							sortDes = '@ViewBag.sortDes'
						}

						const opt = {
							aaSorting: [[sortColumn, sortDes]],
						}

						createDataTable('online', thead, url, data, (json) => {
							vApp.filterDatas = [];
							vApp.outputData.map((item) => {
								var value = json.output[item.key]
								item.value = value

								if (item.value != -1) {
									vApp.filterDatas.push(item);
								}
							})
						}, opt)
					},
					getServerList: function () {
						$.get('/UserInfo/GameServerList', {}, function (data) {
							if (data instanceof Array) {
								vApp.serverList = data;
							}
							else {
								vApp.serverList = {};
							}
						});
					}
				}
			})

