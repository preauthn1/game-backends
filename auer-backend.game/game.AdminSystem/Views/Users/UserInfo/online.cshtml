												if (data.indexOf('-') != -1) {
													return '<span class="update_Red">' + data + '<span>'
												}
												return '<span class="update_Green">' + data + '<span>'
											}
										},
										{ "sTitle": "渠道", "mData": "AreaName" },
										{ "sTitle": "装置", "mData": "HDType" },
										{ "sTitle": "IP", "mData": "IP" },
										{ "sTitle": "归属地", "mData": "Location" },
