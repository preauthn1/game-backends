
@section pageLevelPlugins{
	
	<script src="@Url.Content("~/Plugins/Vue/vue.min.js")"></script>
	<link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
	.instructions {
		flex: .6;
	}

		.instructions span {
			padding: 2%;
		}

	.menu {
		display: flex;
		justify-content: space-between;
		padding-bottom: 1%;
	}

	.table th {
		text-align: center;
	}
</style>


<div id="vApp">
	<div class="row">
		<div class="col-md-12">
			<div class="protlet-body">

				<form class="form-inline instructions" id="form_search" method="get">

					@Html.Partial("_PlatformSelect", false)

					@Html.Partial("AdminAreaList", true)

					<div class="form-group">
						<button type="submit" class="btn btn-default" v-on:click="getSevenDaysLoginBonus()"> 搜 索 </button>
					</div>
					<div class="form-group">
						<button type="button" class="btn btn-light" style="width:100px;" data-toggle="modal" data-target="#add7DaysLoginBonusModal" v-on:click="show_add()">新 增</button>
					</div>
				</form>
				<div class="table-scrollable">
					<table class="table table-striped table-bordered table-hover progressTable">
						<thead>
							<tr>
								<th class="hide">平台编号</th>
								<th class="hide">渠道编号</th>
								<th>平台名称</th>
								<th>渠道名称</th>
								<th>第一天</th>
								<th>第二天</th>
								<th>第三天</th>
								<th>第四天</th>
								<th>第五天</th>
								<th>第六天</th>
								<th>第七天</th>
								<th style="width:5%;">状态</th>
								<th style="width:10%;">动作</th>
							</tr>
						</thead>
						<tbody>
							<tr v-for="row in tableList">
								<td class="hide">{{row.PlatformID}}</td>
								<td class="hide">{{row.AreaID}}</td>
								<td>{{row.PlatformName}}</td>
								<td>{{row.AreaName}}</td>
								<td>{{row.Day1}}</td>
								<td>{{row.Day2}}</td>
								<td>{{row.Day3}}</td>
								<td>{{row.Day4}}</td>
								<td>{{row.Day5}}</td>
								<td>{{row.Day6}}</td>
								<td>{{row.Day7}}</td>
								<td style="text-align:center">{{row.StatusName}}</td>
								<td style="text-align:center">
									<input type="button" class="btn btn-sm dark" data-toggle="modal" data-target="#edit7DaysLoginBonusModal" value="修改" v-on:click="show_edit(row)">
									<input type="button" class="btn btn-sm dark" value="刪除" v-on:click="deleteSevenDaysLoginBonus(row.PlatformID, row.AreaID)">
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<!-- add Modal-->
	<div class="modal fade" id="add7DaysLoginBonusModal" tabindex="-1" role="dialog" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">新增七天登入奖励设置</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form id="form_Add" method="post" action="AddSevenDaysLoginBonus" class="form-horizontal form-bordered">

						<div class="form-group">
							<label class="control-label col-md-4 xing">平台</label>
							<div class="col-md-8">
								<input type="number" name="PlatformID" class="form-control input-medium" value="" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">渠道</label>
							<div class="col-md-8">
								<input type="text" name="AreaID" class="form-control input-medium" value="" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第一天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day1" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第二天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day2" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第三天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day3" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第四天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day4" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第五天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day5" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第六天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day6" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">第七天奖励金额</label>
							<div class="col-md-8">
								<input type="text" name="Day7" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" />
							</div>
						</div>
						<div class="form-group">
							<label class="control-label col-md-4 xing">状态</label>
							<div class="col-md-8">
								<select class="form-control input-small" name="Status">
									<option value="1">開</option>
									<option value="0">關</option>
								</select>
							</div>
						</div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn dark">储存</button>
					<button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
				</div>
				</form>
			</div>
		</div>
	</div>
	<!--End add Modal-->
	<!-- Edit Modal-->
	<div class="modal fade" id="edit7DaysLoginBonusModal" tabindex="-1" role="dialog" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">修改七天登入奖励设置</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form id="form_Add" method="post" action="ModifySevenDayLoginBonus" class="form-horizontal form-bordered">
						<div class="form-body">
							<div class="form-group">
								<label class="control-label col-md-4 xing">平台</label>
								<div class="col-md-8">
									<input type="text" name="PlatformName" class="form-control input-medium" value="" v-model="SevenDaysLoginBonus.PlatformName" readonly="readonly" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">渠道</label>
								<div class="col-md-8">
									<input type="text" name="AreaName" class="form-control input-medium" value="" v-model="SevenDaysLoginBonus.AreaName" readonly="readonly" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第一天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day1" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day1" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第二天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day2" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day2" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第三天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day3" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day3" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第四天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day4" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day4" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第五天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day5" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day5" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第六天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day6" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day6" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">第七天奖励金额</label>
								<div class="col-md-8">
									<input type="text" name="Day7" class="form-control input-medium" placeholder="请输入奖励金额（单位：分）" v-model="SevenDaysLoginBonus.Day7" />
								</div>
							</div>
							<div class="form-group">
								<label class="control-label col-md-4 xing">状态</label>
								<div class="col-md-8">
									<select class="form-control input-small" name="Status" v-model="SevenDaysLoginBonus.Status">
										<option value="1">開</option>
										<option value="0">關</option>
									</select>
								</div>
							</div>
						</div>
						<div class="modal-footer">
							<button type="submit" class="btn btn dark">储存</button>
							<button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<!--End Edit Modal-->
</div>



@section initScripts{
	<script>
		$(function () {

			var vApp = new Vue({
				el: '#vApp',
				data: {
					tableList: {},
					SevenDaysLoginBonus: {}
				},
				methods: {					
					getSevenDaysLoginBonus: function () {
						$.get('/Activity/GetSevenDaysLoginBonus',
							{ '_r': Math.random(), platformID: $("#platformid").val(), areaID: $("#areaID").val() }, function (data) {
								if (data instanceof Array) {
									vApp.tableList = data;
								}
								else {
									vApp.tableList = {};
								}
							});
					},
					deleteSevenDaysLoginBonus: function (platfromID, areaID) {
						//const status = -1;

						var option = {
							isAjax: true,
							method: 'post',
							data: {
								platfromID: platfromID,
								areaID: areaID
							},
							isReload: false,
							callback: function () {
								vApp.getSevenDaysLoginBonus();
							}
						}
												
						swDelConfirmUrl('DelSevenDaysLoginBonus', '确定要删除此设置？' + '(' + platfromID + ',' + areaID + ')'  , option);
					},
					show_add: function () {
						$("#form_Add")[0].reset();
					},
					show_edit: function (rowData) {
						vApp.SevenDaysLoginBonus = {};
						vApp.SevenDaysLoginBonus = rowData;
					}
				}
			});

			$("#form_Add").validate({
				rules: {
					EventID: {
						required: true
					},
					EventName: {
						required: true,
						maxlength: 32
					},
					StartTime: {
						required: true
					},
					GiftCash: {
						required: true,
						number: true
					},
					Status: {
						required: true
					}
				},
				messages: {
					GiftCash: {
						number: '只能使用数字'
					}
				}
			});

			$("#form_Edit").validate({
				rules: {
					EventID: {
						required: true
					},
					EventName: {
						required: true,
						maxlength: 32
					},
					StartTime: {
						required: true
					},
					GiftCash: {
						required: true,
						number: true
					},
					Status: {
						required: true
					}
				},
				messages: {
					GiftCash: {
						number: '只能使用数字'
					}
				}
			});

			vApp.getSevenDaysLoginBonus();
		});
	</script>
}
