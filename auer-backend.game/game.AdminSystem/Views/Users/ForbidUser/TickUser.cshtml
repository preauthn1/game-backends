@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using FW.Core.Helper

@model  game.Entity.Users.UserInfo
@{
    game.Entity.Money.Cash cash = ViewBag.UserCash as game.Entity.Money.Cash;
    cash = cash ?? new game.Entity.Money.Cash();
    game.Entity.Money.Bank bank = ViewBag.UserBank as game.Entity.Money.Bank;
    bank = bank ?? new game.Entity.Money.Bank();
    bool Type = ViewBag.Type == null ? false : ViewBag.Type;
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
        </div>
    </div>
</div>
@if (Model != null)
{
    <br />
    <div class="row">
        <div class="col-md-6 col-md-offset-3">
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-globe"></i>封锁账号
                    </div>
                </div>
                <div class="portlet-body form">
                    <form id="form1" class="form-horizontal form-bordered" method="post">
                        <div class="form-body">

                            <div class="form-group">
                                <label class="control-label col-md-5 ">账号</label>
                                <div class="col-md-7">
                                    <span>@Model.LoginName</span>
                                    <input hidden value="@Model.Id" name="userID" id="userID" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-5 ">现金数</label>
                                <div class="col-md-7">
                                    <span>@cash.Amount.ToCash()</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-5 ">保險箱数</label>
                                <div class="col-md-7">
                                    <span>@bank.Amount.ToCash()</span>
                                </div>
                            </div>
                            @if (Type)
                            {
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">备注</label>
                                    <div class="col-md-7">
                                        <textarea rows="3" name="memo" id="memo" class="form-control  input-large" placeholder="修改原因"></textarea>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="col-md-offset-5 col-md-7">
                                        @Html.OkWithRight(value: "踢人", onclick: "return Check()")
                                    </div>
                                </div>
                            }
                        </div>

                    </form>
                    <!-- END FORM-->
                </div>
            </div>

        </div>
    </div>
}
else
{
    game.Entity.Users.UserInfo data = ViewBag.Model as game.Entity.Users.UserInfo;
    if (data != null)
    {
        <br />
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="portlet box grey">
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-globe"></i>封锁账号
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <form id="form1" class="form-horizontal form-bordered" method="post">
                            <div class="form-body">
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">账号</label>
                                    <div class="col-md-7">
                                        <span>@data.LoginName</span>
                                        <input hidden value="@data.Id" name="userID" id="userID" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">现金数</label>
                                    <div class="col-md-7">
                                        <span>--</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">保險箱数</label>
                                    <div class="col-md-7">
                                        <span>--</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">备注</label>
                                    <div class="col-md-7">
                                        <textarea rows="3" name="memo" id="memo" class="form-control  input-large" placeholder="修改原因"></textarea>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="col-md-offset-5 col-md-7">
                                        @*@Html.OkWithRight(value: "封锁账号", onclick: "return Check()")*@
                                        <button id="btnOk" type="submit" class="btn btn-primary" style="" onclick="return Check()"><i class="fa fa-file-o"></i> 踢人</button>
                                    </div>
                                </div>
                            </div>

                        </form>
                        <!-- END FORM-->
                    </div>
                </div>

            </div>
        </div>
    }
}
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
        $("#form1").validate({
            rules: {
                userID: {
                    required: true
                },
                memo: {
                    required: true,
                    minlength: 5,
                    maxlength: 512
                }
            }
        });
        function Check() {
            if (confirm("是否踢出此用户？")) {
                return true;
            } else {
                return false;
            }
        }
    </script>
}