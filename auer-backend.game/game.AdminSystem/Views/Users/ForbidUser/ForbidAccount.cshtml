@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
    <script src="@Url.Content("~/Plugins/Vue/vue.js")"></script>
    <script src="@Url.Content("~/Plugins/DataTable/jquery.dataTables.min.js")"></script>
    <link href="@Url.Content("~/Plugins/DataTable/css/dataTables.jqueryui.min.css")" rel="stylesheet" type="text/css" />
}

<style>
    .menu {
        display: flex;
        justify-content: space-between;
        padding-bottom: 1%;
    }
</style>


<div class="row" id="forbidaccountApp">
    <div class="col-md-12">
        <div class="protlet-body">
            <div class="menu">
                <div class="form-inline" id="form_search">
                    <div class="form-group">
                        <label>手机号 / 支付帐号</label>
                        <input type="text" class="form-control input-medium" id="accountID" name="accountID" placeholder="请输入手机号，支付宝或银联帐号" value="@ViewBag.accountID">
                    </div>
                    <div class="form-group">
                        <label>类别</label>
                        <select name="IdType" id="idType" class="form-control input-small">
                            <option value="">全部</option>
                            <option value="1">正式帐号(手机号)</option>
                            <option value="2">支付宝帐号</option>
                            <option value="3">银联帐号</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>开始时间</label>
                        <input type="text" class="form-control " style="width:180px" id="startTime" name="startTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm',isShowClear:false,readOnly:true})" placeholder="开始时间" autocomplete="off">
                        到
                        <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn btn-default" v-on:click="getForbidAccount()"> 搜 索 </button>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-light" style="width:100px; height:50px;" data-toggle="modal" data-target="#addForbidaccountModal">新 增</button>
                </div>
            </div>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width:20%">帐号</th>
                            <th style="width:20%">类别</th>
                            <th>备注</th>
                            <th style="width:5%;">动作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in tableList">
                            <td>{{row.AccountID}}</td>
                            <td>{{IdTypeName[row.IdType]}}</td>
                            <td>{{row.Memo}}</td>
                            <td>
                                <input type="button" class="btn btn-sm dark" value="刪除" v-on:click="unForbidAccount(row)">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- add Modal-->
    <div class="modal fade" id="addForbidaccountModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">新增</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_Add" method="post" action="AddForbidAccount" class="form-horizontal form-bordered">
                        <div class="form-body">
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">帐号</label>
                                <div class="col-md-8">
                                    <input type="text" name="AccountID" class="form-control input-medium" value="" maxlength="50" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">类别</label>
                                <div class="col-md-8">
                                    <select class="form-control input-medium" name="IdType">
                                        <option value="1">正式帐号(手机号)</option>
                                        <option value="2">支付宝帐号</option>
                                        <option value="3">银联帐号</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-4 xing">备注</label>
                                <div class="col-md-8">
                                    <textarea rows="5" cols="20" maxlength="100" name="Memo" class="form-control input-medium">帐号封号</textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn dark">储存</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--End add Modal-->
</div>
@section initScripts{
    <script>
        $(function () {
            var vApp = new Vue({
                el: '#forbidaccountApp',
                data: {
                    tableList: {},
                    IdTypeName: ["", "正式帐号(手机号)", "支付宝帐号", "银联帐号"]
                },
                methods: {
                    getForbidAccount: function () {
                        $.get('/ForbidUser/GetForbidAccount',
                            { startTime: $("#startTime").val(), endTime: $("#endTime").val(), idType: $("#idType").val(), accountID: $("#accountID").val() }, function (data) {
                                if (data instanceof Array) {
                                    vApp.tableList = data;
                                }
                                else {
                                    vApp.tableList = {};
                                }
                            });
                    },
                    unForbidAccount: function (data) {
                        var option = {
                            isAjax: true,
                            method: 'post',
                            data: {
                                accountID: data.AccountID,
                                idType: data.IdType
                            },
                            isReload: false,
                            callback: function () {
                                vApp.getForbidAccount();
                            }
                        }

                        swDelConfirmUrl('UnForbidAccount', '确定要删除么？', option);
                    }
                },
            });

            $("#form_Add").validate({
                rules: {
                    AccountID: {
                        required: true
                    },
                    IdType: {
                        required: true
                    }
                }
            });

            vApp.getForbidAccount();

        })
    </script>
}