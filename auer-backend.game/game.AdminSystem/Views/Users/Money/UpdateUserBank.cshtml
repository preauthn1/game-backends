@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web
@using FW.Core.Helper

@model game.Entity.Money.Bank
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_message")
                @Html.Partial("~/Views/Shared/_userPartial.cshtml")
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
        </div>
    </div>
</div>
@if (Model != null)
{
    <br />
    <div class="row">
        <div class="col-md-6 col-md-offset-3">
            <div class="portlet box grey">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-globe"></i>修改保險箱金额
                    </div>
                </div>
                <div class="portlet-body form">
                    <form id="form1" class="form-horizontal form-bordered" method="post">
                        <div class="form-body">
                            @Html.Partial("UserInfo", Model.User)
                            <input hidden value="@Model.User.Id" name="userID" id="userID" />
                            <div class="form-group">
                                <label class="control-label col-md-5 ">余额</label>
                                <div class="col-md-7">
                                    <span>@Model.Amount.ToCash()</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-5 ">修改金额</label>
                                <div class="col-md-7">
                                    <input type="number" class="form-control input-small " id="amount" name="amount" placeholder="金额">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-5 ">备注</label>
                                <div class="col-md-7">
                                    <textarea rows="3" name="memo" id="memo" class="form-control  input-large" placeholder="修改原因"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-5 ">金钥</label>
                                <div class="col-md-7">
                                    <input class="form-control placeholder-no-fix input-inline input-medium" type="text" autocomplete="off" data-required="1" id="txtScretKey" name="txtScretKey" placeholder="请输入金钥...">
                                </div>
                            </div>
                            <div class="form-actions">
                                <div class="col-md-offset-5 col-md-7">
                                    @Html.OkWithRight(value: "修改保險箱金额")
                                </div>
                            </div>
                        </div>

                    </form>
                    <!-- END FORM-->
                </div>
            </div>

        </div>
    </div>
}
else
{
    game.Entity.Users.UserInfo data = ViewBag.Model as game.Entity.Users.UserInfo;
    if (data != null)
    {
        <br />
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="portlet box grey">
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-globe"></i>修改保險箱金额
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <form id="form1" class="form-horizontal form-bordered" method="post">
                            <div class="form-body">
                                @Html.Partial("UserInfo", data)
                                <input hidden value="@(data.Id.ToString())" name="userID" id="userID" />
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">余额</label>
                                    <div class="col-md-7">
                                        <span>无保險箱金额</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">修改金额</label>
                                    <div class="col-md-7">
                                        <input type="number" class="form-control input-small " id="amount" name="amount" placeholder="金额">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">备注</label>
                                    <div class="col-md-7">
                                        <textarea rows="3" name="memo" id="memo" class="form-control  input-large" placeholder="修改原因"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">金钥</label>
                                    <div class="col-md-7">
                                        <input class="form-control placeholder-no-fix input-inline input-medium" type="text" autocomplete="off" data-required="1" id="txtScretKey" name="txtScretKey" placeholder="请输入金钥...">
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="col-md-offset-5 col-md-7">
                                        @Html.OkWithRight(value: "修改保險箱金额")
                                    </div>
                                </div>
                            </div>

                        </form>
                        <!-- END FORM-->
                    </div>
                </div>

            </div>
        </div>
    }
}
@section initScripts{
    <script>
        $(function () {

            var validateFunc = function () {
                var validator = new Validator()
                validator.add([form_search.loginName, form_search.nickName, form_search.userID], [{
                    strategy: 'isSomeNonEmpty',
                    errorMsg: '账户信息不能全为空,请输入昵称、账号或者ID！'
                }])

                var errorMsg = validator.start()
                return errorMsg
            }

            var form = document.getElementById('form_search')
            form.onsubmit = function () {
                var errorMsg = validateFunc()
                if (errorMsg) {
                    Msg.alert(errorMsg, 'danger')
                    return false
                }
            }

            fillFormData('form_search');
            $("#form1").validate({
                rules: {
                    userID: {
                        required: true
                    },
                    amount: {
                        required: true,
                        number: true,
                        range: [-2147483648, 2147483647]
                    },
                    memo: {
                        required: true,
                        minlength: 5,
                        maxlength: 512
                    },
                    txtScretKey: {
                        required: true
                    }
                }
            });
        })
    </script>
}