@using FW.Core.Web.Mvc
@using FW.Core.Helper

@model PagedList<game.Entity.Money.MoneyLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("_PlatformSelect", false)
                @Html.Partial("AdminAreaList", true)
                @Html.Partial("_userPartial")
                @Html.Partial("SourceType")
                <div class="form-group">
                    <label>IP地址</label>
                    <input type="text" class="form-control input-small " id="ipAddress" name="ipAddress" placeholder="IP地址">
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" id="beginTime" name="beginTime" value="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd HH:mm")" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="endTime" name="endTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover ">
                    <thead>
                        <tr>
                            <th>创建时间</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>流通类型</th>
                            <th>当前数量</th>
                            <th>更新的数量</th>
                            <th>更新后数量</th>
                            <th>IP地址</th>
                            <th>说明</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.PageData != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.User)
                                    <td>@item.SourceType.SourceName</td>
                                    <td>@item.CurrentAmount.ToCash()</td>
                                    <td>@item.UpdateAmount.ToCash()</td>
                                    <td>@((item.CurrentAmount + item.UpdateAmount).ToCash())</td>
                                    <td>@item.IPAddress</td>
                                    <td>@item.Memo</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @if (Model != null && Model.PageData != null)
                        {
                            @Html.Pager(Model)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}