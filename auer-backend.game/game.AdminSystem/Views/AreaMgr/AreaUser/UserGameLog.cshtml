@using FW.Core.Web.Mvc
@model FW.Core.Helper.PagedList<game.Entity.Game.GameLog>
@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("AreaListWithAll")
                @Html.Partial("_userPartial")
                @Html.Partial("GameServer")
                <div class="form-group">
                    <label>IP地址</label>
                    <input type="text" class="form-control input-small " id="ipAddress" name="ipAddress" placeholder="IP地址">
                </div>
                <div class="form-group">
                    <label>硬件类型</label>
                    <select id="hDtype" name="hDtype" class="form-control input-small">
                        <option value="">所有</option>
                        <option value="1">PC</option>
                        <option value="2">安卓</option>
                        <option value="3">苹果</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>硬件码</label>
                    <input type="text" class="form-control input-small " id="hDcode" name="hDcode" placeholder="硬件码">
                </div>
                <div class="form-group">
                    <label>登入时间</label>
                    <input type="text" class="form-control " style="width:180px" id="loginBeginTime" name="loginBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="loginEndTime" name="loginEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>登出时间</label>
                    <input type="text" class="form-control " style="width:180px" id="logoutBeginTime" name="logoutBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@Convert.ToDateTime(DateTime.Now.ToShortDateString()).ToString("yyyy-MM-dd HH:mm")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="logoutEndTime" name="logoutEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>服务器</th>
                            <th>进游戏金币</th>                            
                            <th>输赢金币</th>
                            <th>税收</th>
                            <th>赢</th>
                            <th>输</th>
                            <th>平</th>
                            <th>游戏时间</th>
                            <th>IP地址</th>
                            <th>硬件类型</th>
                            <th>硬件唯一码</th>                            
                            <th>登入时间</th>
                            <th>登出时间</th>
                        
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.User)
                                    <td>@item.GameServer.ServerName </td>
                                    <td>@item.LoginMoney.ToCash()</td> 
                                    <td>@item.Amount.ToCash()</td>
                                    <td>@item.TaxAmount.ToCash()</td>
                                    <td>@item.WinCount</td>
                                    <td>@item.LoseCount</td>
                                    <td>@item.DrawCount</td>
                                    <td>@item.GameTime</td>
                                    <td>@item.IPAddress</td>
                                    <td>@FW.Core.Helper.Enum.EnumExtensions.GetDisplayName(item.HDType)</td>
                                    <td>@item.HDCode</td> 
                                    <td>@item.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@item.LogoutTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                   

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
    </script>
}