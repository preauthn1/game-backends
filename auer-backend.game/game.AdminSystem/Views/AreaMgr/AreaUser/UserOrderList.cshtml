@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  FW.Core.Helper.PagedList<game.Entity.Pay.CDPayOrder>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}

<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                @Html.Partial("AreaListWithAll")
                @Html.Partial("_userPartial")
                <div class="form-group">
                    <label>订单编号</label>
                    <input type="text" class="form-control input-small" id="orderID" name="orderID" placeholder="订单编号">
                </div>
                <div class="form-group">
                    <label>第三方交易数据</label>
                    <input type="text" class="form-control input-small" id="transData" name="transData" placeholder="第三方交易数据">
                </div>
                <div class="form-group">
                    <label>IP地址</label>
                    <input type="text" class="form-control input-small" id="ipAddress" name="ipAddress" placeholder="IP地址">
                </div>
                <div class="form-group">
                    <label>支付类型</label>
                    <select class="form-control input-small" id="payTypeID" name="payTypeID">
                        <option>--不限--</option>                        
                        <option value="@game.Infrastructure.PaySourceType.IOSPay.ToString().ToLower()">苹果IOS充值</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>支付状态</label>
                    <select class="form-control input-small" id="status" name="status">
                        <option>--不限--</option>
                        @foreach (var item in Enum.GetValues(typeof(game.Entity.Pay.CDOrderStatus)))
                        {
                            <option value="@item.ToString().ToLower()">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>创建时间</label>
                    <input type="text" class="form-control " style="width:180px" value="@Convert.ToDateTime(DateTime.Now.ToShortDateString()).ToString("yyyy-MM-dd HH:mm")" id="createBeginTime" name="createBeginTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间">
                    到
                    <input type="text" class="form-control " style="width:180px" id="createEndTime" name="createEndTime" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>创建时间</th><th>编号</th>
                            <th>支付类型</th>
                            @Html.Partial("~/Views/Shared/_userTHeadPartial.cshtml")
                            <th>充值金额</th>
                            <th>订单状态</th>
                            <th>IP地址</th>
                            <th>交易标识</th>
                            <th style="width:550px">第三方交易数据</th>                        
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td><td>@item.Id</td>
                                    <td>@item.PayType.TypeName</td>
                                    @Html.Partial("~/Views/Shared/_userTBodyPartial.cshtml", item.UserInfo)
                                    <td>@Html.FormatAmount(item.Amount.ToString())</td>
                                    <td>@item.Status.GetDisplayName()</td>
                                    <td>@item.IPAddress</td>
                                    <td>@item.TransID</td>
                                    <td style="width:550px">
                                        <div style="width:550px;  word-break: break-all;white-space:normal;min-width:300px;max-height:50px;overflow:hidden">@item.TransData</div>
                                    </td>                                 
                                    <td>
                                        @if (item.Status == game.Entity.Pay.CDOrderStatus.Waiting)
                                        {
                                            @Html.LinkWithRight(action: "FinishOrder", value: "手动完成充值", onclick: "FinishOrder('" + item.Id + "')", href: "#")
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
        })
        function FinishOrder(id) {
            DelConfirmUrl("FinishOrder?orderID=" + id
                , "确定手动完成此充值吗？");
        }
    </script>
}