@using FW.Core.Helper.Enum
@using FW.Core.Web.Mvc
@using FW.Core.Web

@model  FW.Core.Helper.PagedList<game.Entity.Warning.WarningLog>

@section pageLevelPlugins{
    <script src="@Url.Content("~/Plugins/My97DatePicker/WdatePicker.js")"></script>
}
@{
    var warningTypeList = ViewBag.Type as List<game.Entity.Warning.WarningType>;
}
<div class="row">
    <div class="col-md-12">
        <div class="protlet-body">
            <form class="form-inline" id="form_search" method="get">
                <div class="form-group hide" >
                    <label>管理员编号</label>
                    <input type="text" class="form-control input-small" id="adminUserID" name="adminUserID" value="@SiteService.GetAdminUserID()" placeholder="管理员编号">
                </div>
                <div class="form-group">
                    <label>报警类型</label>
                    <select class="form-control input-small" name="typeID" id="typeID">
                        <option>--不限--</option>
                        @foreach (var item in warningTypeList)
                        {
                            <option value="@item.Id">@item.TypeName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>报警时间</label>
                    <input type="text" class="form-control " style="width:180px" id="begin" name="begin" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm', isShowClear: false, readOnly: true })" placeholder="开始时间" value="@Convert.ToDateTime(DateTime.Now.AddDays(-30).ToShortDateString()).ToString("yyyy-MM-dd HH:mm")">
                    到
                    <input type="text" class="form-control " style="width:180px" id="end" name="end" onfocus="WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm'})" placeholder="结束时间" autocomplete="off">
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-default" id="seach"> 搜 索 </button>
                </div>
            </form>
            <div class="table-scrollable">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                           <th>报警类型名称</th>
                           <th>报警内容</th>
                            <th>报警时间</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.PageData)
                            {
                                <tr>
                                  <td>@item.WarningType.TypeName</td>
                                    <td>@item.Memo</td>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row rpager">
                <div class="pager">
                    <div class="pagerc">
                        @Html.Pager(Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section initScripts{
    <script>
        $(function () {
            fillFormData('form_search');
            $("#seach").click(function () {
                var id = $("#adminUserID").val();
                if (id.toString().trim()=="") {
                    var id = $("#adminUserID").val("-1");
                }
            })
        })
    </script>
}