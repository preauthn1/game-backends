<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<configSections>
		<section name="engineConfig" type="FW.Core.Engine.EngineConfigHandler, FW.Core.Engine" requirePermission="false" />
		<section name="logConfig" type="FW.Core.Logger.LogConfigHandler, FW.Core.Logger" requirePermission="false" />
		<section name="userRightConfig" type="FW.Core.Auth.UserRight.UserRightConfigHandler, FW.Core.Auth" />
		<section name="authConfig" type="FW.Core.Auth.AuthorizeRule.Mvc.ConfigMvcTokenAuthorizeRuleProvider, FW.Core.Auth" />
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" requirePermission="false" />
		<sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, System.Web.WebPages.Razor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]">
			<section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, System.Web.WebPages.Razor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" requirePermission="false" />
			<section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, System.Web.WebPages.Razor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<engineConfig>
		<injectDlls></injectDlls>
		<engineProvider>FW.Core.Engine.AutofacEngineProvider, FW.Core.Engine</engineProvider>
	</engineConfig>
	<logConfig>
		<enable>Info,Error,Debug,Fatal,Warn</enable>
	</logConfig>
	<userRightConfig>
		<user name="1">
			<userRole>website</userRole>
		</user>
	</userRightConfig>
	<authConfig>

		<rule controller="*" allowRoles="*" />
		<!--<rule controller="*" denyUsers="?"  />-->
	</authConfig>
	<system.web.webPages.razor>
		<host factoryType="System.Web.Mvc.MvcWebRazorHostFactory, System.Web.Mvc, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" />
		<pages pageBaseType="System.Web.Mvc.WebViewPage">
			<namespaces>
				<add namespace="System.Web.Mvc" />
				<add namespace="System.Web.Mvc.Ajax" />
				<add namespace="System.Web.Mvc.Html" />
				<add namespace="System.Web.Routing" />
				<add namespace="FW.Core.AdminSys.WebUI" />
				<add namespace="FW.Core.AdminSys.WebUI.Themes.Bootstrap" />
			</namespaces>
		</pages>
	</system.web.webPages.razor>  
	<appSettings>
		
		<add key="webpages:Version" value="0.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />

		<!--game api位置-->
		<add key="GameAPIUrl" value="http://localhost:5264/api/v1/" />    
		<!--與後端API溝通需要的 id & key 值, 需與後端一致 -->
		<add key="GameAPIID" value="1" />
		<add key="GameAPIKey" value="123" /> 
		
		<!--显示中1个金币与数据存储的比例,如：100表示 显示的一个金币在数据中存储的是100个金币 -->
		<add key="CoinShowRate" value="100" />

		<!-- 推送telegram訊息的api位置與機器人token -->
		<add key="TGServerIP" value="http://0.0.0.0:8080/Sendmessage.ashx"/>
		<add key="TGServerToken" value="[TG_BOT_TOKEN_REDACTED]"/>
		
		<!--可以在管理后台操作房间的游戏编号，多个用逗号隔开-->
		<add key="OperateServerGameID" value="
			2@/GameQZNN/TableList?serverID={0}
			,3@/GameZJH/SuperTool?serverID={0}
			,9@/GameSGJ/TableList?serverID={0}
			,11@/GameLHD/TableDetail?serverID={0}&amp;tableNo=0
			,13@/GameBJL/TableList?serverID={0}
			,18@/GameFKEB/TableList?serverID={0}
			,19@/GameBRNN/TableDetail?serverID={0}&amp;tableNo=0
			,20@/GameHHDZ/TableDetail?serverID={0}&amp;tableNo=0
			,21@/GameHHNN/TableDetail?serverID={0}&amp;tableNo=0
			,14@/GameBY/SuperTool?serverID={0}" />
		<add key="ProtoBufMD5Key" value="abc123" />

		<!--不紀錄adminlog的action-->
		<add key="DisableLogAction" value="_UserQuestionLog_GetUnReplyQuestionCount_GET,_UserQuestionLog_GetLogonQuestionCount_GET,_Money_GetConvertLogCount_GET,_Warning_ExistWarning_GET" />

		<!--上传文件目录-->
		<add key="uploadFolder" value="E:\shiquan\web\game\game.WebSite" />
		<!--上传文件基地址-->
		<add key="uploadFileBaseUrl" value="http://localhost:9332" />
		<!--网站域名-->
		<add key="webSiteHost" value="http://localhost:9230/" />
		<!--是否要金鑰驗證-->
		<add key="NeedVerification" value="False" />
		<!--修改金幣是否要金鑰驗證-->
		<add key="IgnoreRolesVerification" value="5" />
		<!--金鑰驗證Tag-->
		<add key="QRCodeTag" value="AuerProject" />

		<!--客服功能图片存取位置-->
		<add key="ImageUrl" value="http://localhost:9332" />
		
		<!-- 是否显示完整的用户LoginName(1:YES, 0:NO)-->
		<add key="ShowCompleteLoginName" value="1"/>
		
		<!-- 自訂系統名稱 -->
		<add key="systemName" value="老虎機后台管理系统" />
	
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.5" />
		<httpRuntime targetFramework="4.5" />
		<sessionState mode="StateServer" stateConnectionString="tcpip=0.0.0.0:42424" cookieless="false" timeout="360" />
		<pages validateRequest="false" />
	</system.web>
	<entityFramework>
		<defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
			<parameters>
				<parameter value="v11.0" />
			</parameters>
		</defaultConnectionFactory>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Web.WebPages.Deployment" publicKeyToken=[REDACTED]" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.WebPages.Razor" publicKeyToken=[REDACTED]" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Razor" publicKeyToken=[REDACTED]" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Mvc" publicKeyToken=[REDACTED]" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Helpers" publicKeyToken=[REDACTED]" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.WebPages" publicKeyToken=[REDACTED]" />
				<bindingRedirect oldVersion="0.0.0.0-0.0.0.0" newVersion="0.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
		<system.webServer>
				<defaultDocument enabled="false">
						<files>
						</files>
				</defaultDocument>
			<modules runAllManagedModulesForAllRequests="true" />
			<staticContent>
				<remove fileExtension=".woff"/>
				<mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
			</staticContent>
		</system.webServer>
</configuration>
