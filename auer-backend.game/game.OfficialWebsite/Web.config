  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=0.0.0.0, Culture=neutral, PublicKeyToken=[REDACTED]" warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701" />
