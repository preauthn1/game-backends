<configuration>
  <appSettings>
    <add key="GameAPIUrl" value="http://localhost:10707/api/v1/"/>
    <add key="GameAPIId" value="1"/>
    <add key="GameAPIKey" value="123"/>
    <add key="AppleTouchIconUrl" value="/Content/image"/>

    
    <add key="webpages:Version" value="0.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.5.2" />
    <httpRuntime targetFramework="4.5.2" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken=[REDACTED]" />
